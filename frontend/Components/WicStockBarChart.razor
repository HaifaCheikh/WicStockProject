@using WicStock.Web.Models
﻿

<div class="wicstock-bar-chart" style="width:@Width; font-family:'Inter',sans-serif;">
    <svg viewBox="0 0 @SvgTotalW @F(SvgH)" width="100%" xmlns="http://www.w3.org/2000/svg"
         style="display:block; overflow:visible; max-width:100%;">
        @GetSvgContent()
    </svg>
    @if (Labels.Count > MaxBars)
    {
        <p style="font-size:11px;color:#94a3b8;margin:6px 0 0 @(LabelW)px;font-family:Inter,sans-serif;">
            Top @MaxBars affich&#233;s sur @Labels.Count r&#233;sultats
        </p>
    }
</div>

@code {
    [Parameter] public List<string> Labels { get; set; } = new();
    [Parameter] public List<double> Series { get; set; } = new();
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public int MaxBars { get; set; } = 10;
    [Parameter] public string[]? CustomPalette { get; set; }
    [Parameter] public EventCallback<string> OnDrillDown { get; set; }
    [Parameter] public string? UserRole { get; set; }

    private const double LabelW = 180;
    private const double RightPad = 25;
    private const double TopPad = 26;
    private const double BarH = 30;
    private const double BarGap = 10;
    private const int GridLines = 4;
    private const double SvgTotalW = 720;

    private List<string> VisibleLabels => Labels.Take(MaxBars).ToList();
    private List<double> VisibleSeries => Series.Take(MaxBars).ToList();
    private int VisibleCount => Math.Min(Labels.Count, MaxBars);
    private double ChartW => SvgTotalW - LabelW - RightPad;
    private double ChartH => Math.Max(1, VisibleCount * (BarH + BarGap) - BarGap);
    private double SvgH => TopPad + ChartH + 16;
    private double MaxVal => VisibleSeries.Count > 0 ? (VisibleSeries.Max() > 0 ? VisibleSeries.Max() * 1.08 : 1) : 1;

    private string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string FormatVal(double v)
    {
        if (v >= 1_000_000) return (v / 1_000_000.0).ToString("0.#") + "M";
        if (v >= 1_000) return (v / 1_000.0).ToString("0.#") + "k";
        if (v % 1 < double.Epsilon) return ((long)v).ToString();
        return v.ToString("0.#");
    }

    private static string Truncate(string s, int max) =>
        s.Length > max ? s[..Math.Max(1, max - 1)] + "\u2026" : s;

    private MarkupString GetSvgContent()
    {
        var sb = new System.Text.StringBuilder();

        // Grille verticale
        for (int g = 0; g <= GridLines; g++)
        {
            double gx = LabelW + g * (ChartW / GridLines);
            double gVal = MaxVal * g / GridLines;
            sb.AppendLine($@"<line x1=""{F(gx)}"" y1=""{F(TopPad)}"" x2=""{F(gx)}"" y2=""{F(TopPad + ChartH)}"" stroke=""#e2e8f0"" stroke-width=""1"" stroke-dasharray=""3 3"" />");
            sb.AppendLine($@"<text x=""{F(gx)}"" y=""{F(TopPad - 8)}"" text-anchor=""middle"" font-size=""10.5"" fill=""#94a3b8"" font-family=""Inter,sans-serif"">{System.Net.WebUtility.HtmlEncode(FormatVal(gVal))}</text>");
        }

        // Barres horizontales
        for (int i = 0; i < VisibleCount; i++)
        {
            double barY = TopPad + i * (BarH + BarGap);
            double barW = MaxVal > 0 ? (VisibleSeries[i] / MaxVal) * ChartW : 0;
            string color = (CustomPalette != null && CustomPalette.Length > 0) ? CustomPalette[i % CustomPalette.Length] : WicStockChartConfig.Palette[i % WicStockChartConfig.Palette.Length];
            string labelEsc = System.Net.WebUtility.HtmlEncode(Truncate(VisibleLabels[i], 24));
            string valEsc = System.Net.WebUtility.HtmlEncode(FormatVal(VisibleSeries[i]));
            string titleEsc = System.Net.WebUtility.HtmlEncode($"{VisibleLabels[i]} : {FormatVal(VisibleSeries[i])}");

            // Rail gris
            sb.AppendLine($@"<rect x=""{F(LabelW)}"" y=""{F(barY)}"" width=""{F(ChartW)}"" height=""{F(BarH)}"" rx=""5"" fill=""#f1f5f9"" />");

            // Barre colorée
            sb.AppendLine($@"<rect x=""{F(LabelW)}"" y=""{F(barY)}"" width=""{F(Math.Max(barW, 4))}"" height=""{F(BarH)}"" rx=""5"" fill=""{color}"" opacity=""0.94""><title>{titleEsc}</title></rect>");

            // Label gauche
            sb.AppendLine($@"<text x=""{F(LabelW - 10)}"" y=""{F(barY + BarH / 2 + 4.5)}"" text-anchor=""end"" font-size=""12"" fill=""#334155"" font-family=""Inter,sans-serif"" font-weight=""500"">{labelEsc}</text>");

            // Valeur numérique
            if (barW > 38)
            {
                sb.AppendLine($@"<text x=""{F(LabelW + barW - 8)}"" y=""{F(barY + BarH / 2 + 4.5)}"" text-anchor=""end"" font-size=""11.5"" fill=""white"" font-family=""JetBrains Mono,monospace"" font-weight=""700"">{valEsc}</text>");
            }
            else
            {
                sb.AppendLine($@"<text x=""{F(LabelW + barW + 8)}"" y=""{F(barY + BarH / 2 + 4.5)}"" text-anchor=""start"" font-size=""11.5"" fill=""{color}"" font-family=""JetBrains Mono,monospace"" font-weight=""700"">{valEsc}</text>");
            }
        }

        // Ligne de base verticale
        sb.AppendLine($@"<line x1=""{F(LabelW)}"" y1=""{F(TopPad)}"" x2=""{F(LabelW)}"" y2=""{F(TopPad + ChartH)}"" stroke=""#cbd5e1"" stroke-width=""1.5"" />");

        return new MarkupString(sb.ToString());
    }
}
