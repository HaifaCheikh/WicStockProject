@code {
    [Parameter] public int Id { get; set; }

    private string? imageAgrandieUrl;
    private string? imageAgrandieAlt;

    private void OuvrirImageAgrandie(string? url, string? alt)
    {
        if (string.IsNullOrEmpty(url)) return;
        imageAgrandieUrl = url;
        imageAgrandieAlt = alt ?? "Image du produit";
    }

    private void FermerImageAgrandie()
    {
        imageAgrandieUrl = null;
        imageAgrandieAlt = null;
    }

    [Parameter]
    [SupplyParameterFromQuery(Name = "payment")]
    public string? PaymentQuery { get; set; }

    private SuiviCommandeDto? suivi;
    private AvisDto? avisExistant;
    private bool showAvisModal = false;
    private bool showReclamationModal = false;
    private bool isLoading = true;

    private record TimelineStep(string Key, string Label);

    private static readonly TimelineStep[] EtapesStandard =
    {
        new("CONFIRMEE", "Confirmée"),
        new("PAYEE", "Payée"),
        new("EN_LIVRAISON", "En livraison"),
        new("LIVREE", "Livrée")
    };

    private static readonly TimelineStep[] EtapesSurCommande =
    {
        new("RECUE", "Commande reçue"),
        new("CONFIRMEE", "Confirmée"),
        new("PREPARATION", "En préparation"),
        new("PRETE", "Prête"),
        new("PAYEE", "Payée"),
        new("EN_LIVRAISON", "En livraison"),
        new("LIVREE", "Livrée")
    };

    private IEnumerable<TimelineStep> GetEtapes()
    {
        if (suivi != null && suivi.EstSurCommande)
            return EtapesSurCommande;
        return EtapesStandard;
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        try
        {
            suivi = await CatalogueService.ObtenirSuiviCommande(Id);
            if (suivi != null && IsLivree())
            {
                avisExistant = await FeedbackService.ObtenirAvisCommande(suivi.Id);
            }

            var uri = new Uri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var payStatus = query["payment"];
            if (!string.IsNullOrEmpty(payStatus))
            {
                if (payStatus == "success")
                {
                    Snackbar.Add("Votre paiement a été confirmé avec succès ! Merci.", Severity.Success);
                }
                else if (payStatus == "cancelled")
                {
                    Snackbar.Add("Le paiement a été annulé.", Severity.Info);
                }
            }
        }
        catch { suivi = null; }
        finally { isLoading = false; }
    }

    private bool IsLivree()
    {
        if (suivi == null) return false;
        var st = suivi.Statut?.ToUpperInvariant() ?? suivi.StatutCommande?.ToUpperInvariant() ?? "";
        return st == "LIVREE";
    }

    private bool EstDelaiExceder14Jours()
    {
        if (suivi == null) return true;
        var refDate = suivi.DateLivraison ?? suivi.DateVente;
        return (DateTime.Now - refDate).TotalDays > 14;
    }

    private async Task ChargerAvisExistant()
    {
        if (suivi != null)
        {
            avisExistant = await FeedbackService.ObtenirAvisCommande(suivi.Id);
        }
    }

    private void Retour() => Navigation.NavigateTo("/mes-commandes");

    private string GetFullImageUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        if (url.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }
        return $"{Http.BaseAddress}{url.TrimStart('/')}";
    }

    private int GetCurrentStepIndex()
    {
        if (suivi == null) return -1;
        var statut = suivi.Statut?.ToUpperInvariant() ?? "";

        if (suivi.EstSurCommande)
        {
            return statut switch
            {
                "EN_ATTENTE_CONFIRMATION" or "EN_ATTENTE" => 0,
                "CONFIRMEE" => 1,
                "EN_PREPARATION" => 2,
                "PRETE" => 3,
                "PAYEE" => 4,
                "EN_LIVRAISON" => 5,
                "LIVREE" => 6,
                _ => 0
            };
        }
        else
        {
            return statut switch
            {
                "PAYEE" => 1,
                "EN_LIVRAISON" => 2,
                "LIVREE" => 3,
                _ => 0 // ACCEPTEE / CONFIRMEE -> Step 0 (Confirmée)
            };
        }
    }

    private string GetStepState(string key)
    {
        var idx = GetCurrentStepIndex();
        var etapesList = GetEtapes().ToList();
        int stepIdx = etapesList.FindIndex(e => e.Key == key);
        if (stepIdx == -1) return "future";
        if (idx > stepIdx) return "done";
        if (idx == stepIdx) return "current";
        return "future";
    }

    private bool IsConnectorDone(string key)
    {
        var idx = GetCurrentStepIndex();
        var etapesList = GetEtapes().ToList();
        int stepIdx = etapesList.FindIndex(e => e.Key == key);
        return stepIdx != -1 && idx > stepIdx;
    }

    private double GetProgressPercent()
    {
        var etapesList = GetEtapes().ToList();
        if (etapesList.Count <= 1) return 0;
        var idx = GetCurrentStepIndex();
        if (idx <= 0) return 0;
        var value = (double)idx / (etapesList.Count - 1) * 100;
        return Math.Min(100, Math.Max(0, value));
    }

    private DateTime? GetStepDate(string key) => suivi == null ? null : key switch
    {
        "RECUE" => suivi.DateVente,
        "CONFIRMEE" => suivi.DateConfirmation ?? suivi.DateVente,
        "PREPARATION" => suivi.DateDebutPreparation,
        "PRETE" => suivi.DatePrete,
        "PAYEE" => suivi.DatePaiement,
        "LIVRAISON" => suivi.DateLivraison,
        "LIVREE" => suivi.DateLivraison,
        _ => null
    };

    private bool CanShowPaymentButton()
    {
        if (suivi == null) return false;

        // Déjà payée ou plus loin dans le cycle → pas de bouton
        var statut = suivi.Statut?.ToUpperInvariant() ?? "";
        if (statut == "PAYEE" || statut == "EN_LIVRAISON" || statut == "LIVREE")
            return false;

        // Commande simple acceptée automatiquement (pas sur commande)
        if (!suivi.EstSurCommande && suivi.StatutCommande == "ACCEPTEE")
            return true;

        // Commande sur commande prête
        if (statut == "PRETE")
            return true;

        return false;
    }

    private decimal GetTotalAmount()
    {
        if (suivi == null) return 0;
        return suivi.QuantiteVendue * suivi.PrixUnitaire;
    }

    private void ProceedToPayment()
    {
        if (suivi == null) return;
        Navigation.NavigateTo($"/payment/checkout/{suivi.Id}");
    }

    private bool IsRefusee()
    {
        if (suivi == null) return false;
        var s = suivi.Statut?.ToUpperInvariant() ?? suivi.StatutCommande?.ToUpperInvariant() ?? "";
        return s == "REFUSEE" || s == "ANNULEE";
    }

    private string GetStatusLabel()
    {
        if (suivi == null) return "Inconnu";
        var statut = suivi.Statut?.ToUpperInvariant() ?? suivi.StatutCommande?.ToUpperInvariant() ?? "";
        return statut switch
        {
            "EN_ATTENTE_CONFIRMATION" or "EN_ATTENTE" => "En attente de confirmation",
            "ACCEPTEE" when !suivi.EstSurCommande => "Acceptée — En attente de paiement",
            "CONFIRMEE" => "Confirmée",
            "EN_PREPARATION" => "En préparation",
            "PRETE" => "Prête — En attente de paiement",
            "PAYEE" => "Payée",
            "EN_LIVRAISON" => "En livraison",
            "LIVREE" => "Livrée",
            "REFUSEE" => "Refusée",
            _ => "En cours"
        };
    }

    private string GetStatusPillClass()
    {
        if (suivi == null) return "status-pill--pending";
        var statut = suivi.Statut?.ToUpperInvariant() ?? suivi.StatutCommande?.ToUpperInvariant() ?? "";
        return statut switch
        {
            "LIVREE" => "status-pill--done",
            "PAYEE" or "EN_LIVRAISON" => "status-pill--paid",
            "PRETE" or "ACCEPTEE" when !suivi.EstSurCommande => "status-pill--ready",
            "REFUSEE" => "status-pill--refused",
            "EN_ATTENTE_CONFIRMATION" or "EN_ATTENTE" => "status-pill--pending",
            _ => "status-pill--progress"
        };
    }

    private string GetStatusIcon()
    {
        if (suivi == null) return Icons.Material.Filled.HourglassTop;
        var statut = suivi.Statut?.ToUpperInvariant() ?? suivi.StatutCommande?.ToUpperInvariant() ?? "";
        return statut switch
        {
            "LIVREE" => Icons.Material.Filled.CheckCircle,
            "EN_LIVRAISON" => Icons.Material.Filled.LocalShipping,
            "PAYEE" => Icons.Material.Filled.Payments,
            "PRETE" or "ACCEPTEE" when !suivi.EstSurCommande => Icons.Material.Filled.ShoppingBag,
            "REFUSEE" => Icons.Material.Filled.Cancel,
            "EN_ATTENTE_CONFIRMATION" or "EN_ATTENTE" => Icons.Material.Filled.HourglassTop,
            _ => Icons.Material.Filled.Autorenew
        };
    }
}
