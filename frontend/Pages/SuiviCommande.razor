@page "/mes-commandes/suivi/{Id:int}"
@page "/suivi-commande/{Id:int}"
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@using WicStock.Web.Pages.Feedback
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "CLIENT,ADMIN,RESPONSABLE_STOCK_PRODUCTION")]
@inject CatalogueService CatalogueService
@inject FeedbackService FeedbackService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Suivi commande | WicStock</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="suivi-page">
    @if (isLoading)
    {
        <div class="d-flex justify-center my-12">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (suivi == null)
    {
        <div class="empty-state">
            <div class="empty-icon">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
            </div>
            <MudText Typo="Typo.h6" Class="empty-title mt-3">Commande introuvable</MudText>
            <MudText Typo="Typo.body2" Class="empty-subtitle mt-1">Cette commande n'existe pas ou n'est plus accessible.</MudText>
            <button class="btn btn--primary mt-4" @onclick="Retour">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                <span>Retour à mes commandes</span>
            </button>
        </div>
    }
    else
    {
        <div class="suivi-shell">

            @if (PaymentQuery == "success")
            {
                <div class="payment-alert payment-alert--success">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                    <span>Votre paiement a été reçu avec succès ! Merci pour votre confiance.</span>
                </div>
            }
            else if (PaymentQuery == "cancelled")
            {
                <div class="payment-alert payment-alert--warning">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                    <span>Le paiement a été annulé. Vous pouvez réessayer à tout moment.</span>
                </div>
            }

            <!-- ===== EN-TÊTE ===== -->
            <div class="suivi-header">
                <button class="back-btn" @onclick="Retour" title="Retour">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                </button>
                <div class="header-titles">
                    <MudText Typo="Typo.h4" Class="page-title">Suivi de commande</MudText>
                    <MudText Typo="Typo.body2" Class="page-subtitle">Commandée le @suivi.DateVente.ToString("dd MMMM yyyy à HH:mm")</MudText>
                </div>
                <span class="status-pill @GetStatusPillClass()">
                    <span class="status-pill-dot"></span>
                    <MudIcon Icon="@GetStatusIcon()" Size="Size.Small" />
                    @GetStatusLabel()
                </span>
            </div>

            <!-- ===== CARTE COMMANDE (style récapitulatif) ===== -->
            <div class="order-card">
                @if (suivi.EstMultiLignes && suivi.Lignes.Count > 0)
                {
                    <!-- Commande multi-articles -->
                    <div class="order-card-head order-card-head--minimal">
                        <span class="article-count-chip">@suivi.Lignes.Count article@(suivi.Lignes.Count > 1 ? "s" : "")</span>
                    </div>

                    <div class="order-lines">
                        @foreach (var ligne in suivi.Lignes)
                        {
                            <div class="order-line">
                                <div class="order-line-img">
                                    @if (!string.IsNullOrEmpty(ligne.ProduitImageUrl))
                                    {
                                        <img src="@GetFullImageUrl(ligne.ProduitImageUrl)" alt="@ligne.ProduitNom" @onclick="() => OuvrirImageAgrandie(GetFullImageUrl(ligne.ProduitImageUrl), ligne.ProduitNom)" title="Cliquer pour agrandir l'image" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Small" Style="color:#94A3B8;" />
                                    }
                                </div>
                                <div class="order-line-info">
                                    <span class="ref-code">@ligne.ProduitReference</span>
                                    <span class="order-line-name">@ligne.ProduitNom</span>
                                </div>
                                <div class="order-line-right">
                                    <span class="order-line-qty">× @ligne.Quantite</span>
                                    <span class="order-line-price">@((ligne.PrixUnitaire * ligne.Quantite).ToString("0.00")) DT</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="order-total-row">
                        <span>Montant total</span>
                        <span class="order-total-value">@suivi.MontantAffiche.ToString("0.00") DT</span>
                    </div>

                    <div class="info-chips">
                        <div class="info-chip">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                            <div>
                                <span class="info-chip-label">Quantité totale</span>
                                <span class="info-chip-value">@suivi.QuantiteVendue pièce(s)</span>
                            </div>
                        </div>
                        @if (suivi.DateSouhaitee.HasValue)
                        {
                            <div class="info-chip">
                                <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" />
                                <div>
                                    <span class="info-chip-label">Date souhaitée</span>
                                    <span class="info-chip-value">@suivi.DateSouhaitee.Value.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        }
                        @if (suivi.DateEstimeePreparation.HasValue)
                        {
                            <div class="info-chip">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                <div>
                                    <span class="info-chip-label">Préparation estimée</span>
                                    <span class="info-chip-value">@suivi.DateEstimeePreparation.Value.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- Commande mono-article (legacy) -->
                    <div class="order-card-head order-card-head--single">
                        <div class="order-single-img">
                            @if (!string.IsNullOrEmpty(suivi.ProduitImageUrl))
                            {
                                <img src="@GetFullImageUrl(suivi.ProduitImageUrl)" alt="@suivi.ProduitNom" @onclick="() => OuvrirImageAgrandie(GetFullImageUrl(suivi.ProduitImageUrl), suivi.ProduitNom)" title="Cliquer pour agrandir l'image" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Large" />
                            }
                        </div>
                        <div class="order-single-details">
                            <span class="ref-code">@suivi.ProduitReference</span>
                            <h2 class="order-card-title order-card-title--single">@suivi.ProduitNom</h2>
                        </div>
                    </div>

                    <div class="info-chips">
                        <div class="info-chip">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                            <div>
                                <span class="info-chip-label">Quantité commandée</span>
                                <span class="info-chip-value">@suivi.QuantiteVendue pièce(s)</span>
                            </div>
                        </div>
                        @if (suivi.DateSouhaitee.HasValue)
                        {
                            <div class="info-chip">
                                <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" />
                                <div>
                                    <span class="info-chip-label">Date souhaitée</span>
                                    <span class="info-chip-value">@suivi.DateSouhaitee.Value.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        }
                        @if (suivi.DateEstimeePreparation.HasValue)
                        {
                            <div class="info-chip">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                <div>
                                    <span class="info-chip-label">Préparation estimée</span>
                                    <span class="info-chip-value">@suivi.DateEstimeePreparation.Value.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(suivi.AdresseLivraison) || !string.IsNullOrWhiteSpace(suivi.CodePostal))
                        {
                            <div class="info-chip info-chip--wide">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                                <div>
                                    <span class="info-chip-label">Adresse de livraison</span>
                                    <span class="info-chip-value">
                                        @suivi.AdresseLivraison
                                        @if (!string.IsNullOrWhiteSpace(suivi.Ville))
                                        {
                                            <span>, @suivi.Ville</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(suivi.CodePostal))
                                        {
                                            <span class="cp-badge">CP @suivi.CodePostal</span>
                                        }
                                    </span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="order-total-row">
                        <span>Montant total</span>
                        <span class="order-total-value">@GetTotalAmount().ToString("0.00") DT</span>
                    </div>
                }
            </div>

            <!-- ===== FEEDBACK / RECLAMATION (SI LIVRÉE) ===== -->
            @if (IsLivree())
            {
                if (EstDelaiExceder14Jours())
                {
                    <div class="feedback-expired-card">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Medium" Class="expired-icon" />
                        <div>
                            <h4 class="feedback-card-title">Délai d'avis & réclamation expiré</h4>
                            <p class="feedback-card-subtitle">Le délai de 14 jours après la livraison pour déposer un avis ou effectuer une réclamation est dépassé.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="feedback-action-card">
                        <div class="feedback-action-header">
                            <div>
                                <h3 class="feedback-card-title">Avis & réclamation client</h3>
                                <p class="feedback-card-subtitle">Votre commande a été livrée. Vous avez 14 jours pour donner votre avis ou signaler un problème.</p>
                            </div>
                            <div class="feedback-buttons-row">
                                <button class="btn btn--primary" @onclick="() => showAvisModal = true">
                                    <MudIcon Icon="@Icons.Material.Filled.StarRate" Size="Size.Small" />
                                    <span>@(avisExistant != null ? "Modifier mon avis" : "Laisser un avis")</span>
                                </button>
                                <button class="btn btn--outline-rust" @onclick="() => showReclamationModal = true">
                                    <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" />
                                    <span>Signaler un problème</span>
                                </button>
                            </div>
                        </div>

                        @if (avisExistant != null)
                        {
                            <div class="avis-preview-box mt-4">
                                <div class="avis-preview-header">
                                    <div class="d-flex align-center gap-2">
                                        <div class="stars-display">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                int starVal = i;
                                                <MudIcon Icon="@(starVal <= avisExistant.Note ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)" Size="Size.Small" Class="star-gold" />
                                            }
                                        </div>
                                        <span class="avis-date">Avis déposé le @avisExistant.DateCreation.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <span class="status-pill status-pill--done avis-status-pill">@avisExistant.Statut</span>
                                </div>
                                @if (!string.IsNullOrEmpty(avisExistant.Commentaire))
                                {
                                    <p class="avis-comment-text mt-2">« @avisExistant.Commentaire »</p>
                                }
                            </div>
                        }
                    </div>
                }
            }

            <!-- ===== BOUTON DE PAIEMENT ===== -->
            @if (CanShowPaymentButton())
            {
                <div class="payment-action-card">
                    <div class="payment-action-content">
                        <div class="payment-action-info">
                            <div class="payment-action-icon-wrap">
                                <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Medium" Class="payment-action-icon" />
                            </div>
                            <div>
                                <h3 class="payment-action-title">Payer votre commande</h3>
                                <p class="payment-action-subtitle">Montant à régler : <strong>@GetTotalAmount().ToString("N2") TND</strong></p>
                            </div>
                        </div>
                        <button class="btn btn--primary payment-action-btn" @onclick="ProceedToPayment">
                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Small" />
                            <span>Payer maintenant</span>
                        </button>
                    </div>
                </div>
            }

            <!-- ===== PROGRESSION OU ALERTE REFUSÉE ===== -->
            @if (IsRefusee())
            {
                <div class="commande-refusee-card">
                    <div class="refusee-icon-badge">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Medium" />
                    </div>
                    <div class="refusee-content">
                        <h3 class="refusee-title">Commande refusée</h3>
                        <p class="refusee-description">
                            Cette commande a été refusée par notre équipe et ne fera pas l'objet d'un traitement ni d'une livraison.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <!-- ===== TIMELINE DE PROGRESSION ===== -->
                <div class="timeline-card">
                    <div class="timeline-card-head">
                        <h3 class="timeline-title">Progression de la commande</h3>
                        <span class="timeline-subtitle">Étape @(GetCurrentStepIndex() + 1) sur @GetEtapes().Count()</span>
                    </div>

                    <div class="timeline-horizontal">
                        <div class="timeline-track">
                            <div class="timeline-track-fill" style="width:@(GetProgressPercent())%;"></div>
                        </div>
                        <div class="timeline-steps">
                            @{
                                var etapesList = GetEtapes().ToList();
                                for (int i = 0; i < etapesList.Count; i++)
                                {
                                    var step = etapesList[i];
                                    var state = GetStepState(step.Key);
                                    <div class="timeline-step @state">
                                        <div class="step-icon">
                                            @if (state == "done")
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                            }
                                            else if (state == "current")
                                            {
                                                <span class="step-icon-dot"></span>
                                            }
                                        </div>
                                        <div class="step-label">@step.Label</div>
                                        @if (GetStepDate(step.Key) is DateTime date)
                                        {
                                            <div class="step-date">@date.ToString("dd/MM/yyyy")</div>
                                        }
                                        else if (state == "current")
                                        {
                                            <div class="step-date step-date--pending">En cours</div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Modales Avis & Réclamation -->
            @if (suivi != null)
            {
                <AvisModal @bind-IsOpen="showAvisModal"
                           CommandeId="@suivi.Id"
                           ProduitId="@suivi.ProduitId"
                           ProduitNom="@suivi.ProduitNom"
                           ProduitRef="@suivi.ProduitReference"
                           ProduitImgUrl="@GetFullImageUrl(suivi.ProduitImageUrl)"
                           Lignes="@suivi.Lignes"
                           AvisExistant="@avisExistant"
                           OnAvisEnregistre="ChargerAvisExistant" />

                <ReclamationModal @bind-IsOpen="showReclamationModal"
                                  CommandeId="@suivi.Id"
                                  ProduitId="@suivi.ProduitId"
                                  ProduitNom="@suivi.ProduitNom"
                                  ProduitRef="@suivi.ProduitReference"
                                  ProduitImgUrl="@GetFullImageUrl(suivi.ProduitImageUrl)"
                                  Lignes="@suivi.Lignes" />
            }

        </div>
    }
</div>

<!-- ===== LIGHTBOX IMAGE AGRANDIE ===== -->
@if (!string.IsNullOrEmpty(imageAgrandieUrl))
{
    <div class="image-lightbox-overlay" @onclick="FermerImageAgrandie">
        <button class="lightbox-close-btn" @onclick="FermerImageAgrandie" @onclick:stopPropagation="true" aria-label="Fermer">
            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Large" />
        </button>
        <img src="@imageAgrandieUrl" alt="@imageAgrandieAlt" class="lightbox-img" @onclick:stopPropagation="true" />
        @if (!string.IsNullOrEmpty(imageAgrandieAlt))
        {
            <div class="lightbox-caption">@imageAgrandieAlt</div>
        }
    </div>
}

<style>
    .suivi-page {
        --ink: #16233A;
        --ink-muted: #64748B;
        --paper: #FFFFFF;
        --sand: #F3F6FA;
        --sand-deep: #EAEFF6;
        --border: #E1E7EF;
        --denim: #2B4C7E;
        --denim-dark: #14263F;
        --denim-tint: #E7EDF6;
        --pine: #1E6B4C;
        --pine-tint: #E4F3EC;
        --amber: #D97706;
        --amber-tint: #FEF3C7;
        --rust: #B5563A;
        --rust-tint: #F9ECE8;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 18px;
        --font-display: "Sora", "Inter", sans-serif;
        --font-body: "Inter", sans-serif;
        --font-mono: "JetBrains Mono", monospace;
        font-family: var(--font-body);
        color: var(--ink);
        background: transparent;
        min-height: 100%;
        padding: 4px 4px 40px;
    }

    .suivi-shell {
        max-width: 920px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    /* ===== Payment Alerts ===== */
    .payment-alert {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        border-radius: var(--radius-md);
        font-weight: 600;
        font-size: 0.9375rem;
    }

    .payment-alert--success {
        background: var(--pine-tint);
        color: var(--pine);
        border: 1px solid rgba(30, 107, 76, 0.2);
    }

    .payment-alert--warning {
        background: var(--amber-tint);
        color: var(--amber);
        border: 1px solid #FDE68A;
    }

    /* ===== En-tête ===== */
    .suivi-header {
        display: flex;
        align-items: flex-start;
        gap: 18px;
    }

    .back-btn {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        background: var(--paper);
        color: var(--ink-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.15s ease;
    }

        .back-btn:hover {
            background: var(--sand);
            border-color: var(--denim);
            color: var(--denim);
        }

    .header-titles {
        flex: 1;
        min-width: 200px;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .page-title {
        font-family: var(--font-display) !important;
        font-weight: 700 !important;
        letter-spacing: -0.02em;
        color: var(--ink) !important;
        line-height: 1.15 !important;
    }

    .page-subtitle {
        color: var(--ink-muted) !important;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 0.8125rem;
        font-weight: 700;
        padding: 9px 16px;
        border-radius: 999px;
        white-space: nowrap;
        flex-shrink: 0;
        margin-top: 4px;
        border: 1px solid transparent;
    }

    .status-pill-dot {
        display: none;
    }

    .status-pill--pending {
        background: var(--amber-tint);
        color: var(--amber);
        border-color: #FDE68A;
    }

    .status-pill--progress {
        background: var(--denim-tint);
        color: var(--denim);
        border-color: rgba(43, 76, 126, 0.15);
    }

    .status-pill--done {
        background: var(--pine-tint);
        color: var(--pine);
        border-color: rgba(30, 107, 76, 0.15);
    }

    .status-pill--ready {
        background: var(--denim-tint);
        color: var(--denim);
        border-color: rgba(43, 76, 126, 0.15);
    }

    .status-pill--paid {
        background: #EEF2FF;
        color: #4F46E5;
        border-color: #C7D2FE;
    }

    .status-pill--refused {
        background: var(--rust-tint);
        color: var(--rust);
        border-color: #F0C7BB;
    }

    /* ===== Carte Commande Refusée ===== */
    .commande-refusee-card {
        background: var(--rust-tint);
        border: 1.5px solid #F0C7BB;
        border-radius: var(--radius-lg);
        padding: 24px 28px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 2px 10px rgba(181, 86, 58, 0.06);
    }
    .refusee-icon-badge {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #F8D7DA;
        color: var(--rust);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .refusee-title {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--rust);
        margin-bottom: 4px;
    }
    .refusee-description {
        font-size: 0.9rem;
        color: #7A3320;
        line-height: 1.5;
        margin: 0;
    }

    /* ===== Carte Commande (récapitulatif) ===== */
    .order-card, .timeline-card {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 26px 28px;
        box-shadow: 0 1px 2px rgba(22, 35, 58, 0.04), 0 8px 24px -16px rgba(22, 35, 58, 0.15);
    }

    .order-card-head {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
    }

    .order-card-head--minimal {
        margin-bottom: 14px;
    }

    .order-thumb-stack {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-sm);
        background: var(--denim-tint);
        color: var(--denim);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .order-card-title {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--ink);
        margin: 0 0 4px 0;
        letter-spacing: -0.01em;
    }

    .article-count-chip {
        display: inline-block;
        background: var(--denim-tint);
        color: var(--denim);
        border: 1px solid rgba(43, 76, 126, 0.15);
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 3px 12px;
    }

    /* Ligne d'articles */
    .order-lines {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        overflow: hidden;
        margin-bottom: 18px;
    }

    .order-line {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        background: var(--paper);
        border-bottom: 1px solid var(--border);
        transition: background 0.12s ease;
    }

