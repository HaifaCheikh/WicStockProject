@code {
    [SupplyParameterFromQuery(Name = "statut")]
    public string? StatutQuery { get; set; }

    private List<CommandeManagerDto>? commandes;
    private List<ResponsableDto>? responsables;
    private bool isLoading = true;
    private string searchString = "";
    private string statutFilter = "";
    private bool isGridView = false;
    private string? userRole;

    protected override async Task OnInitializedAsync()
    {
        userRole = await AuthService.ObtenirRole();
        if (!string.IsNullOrWhiteSpace(StatutQuery))
        {
            statutFilter = StatutQuery.ToUpperInvariant().Trim();
        }
        await ChargerCommandes();
        if (userRole == "ADMIN")
        {
            await ChargerResponsables();
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(StatutQuery))
        {
            statutFilter = StatutQuery.ToUpperInvariant().Trim();
        }
    }

    private async Task ChargerCommandes()
    {
        isLoading = true;
        try
        {
            commandes = await CatalogueService.ObtenirToutesLesCommandes();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur de chargement des commandes: {ex.Message}", Severity.Error);
            commandes = new List<CommandeManagerDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChargerResponsables()
    {
        try
        {
            responsables = await CatalogueService.ObtenirResponsables();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur de chargement des responsables: {ex.Message}", Severity.Error);
            responsables = new List<ResponsableDto>();
        }
    }

    private IEnumerable<CommandeManagerDto> FilteredCommandes
    {
        get
        {
            if (commandes == null) return Enumerable.Empty<CommandeManagerDto>();

            var list = commandes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(statutFilter))
            {
                list = list.Where(c => c.StatutCommande.Equals(statutFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(searchString))
            {
                var s = searchString.Trim();
                list = list.Where(c =>
                    (c.ClientNom?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.ClientEmail?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.ProduitNom?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.ProduitReference?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                );
            }

            return list;
        }
    }

    private int CountTotal => commandes?.Count ?? 0;
    private int CountEnAttente => commandes?.Count(c => c.StatutCommande == "EN_ATTENTE") ?? 0;
    private int CountAcceptees => commandes?.Count(c => c.StatutCommande == "ACCEPTEE") ?? 0;
    private int CountRefusees => commandes?.Count(c => c.StatutCommande == "REFUSEE") ?? 0;

    private Task OnStatutFilterChanged(ChangeEventArgs e)
    {
        statutFilter = e.Value?.ToString() ?? "";
        return Task.CompletedTask;
    }

    private async Task Accepter(int id)
    {
        var succes = await CatalogueService.AccepterCommande(id);
        if (succes)
        {
            Snackbar.Add("Commande acceptée avec succès ! Le stock a été mis à jour.", Severity.Success);
            await ChargerCommandes();
            await CommandeBadgeService.RafraichirAsync();
        }
        else
        {
            Snackbar.Add("Impossible d'accepter la commande.", Severity.Error);
        }
    }

    private CommandeManagerDto? commandeARefuser;

    private void DemanderRefus(CommandeManagerDto cmd) => commandeARefuser = cmd;
    private void FermerRefus() => commandeARefuser = null;

    private async Task ConfirmerRefus()
    {
        if (commandeARefuser == null) return;

        var id = commandeARefuser.Id;
        FermerRefus();

        var succes = await CatalogueService.RefuserCommande(id);
        if (succes)
        {
            Snackbar.Add("Commande refusée avec succès.", Severity.Info);
            await ChargerCommandes();
            await CommandeBadgeService.RafraichirAsync();
        }
        else
        {
            Snackbar.Add("Impossible de refuser la commande.", Severity.Error);
        }
    }

    private CommandeManagerDto? commandeASupprimer;

    private void DemanderSuppression(CommandeManagerDto cmd) => commandeASupprimer = cmd;
    private void FermerSuppression() => commandeASupprimer = null;

    private async Task ConfirmerSuppression()
    {
        if (commandeASupprimer == null) return;

        var id = commandeASupprimer.Id;
        FermerSuppression();

        var succes = await CatalogueService.SupprimerCommande(id);
        if (succes)
        {
            Snackbar.Add("Commande supprimée avec succès.", Severity.Success);
            await ChargerCommandes();
        }
        else
        {
            Snackbar.Add("Impossible de supprimer la commande.", Severity.Error);
        }
    }

    private string GetStatutCssClass(string? statut) => statut switch
    {
        "ACCEPTEE" or "CONFIRMEE" or "PRETE" => "badge-statut--accepted",
        "PAYEE" => "badge-statut--paid",
        "EN_LIVRAISON" => "badge-statut--shipped",
        "LIVREE" => "badge-statut--delivered",
        "REFUSEE" => "badge-statut--rejected",
        _ => "badge-statut--pending"
    };

    private string GetStatutLabel(string? statut) => statut switch
    {
        "ACCEPTEE" => "Acceptée",
        "REFUSEE" => "Refusée",
        "EN_ATTENTE_CONFIRMATION" => "En attente de confirmation",
        "CONFIRMEE" => "Confirmée",
        "EN_PREPARATION" => "En préparation",
        "PRETE" => "Prête",
        "PAYEE" => "Payée",
        "EN_LIVRAISON" => "En livraison",
        "LIVREE" => "Livrée",
        _ => "En attente"
    };

    private CommandeManagerDto? commandeEtapeSuivante;
    private CommandeManagerDto? commandeAAssigner;
    private int? selectedResponsableId;
    private DateTime? dateEstimeePreparation;
    private bool etapeEnCours = false;

    private void DemanderEtapeSuivante(CommandeManagerDto cmd)
    {
        commandeEtapeSuivante = cmd;
        dateEstimeePreparation = cmd.DateEstimeePreparation;
    }

    private void FermerEtapeSuivante()
    {
        commandeEtapeSuivante = null;
        dateEstimeePreparation = null;
    }

    private void DemanderAssignation(CommandeManagerDto cmd)
    {
        commandeAAssigner = cmd;
        selectedResponsableId = null;
    }

    private void FermerAssignation()
    {
        commandeAAssigner = null;
        selectedResponsableId = null;
    }

    private async Task ConfirmerAssignation()
    {
        if (commandeAAssigner == null || selectedResponsableId == null) return;

        etapeEnCours = true;
        var id = commandeAAssigner.Id;
        var responsableId = selectedResponsableId.Value;
        FermerAssignation();

        var (succes, message) = await CatalogueService.AssignerCommande(id, responsableId);
        etapeEnCours = false;

        if (succes)
        {
            Snackbar.Add($"Commande assignée avec succès.", Severity.Success);
            await ChargerCommandes();
            await CommandeBadgeService.RafraichirAsync();
        }
        else
        {
            Snackbar.Add($"Erreur lors de l'assignation: {message}", Severity.Error);
        }
    }

    private bool EstAssigneAUtilisateur(CommandeManagerDto cmd)
    {
        // Pour l'instant, on assume que le responsable connecté est celui assigné
        // Dans une implémentation complète, il faudrait récupérer l'ID utilisateur courant
        return cmd.ResponsableId.HasValue;
    }

    private string GetEtapeSuivanteTitre(CommandeManagerDto cmd) => (cmd.Statut ?? "") switch
    {
        "EN_ATTENTE_CONFIRMATION" => "Confirmer la commande",
        "CONFIRMEE" => "Démarrer la préparation",
        "EN_PREPARATION" => "Marquer comme prête",
        _ => "Étape suivante"
    };

    private async Task ConfirmerEtapeSuivante()
    {
        if (commandeEtapeSuivante == null) return;

        etapeEnCours = true;
        var id = commandeEtapeSuivante.Id;
        var statut = commandeEtapeSuivante.Statut ?? "";
        bool succes = false;

        if (statut == "EN_ATTENTE_CONFIRMATION")
        {
            succes = await CatalogueService.ConfirmerCommandeSurCommande(id, new ConfirmerCommandeRequestDto
            {
                DateEstimeePreparation = dateEstimeePreparation
            });
        }
        else if (statut == "CONFIRMEE")
        {
            succes = await CatalogueService.DemarrerPreparation(id);
        }
        else if (statut == "EN_PREPARATION")
        {
            succes = await CatalogueService.MarquerPrete(id);
        }

        etapeEnCours = false;

        if (succes)
        {
            Snackbar.Add("Étape mise à jour avec succès.", Severity.Success);
            FermerEtapeSuivante();
            await ChargerCommandes();
            await CommandeBadgeService.RafraichirAsync();
        }
        else
        {
            Snackbar.Add("Impossible de faire avancer cette commande.", Severity.Error);
        }
    }

    private string GetInitiale(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "C";
        var parts = name.Trim().Split(' ');
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name[0].ToString().ToUpper();
    }

    // ===== Assignation Livreur (Admin) =====
    private List<LivreurInfoDto> listeLivreurs = new();
    private CommandeManagerDto? commandeAssignerLivreur;
    private int selectedLivreurId;
    private bool assignationLivreurEnCours = false;

    private async Task OuvrirAssignationLivreur(CommandeManagerDto c)
    {
        commandeAssignerLivreur = c;
        listeLivreurs = await LivraisonService.ObtenirLivreurs();
        selectedLivreurId = listeLivreurs.FirstOrDefault()?.Id ?? 0;
    }

    private void FermerAssignationLivreur() => commandeAssignerLivreur = null;

    private async Task ConfirmerAssignerLivreur()
    {
        if (commandeAssignerLivreur == null || selectedLivreurId <= 0) return;
        assignationLivreurEnCours = true;
        var ok = await LivraisonService.AssignerLivreur(commandeAssignerLivreur.Id, selectedLivreurId);
        assignationLivreurEnCours = false;

        if (ok)
        {
            Snackbar.Add("Livreur assigné avec succès !", Severity.Success);
            FermerAssignationLivreur();
            await ChargerCommandes();
        }
        else
        {
            Snackbar.Add("Erreur lors de l'assignation du livreur.", Severity.Error);
        }
    }
}
