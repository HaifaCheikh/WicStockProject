@page "/commandes"
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "RESPONSABLE_STOCK_PRODUCTION,ADMIN")]
@inject CatalogueService CatalogueService
@inject CommandeBadgeService CommandeBadgeService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject LivraisonService LivraisonService

<PageTitle>Gestion des Commandes | WicStock</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="admin-page">

    <!-- ===== EN-TÊTE ===== -->
    <div class="admin-hero">
        <div class="hero-text">
            <div class="d-flex align-center gap-3">
                <h1 class="page-title">Commandes Clients</h1>
                @if (commandes != null)
                {
                    <span class="count-badge">@FilteredCommandes.Count() résultat(s)</span>
                }
            </div>
            <p class="page-subtitle">Acceptez, refusez et suivez les demandes de commande passées par les enseignes.</p>
        </div>
    </div>

    @if (!isLoading && commandes != null && commandes.Any())
    {
        <!-- ===== STATISTIQUES CLIQUABLES ===== -->
        <div class="stats-row mb-6">
            <div class="stat-card @(statutFilter == "" ? "stat-card--active" : "")" @onclick='() => statutFilter = ""'>
                <div class="stat-icon stat-icon--denim">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
                </div>
                <div>
                    <div class="stat-value">@CountTotal</div>
                    <div class="stat-label">Toutes les commandes</div>
                </div>
            </div>
            <div class="stat-card @(statutFilter == "EN_ATTENTE" ? "stat-card--active" : "")" @onclick='() => statutFilter = "EN_ATTENTE"'>
                <div class="stat-icon stat-icon--amber">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" />
                </div>
                <div>
                    <div class="stat-value">@CountEnAttente</div>
                    <div class="stat-label">En attente de validation</div>
                </div>
                @if (CountEnAttente > 0)
                {
                    <span class="pulse-indicator"></span>
                }
            </div>
            <div class="stat-card @(statutFilter == "ACCEPTEE" ? "stat-card--active" : "")" @onclick='() => statutFilter = "ACCEPTEE"'>
                <div class="stat-icon stat-icon--pine">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                </div>
                <div>
                    <div class="stat-value">@CountAcceptees</div>
                    <div class="stat-label">Commandes acceptées</div>
                </div>
            </div>
            <div class="stat-card @(statutFilter == "REFUSEE" ? "stat-card--active" : "")" @onclick='() => statutFilter = "REFUSEE"'>
                <div class="stat-icon stat-icon--rust">
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                </div>
                <div>
                    <div class="stat-value">@CountRefusees</div>
                    <div class="stat-label">Commandes refusées</div>
                </div>
            </div>
        </div>

        <!-- ===== FILTRES ===== -->
        <div class="filters-card mb-6">
            <label class="filter-label">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
                Filtrer
            </label>
            <select class="filter-select" value="@statutFilter" @onchange="OnStatutFilterChanged">
                <option value="">Toutes les commandes</option>
                <option value="EN_ATTENTE">En attente uniquement</option>
                <option value="ACCEPTEE">Acceptées uniquement</option>
                <option value="REFUSEE">Refusées uniquement</option>
            </select>

            <div class="search-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="search-icon" />
                <input class="search-input" placeholder="Rechercher un client, un produit ou une référence…" @bind="searchString" @bind:event="oninput" />
            </div>

            <div class="view-toggle">
                <button class="view-toggle-btn @(!isGridView ? "active" : "")" @onclick="() => isGridView = false" title="Vue tableau">
                    <MudIcon Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small" />
                </button>
                <button class="view-toggle-btn @(isGridView ? "active" : "")" @onclick="() => isGridView = true" title="Vue grille">
                    <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                </button>
            </div>

            <span class="filter-count">@FilteredCommandes.Count() résultat(s)</span>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex justify-center my-12">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (commandes == null || !commandes.Any())
    {
        <div class="empty-card">
            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="empty-icon" />
            <h3 class="empty-title">Aucune commande pour le moment</h3>
            <p class="empty-subtitle">Les commandes passées par vos clients apparaîtront ici.</p>
        </div>
    }
    else if (!FilteredCommandes.Any())
    {
        <div class="empty-card">
            <MudIcon Icon="@Icons.Material.Filled.FilterAltOff" Size="Size.Large" Class="empty-icon" />
            <h3 class="empty-title">Aucune commande ne correspond à ce filtre</h3>
            <p class="empty-subtitle">Essayez de modifier vos critères de recherche.</p>
        </div>
    }
    else if (!isGridView)
    {
        <!-- ===== VUE TABLEAU ===== -->
        <div class="table-panel">
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Produit</th>
                        <th>Montant</th>
                        <th>Dates</th>
                        <th>Statut</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var context in FilteredCommandes)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-center gap-2">
                                    <div class="client-avatar">@GetInitiale(context.ClientNom)</div>
                                    <div>
                                        <div class="client-name">@context.ClientNom</div>
                                        <div class="client-email">@context.ClientEmail</div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="cell-name">@context.ProduitNom</div>
                                <span class="ref-code">@context.ProduitReference</span>
                            </td>

                            <td>
                                <div class="montant-cell" title="@($"{context.QuantiteVendue} × {context.PrixUnitaire:0.00} DT")">
                                    <span class="montant-total">@context.TotalCommande.ToString("0.00") DT</span>
                                    <span class="montant-detail">@context.QuantiteVendue u. · @context.PrixUnitaire.ToString("0.00") DT/u.</span>
                                </div>
                            </td>

                            <td>
                                <div class="dates-cell">
                                    <span class="date-line">@context.DateVente.ToString("dd MMM yyyy")</span>
                                    @if (context.DateSouhaitee.HasValue)
                                    {
                                        <span class="date-souhaitee">
                                            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
                                            @context.DateSouhaitee.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                </div>
                            </td>

                            <td>
                                <span class="badge-statut @GetStatutCssClass(context.Statut ?? context.StatutCommande)">
                                    @GetStatutLabel(context.Statut ?? context.StatutCommande)
                                </span>
                                @if (context.ResponsableId.HasValue || context.LivreurId.HasValue)
                                {
                                    <div class="assignation-line">
                                        @if (context.ResponsableId.HasValue)
                                        {
                                            <span class="assignation-tag" title="Responsable assigné">
                                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />@context.ResponsableNom
                                            </span>
                                        }
                                        @if (context.LivreurId.HasValue)
                                        {
                                            <span class="assignation-tag assignation-tag--livreur" title="Livreur assigné">
                                                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" />@context.LivreurNom
                                            </span>
                                        }
                                    </div>
                                }
                            </td>

                            <td class="text-right">
                                <div class="d-flex justify-end align-center gap-1 flex-wrap">
                                    @if (userRole == "ADMIN" && (context.Statut ?? "") == "EN_ATTENTE_CONFIRMATION")
                                    {
                                        <button class="icon-btn icon-btn--valider" title="Assigner et accepter" @onclick="() => DemanderAssignation(context)">
                                            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />
                                        </button>
                                        <button class="icon-btn icon-btn--refuser" title="Refuser" @onclick="() => DemanderRefus(context)">
                                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                                        </button>
                                    }
                                    else if (context.StatutCommande == "EN_ATTENTE" && !context.EstSurCommande)
                                    {
                                        <button class="icon-btn icon-btn--valider" title="Accepter" @onclick="() => Accepter(context.Id)">
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                        </button>
                                        <button class="icon-btn icon-btn--refuser" title="Refuser" @onclick="() => DemanderRefus(context)">
                                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                                        </button>
                                    }
                                    else if (userRole == "RESPONSABLE_STOCK_PRODUCTION" && context.ResponsableId.HasValue && EstAssigneAUtilisateur(context))
                                    {
                                        if ((context.Statut ?? "") == "CONFIRMEE")
                                        {
                                            <button class="icon-btn icon-btn--valider" title="Prendre en charge" @onclick="() => DemanderEtapeSuivante(context)">
                                                <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Size="Size.Small" />
                                            </button>
                                        }
                                        else if ((context.Statut ?? "") == "EN_PREPARATION")
                                        {
                                            <button class="icon-btn icon-btn--valider" title="Marquer comme prête" @onclick="() => DemanderEtapeSuivante(context)">
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                            </button>
                                        }
                                    }

                                    @if (userRole == "ADMIN" && (context.DatePaiement.HasValue || context.Statut == "PAYEE" || context.Statut == "PRETE") && !context.LivreurId.HasValue)
                                    {
                                        <button class="icon-btn icon-btn--livreur" title="Assigner un livreur" @onclick="() => OuvrirAssignationLivreur(context)">
                                            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" />
                                        </button>
                                    }

                                    <button class="icon-btn icon-btn--danger" title="Supprimer" @onclick="() => DemanderSuppression(context)">
                                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <!-- ===== VUE GRILLE (CARTES) ===== -->
        <div class="orders-grid">
            @foreach (var cmd in FilteredCommandes)
            {
                <div class="order-card @(cmd.StatutCommande == "EN_ATTENTE" ? "order-card--pending" : "")">
                    <div class="card-header">
                        <div class="d-flex align-center gap-2">
                            <span class="ref-code">@cmd.ProduitReference</span>
                            <strong class="product-title">@cmd.ProduitNom</strong>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <span class="badge-statut @GetStatutCssClass(cmd.Statut ?? cmd.StatutCommande)">
                                @GetStatutLabel(cmd.Statut ?? cmd.StatutCommande)
                            </span>
                            <button class="delete-btn" title="Supprimer" @onclick="() => DemanderSuppression(cmd)">
                                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                            </button>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="meta-footer mb-3">
                            <div class="client-chip">
                                <span class="client-avatar">@GetInitiale(cmd.ClientNom)</span>
                                <span class="client-name">@cmd.ClientNom</span>
                            </div>
                            <span class="meta-dot">•</span>
                            <span class="meta-date">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                                @cmd.DateVente.ToString("dd MMMM yyyy à HH:mm")
                            </span>
                        </div>

                        <div class="order-math-grid">
                            <div class="math-item">
                                <span class="math-label">Quantité</span>
                                <span class="math-value">@cmd.QuantiteVendue articles</span>
                            </div>
                            <div class="math-item">
                                <span class="math-label">Prix unitaire</span>
                                <span class="math-value">@cmd.PrixUnitaire.ToString("0.00") DT</span>
                            </div>
                            <div class="math-item math-item--total">
                                <span class="math-label">Total commande</span>
                                <span class="math-value-total">@cmd.TotalCommande.ToString("0.00") DT</span>
                            </div>
                        </div>

                        @if (cmd.DateSouhaitee.HasValue)
                        {
                            <div class="date-souhaitee mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
                                Date souhaitée : @cmd.DateSouhaitee.Value.ToString("dd/MM/yyyy")
                            </div>
                        }

                        @if (cmd.ResponsableId.HasValue || cmd.LivreurId.HasValue)
                        {
                            <div class="assignation-line mt-2">
                                @if (cmd.ResponsableId.HasValue)
                                {
                                    <span class="assignation-tag">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />@cmd.ResponsableNom
                                    </span>
                                }
                                @if (cmd.LivreurId.HasValue)
                                {
                                    <span class="assignation-tag assignation-tag--livreur">
                                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" />@cmd.LivreurNom
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="card-actions">
                        @if (cmd.EstSurCommande)
                        {
                            @if (userRole == "ADMIN" && (cmd.Statut ?? "") == "EN_ATTENTE_CONFIRMATION")
                            {
                                <button class="btn btn--toggle btn--publish" @onclick="() => DemanderAssignation(cmd)">
                                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />
                                    <span>Assigner</span>
                                </button>
                                <button class="btn btn--toggle btn--hide" @onclick="() => DemanderRefus(cmd)">
                                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                                    <span>Refuser</span>
                                </button>
                            }
                            else if (userRole == "RESPONSABLE_STOCK_PRODUCTION" && cmd.ResponsableId.HasValue && EstAssigneAUtilisateur(cmd))
                            {
                                if ((cmd.Statut ?? "") == "CONFIRMEE")
                                {
                                    <button class="btn btn--toggle btn--publish" @onclick="() => DemanderEtapeSuivante(cmd)">
                                        <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Size="Size.Small" />
                                        <span>Prendre en charge</span>
                                    </button>
                                }
                                else if ((cmd.Statut ?? "") == "EN_PREPARATION")
                                {
                                    <button class="btn btn--toggle btn--publish" @onclick="() => DemanderEtapeSuivante(cmd)">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                        <span>Marquer prête</span>
                                    </button>
                                }
                            }
                            else if (userRole == "RESPONSABLE_STOCK_PRODUCTION" && !cmd.ResponsableId.HasValue)
                            {
                                <span class="status-summary-text text-muted">En attente d'assignation</span>
                            }
                            else if (userRole == "ADMIN" && cmd.ResponsableId.HasValue)
                            {
                                <span class="status-summary-text text-muted">Assignée à @cmd.ResponsableNom</span>
                            }
                        }
                        else if (cmd.StatutCommande == "EN_ATTENTE" && !cmd.EstSurCommande)
                        {
                            <button class="btn btn--toggle btn--publish" @onclick="() => Accepter(cmd.Id)">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                <span>Accepter</span>
                            </button>
                            <button class="btn btn--toggle btn--hide" @onclick="() => DemanderRefus(cmd)">
                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                                <span>Refuser</span>
                            </button>
                        }
                        else if (cmd.StatutCommande == "ACCEPTEE")
                        {
                            <span class="status-summary-text text-success">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                Commande acceptée
                            </span>
                        }

                        @if (userRole == "ADMIN" && (cmd.DatePaiement.HasValue || cmd.Statut == "PAYEE" || cmd.Statut == "PRETE") && !cmd.LivreurId.HasValue)
                        {
                            <button class="icon-btn icon-btn--livreur ml-auto" title="Assigner un livreur" @onclick="() => OuvrirAssignationLivreur(cmd)">
                                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" />
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ===== MODAL ÉTAPE SUIVANTE ===== -->
@if (commandeEtapeSuivante != null)
{
    <div class="wic-modal-overlay" @onclick="FermerEtapeSuivante">
        <div class="wic-modal-card" @onclick:stopPropagation="true">
            <div class="wic-modal-header">
                <div class="wic-modal-header-left">
                    <div class="wic-modal-icon">
                        <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Size="Size.Small" />
                    </div>
                    <div>
                        <h3 class="wic-modal-title">@GetEtapeSuivanteTitre(commandeEtapeSuivante)</h3>
                        <p class="wic-modal-subtitle">@commandeEtapeSuivante.ProduitNom — @commandeEtapeSuivante.ClientNom</p>
                    </div>
                </div>
                <button class="wic-modal-close" @onclick="FermerEtapeSuivante">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </div>

            <div class="wic-modal-body">
                @if ((commandeEtapeSuivante.Statut ?? "") == "EN_ATTENTE_CONFIRMATION")
                {
                    <p class="wic-body-text mb-3">Confirmer cette commande sur commande et, si besoin, indiquer une date de préparation estimée.</p>
                    <MudDatePicker @bind-Date="dateEstimeePreparation"
                                   Label="Date estimée de préparation (optionnelle)"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   MinDate="DateTime.Today"
                                   Clearable="true" />
                }
                else
                {
                    <p class="wic-body-text">Confirmer le passage à l'étape suivante du cycle de production ?</p>
                }
            </div>

            <div class="wic-modal-footer">
                <button class="btn btn--outline" @onclick="FermerEtapeSuivante" disabled="@etapeEnCours">Annuler</button>
                <button class="btn btn--primary" @onclick="ConfirmerEtapeSuivante" disabled="@etapeEnCours">
                    @if (etapeEnCours)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" Color="Color.Inherit" />
                        <span>Enregistrement...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                        <span>Confirmer</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ===== MODAL CONFIRMATION REFUS ===== -->
@if (commandeARefuser != null)
{
    <div class="wic-modal-overlay" @onclick="FermerRefus">
        <div class="wic-confirm-card" @onclick:stopPropagation="true">
            <div class="wic-confirm-icon">
                <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Large" />
            </div>
            <h3 class="wic-confirm-title">Refuser la commande ?</h3>
            <div class="wic-recap-box mb-3">
                <div class="wic-recap-row">
                    <span class="wic-recap-label">Client</span>
                    <span class="wic-recap-value">@commandeARefuser.ClientNom</span>
                </div>
                <div class="wic-recap-row">
                    <span class="wic-recap-label">Article</span>
                    <span class="wic-recap-value">@commandeARefuser.ProduitNom</span>
                </div>
                <div class="wic-recap-row">
                    <span class="wic-recap-label">Quantité</span>
                    <span class="wic-recap-value">@commandeARefuser.QuantiteVendue articles</span>
                </div>
                <div class="wic-recap-row">
                    <span class="wic-recap-label">Total</span>
                    <span class="wic-recap-value wic-recap-value--accent">@commandeARefuser.TotalCommande.ToString("0.00") DT</span>
                </div>
            </div>
            <p class="wic-confirm-text">Cette commande sera marquée comme refusée et conservée dans l'historique.</p>
            <div class="wic-confirm-actions">
                <button class="btn btn--outline" @onclick="FermerRefus">Conserver</button>
                <button class="btn btn--danger" @onclick="ConfirmerRefus">
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                    <span>Oui, refuser</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- ===== MODAL ASSIGNATION RESPONSABLE ===== -->
@if (commandeAAssigner != null)
{
    <div class="wic-modal-overlay" @onclick="FermerAssignation">
        <div class="wic-modal-card" @onclick:stopPropagation="true">
            <div class="wic-modal-header">
                <div class="wic-modal-header-left">
                    <div class="wic-modal-icon">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />
                    </div>
                    <div>
                        <h3 class="wic-modal-title">Assigner la commande</h3>
                        <p class="wic-modal-subtitle">@commandeAAssigner.ProduitNom — @commandeAAssigner.ClientNom</p>
                    </div>
                </div>
                <button class="wic-modal-close" @onclick="FermerAssignation">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </div>

            <div class="wic-modal-body">
                <div class="wic-recap-box mb-4">
                    <div class="wic-recap-row">
                        <span class="wic-recap-label">Client</span>
                        <span class="wic-recap-value">@commandeAAssigner.ClientNom</span>
                    </div>
                    <div class="wic-recap-row">
                        <span class="wic-recap-label">Article</span>
                        <span class="wic-recap-value">@commandeAAssigner.ProduitNom</span>
                    </div>
                    <div class="wic-recap-row">
                        <span class="wic-recap-label">Quantité</span>
                        <span class="wic-recap-value">@commandeAAssigner.QuantiteVendue articles</span>
                    </div>
                    @if (commandeAAssigner.DateSouhaitee.HasValue)
                    {
                        <div class="wic-recap-row">
                            <span class="wic-recap-label">Date souhaitée</span>
                            <span class="wic-recap-value">@commandeAAssigner.DateSouhaitee.Value.ToString("dd/MM/yyyy")</span>
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label mb-2">Responsable à assigner <span class="req-star">*</span></label>
                    <MudSelect T="int?" @bind-Value="selectedResponsableId" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @if (responsables != null)
                        {
                            @foreach (var resp in responsables)
                            {
                                <MudSelectItem Value="@(resp.Id as int?)">@resp.Prenom @resp.Nom (@resp.Email)</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </div>
            </div>

            <div class="wic-modal-footer">
                <button class="btn btn--outline" @onclick="FermerAssignation">Annuler</button>
                <button class="btn btn--primary" @onclick="ConfirmerAssignation" disabled="@(!selectedResponsableId.HasValue || etapeEnCours)">
                    @if (etapeEnCours)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" Color="Color.Inherit" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                    }
                    <span>Assigner et accepter</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- ===== MODAL CONFIRMATION SUPPRESSION ===== -->
@if (commandeASupprimer != null)
{
    <div class="wic-modal-overlay" @onclick="FermerSuppression">
        <div class="wic-confirm-card" @onclick:stopPropagation="true">
            <div class="wic-confirm-icon wic-confirm-icon--danger">
                <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Large" />
            </div>
            <h3 class="wic-confirm-title">Supprimer cette commande ?</h3>
            <div class="wic-recap-box mb-3">
                <div class="wic-recap-row">
                    <span class="wic-recap-label">Client</span>
                    <span class="wic-recap-value">@commandeASupprimer.ClientNom</span>
                </div>
                <div class="wic-recap-row">
                    <span class="wic-recap-label">Article</span>
                    <span class="wic-recap-value">@commandeASupprimer.ProduitNom</span>
                </div>
                <div class="wic-recap-row">
                    <span class="wic-recap-label">Quantité</span>
                    <span class="wic-recap-value">@commandeASupprimer.QuantiteVendue articles</span>
                </div>
                <div class="wic-recap-row">
                    <span class="wic-recap-label">Total</span>
                    <span class="wic-recap-value wic-recap-value--accent">@commandeASupprimer.TotalCommande.ToString("0.00") DT</span>
                </div>
            </div>
            <p class="wic-confirm-text">Cette action est définitive et ne peut pas être annulée.</p>
            <div class="wic-confirm-actions">
                <button class="btn btn--outline" @onclick="FermerSuppression">Annuler</button>
                <button class="btn btn--danger" @onclick="ConfirmerSuppression">
                    <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                    <span>Oui, supprimer</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- ===== MODAL ASSIGNATION LIVREUR ===== -->
@if (commandeAssignerLivreur != null)
{
    <div class="wic-modal-overlay" @onclick="FermerAssignationLivreur">
        <div class="wic-modal-card" @onclick:stopPropagation="true">
            <div class="wic-modal-header">
                <div class="wic-modal-header-left">
                    <div class="wic-modal-icon">
                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" />
                    </div>
                    <div>
                        <h3 class="wic-modal-title">Assigner un livreur</h3>
                        <p class="wic-modal-subtitle">@commandeAssignerLivreur.ProduitNom — @commandeAssignerLivreur.ClientNom</p>
                    </div>
                </div>
                <button class="wic-modal-close" @onclick="FermerAssignationLivreur">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </div>

            <div class="wic-modal-body">
                <div class="wic-recap-box mb-4">
                    <div class="wic-recap-row">
                        <span class="wic-recap-label">Client</span>
                        <span class="wic-recap-value">@commandeAssignerLivreur.ClientNom</span>
                    </div>
                    <div class="wic-recap-row">
                        <span class="wic-recap-label">Article</span>
                        <span class="wic-recap-value">@commandeAssignerLivreur.ProduitNom (@commandeAssignerLivreur.QuantiteVendue pièce(s))</span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label mb-2">Livreur à assigner <span class="req-star">*</span></label>
                    <MudSelect T="int" @bind-Value="selectedLivreurId" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @if (listeLivreurs != null && listeLivreurs.Any())
                        {
                            @foreach (var liv in listeLivreurs)
                            {
                                <MudSelectItem Value="@liv.Id">@liv.Nom (@liv.Email)</MudSelectItem>
                            }
                        }
                        else
                        {
                            <MudSelectItem Value="0" Disabled="true">Aucun livreur inscrit</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </div>

            <div class="wic-modal-footer">
                <button class="btn btn--outline" @onclick="FermerAssignationLivreur">Annuler</button>
                <button class="btn btn--primary" @onclick="ConfirmerAssignerLivreur" disabled="@(selectedLivreurId <= 0 || assignationLivreurEnCours)">
                    @if (assignationLivreurEnCours)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" Color="Color.Inherit" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" />
                    }
                    <span>Assigner la livraison</span>
                </button>
            </div>
        </div>
    </div>
}

