@page "/boutique"
@layout WicStock.Web.Layout.HomeLayout
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@inject BoutiqueService BoutiqueService
@inject CartService CartService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Boutique — WicStock</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="boutique-page">

    <!-- ===== NAVBAR BOUTIQUE ===== -->
    <header class="b-navbar">
        <div class="b-nav-inner">
            <a href="/" class="b-brand">
                <span class="b-brand-mark">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                        <path d="M3 8 L21 8 M3 12 L21 12 M3 16 L21 16" stroke="#fff" stroke-width="2" stroke-linecap="round" />
                        <path d="M7 4 L7 20 M12 4 L12 20 M17 4 L17 20" stroke="rgba(255,255,255,0.55)" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                </span>
                <span class="b-brand-name">WicStock</span>
            </a>
            <nav class="b-nav-links">
                <a href="/">Accueil</a>
                <a href="/boutique" class="active">Boutique</a>
            </nav>
            <div class="b-nav-actions">
                <a href="/panier" class="b-cart-btn" title="Mon panier">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
                        <path d="M6 2 L3 6 V20 C3 21.1 3.9 22 5 22 H19 C20.1 22 21 21.1 21 20 V6 L18 2 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M3 6 H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M16 10 C16 12.2 14.2 14 12 14 C9.8 14 8 12.2 8 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    @if (cartCount > 0)
                    {
                        <span class="b-cart-badge">@cartCount</span>
                    }
                </a>
                <AuthorizeView>
                    <Authorized>
                        <a href="/catalogue" class="b-btn b-btn--outline">Mon espace</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="b-btn b-btn--outline">Se connecter</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <!-- ===== HERO ===== -->
    <section class="b-hero">
        <div class="b-hero-content">
            <span class="b-hero-tag">Collection Textile</span>
            <h1 class="b-hero-title">Notre catalogue de tissus</h1>
            <p class="b-hero-sub">Découvrez nos références et commandez directement en ligne. Aucun compte requis pour parcourir.</p>
        </div>
    </section>

    <!-- ===== FILTRES ===== -->
    <div class="b-filters-bar">
        <div class="b-filters-inner">
            <div class="b-search-wrap">
                <svg class="b-search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none">
                    <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M21 21 L16.65 16.65" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
                <input class="b-search-input"
                       placeholder="Rechercher par nom, référence, tissu..."
                       @bind="searchString"
                       @bind:event="oninput" />
            </div>

            <select class="b-filter-select" @bind="categoryFilter">
                <option value="">Toutes les catégories</option>
                @foreach (var cat in CategoriesDisponibles)
                {
                    <option value="@cat">@cat</option>
                }
            </select>

            <select class="b-filter-select" @bind="tissFilter">
                <option value="">Tous les tissus</option>
                @foreach (var t in TissusDisponibles)
                {
                    <option value="@t">@t</option>
                }
            </select>

            <span class="b-filter-count">@FilteredProduits.Count() article(s)</span>
        </div>
    </div>

    <!-- ===== GRILLE PRODUITS ===== -->
    <main class="b-main">
        @if (produits == null)
        {
            <div class="b-grid">
                @for (int i = 0; i < 8; i++)
                {
                    <div class="b-card b-card--skeleton">
                        <div class="b-card-img-wrap b-skel"></div>
                        <div class="b-card-body">
                            <div class="b-skel b-skel--line" style="width:70%;height:14px;margin-bottom:8px;"></div>
                            <div class="b-skel b-skel--line" style="width:50%;height:12px;margin-bottom:16px;"></div>
                            <div class="b-skel b-skel--line" style="width:40%;height:18px;"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (!FilteredProduits.Any())
        {
            <div class="b-empty">
                <svg viewBox="0 0 24 24" width="48" height="48" fill="none">
                    <circle cx="11" cy="11" r="8" stroke="#94a3b8" stroke-width="1.5"/>
                    <path d="M21 21 L16.65 16.65" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M8 11 L14 11" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <p>Aucun produit trouvé pour ces filtres.</p>
                <button class="b-btn b-btn--ghost" @onclick="ResetFiltres">Réinitialiser les filtres</button>
            </div>
        }
        else
        {
            <div class="b-grid">
                @foreach (var p in FilteredProduits)
                {
                    <div class="b-card @(ajoutsEnCours.Contains(p.Id) ? "b-card--adding" : "")"
                         @onclick="() => VoirDetail(p.Id)">

                        <!-- Image -->
                        <div class="b-card-img-wrap">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.Nom" class="b-card-img" />
                            }
                            else
                            {
                                <div class="b-card-img-placeholder">
                                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none">
                                        <rect x="3" y="3" width="18" height="18" rx="3" stroke="#cbd5e1" stroke-width="1.5"/>
                                        <circle cx="8.5" cy="8.5" r="1.5" stroke="#cbd5e1" stroke-width="1.5"/>
                                        <path d="M21 15 L16 10 L11 15" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M3 20 L8 15" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round"/>
                                    </svg>
                                </div>
                            }

                            <!-- Badges -->
                            <div class="b-card-badges">
                                @if (p.EstEnPromotion)
                                {
                                    <span class="b-badge b-badge--promo">-@p.RemisePourcentage%</span>
                                }
                                @{
                                    var (statutLabel, statutClass) = GetStatutBadge(p);
                                }
                                <span class="b-badge @statutClass">@statutLabel</span>
                            </div>
                        </div>

                        <!-- Corps de la carte -->
                        <div class="b-card-body" @onclick:stopPropagation="false">
                            <p class="b-card-ref">@p.Reference</p>
                            <h3 class="b-card-name">@p.Nom</h3>
                            @if (!string.IsNullOrEmpty(p.TypeTissu))
                            {
                                <p class="b-card-tissu">@p.TypeTissu</p>
                            }

                            <!-- Prix -->
                            <div class="b-card-prix">
                                @if (p.EstEnPromotion && p.PrixPromo > 0)
                                {
                                    <span class="b-prix-promo">@p.PrixPromo.ToString("0.00") DH</span>
                                    <span class="b-prix-barre">@p.PrixUnitaire.ToString("0.00") DH</span>
                                }
                                else
                                {
                                    <span class="b-prix">@p.PrixUnitaire.ToString("0.00") DH</span>
                                }
                            </div>

                            <!-- Bouton Ajouter au panier -->
                            <button class="b-add-btn @(p.PeutCommander ? "" : "b-add-btn--disabled")"
                                    @onclick="() => AjouterAuPanier(p)"
                                    @onclick:stopPropagation="true"
                                    disabled="@(!p.PeutCommander && !ajoutsEnCours.Contains(p.Id))">
                                @if (ajoutsEnCours.Contains(p.Id))
                                {
                                    <svg class="b-spinner" viewBox="0 0 24 24" width="16" height="16">
                                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" stroke-dasharray="60" stroke-dashoffset="15" fill="none"/>
                                    </svg>
                                    <span>Ajout...</span>
                                }
                                else if (!p.PeutCommander)
                                {
                                    <span>Rupture de stock</span>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none">
                                        <path d="M6 2 L3 6 V20 C3 21.1 3.9 22 5 22 H19 C20.1 22 21 21.1 21 20 V6 L18 2 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M12 8 V16 M8 12 H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                    </svg>
                                    <span>Ajouter au panier</span>
                                }
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="b-footer">
        <p>© 2026 WicStock — Gestion d'inventaire textile</p>
    </footer>
</div>

<style>
    :root {
        --b-primary: #2b4c7e;
        --b-primary-dark: #1e3557;
        --b-accent: #4f7fcc;
        --b-bg: #f8fafc;
        --b-surface: #ffffff;
        --b-border: #e2e8f0;
        --b-text: #16233a;
        --b-muted: #64748b;
        --b-radius: 14px;
        --b-radius-sm: 8px;
        --font-head: 'Sora', 'Inter', sans-serif;
        --font-body: 'Inter', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    .boutique-page { font-family: var(--font-body); background: var(--b-bg); min-height: 100vh; color: var(--b-text); }

    /* NAVBAR */
    .b-navbar { background: var(--b-primary); position: sticky; top: 0; z-index: 100; }
    .b-nav-inner { max-width: 1280px; margin: 0 auto; padding: 0 24px; height: 60px; display: flex; align-items: center; gap: 24px; }
    .b-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .b-brand-mark { width: 34px; height: 34px; background: rgba(255,255,255,0.15); border-radius: 9px; display: flex; align-items: center; justify-content: center; }
    .b-brand-name { font-family: var(--font-head); font-weight: 700; font-size: 1.1rem; color: #fff; letter-spacing: -0.01em; }
    .b-nav-links { display: flex; gap: 20px; margin-left: 24px; flex: 1; }
    .b-nav-links a { color: rgba(255,255,255,0.7); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.15s; }
    .b-nav-links a:hover, .b-nav-links a.active { color: #fff; }
    .b-nav-actions { display: flex; align-items: center; gap: 12px; }

    .b-cart-btn { position: relative; width: 38px; height: 38px; border-radius: 9px; background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.9); display: flex; align-items: center; justify-content: center; text-decoration: none; transition: background 0.15s; }
    .b-cart-btn:hover { background: rgba(255,255,255,0.2); }
    .b-cart-badge { position: absolute; top: -4px; right: -4px; background: #ef4444; color: #fff; font-size: 0.65rem; font-weight: 700; min-width: 18px; height: 18px; border-radius: 9px; display: flex; align-items: center; justify-content: center; padding: 0 4px; border: 2px solid var(--b-primary); }

    .b-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: var(--b-radius-sm); font-family: var(--font-body); font-size: 0.875rem; font-weight: 600; cursor: pointer; text-decoration: none; transition: all 0.15s; border: none; }
    .b-btn--outline { background: rgba(255,255,255,0.1); color: #fff; border: 1.5px solid rgba(255,255,255,0.3); }
    .b-btn--outline:hover { background: rgba(255,255,255,0.2); }
    .b-btn--ghost { background: transparent; color: var(--b-primary); border: 1.5px solid var(--b-border); }
    .b-btn--ghost:hover { background: var(--b-bg); }

    /* HERO */
    .b-hero { background: linear-gradient(135deg, var(--b-primary) 0%, #1e3f6e 50%, #16233a 100%); padding: 64px 24px; text-align: center; }
    .b-hero-content { max-width: 640px; margin: 0 auto; }
    .b-hero-tag { display: inline-block; background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.85); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 6px 14px; border-radius: 20px; margin-bottom: 20px; }
    .b-hero-title { font-family: var(--font-head); font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; color: #fff; line-height: 1.15; margin-bottom: 16px; letter-spacing: -0.02em; }
    .b-hero-sub { font-size: 1rem; color: rgba(255,255,255,0.7); line-height: 1.6; }

    /* FILTRES */
    .b-filters-bar { background: var(--b-surface); border-bottom: 1px solid var(--b-border); padding: 16px 24px; position: sticky; top: 60px; z-index: 90; }
    .b-filters-inner { max-width: 1280px; margin: 0 auto; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .b-search-wrap { position: relative; flex: 1; min-width: 200px; }
    .b-search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--b-muted); }
    .b-search-input { width: 100%; padding: 10px 12px 10px 36px; border: 1.5px solid var(--b-border); border-radius: var(--b-radius-sm); font-family: var(--font-body); font-size: 0.875rem; color: var(--b-text); background: var(--b-bg); transition: border-color 0.15s; outline: none; }
    .b-search-input:focus { border-color: var(--b-accent); background: var(--b-surface); }
    .b-filter-select { padding: 10px 14px; border: 1.5px solid var(--b-border); border-radius: var(--b-radius-sm); font-family: var(--font-body); font-size: 0.875rem; color: var(--b-text); background: var(--b-bg); cursor: pointer; outline: none; transition: border-color 0.15s; }
    .b-filter-select:focus { border-color: var(--b-accent); }
    .b-filter-count { font-size: 0.8rem; color: var(--b-muted); font-weight: 500; white-space: nowrap; }

    /* GRILLE */
    .b-main { max-width: 1280px; margin: 0 auto; padding: 36px 24px 60px; }
    .b-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px; }

    /* CARTE PRODUIT */
    .b-card { background: var(--b-surface); border: 1.5px solid var(--b-border); border-radius: var(--b-radius); overflow: hidden; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
    .b-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px -8px rgba(43,76,126,0.18); border-color: var(--b-accent); }
    .b-card--adding { pointer-events: none; opacity: 0.7; }

    .b-card-img-wrap { position: relative; height: 200px; background: #f1f5f9; overflow: hidden; }
    .b-card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
    .b-card:hover .b-card-img { transform: scale(1.04); }
    .b-card-img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }

    .b-card-badges { position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 4px; }
    .b-badge { font-size: 0.7rem; font-weight: 700; padding: 3px 8px; border-radius: 20px; letter-spacing: 0.04em; }
    .b-badge--promo { background: #fef3c7; color: #92400e; }
    .b-badge--dispo { background: #d1fae5; color: #065f46; }
    .b-badge--faible { background: #fef9c3; color: #854d0e; }
    .b-badge--rupture { background: #fee2e2; color: #991b1b; }
    .b-badge--surcommande { background: #ede9fe; color: #5b21b6; }

    .b-card-body { padding: 16px; }
    .b-card-ref { font-size: 0.72rem; font-weight: 600; color: var(--b-muted); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 4px; }
    .b-card-name { font-family: var(--font-head); font-size: 1rem; font-weight: 700; color: var(--b-text); margin-bottom: 4px; line-height: 1.3; }
    .b-card-tissu { font-size: 0.8rem; color: var(--b-muted); margin-bottom: 12px; }

    .b-card-prix { margin-bottom: 14px; }
    .b-prix { font-size: 1.1rem; font-weight: 700; color: var(--b-primary); }
    .b-prix-promo { font-size: 1.1rem; font-weight: 700; color: #16a34a; }
    .b-prix-barre { font-size: 0.85rem; color: var(--b-muted); text-decoration: line-through; margin-left: 6px; }

    .b-add-btn { width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 11px 16px; background: var(--b-primary); color: #fff; border: none; border-radius: var(--b-radius-sm); font-family: var(--font-body); font-size: 0.875rem; font-weight: 600; cursor: pointer; transition: background 0.15s, transform 0.1s; }
    .b-add-btn:hover:not(:disabled) { background: var(--b-primary-dark); transform: translateY(-1px); }
    .b-add-btn:active:not(:disabled) { transform: translateY(0); }
    .b-add-btn--disabled, .b-add-btn:disabled { background: #e2e8f0; color: #94a3b8; cursor: not-allowed; transform: none; }

    /* Spinner */
    .b-spinner { animation: spin 0.8s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* Skeletons */
    .b-card--skeleton { cursor: default; pointer-events: none; }
    .b-skel { background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: 6px; }
    .b-card-img-wrap.b-skel { border-radius: 0; }
    @@keyframes shimmer { to { background-position: -200% 0; } }

    /* Empty */
    .b-empty { text-align: center; padding: 80px 20px; color: var(--b-muted); }
    .b-empty svg { margin-bottom: 16px; }
    .b-empty p { font-size: 1rem; margin-bottom: 20px; }

    /* Footer */
    .b-footer { text-align: center; padding: 24px; background: var(--b-surface); border-top: 1px solid var(--b-border); color: var(--b-muted); font-size: 0.8rem; }

    @@media (max-width: 640px) {
        .b-nav-links { display: none; }
        .b-filters-inner { flex-direction: column; align-items: stretch; }
        .b-filter-select { width: 100%; }
    }
</style>

@code {
    private List<CatalogueProduitDto>? produits;
    private string searchString = string.Empty;
    private string categoryFilter = string.Empty;
    private string tissFilter = string.Empty;
    private int cartCount = 0;
    private HashSet<int> ajoutsEnCours = new();

    private IEnumerable<CatalogueProduitDto> FilteredProduits => produits?
        .Where(p =>
            (string.IsNullOrEmpty(searchString) ||
             p.Nom.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
             p.Reference.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
             (p.TypeTissu?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false))
            && (string.IsNullOrEmpty(categoryFilter) || p.Categorie == categoryFilter)
            && (string.IsNullOrEmpty(tissFilter) || p.TypeTissu == tissFilter))
        ?? Enumerable.Empty<CatalogueProduitDto>();

    private IEnumerable<string> CategoriesDisponibles => produits?
        .Where(p => !string.IsNullOrEmpty(p.Categorie))
        .Select(p => p.Categorie!)
        .Distinct()
        .OrderBy(c => c)
        ?? Enumerable.Empty<string>();

    private IEnumerable<string> TissusDisponibles => produits?
        .Where(p => !string.IsNullOrEmpty(p.TypeTissu))
        .Select(p => p.TypeTissu!)
        .Distinct()
        .OrderBy(t => t)
        ?? Enumerable.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        // Charger le catalogue (appel public, sans token)
        produits = await BoutiqueService.ObtenirCataloguePublic();

        // Badge panier
        cartCount = await CartService.GetCountAsync();
        CartService.OnCartChanged += MettreAJourBadge;
    }

    private void MettreAJourBadge()
    {
        cartCount = CartService.Count;
        InvokeAsync(StateHasChanged);
    }

    private async Task AjouterAuPanier(CatalogueProduitDto produit)
    {
        if (!produit.PeutCommander) return;
        ajoutsEnCours.Add(produit.Id);
        StateHasChanged();

        await CartService.AddToCartAsync(produit, 1);

        Snackbar.Add($"« {produit.Nom} » ajouté au panier ✓", Severity.Success,
            config => { config.VisibleStateDuration = 2000; config.HideTransitionDuration = 200; });

        await Task.Delay(400);
        ajoutsEnCours.Remove(produit.Id);
        StateHasChanged();
    }

    private void VoirDetail(int id)
    {
        Navigation.NavigateTo($"/boutique/{id}");
    }

    private void ResetFiltres()
    {
        searchString = string.Empty;
        categoryFilter = string.Empty;
        tissFilter = string.Empty;
    }

    private (string Label, string CssClass) GetStatutBadge(CatalogueProduitDto p)
    {
        if (p.EstEnRupture) return ("Rupture", "b-badge--rupture");
        if (p.EstSurCommande) return ("Sur commande", "b-badge--surcommande");
        if (p.EstStockFaibleEffectif) return ("Stock faible", "b-badge--faible");
        return ("Disponible", "b-badge--dispo");
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= MettreAJourBadge;
    }
}
