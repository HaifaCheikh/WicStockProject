@page "/boutique"
@layout WicStock.Web.Layout.HomeLayout
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@inject BoutiqueService BoutiqueService
@inject CartService CartService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Boutique — WicStock</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="boutique-page">

    <!-- ===== NAVBAR BOUTIQUE (même style que la Home : blanche, sticky) ===== -->
    <header class="b-navbar">
        <div class="b-nav-inner">
            <a href="/" class="b-brand">
                <span class="b-brand-mark">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                        <path d="M3 8 L21 8 M3 12 L21 12 M3 16 L21 16" stroke="#fff" stroke-width="2" stroke-linecap="round" />
                        <path d="M7 4 L7 20 M12 4 L12 20 M17 4 L17 20" stroke="rgba(255,255,255,0.55)" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                </span>
                <span class="b-brand-name">WicStock</span>
            </a>
            <nav class="b-nav-links">
                <a href="/">Accueil</a>
                <a href="/boutique" class="active">Boutique</a>
            </nav>
            <div class="b-nav-actions">
                <a href="/panier" class="b-cart-btn" title="Mon panier">
                    <svg viewBox="0 0 24 24" width="19" height="19" fill="none">
                        <path d="M6 2 L3 6 V20 C3 21.1 3.9 22 5 22 H19 C20.1 22 21 21.1 21 20 V6 L18 2 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M3 6 H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M16 10 C16 12.2 14.2 14 12 14 C9.8 14 8 12.2 8 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    @if (cartCount > 0)
                    {
                        <span class="b-cart-badge">@cartCount</span>
                    }
                </a>
                <AuthorizeView>
                    <Authorized>
                        <a href="/catalogue" class="b-btn b-btn--outline">Mon espace</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="b-btn b-btn--outline">Se connecter</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <!-- ===== HERO (dégradé clair, comme la Home) ===== -->
    <section class="b-hero">
        <div class="b-hero-content">
            <span class="b-hero-tag">Collection Textile</span>
            <h1 class="b-hero-title">Explorez notre Collection Textile</h1>
            <p class="b-hero-sub">Découvrez nos références et commandez directement en ligne.</p>
        </div>
    </section>

    <!-- ===== FILTRES ===== -->
    <div class="b-filters-bar">
        <div class="b-filters-inner">
            <div class="b-search-wrap">
                <svg class="b-search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none">
                    <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M21 21 L16.65 16.65" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
                <input class="b-search-input"
                       placeholder="Rechercher par nom, référence, tissu..."
                       @bind="searchString"
                       @bind:event="oninput" />
            </div>

            <select class="b-filter-select" @bind="categoryFilter">
                <option value="">Toutes les catégories</option>
                @foreach (var cat in CategoriesDisponibles)
                {
                    <option value="@cat">@cat</option>
                }
            </select>

            <select class="b-filter-select" @bind="genreFilter">
                <option value="">Tous les genres</option>
                @foreach (var g in WicStock.Web.Models.AttributsProduit.Genres)
                {
                    <option value="@g">@g</option>
                }
            </select>

            <select class="b-filter-select" @bind="tailleFilter">
                <option value="">Toutes les tailles</option>
                @foreach (var t in WicStock.Web.Models.AttributsProduit.ToutesLesTailles)
                {
                    <option value="@t">Taille @t</option>
                }
            </select>

            <select class="b-filter-select" @bind="couleurFilter">
                <option value="">Toutes les couleurs</option>
                @foreach (var c in WicStock.Web.Models.AttributsProduit.Couleurs)
                {
                    <option value="@c">@c</option>
                }
            </select>

            <select class="b-filter-select" @bind="priceSortFilter">
                <option value="">Trier par prix</option>
                <option value="asc">Prix : croissant</option>
                <option value="desc">Prix : décroissant</option>
            </select>

            <span class="b-filter-count">@FilteredProduits.Count() article(s)</span>
        </div>
    </div>

    <!-- ===== GRILLE PRODUITS ===== -->
    <main class="b-main">
        @if (produits == null)
        {
            <div class="b-grid">
                @for (int i = 0; i < 8; i++)
                {
                    <div class="b-card b-card--skeleton">
                        <div class="b-card-img-wrap b-skel"></div>
                        <div class="b-card-body">
                            <div class="b-skel b-skel--line" style="width:70%;height:14px;margin-bottom:8px;"></div>
                            <div class="b-skel b-skel--line" style="width:50%;height:12px;margin-bottom:16px;"></div>
                            <div class="b-skel b-skel--line" style="width:40%;height:18px;"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (!FilteredProduits.Any())
        {
            <div class="b-empty">
                <svg viewBox="0 0 24 24" width="48" height="48" fill="none">
                    <circle cx="11" cy="11" r="8" stroke="#94a3b8" stroke-width="1.5"/>
                    <path d="M21 21 L16.65 16.65" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M8 11 L14 11" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <p>Aucun produit trouvé pour ces filtres.</p>
                <button class="b-btn b-btn--ghost" @onclick="ResetFiltres">Réinitialiser les filtres</button>
            </div>
        }
        else
        {
            <div class="b-grid">
                @foreach (var p in FilteredProduits)
                {
                    <div class="b-card @(ajoutsEnCours.Contains(p.Id) ? "b-card--adding" : "")"
                         @onclick="() => VoirDetail(p.Id)">

                        <!-- Image -->
                        <div class="b-card-img-wrap">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.Nom" class="b-card-img" />
                            }
                            else
                            {
                                <div class="b-card-img-placeholder">
                                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none">
                                        <rect x="3" y="3" width="18" height="18" rx="3" stroke="#cbd5e1" stroke-width="1.5"/>
                                        <circle cx="8.5" cy="8.5" r="1.5" stroke="#cbd5e1" stroke-width="1.5"/>
                                        <path d="M21 15 L16 10 L11 15" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M3 20 L8 15" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round"/>
                                    </svg>
                                </div>
                            }

                            <!-- Badges -->
                            <div class="b-card-badges">
                                @if (p.EstEnPromotion)
                                {
                                    <span class="b-badge b-badge--promo">-@p.RemisePourcentage%</span>
                                }
                                @{
                                    var (statutLabel, statutClass) = GetStatutBadge(p);
                                }
                                <span class="b-badge @statutClass">@statutLabel</span>
                            </div>
                        </div>

                        <!-- Corps de la carte -->
                        <div class="b-card-body" @onclick:stopPropagation="false">
                            <div class="b-card-header-row">
                                <p class="b-card-ref">@p.Reference</p>
                                <span class="b-rating-pill" title="Note moyenne des clients">
                                    <span class="b-star">★</span>
                                    @if (p.NombreAvis > 0)
                                    {
                                        <span class="b-rating-val">@p.NoteMoyenne.ToString("0.0")</span>
                                        <span class="b-rating-cnt">(@p.NombreAvis)</span>
                                    }
                                    else
                                    {
                                        <span class="b-rating-none">--</span>
                                    }
                                </span>
                            </div>
                            <h3 class="b-card-name">@p.Nom</h3>
                            @if (!string.IsNullOrEmpty(p.TypeTissu))
                            {
                                <p class="b-card-tissu">@p.TypeTissu</p>
                            }

                            <!-- Badges Genre / Taille / Couleur -->
                            <div class="b-card-attrs" style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 4px; margin-bottom: 8px;">
                                @if (!string.IsNullOrEmpty(p.Genre))
                                {
                                    <span style="font-size: 0.72rem; padding: 2px 8px; border-radius: 999px; background: #F1F5F9; color: #475569; font-weight: 600;">@p.Genre</span>
                                }
                                @if (!string.IsNullOrEmpty(p.Taille))
                                {
                                    <span style="font-size: 0.72rem; padding: 2px 8px; border-radius: 999px; background: #F1F5F9; color: #475569; font-weight: 600;">Taille @p.Taille</span>
                                }
                                @if (!string.IsNullOrEmpty(p.Couleur))
                                {
                                    <span style="font-size: 0.72rem; padding: 2px 8px; border-radius: 999px; background: #F1F5F9; color: #475569; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                        <span style="width: 8px; height: 8px; border-radius: 50%; background-color: @(p.CodeHexCouleur ?? WicStock.Web.Models.AttributsProduit.GetHex(p.Couleur)); border: 1px solid rgba(0,0,0,0.15); display: inline-block;"></span>
                                        @p.Couleur
                                    </span>
                                }
                            </div>

                            <!-- Prix -->
                            <div class="b-card-prix">
                                @if (p.EstEnPromotion && p.PrixPromo > 0)
                                {
                                    <span class="b-prix-promo">@p.PrixPromo.ToString("0.00") DT</span>
                                    <span class="b-prix-barre">@p.PrixUnitaire.ToString("0.00") DT</span>
                                }
                                else
                                {
                                    <span class="b-prix">@p.PrixUnitaire.ToString("0.00") DT</span>
                                }
                            </div>

                            <!-- Info Stock Urgence (uniquement si stock faible) -->
                            @if (p.EstStockFaibleEffectif && p.QuantiteDisponible > 0)
                            {
                                <p class="b-stock-faible-msg">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                                        <path d="M12 9 V13 M12 17 H12.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                        <path d="M10.29 3.86 L1.82 18 a2 2 0 0 0 1.71 3h16.94 a2 2 0 0 0 1.71-3L13.71 3.86 a2 2 0 0 0-3.42 0z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <span>Il ne reste que <strong>@p.QuantiteDisponible pièce(s)</strong></span>
                                </p>
                            }

                            <!-- Bouton Commander -->
                            <button class="b-add-btn @(p.PeutCommander ? "" : "b-add-btn--disabled")"
                                    @onclick="() => VoirDetail(p.Id)"
                                    @onclick:stopPropagation="true"
                                    disabled="@(!p.PeutCommander)">
                                @if (p.EstEnRupture)
                                {
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none">
                                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
                                        <path d="M5.636 5.636 L18.364 18.364" stroke="currentColor" stroke-width="1.8"/>
                                    </svg>
                                    <span>En rupture</span>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none">
                                        <path d="M6 2 L3 6 V20 C3 21.1 3.9 22 5 22 H19 C20.1 22 21 21.1 21 20 V6 L18 2 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M12 8 V16 M8 12 H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                    </svg>
                                    <span>Commander</span>
                                }
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="b-footer">
        <p>© 2026 WicStock — Gestion d'inventaire textile</p>
    </footer>
</div>

<style>
    /* ---------------------------------------------------------------------
       PALETTE ALIGNÉE SUR LA HOME
       Mêmes noms de variables que Pages/Index.razor (--ink, --denim, etc.)
       pour que Boutique ne soit plus visuellement une app à part.
       --------------------------------------------------------------------- */
    :root {
        --b-ink: #16233A;
        --b-ink-muted: #64748B;
        --b-paper: #FFFFFF;
        --b-sand: #F3F6FA;
        --b-border: #E1E7EF;
        --b-denim: #2B4C7E;
        --b-denim-dark: #14263F;
        --b-denim-tint: #E7EDF6;
        --b-denim-soft: #EAF0F8;
        --b-rust: #B5563A;
        --b-rust-soft: #F9ECE8;
        --b-pine: #1E6B4C;
        --b-pine-soft: #E4F3EC;
        --b-amber-soft: #FEF3C7;
        --b-radius: 16px;
        --b-radius-sm: 8px;
        --font-head: 'Sora', 'Inter', sans-serif;
        --font-body: 'Inter', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    .boutique-page { font-family: var(--font-body); background: var(--b-sand); min-height: 100vh; color: var(--b-ink); display: flex; flex-direction: column; }

    /* NAVBAR — blanche et sticky, comme la Home (plus de bleu marine plein) */
    .b-navbar { background: var(--b-paper); border-bottom: 1px solid var(--b-border); position: sticky; top: 0; z-index: 100; }
    .b-nav-inner { max-width: 1160px; margin: 0 auto; padding: 0 24px; height: 64px; display: flex; align-items: center; gap: 24px; }
    .b-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .b-brand-mark { width: 32px; height: 32px; background: var(--b-denim); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
    .b-brand-name { font-family: var(--font-head); font-weight: 700; font-size: 1.125rem; color: var(--b-ink); letter-spacing: -0.01em; }
    .b-nav-links { display: flex; gap: 28px; margin-left: 24px; flex: 1; }
    .b-nav-links a { color: var(--b-ink-muted); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 0.15s; }
    .b-nav-links a:hover, .b-nav-links a.active { color: var(--b-denim); }
    .b-nav-actions { display: flex; align-items: center; gap: 12px; }

    .b-cart-btn { position: relative; width: 38px; height: 38px; border-radius: var(--b-radius-sm); background: var(--b-sand); color: var(--b-ink-muted); display: flex; align-items: center; justify-content: center; text-decoration: none; transition: background 0.15s, color 0.15s; }
    .b-cart-btn:hover { background: var(--b-denim-soft); color: var(--b-denim); }
    .b-cart-badge { position: absolute; top: -4px; right: -4px; background: var(--b-rust); color: #fff; font-size: 0.65rem; font-weight: 700; min-width: 18px; height: 18px; border-radius: 9px; display: flex; align-items: center; justify-content: center; padding: 0 4px; border: 2px solid var(--b-paper); }

    .b-btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; border-radius: var(--b-radius-sm); font-family: var(--font-body); font-size: 0.875rem; font-weight: 600; cursor: pointer; text-decoration: none; transition: all 0.15s; border: none; }
    .b-btn--outline { background: transparent; color: var(--b-ink); border: 1.5px solid var(--b-border); }
    .b-btn--outline:hover { border-color: var(--b-denim); color: var(--b-denim); background: var(--b-denim-soft); }
    .b-btn--ghost { background: transparent; color: var(--b-ink-muted); border: 1.5px solid var(--b-border); }
    .b-btn--ghost:hover { background: var(--b-sand); color: var(--b-ink); }

    /* HERO — dégradé clair, cohérent avec la Home (fini le bleu marine sombre) */
    .b-hero { background: linear-gradient(180deg, var(--b-denim-tint) 0%, var(--b-paper) 100%); padding: 56px 24px; text-align: center; }
    .b-hero-content { max-width: 640px; margin: 0 auto; }
    .b-hero-tag { display: inline-block; background: var(--b-denim-tint); color: var(--b-denim); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; margin-bottom: 18px; border: 1px solid rgba(43,76,126,0.15); }
    .b-hero-title { font-family: var(--font-head); font-size: clamp(1.7rem, 3.4vw, 2.4rem); font-weight: 800; color: var(--b-ink); line-height: 1.18; margin-bottom: 14px; letter-spacing: -0.02em; }
    .b-hero-sub { font-size: 1rem; color: var(--b-ink-muted); line-height: 1.6; }

    /* FILTRES */
    .b-filters-bar { background: var(--b-paper); border-bottom: 1px solid var(--b-border); padding: 16px 24px; position: sticky; top: 64px; z-index: 90; }
    .b-filters-inner { max-width: 1160px; margin: 0 auto; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .b-search-wrap { position: relative; flex: 1; min-width: 200px; }
    .b-search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--b-ink-muted); }
    .b-search-input { width: 100%; padding: 10px 12px 10px 36px; border: 1.5px solid var(--b-border); border-radius: var(--b-radius-sm); font-family: var(--font-body); font-size: 0.875rem; color: var(--b-ink); background: var(--b-sand); transition: border-color 0.15s; outline: none; }
    .b-search-input:focus { border-color: var(--b-denim); background: var(--b-paper); }
    .b-filter-select { padding: 10px 14px; border: 1.5px solid var(--b-border); border-radius: var(--b-radius-sm); font-family: var(--font-body); font-size: 0.875rem; color: var(--b-ink); background: var(--b-sand); cursor: pointer; outline: none; transition: border-color 0.15s; }
    .b-filter-select:focus { border-color: var(--b-denim); }
    .b-filter-count { font-size: 0.8rem; color: var(--b-ink-muted); font-weight: 500; white-space: nowrap; }

    /* GRILLE */
    .b-main { max-width: 1160px; margin: 0 auto; padding: 36px 24px 60px; flex: 1; width: 100%; }
    .b-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }

    /* CARTE PRODUIT */
    .b-card { background: var(--b-paper); border: 1px solid var(--b-border); border-radius: var(--b-radius); overflow: hidden; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; display: flex; flex-direction: column; height: 100%; }
    .b-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px -12px rgba(22,35,58,0.22); border-color: #D5DEEA; }
    .b-card--adding { pointer-events: none; opacity: 0.7; }

    .b-card-img-wrap { position: relative; height: 190px; background: var(--b-sand); overflow: hidden; flex-shrink: 0; }
    .b-card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
    .b-card:hover .b-card-img { transform: scale(1.04); }
    .b-card-img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }

    .b-card-badges { position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 4px; }
    /* Badges — mêmes teintes que l'admin /produits */
    .b-badge { font-size: 0.72rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; letter-spacing: 0.02em; box-shadow: 0 2px 6px rgba(0,0,0,0.08); }
    .b-badge--promo { background: var(--b-amber-soft); color: #92400E; border: 1px solid #F59E0B; }
    .b-badge--dispo { background: var(--b-pine-soft); color: var(--b-pine); border: 1px solid #86EFAC; }
    .b-badge--faible { background: var(--b-amber-soft); color: #92400E; border: 1px solid #F59E0B; }
    .b-badge--rupture { background: #FEE2E2; color: #991B1B; border: 1px solid #FCA5A5; }
    .b-badge--surcommande { background: var(--b-denim-soft); color: var(--b-denim); border: 1px solid #93A8C4; }

    .b-card-body { padding: 16px; display: flex; flex-direction: column; flex: 1; }
    .b-card-header-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
    .b-card-ref { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; color: var(--b-ink-muted); letter-spacing: 0.02em; text-transform: uppercase; }
    
    /* Rating pill */
    .b-rating-pill { display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; background: #FEF3C7; border: 1px solid #F59E0B; border-radius: 999px; font-size: 0.72rem; font-weight: 600; color: #92400E; }
    .b-star { color: #D97706; font-size: 0.75rem; }
    .b-rating-cnt { color: #B45309; font-size: 0.68rem; font-weight: 500; }
    .b-rating-none { color: #94A3B8; font-size: 0.7rem; font-weight: 500; }

    .b-card-name { font-family: var(--font-head); font-size: 1rem; font-weight: 700; color: var(--b-ink); margin-bottom: 4px; line-height: 1.3; min-height: 2.6em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .b-card-tissu { font-size: 0.8rem; color: var(--b-ink-muted); margin-bottom: 10px; }

    .b-card-prix { margin-bottom: 10px; }
    .b-prix { font-size: 1.1rem; font-weight: 700; color: var(--b-denim); font-family: var(--font-head); }
    .b-prix-promo { font-size: 1.1rem; font-weight: 700; color: var(--b-pine); font-family: var(--font-head); }
    .b-prix-barre { font-size: 0.85rem; color: var(--b-ink-muted); text-decoration: line-through; margin-left: 6px; }

    .b-stock-faible-msg { display: flex; align-items: center; gap: 5px; font-size: 0.78rem; color: var(--b-rust); margin-bottom: 12px; font-weight: 500; }
