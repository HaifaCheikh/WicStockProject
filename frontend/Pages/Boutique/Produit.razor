@page "/boutique/{Id:int}"
@layout WicStock.Web.Layout.HomeLayout
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@inject BoutiqueService BoutiqueService
@inject CartService CartService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(produit?.Nom ?? "Fiche produit") — WicStock Boutique</PageTitle>

<HeadContent>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="boutique-page">

    <!-- NAVBAR -->
    <header class="b-navbar">
        <div class="b-nav-inner">
            <a href="/" class="b-brand">
                <span class="b-brand-mark">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                        <path d="M3 8 L21 8 M3 12 L21 12 M3 16 L21 16" stroke="#fff" stroke-width="2" stroke-linecap="round" />
                        <path d="M7 4 L7 20 M12 4 L12 20 M17 4 L17 20" stroke="rgba(255,255,255,0.55)" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                </span>
                <span class="b-brand-name">WicStock</span>
            </a>
            <nav class="b-nav-links">
                <a href="/">Accueil</a>
                <a href="/boutique" class="active">Boutique</a>
            </nav>
            <div class="b-nav-actions">
                <a href="/panier" class="b-cart-btn" title="Mon panier">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
                        <path d="M6 2 L3 6 V20 C3 21.1 3.9 22 5 22 H19 C20.1 22 21 21.1 21 20 V6 L18 2 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M3 6 H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M16 10 C16 12.2 14.2 14 12 14 C9.8 14 8 12.2 8 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    @if (cartCount > 0)
                    {
                        <span class="b-cart-badge">@cartCount</span>
                    }
                </a>
            </div>
        </div>
    </header>

    <!-- BREADCRUMB -->
    <nav class="bp-breadcrumb">
        <div class="bp-breadcrumb-inner">
            <a href="/boutique">← Retour au catalogue</a>
        </div>
    </nav>

    @if (chargement)
    {
        <div class="bp-loading">
            <div class="bp-spinner-ring"></div>
            <p>Chargement du produit...</p>
        </div>
    }
    else if (produit == null)
    {
        <div class="bp-not-found">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="none">
                <circle cx="12" cy="12" r="10" stroke="#94a3b8" stroke-width="1.5"/>
                <path d="M12 8 V12 M12 16 H12.01" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <h2>Produit introuvable</h2>
            <p>Ce produit n'existe pas ou a été retiré du catalogue.</p>
            <a href="/boutique" class="b-btn b-btn-primary">Retour au catalogue</a>
        </div>
    }
    else
    {
        <main class="bp-main">
            <div class="bp-grid">

                <!-- Image -->
                <div class="bp-img-col">
                    <div class="bp-img-wrap">
                        @if (!string.IsNullOrEmpty(produit.ImageUrl))
                        {
                            <img src="@produit.ImageUrl" alt="@produit.Nom" class="bp-img" />
                        }
                        else
                        {
                            <div class="bp-img-placeholder">
                                <svg viewBox="0 0 24 24" width="48" height="48" fill="none">
                                    <rect x="3" y="3" width="18" height="18" rx="3" stroke="#cbd5e1" stroke-width="1.5"/>
                                    <circle cx="8.5" cy="8.5" r="1.5" stroke="#cbd5e1" stroke-width="1.5"/>
                                    <path d="M21 15 L16 10 L11 15" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M3 20 L8 15" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round"/>
                                </svg>
                                <p>Aucune image disponible</p>
                            </div>
                        }

                        <!-- Badges -->
                        <div class="bp-badges">
                            @if (produit.EstEnPromotion)
                            {
                                <span class="b-badge b-badge--promo">Promo -@produit.RemisePourcentage%</span>
                            }
                            @{
                                var (statutLabel, statutClass) = GetStatutBadge(produit);
                            }
                            <span class="b-badge @statutClass">@statutLabel</span>
                        </div>
                    </div>
                </div>

                <!-- Informations -->
                <div class="bp-info-col">
                    <p class="bp-ref">@produit.Reference</p>
                    <h1 class="bp-name">@produit.Nom</h1>

                    @if (!string.IsNullOrEmpty(produit.TypeTissu))
                    {
                        <p class="bp-tissu">
                            <span class="bp-label">Tissu :</span> @produit.TypeTissu
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(produit.Categorie))
                    {
                        <p class="bp-categorie">
                            <span class="bp-label">Catégorie :</span> @produit.Categorie
                        </p>
                    }

                    <!-- Prix -->
                    <div class="bp-prix-block">
                        @if (produit.EstEnPromotion && produit.PrixPromo > 0)
                        {
                            <span class="bp-prix-promo">@produit.PrixPromo.ToString("0.00") DH</span>
                            <span class="bp-prix-barre">@produit.PrixUnitaire.ToString("0.00") DH</span>
                            @if (produit.DateFinPromotion.HasValue)
                            {
                                <span class="bp-promo-expiry">Offre jusqu'au @produit.DateFinPromotion.Value.ToString("dd/MM/yyyy")</span>
                            }
                        }
                        else
                        {
                            <span class="bp-prix">@produit.PrixUnitaire.ToString("0.00") DH</span>
                        }
                    </div>

                    <!-- Stock info -->
                    <div class="bp-stock-info @GetStockClass(produit)">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/>
                            <path d="M12 8 V12 L14 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                        @GetStockMessage(produit)
                    </div>

                    <!-- Sélecteur de quantité -->
                    @if (produit.PeutCommander)
                    {
                        <div class="bp-qty-block">
                            <label class="bp-label">Quantité</label>
                            <div class="bp-qty-controls">
                                <button class="bp-qty-btn" @onclick="DecrementerQty" disabled="@(quantite <= 1)">−</button>
                                <span class="bp-qty-val">@quantite</span>
                                <button class="bp-qty-btn" @onclick="IncrementerQty"
                                        disabled="@(!produit.DisponibleSurCommande && quantite >= produit.QuantiteDisponible)">+</button>
                            </div>
                            @if (!produit.DisponibleSurCommande && produit.QuantiteDisponible > 0)
                            {
                                <span class="bp-qty-max">Max : @produit.QuantiteDisponible</span>
                            }
                        </div>

                        <button class="bp-add-btn @(ajoutEnCours ? "bp-add-btn--loading" : "")"
                                @onclick="AjouterAuPanier"
                                disabled="@ajoutEnCours">
                            @if (ajoutEnCours)
                            {
                                <svg class="b-spinner" viewBox="0 0 24 24" width="18" height="18">
                                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" stroke-dasharray="60" stroke-dashoffset="15" fill="none"/>
                                </svg>
                                <span>Ajout en cours...</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                                    <path d="M6 2 L3 6 V20 C3 21.1 3.9 22 5 22 H19 C20.1 22 21 21.1 21 20 V6 L18 2 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M12 8 V16 M8 12 H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                </svg>
                                <span>Ajouter au panier</span>
                            }
                        </button>

                        <a href="/panier" class="bp-voir-panier">
                            Voir mon panier @(cartCount > 0 ? $"({cartCount} article{(cartCount > 1 ? "s" : "")})" : "")
                        </a>
                    }
                    else
                    {
                        <div class="bp-rupture-msg">
                            <p>Ce produit est actuellement en rupture de stock.</p>
                            <a href="/boutique" class="b-btn b-btn--ghost">Voir d'autres produits</a>
                        </div>
                    }
                </div>
            </div>
        </main>
    }

    <footer class="b-footer">
        <p>© 2026 WicStock — Gestion d'inventaire textile</p>
    </footer>
</div>

<style>
    :root {
        --b-primary: #2b4c7e; --b-primary-dark: #1e3557; --b-accent: #4f7fcc;
        --b-bg: #f8fafc; --b-surface: #ffffff; --b-border: #e2e8f0;
        --b-text: #16233a; --b-muted: #64748b; --b-radius: 14px; --b-radius-sm: 8px;
        --font-head: 'Sora', 'Inter', sans-serif; --font-body: 'Inter', sans-serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    .boutique-page { font-family: var(--font-body); background: var(--b-bg); min-height: 100vh; color: var(--b-text); }

    /* NAVBAR (même que Index.razor) */
    .b-navbar { background: var(--b-primary); position: sticky; top: 0; z-index: 100; }
    .b-nav-inner { max-width: 1280px; margin: 0 auto; padding: 0 24px; height: 60px; display: flex; align-items: center; gap: 24px; }
    .b-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .b-brand-mark { width: 34px; height: 34px; background: rgba(255,255,255,0.15); border-radius: 9px; display: flex; align-items: center; justify-content: center; }
    .b-brand-name { font-family: var(--font-head); font-weight: 700; font-size: 1.1rem; color: #fff; }
    .b-nav-links { display: flex; gap: 20px; margin-left: 24px; flex: 1; }
    .b-nav-links a { color: rgba(255,255,255,0.7); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.15s; }
    .b-nav-links a:hover, .b-nav-links a.active { color: #fff; }
    .b-nav-actions { display: flex; align-items: center; gap: 12px; }
    .b-cart-btn { position: relative; width: 38px; height: 38px; border-radius: 9px; background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.9); display: flex; align-items: center; justify-content: center; text-decoration: none; transition: background 0.15s; }
    .b-cart-btn:hover { background: rgba(255,255,255,0.2); }
    .b-cart-badge { position: absolute; top: -4px; right: -4px; background: #ef4444; color: #fff; font-size: 0.65rem; font-weight: 700; min-width: 18px; height: 18px; border-radius: 9px; display: flex; align-items: center; justify-content: center; padding: 0 4px; border: 2px solid var(--b-primary); }

    .b-btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border-radius: var(--b-radius-sm); font-family: var(--font-body); font-size: 0.875rem; font-weight: 600; cursor: pointer; text-decoration: none; transition: all 0.15s; border: none; }
    .b-btn-primary { background: var(--b-primary); color: #fff; }
    .b-btn-primary:hover { background: var(--b-primary-dark); }
    .b-btn--ghost { background: transparent; color: var(--b-primary); border: 1.5px solid var(--b-border); }
    .b-btn--ghost:hover { background: var(--b-bg); }
    .b-btn--outline { background: rgba(255,255,255,0.1); color: #fff; border: 1.5px solid rgba(255,255,255,0.3); }

    /* BREADCRUMB */
    .bp-breadcrumb { background: var(--b-surface); border-bottom: 1px solid var(--b-border); padding: 12px 24px; }
    .bp-breadcrumb-inner { max-width: 1280px; margin: 0 auto; }
    .bp-breadcrumb a { color: var(--b-muted); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 0.15s; }
    .bp-breadcrumb a:hover { color: var(--b-primary); }

    /* LOADING / NOT FOUND */
    .bp-loading, .bp-not-found { text-align: center; padding: 80px 20px; color: var(--b-muted); }
    .bp-spinner-ring { width: 40px; height: 40px; border: 3px solid var(--b-border); border-top-color: var(--b-primary); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 16px; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .bp-not-found h2 { font-family: var(--font-head); font-size: 1.4rem; margin: 16px 0 8px; color: var(--b-text); }
    .bp-not-found p { margin-bottom: 24px; }

    /* MAIN */
    .bp-main { max-width: 1280px; margin: 0 auto; padding: 48px 24px 80px; }
    .bp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
    @@media (max-width: 768px) { .bp-grid { grid-template-columns: 1fr; gap: 32px; } }

    /* IMAGE */
    .bp-img-wrap { position: relative; border-radius: var(--b-radius); overflow: hidden; background: #f1f5f9; }
    .bp-img { width: 100%; max-height: 480px; object-fit: cover; display: block; }
    .bp-img-placeholder { height: 360px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; color: var(--b-muted); font-size: 0.875rem; }
    .bp-badges { position: absolute; top: 14px; left: 14px; display: flex; flex-direction: column; gap: 6px; }

    .b-badge { font-size: 0.72rem; font-weight: 700; padding: 4px 10px; border-radius: 20px; letter-spacing: 0.04em; }
    .b-badge--promo { background: #fef3c7; color: #92400e; }
    .b-badge--dispo { background: #d1fae5; color: #065f46; }
    .b-badge--faible { background: #fef9c3; color: #854d0e; }
    .b-badge--rupture { background: #fee2e2; color: #991b1b; }
    .b-badge--surcommande { background: #ede9fe; color: #5b21b6; }

    /* INFOS */
    .bp-ref { font-size: 0.75rem; font-weight: 600; color: var(--b-muted); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; }
    .bp-name { font-family: var(--font-head); font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 800; color: var(--b-text); margin-bottom: 16px; line-height: 1.2; letter-spacing: -0.02em; }
    .bp-tissu, .bp-categorie { font-size: 0.9rem; color: var(--b-muted); margin-bottom: 6px; }
    .bp-label { font-weight: 600; color: var(--b-text); }

    .bp-prix-block { margin: 20px 0; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .bp-prix { font-size: 1.8rem; font-weight: 800; color: var(--b-primary); font-family: var(--font-head); }
    .bp-prix-promo { font-size: 1.8rem; font-weight: 800; color: #16a34a; font-family: var(--font-head); }
    .bp-prix-barre { font-size: 1rem; color: var(--b-muted); text-decoration: line-through; }
    .bp-promo-expiry { font-size: 0.78rem; color: #92400e; background: #fef3c7; padding: 3px 8px; border-radius: 20px; font-weight: 600; }

    .bp-stock-info { display: flex; align-items: center; gap: 6px; font-size: 0.85rem; font-weight: 600; padding: 10px 14px; border-radius: var(--b-radius-sm); margin-bottom: 20px; }
    .bp-stock--dispo { background: #f0fdf4; color: #15803d; }
    .bp-stock--faible { background: #fefce8; color: #a16207; }
    .bp-stock--rupture { background: #fef2f2; color: #dc2626; }
    .bp-stock--surcommande { background: #f5f3ff; color: #7c3aed; }

    .bp-qty-block { margin-bottom: 20px; }
    .bp-qty-block .bp-label { font-size: 0.85rem; font-weight: 600; color: var(--b-text); display: block; margin-bottom: 8px; }
    .bp-qty-controls { display: flex; align-items: center; gap: 0; border: 1.5px solid var(--b-border); border-radius: var(--b-radius-sm); overflow: hidden; width: fit-content; }
    .bp-qty-btn { width: 40px; height: 40px; background: var(--b-bg); border: none; font-size: 1.2rem; cursor: pointer; color: var(--b-text); transition: background 0.15s; }
    .bp-qty-btn:hover:not(:disabled) { background: #e2e8f0; }
    .bp-qty-btn:disabled { color: var(--b-muted); cursor: not-allowed; }
    .bp-qty-val { padding: 0 20px; font-weight: 700; font-size: 1rem; color: var(--b-text); background: var(--b-surface); }
    .bp-qty-max { font-size: 0.75rem; color: var(--b-muted); margin-top: 4px; display: block; }

    .bp-add-btn { width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; padding: 14px 24px; background: var(--b-primary); color: #fff; border: none; border-radius: var(--b-radius-sm); font-family: var(--font-body); font-size: 1rem; font-weight: 700; cursor: pointer; transition: background 0.15s, transform 0.1s; margin-bottom: 14px; }
    .bp-add-btn:hover:not(:disabled) { background: var(--b-primary-dark); transform: translateY(-1px); }
    .bp-add-btn:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }

    .bp-voir-panier { display: block; text-align: center; color: var(--b-accent); text-decoration: none; font-size: 0.875rem; font-weight: 600; }
    .bp-voir-panier:hover { text-decoration: underline; }

    .bp-rupture-msg { background: #fef2f2; border: 1.5px solid #fecaca; border-radius: var(--b-radius-sm); padding: 20px; text-align: center; }
    .bp-rupture-msg p { color: #dc2626; font-size: 0.9rem; margin-bottom: 16px; }

    .b-footer { text-align: center; padding: 24px; background: var(--b-surface); border-top: 1px solid var(--b-border); color: var(--b-muted); font-size: 0.8rem; }

    .b-spinner { animation: spin 0.8s linear infinite; }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private CatalogueProduitDto? produit;
    private bool chargement = true;
    private int quantite = 1;
    private int cartCount = 0;
    private bool ajoutEnCours = false;

    protected override async Task OnInitializedAsync()
    {
        cartCount = await CartService.GetCountAsync();
        CartService.OnCartChanged += MettreAJourBadge;
    }

    protected override async Task OnParametersSetAsync()
    {
        chargement = true;
        produit = await BoutiqueService.ObtenirProduitPublic(Id);
        quantite = 1;
        chargement = false;
    }

    private void MettreAJourBadge()
    {
        cartCount = CartService.Count;
        InvokeAsync(StateHasChanged);
    }

    private void IncrementerQty()
    {
        if (produit == null) return;
        if (produit.DisponibleSurCommande || quantite < produit.QuantiteDisponible)
            quantite++;
    }

    private void DecrementerQty()
    {
        if (quantite > 1) quantite--;
    }

    private async Task AjouterAuPanier()
    {
        if (produit == null || !produit.PeutCommander) return;
        ajoutEnCours = true;

        await CartService.AddToCartAsync(produit, quantite);

        Snackbar.Add($"« {produit.Nom} » × {quantite} ajouté(s) au panier ✓", Severity.Success,
            config => { config.VisibleStateDuration = 2500; });

        ajoutEnCours = false;
    }

    private (string Label, string CssClass) GetStatutBadge(CatalogueProduitDto p)
    {
        if (p.EstEnRupture) return ("Rupture", "b-badge--rupture");
        if (p.EstSurCommande) return ("Sur commande", "b-badge--surcommande");
        if (p.EstStockFaibleEffectif) return ("Stock faible", "b-badge--faible");
        return ("Disponible", "b-badge--dispo");
    }

    private string GetStockClass(CatalogueProduitDto p) =>
        p.EstEnRupture ? "bp-stock-info bp-stock--rupture" :
        p.EstSurCommande ? "bp-stock-info bp-stock--surcommande" :
        p.EstStockFaibleEffectif ? "bp-stock-info bp-stock--faible" :
        "bp-stock-info bp-stock--dispo";

    private string GetStockMessage(CatalogueProduitDto p)
    {
        if (p.EstEnRupture) return "Rupture de stock — non disponible";
        if (p.EstSurCommande) return "Disponible sur commande";
        if (p.EstStockFaibleEffectif) return $"Stock faible : {p.QuantiteDisponible} unité(s) restante(s)";
        return $"En stock : {p.QuantiteDisponible} unité(s) disponible(s)";
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= MettreAJourBadge;
    }
}
