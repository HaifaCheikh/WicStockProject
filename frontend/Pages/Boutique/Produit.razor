@page "/boutique/{Id:int}"
@layout WicStock.Web.Layout.HomeLayout
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@inject BoutiqueService BoutiqueService
@inject CartService CartService
@inject FeedbackService FeedbackService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(produit?.Nom ?? "Fiche produit") — WicStock Boutique</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="boutique-page">

    <!-- NAVBAR (identique à Boutique/Index.razor) -->
    <header class="b-navbar">
        <div class="b-nav-inner">
            <a href="/" class="b-brand">
                <span class="b-brand-mark">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                        <path d="M3 8 L21 8 M3 12 L21 12 M3 16 L21 16" stroke="#fff" stroke-width="2" stroke-linecap="round" />
                        <path d="M7 4 L7 20 M12 4 L12 20 M17 4 L17 20" stroke="rgba(255,255,255,0.55)" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                </span>
                <span class="b-brand-name">WicStock</span>
            </a>
            <nav class="b-nav-links">
                <a href="/">Accueil</a>
                <a href="/boutique" class="active">Boutique</a>
            </nav>
            <div class="b-nav-actions">
                <a href="/panier" class="b-cart-btn" title="Mon panier">
                    <svg viewBox="0 0 24 24" width="19" height="19" fill="none">
                        <path d="M6 2 L3 6 V20 C3 21.1 3.9 22 5 22 H19 C20.1 22 21 21.1 21 20 V6 L18 2 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M3 6 H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M16 10 C16 12.2 14.2 14 12 14 C9.8 14 8 12.2 8 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    @if (cartCount > 0)
                    {
                        <span class="b-cart-badge">@cartCount</span>
                    }
                </a>
                <AuthorizeView>
                    <Authorized>
                        <a href="/catalogue" class="b-btn b-btn--outline">Mon espace</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="b-btn b-btn--outline">Se connecter</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <!-- BREADCRUMB -->
    <nav class="bp-breadcrumb">
        <div class="bp-breadcrumb-inner">
            <a href="/boutique" class="b-btn-back-icon" title="Retour à la boutique">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                    <path d="M19 12 H5 M11 18 L5 12 L11 6" stroke="var(--b-denim)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>
    </nav>

    @if (chargement)
    {
        <div class="bp-loading">
            <div class="bp-spinner-ring"></div>
            <p>Chargement du produit...</p>
        </div>
    }
    else if (produit == null)
    {
        <div class="bp-not-found">
            <svg viewBox="0 0 24 24" width="44" height="44" fill="none">
                <circle cx="12" cy="12" r="10" stroke="#94a3b8" stroke-width="1.5"/>
                <path d="M12 8 V12 M12 16 H12.01" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <h2>Produit introuvable</h2>
            <p>Ce produit n'existe pas ou a été retiré du catalogue.</p>
            <a href="/boutique" class="b-btn b-btn-primary">Retour au catalogue</a>
        </div>
    }
    else
    {
        <main class="bp-main">
            <div class="bp-grid">

                <!-- Image -->
                <div class="bp-img-col">
                    <div class="bp-img-wrap">
                        @if (!string.IsNullOrEmpty(produit.ImageUrl))
                        {
                            <img src="@produit.ImageUrl" alt="@produit.Nom" class="bp-img" />
                        }
                        else
                        {
                            <div class="bp-img-placeholder">
                                <svg viewBox="0 0 24 24" width="44" height="44" fill="none">
                                    <rect x="3" y="3" width="18" height="18" rx="3" stroke="#cbd5e1" stroke-width="1.5"/>
                                    <circle cx="8.5" cy="8.5" r="1.5" stroke="#cbd5e1" stroke-width="1.5"/>
                                    <path d="M21 15 L16 10 L11 15" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M3 20 L8 15" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round"/>
                                </svg>
                                <p>Aucune image disponible</p>
                            </div>
                        }

                        <!-- Badges -->
                        <div class="bp-badges">
                            @if (produit.EstEnPromotion)
                            {
                                <span class="b-badge b-badge--promo">Promo -@produit.RemisePourcentage%</span>
                            }
                            @{
                                var (statutLabel, statutClass) = GetStatutBadge(produit);
                            }
                            <span class="b-badge @statutClass">@statutLabel</span>
                        </div>
                    </div>
                </div>

                <!-- Informations -->
                <div class="bp-info-col">
                    <p class="bp-ref">@produit.Reference</p>
                    <h1 class="bp-name">@produit.Nom</h1>

                    <!-- Rating badge public -->
                    <div class="bp-rating-row">
                        <span class="bp-rating-badge">
                            <span class="star">★</span>
                            @if (produit.NombreAvis > 0)
                            {
                                <strong>@produit.NoteMoyenne.ToString("0.0")</strong>
                                <span class="cnt">(@produit.NombreAvis avis)</span>
                            }
                            else
                            {
                                <span class="cnt">Aucun avis pour le moment</span>
                            }
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(produit.TypeTissu))
                    {
                        <p class="bp-tissu">
                            <span class="bp-label">Tissu :</span> @produit.TypeTissu
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(produit.Categorie))
                    {
                        <p class="bp-categorie">
                            <span class="bp-label">Catégorie :</span> @produit.Categorie
                        </p>
                    }

                    <!-- Prix -->
                    <div class="bp-prix-block">
                        @if (produit.EstEnPromotion && produit.PrixPromo > 0)
                        {
                            <span class="bp-prix-promo">@produit.PrixPromo.ToString("0.00") DT</span>
                            <span class="bp-prix-barre">@produit.PrixUnitaire.ToString("0.00") DT</span>
                            @if (produit.DateFinPromotion.HasValue)
                            {
                                <span class="bp-promo-expiry">Offre jusqu'au @produit.DateFinPromotion.Value.ToString("dd/MM/yyyy")</span>
                            }
                        }
                        else
                        {
                            <span class="bp-prix">@produit.PrixUnitaire.ToString("0.00") DT</span>
                        }
                    </div>

                    <!-- Stock info -->
                    <div class="bp-stock-info @GetStockClass(produit)">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/>
                            <path d="M12 8 V12 L14 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                        @GetStockMessage(produit)
                    </div>

                    <!-- Sélecteur de quantité -->
                    @if (produit.PeutCommander)
                    {
                        <div class="bp-qty-block">
                            <label class="bp-label">Quantité</label>
                            <div class="bp-qty-controls">
                                <button class="bp-qty-btn" @onclick="DecrementerQty" disabled="@(quantite <= 1)">−</button>
                                <span class="bp-qty-val">@quantite</span>
                                <button class="bp-qty-btn" @onclick="IncrementerQty"
                                        disabled="@(!produit.DisponibleSurCommande && quantite >= produit.QuantiteDisponible)">+</button>
                            </div>
                        </div>

                        <button class="bp-add-btn @(ajoutEnCours ? "bp-add-btn--loading" : "")"
                                @onclick="AjouterAuPanier"
                                disabled="@ajoutEnCours">
                            @if (ajoutEnCours)
                            {
                                <svg class="b-spinner" viewBox="0 0 24 24" width="18" height="18">
                                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" stroke-dasharray="60" stroke-dashoffset="15" fill="none"/>
                                </svg>
                                <span>Ajout en cours...</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                                    <path d="M6 2 L3 6 V20 C3 21.1 3.9 22 5 22 H19 C20.1 22 21 21.1 21 20 V6 L18 2 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M12 8 V16 M8 12 H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                </svg>
                                <span>Ajouter au panier</span>
                            }
                        </button>

                        <a href="/panier" class="bp-voir-panier-btn">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
                                <path d="M6 2 L3 6 V20 C3 21.1 3.9 22 5 22 H19 C20.1 22 21 21.1 21 20 V6 L18 2 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M3 6 H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            </svg>
                            <span>Voir mon panier @(cartCount > 0 ? $"({cartCount} article{(cartCount > 1 ? "s" : "")})" : "")</span>
                        </a>
                    }
                    else
                    {
                        <div class="bp-rupture-msg">
                            <p>Ce produit est actuellement en rupture de stock.</p>
                            <a href="/boutique" class="b-btn b-btn--ghost">Voir d'autres produits</a>
                        </div>
                    }
                </div>
            </div>

            <!-- ===== SECTION AVIS CLIENTS ===== -->
            <div class="bp-avis-section">
                <h2 class="bp-avis-title">Avis des clients (@(avisList?.Count ?? 0))</h2>

                <!-- Formulaire de soumission (Réservé aux clients connectés) -->
                <AuthorizeView>
                    <Authorized>
                        <div class="bp-avis-form-card">
                            <h3>Laisser un avis sur ce produit</h3>
                            @if (avisSoumis)
                            {
                                <div class="bp-avis-success">Votre avis a été soumis avec succès et sera publié après validation ! ✓</div>
                            }
                            else
                            {
                                <div class="bp-rating-picker">
                                    <span>Votre note :</span>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        int starIndex = i;
                                        <button type="button" class="bp-star-btn @(nouvelleNote >= starIndex ? "active" : "")" @onclick="() => nouvelleNote = starIndex">★</button>
                                    }
                                </div>
                                <textarea class="bp-avis-textarea" placeholder="Partagez votre expérience avec ce produit..." @bind="nouveauCommentaire"></textarea>
                                @if (!string.IsNullOrEmpty(erreurAvis))
                                {
                                    <p class="bp-avis-error">@erreurAvis</p>
                                }
                                <button type="button" class="b-btn b-btn-primary" @onclick="SoumettreAvis" disabled="@envoiAvisEnCours">
                                    @(envoiAvisEnCours ? "Envoi en cours..." : "Publier mon avis")
                                </button>
                            }
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="bp-avis-auth-prompt">
                            <p>Vous souhaitez donner votre avis sur ce produit ?</p>
                            <a href="/login?redirect=/boutique/@Id" class="b-btn b-btn--outline">Se connecter pour laisser un avis</a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>

                <!-- Liste des avis publics -->
                @if (avisList == null)
                {
                    <p class="bp-avis-empty">Chargement des avis...</p>
                }
                else if (!avisList.Any())
                {
                    <p class="bp-avis-empty">Soyez le premier à donner votre avis sur ce produit !</p>
                }
                else
                {
                    <div class="bp-avis-list">
                        @foreach (var avis in avisList)
                        {
                            <div class="bp-avis-item">
                                <div class="bp-avis-header">
                                    <span class="bp-avis-author">@(string.IsNullOrEmpty(avis.ClientNom) ? "Client WicStock" : avis.ClientNom)</span>
                                    <span class="bp-avis-date">@avis.DateCreation.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="bp-avis-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="@(i <= avis.Note ? "star-fill" : "star-empty")">★</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(avis.Commentaire))
                                {
                                    <p class="bp-avis-text">@avis.Commentaire</p>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </main>
    }

    <footer class="b-footer">
        <p>© 2026 WicStock — Gestion d'inventaire textile</p>
    </footer>
</div>

<style>
    /* Même palette que Boutique/Index.razor et la Home */
    :root {
        --b-ink: #16233A; --b-ink-muted: #64748B; --b-paper: #FFFFFF; --b-sand: #F3F6FA; --b-border: #E1E7EF;
        --b-denim: #2B4C7E; --b-denim-dark: #14263F; --b-denim-tint: #E7EDF6; --b-denim-soft: #EAF0F8;
        --b-rust: #B5563A; --b-rust-soft: #F9ECE8; --b-pine: #1E6B4C; --b-pine-soft: #E4F3EC; --b-amber-soft: #FEF3C7;
        --b-radius: 16px; --b-radius-sm: 8px;
        --font-head: 'Sora', 'Inter', sans-serif; --font-body: 'Inter', sans-serif; --font-mono: 'JetBrains Mono', monospace;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    .boutique-page { font-family: var(--font-body); background: var(--b-sand); min-height: 100vh; color: var(--b-ink); display: flex; flex-direction: column; }

    /* NAVBAR */
    .b-navbar { background: var(--b-paper); border-bottom: 1px solid var(--b-border); position: sticky; top: 0; z-index: 100; }
    .b-nav-inner { max-width: 1160px; margin: 0 auto; padding: 0 24px; height: 64px; display: flex; align-items: center; gap: 24px; }
    .b-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .b-brand-mark { width: 32px; height: 32px; background: var(--b-denim); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
    .b-brand-name { font-family: var(--font-head); font-weight: 700; font-size: 1.125rem; color: var(--b-ink); }
    .b-nav-links { display: flex; gap: 28px; margin-left: 24px; flex: 1; }
    .b-nav-links a { color: var(--b-ink-muted); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 0.15s; }
    .b-nav-links a:hover, .b-nav-links a.active { color: var(--b-denim); }
    .b-nav-actions { display: flex; align-items: center; gap: 12px; }
    .b-cart-btn { position: relative; width: 38px; height: 38px; border-radius: var(--b-radius-sm); background: var(--b-sand); color: var(--b-ink-muted); display: flex; align-items: center; justify-content: center; text-decoration: none; transition: background 0.15s, color 0.15s; }
    .b-cart-btn:hover { background: var(--b-denim-soft); color: var(--b-denim); }
    .b-cart-badge { position: absolute; top: -4px; right: -4px; background: var(--b-rust); color: #fff; font-size: 0.65rem; font-weight: 700; min-width: 18px; height: 18px; border-radius: 9px; display: flex; align-items: center; justify-content: center; padding: 0 4px; border: 2px solid var(--b-paper); }

    .b-btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: var(--b-radius-sm); font-family: var(--font-body); font-size: 0.875rem; font-weight: 600; cursor: pointer; text-decoration: none; transition: all 0.15s; border: none; }
    .b-btn-primary { background: var(--b-denim); color: #fff; box-shadow: 0 6px 16px -6px rgba(43,76,126,0.35); }
    .b-btn-primary:hover { background: var(--b-denim-dark); }
    .b-btn--ghost { background: transparent; color: var(--b-ink); border: 1.5px solid var(--b-border); }
    .b-btn--ghost:hover { background: var(--b-sand); border-color: var(--b-denim); color: var(--b-denim); }
    .b-btn--outline { background: transparent; color: var(--b-ink); border: 1.5px solid var(--b-border); }
    .b-btn--outline:hover { border-color: var(--b-denim); color: var(--b-denim); background: var(--b-denim-soft); }

    /* BREADCRUMB */
    .bp-breadcrumb { background: var(--b-sand); padding: 12px 24px; }
    .bp-breadcrumb-inner { max-width: 1160px; margin: 0 auto; display: flex; align-items: center; }
    .b-btn-back-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        color: var(--b-denim);
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .b-btn-back-icon:hover {
        background: var(--b-denim-soft);
        transform: translateX(-3px);
    }

    /* LOADING / NOT FOUND */
    .bp-loading, .bp-not-found { text-align: center; padding: 80px 20px; color: var(--b-ink-muted); }
    .bp-spinner-ring { width: 40px; height: 40px; border: 3px solid var(--b-border); border-top-color: var(--b-denim); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 16px; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .bp-not-found h2 { font-family: var(--font-head); font-size: 1.3rem; margin: 16px 0 8px; color: var(--b-ink); }
    .bp-not-found p { margin-bottom: 24px; }

    /* MAIN */
    .bp-main { max-width: 1160px; margin: 0 auto; padding: 44px 24px 80px; flex: 1; width: 100%; }
    .bp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 52px; align-items: start; }
    @@media (max-width: 768px) { .bp-grid { grid-template-columns: 1fr; gap: 28px; } }

    /* IMAGE */
    .bp-img-wrap { position: relative; border-radius: var(--b-radius); overflow: hidden; background: var(--b-paper); border: 1px solid var(--b-border); }
    .bp-img { width: 100%; max-height: 460px; object-fit: cover; display: block; }
    .bp-img-placeholder { height: 340px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: var(--b-ink-muted); font-size: 0.875rem; }
    .bp-badges { position: absolute; top: 14px; left: 14px; display: flex; flex-direction: column; gap: 6px; }

    .b-badge { font-size: 0.72rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; letter-spacing: 0.02em; box-shadow: 0 2px 6px rgba(0,0,0,0.08); }
    .b-badge--promo { background: var(--b-amber-soft); color: #92400E; border: 1px solid #F59E0B; }
    .b-badge--dispo { background: var(--b-pine-soft); color: var(--b-pine); border: 1px solid #86EFAC; }
    .b-badge--faible { background: var(--b-amber-soft); color: #92400E; border: 1px solid #F59E0B; }
    .b-badge--rupture { background: #FEE2E2; color: #991B1B; border: 1px solid #FCA5A5; }
    .b-badge--surcommande { background: var(--b-denim-soft); color: var(--b-denim); border: 1px solid #93A8C4; }

    /* INFOS */
    .bp-ref { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: var(--b-ink-muted); letter-spacing: 0.02em; text-transform: uppercase; margin-bottom: 8px; }
    .bp-name { font-family: var(--font-head); font-size: clamp(1.35rem, 2.8vw, 1.9rem); font-weight: 800; color: var(--b-ink); margin-bottom: 16px; line-height: 1.2; letter-spacing: -0.02em; }
    .bp-tissu, .bp-categorie { font-size: 0.9rem; color: var(--b-ink-muted); margin-bottom: 6px; }
    .bp-label { font-weight: 600; color: var(--b-ink); }

    .bp-prix-block { margin: 18px 0; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .bp-prix { font-size: 1.7rem; font-weight: 800; color: var(--b-denim); font-family: var(--font-head); }
    .bp-prix-promo { font-size: 1.7rem; font-weight: 800; color: var(--b-pine); font-family: var(--font-head); }
    .bp-prix-barre { font-size: 1rem; color: var(--b-ink-muted); text-decoration: line-through; }
    .bp-promo-expiry { font-size: 0.78rem; color: #92400E; background: var(--b-amber-soft); padding: 3px 10px; border-radius: 999px; font-weight: 600; }

    .bp-stock-info { display: flex; align-items: center; gap: 6px; font-size: 0.85rem; font-weight: 600; padding: 9px 14px; border-radius: var(--b-radius-sm); margin-bottom: 20px; }
    .bp-stock--dispo { background: var(--b-pine-soft); color: var(--b-pine); }
    .bp-stock--faible { background: var(--b-amber-soft); color: #92400E; }
    .bp-stock--rupture { background: #FEE2E2; color: #991B1B; }
    .bp-stock--surcommande { background: var(--b-denim-soft); color: var(--b-denim); }

    .bp-qty-block { margin-bottom: 20px; }
    .bp-qty-block .bp-label { font-size: 0.85rem; font-weight: 600; color: var(--b-ink); display: block; margin-bottom: 8px; }
    .bp-qty-controls { display: flex; align-items: center; gap: 0; border: 1.5px solid var(--b-border); border-radius: var(--b-radius-sm); overflow: hidden; width: fit-content; }
    .bp-qty-btn { width: 40px; height: 40px; background: var(--b-sand); border: none; font-size: 1.2rem; cursor: pointer; color: var(--b-ink); transition: background 0.15s; }
    .bp-qty-btn:hover:not(:disabled) { background: var(--b-border); }
    .bp-qty-btn:disabled { color: var(--b-ink-muted); cursor: not-allowed; }
    .bp-qty-val { padding: 0 20px; font-weight: 700; font-size: 1rem; color: var(--b-ink); background: var(--b-paper); }
    .bp-qty-max { font-size: 0.75rem; color: var(--b-ink-muted); margin-top: 4px; display: block; }

    .bp-add-btn { width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; padding: 14px 24px; background: var(--b-denim); color: #fff; border: none; border-radius: var(--b-radius-sm); font-family: var(--font-body); font-size: 1rem; font-weight: 700; cursor: pointer; transition: background 0.15s, transform 0.1s; margin-bottom: 14px; box-shadow: 0 6px 16px -6px rgba(43,76,126,0.35); }
    .bp-add-btn:hover:not(:disabled) { background: var(--b-denim-dark); transform: translateY(-1px); }
    .bp-add-btn:disabled { opacity: 0.7; cursor: not-allowed; transform: none; box-shadow: none; }

    .bp-voir-panier-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        background: var(--b-paper);
        color: var(--b-denim);
        border: 1.5px solid var(--b-border);
        border-radius: var(--b-radius-sm);
        font-family: var(--font-body);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .bp-voir-panier-btn svg { color: var(--b-denim); }
    .bp-voir-panier-btn:hover {
        background: var(--b-denim-soft);
        border-color: #B2C4DC;
        color: var(--b-denim-dark);
        box-shadow: 0 4px 12px -4px rgba(43,76,126,0.15);
    }

    .bp-rupture-msg { background: var(--b-rust-soft); border: 1.5px solid #F0C7BB; border-radius: var(--b-radius-sm); padding: 20px; text-align: center; }
    .bp-rupture-msg p { color: var(--b-rust); font-size: 0.9rem; margin-bottom: 16px; }

    /* Rating & Avis */
    .bp-rating-row { margin-bottom: 12px; }
    .bp-rating-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; background: var(--b-amber-soft); border: 1px solid #F59E0B; border-radius: 999px; font-size: 0.8rem; color: #92400E; }
    .bp-rating-badge .star { color: #D97706; font-size: 0.9rem; }
    .bp-rating-badge .cnt { color: #B45309; font-size: 0.78rem; }

    .bp-avis-section { margin-top: 56px; border-top: 1px solid var(--b-border); padding-top: 40px; }
    .bp-avis-title { font-family: var(--font-head); font-size: 1.3rem; font-weight: 700; color: var(--b-ink); margin-bottom: 24px; }
    
    .bp-avis-form-card { background: var(--b-paper); border: 1px solid var(--b-border); border-radius: var(--b-radius); padding: 24px; margin-bottom: 32px; }
    .bp-avis-form-card h3 { font-family: var(--font-head); font-size: 1rem; font-weight: 700; margin-bottom: 16px; color: var(--b-ink); }
    .bp-rating-picker { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; font-size: 0.9rem; font-weight: 600; }
    .bp-star-btn { background: none; border: none; font-size: 1.5rem; color: var(--b-border); cursor: pointer; transition: color 0.15s; padding: 0 2px; }
    .bp-star-btn.active { color: #F59E0B; }
    .bp-avis-textarea { width: 100%; height: 90px; border: 1.5px solid var(--b-border); border-radius: var(--b-radius-sm); padding: 12px; font-family: var(--font-body); font-size: 0.875rem; color: var(--b-ink); background: var(--b-sand); outline: none; margin-bottom: 14px; resize: vertical; }
    .bp-avis-textarea:focus { border-color: var(--b-denim); background: var(--b-paper); }
    .bp-avis-success { background: var(--b-pine-soft); color: var(--b-pine); border: 1px solid #86EFAC; padding: 14px 18px; border-radius: var(--b-radius-sm); font-size: 0.9rem; font-weight: 600; }
    .bp-avis-error { color: var(--b-rust); font-size: 0.85rem; margin-bottom: 12px; font-weight: 600; }

    .bp-avis-auth-prompt { background: var(--b-paper); border: 1.5px dashed var(--b-border); border-radius: var(--b-radius); padding: 24px; text-align: center; margin-bottom: 32px; }
    .bp-avis-auth-prompt p { font-size: 0.95rem; color: var(--b-ink-muted); margin-bottom: 14px; }

    .bp-avis-empty { color: var(--b-ink-muted); font-size: 0.9rem; text-align: center; margin: 24px 0; }

    .b-footer { text-align: center; padding: 24px; background: var(--b-sand); color: var(--b-ink-muted); font-size: 0.8125rem; margin-top: 40px; }
    .bp-avis-list { display: flex; flex-direction: column; gap: 16px; }
    .bp-avis-item { background: var(--b-paper); border: 1px solid var(--b-border); border-radius: var(--b-radius-sm); padding: 18px; }
    .bp-avis-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .bp-avis-author { font-weight: 700; font-size: 0.9rem; color: var(--b-ink); }
    .bp-avis-date { font-size: 0.78rem; color: var(--b-ink-muted); }
    .bp-avis-stars { color: #F59E0B; font-size: 0.9rem; margin-bottom: 8px; }
    .bp-avis-stars .star-empty { color: var(--b-border); }
    .bp-avis-text { font-size: 0.875rem; color: var(--b-ink); line-height: 1.5; }

    .b-spinner { animation: spin 0.8s linear infinite; }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private CatalogueProduitDto? produit;
    private bool chargement = true;
    private int quantite = 1;
    private int cartCount = 0;
    private bool ajoutEnCours = false;

    private List<AvisDto>? avisList;
    private int nouvelleNote = 5;
    private string nouveauCommentaire = string.Empty;
    private bool envoiAvisEnCours = false;
    private bool avisSoumis = false;
    private string? erreurAvis;

    protected override async Task OnInitializedAsync()
    {
        cartCount = await CartService.GetCountAsync();
        CartService.OnCartChanged += MettreAJourBadge;
    }

    protected override async Task OnParametersSetAsync()
    {
        chargement = true;
        produit = await BoutiqueService.ObtenirProduitPublic(Id);
        quantite = 1;

        if (produit != null)
        {
            avisList = await FeedbackService.ObtenirAvisPublicsProduit(produit.Id);
        }

        chargement = false;
    }

    private void MettreAJourBadge()
    {
        cartCount = CartService.Count;
        InvokeAsync(StateHasChanged);
    }

    private void IncrementerQty()
    {
        if (produit == null) return;
        if (produit.DisponibleSurCommande || quantite < produit.QuantiteDisponible)
            quantite++;
    }

    private void DecrementerQty()
    {
        if (quantite > 1) quantite--;
    }

    private async Task AjouterAuPanier()
    {
        if (produit == null || !produit.PeutCommander) return;
        ajoutEnCours = true;

        await CartService.AddToCartAsync(produit, quantite);

        Snackbar.Add($"« {produit.Nom} » × {quantite} ajouté(s) au panier ✓", Severity.Success,
            config => { config.VisibleStateDuration = 2500; });

        ajoutEnCours = false;
    }

    private async Task SoumettreAvis()
    {
        if (produit == null) return;
        envoiAvisEnCours = true;
        erreurAvis = null;

        var dto = new CreerModifierAvisDto
        {
            Note = nouvelleNote,
            Commentaire = nouveauCommentaire
        };

        var (succes, message, avis) = await FeedbackService.SoumettreAvis(dto);
        if (succes)
        {
            avisSoumis = true;
            avisList = await FeedbackService.ObtenirAvisPublicsProduit(produit.Id);
        }
        else
        {
            erreurAvis = string.IsNullOrEmpty(message) ? "Impossible d'envoyer votre avis. Seuls les clients ayant acheté ce produit peuvent donner leur avis." : message;
        }

        envoiAvisEnCours = false;
    }

    private (string Label, string CssClass) GetStatutBadge(CatalogueProduitDto p)
    {
        if (p.EstEnRupture) return ("Rupture de stock", "b-badge--rupture");
        if (p.EstSurCommande) return ("Sur commande", "b-badge--surcommande");
        return ("En stock", "b-badge--dispo");
    }

    private string GetStockClass(CatalogueProduitDto p) =>
        p.EstEnRupture ? "bp-stock-info bp-stock--rupture" :
        p.EstSurCommande ? "bp-stock-info bp-stock--surcommande" :
        p.EstStockFaibleEffectif ? "bp-stock-info bp-stock--faible" :
        "bp-stock-info bp-stock--dispo";

    private string GetStockMessage(CatalogueProduitDto p)
    {
        if (p.EstEnRupture) return "Rupture de stock — non disponible";
        if (p.EstSurCommande) return "Disponible sur commande";
        if (p.EstStockFaibleEffectif) return $"Il ne reste que {p.QuantiteDisponible} pièce(s)";
        return "En stock";
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= MettreAJourBadge;
    }
}
