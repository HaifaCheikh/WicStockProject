@code {
    private List<AvisDto> tousAvis = new();
    private bool isLoading = true;
    private string selectedVisibilite = "";
    private string selectedStatut = "";
    private int? togglingId = null;
    private int? confirmDeleteId = null;
    private int? deletingId = null;

    private double noteMoyenne => tousAvis.Any() ? tousAvis.Average(a => a.Note) : 0;

    private AvisDto? AvisASupprimer => confirmDeleteId.HasValue
        ? tousAvis.FirstOrDefault(a => a.Id == confirmDeleteId.Value)
        : null;

    private IEnumerable<AvisDto> AvisFiltres => tousAvis.Where(a =>
        (selectedVisibilite == "" || (selectedVisibilite == "visible" && !a.EstMasque) || (selectedVisibilite == "masque" && a.EstMasque)) &&
        (selectedStatut == "" || string.Equals(a.Statut, selectedStatut, StringComparison.OrdinalIgnoreCase))
    );

    protected override async Task OnInitializedAsync()
    {
        await ChargerAvis();
    }

    private async Task ChargerAvis()
    {
        isLoading = true;
        try
        {
            tousAvis = await FeedbackService.ObtenirToutesAvisAdmin();
        }
        catch { }
        finally { isLoading = false; }
    }

    private async Task ToggleVisibilite(AvisDto a)
    {
        togglingId = a.Id;
        try
        {
            var dto = new ModererAvisDto
            {
                Statut = a.Statut,
                EstMasque = !a.EstMasque
            };

            var ok = await FeedbackService.ModererAvis(a.Id, dto);
            if (ok)
            {
                a.EstMasque = !a.EstMasque;
                Snackbar.Add(a.EstMasque ? "L'avis a été masqué du public." : "L'avis est maintenant public.", Severity.Info);
            }
            else
            {
                Snackbar.Add("Erreur lors de la mise à jour de l'avis.", Severity.Error);
            }
        }
        finally
        {
            togglingId = null;
        }
    }

    private void FermerModaleSuppression()
    {
        if (deletingId == null)
        {
            confirmDeleteId = null;
        }
    }

    private async Task SupprimerAvis(AvisDto a)
    {
        deletingId = a.Id;
        try
        {
            var ok = await FeedbackService.SupprimerAvis(a.Id);
            if (ok)
            {
                tousAvis.Remove(a);
                Snackbar.Add("L'avis a été supprimé définitivement.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Erreur lors de la suppression de l'avis.", Severity.Error);
            }
        }
        finally
        {
            deletingId = null;
            confirmDeleteId = null;
        }
    }

    private string GetInitiales(string? nom)
    {
        if (string.IsNullOrWhiteSpace(nom)) return "?";
        var parts = nom.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][0].ToString().ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }

    private string GetStatutClass(string statut) => statut?.ToUpperInvariant() switch
    {
        "PUBLIE" => "status-pill--done",
        "REJETE" => "status-pill--rejected",
        _ => "status-pill--pending"
    };

    private string GetStatutLabel(string statut) => statut?.ToUpperInvariant() switch
    {
        "PUBLIE" => "Publié",
        "REJETE" => "Rejeté",
        "EN_ATTENTE" => "En attente",
        _ => statut ?? string.Empty
    };
}

