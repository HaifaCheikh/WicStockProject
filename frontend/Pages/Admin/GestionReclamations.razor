@page "/admin/reclamations"
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ADMIN")]
@inject FeedbackService FeedbackService
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Gestion des Réclamations | WicStock Admin</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="admin-page">
    <!-- En-tête -->
    <div class="admin-hero">
        <div class="hero-text">
            <h1 class="page-title">Gestion des Réclamations Clients</h1>
            <p class="page-subtitle">Suivez et traitez les réclamations déposées par les clients sur leurs commandes livrées.</p>
        </div>
    </div>

    @if (!isLoading && reclamations.Any())
    {
        <!-- STATISTIQUES (cliquables pour filtrer) -->
        <div class="stats-row mb-6">
            <div class="stat-card @(selectedStatut == "" ? "stat-card--active" : "")" @onclick='() => SelectStatut("")'>
                <div class="stat-icon stat-icon--denim">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Small" />
                </div>
                <div>
                    <div class="stat-value">@reclamations.Count</div>
                    <div class="stat-label">Total</div>
                </div>
            </div>
            <div class="stat-card @(selectedStatut == "ENVOYEE" ? "stat-card--active" : "")" @onclick='() => SelectStatut("ENVOYEE")'>
                <div class="stat-icon stat-icon--amber">
                    <MudIcon Icon="@Icons.Material.Filled.MarkEmailUnread" Size="Size.Small" />
                </div>
                <div>
                    <div class="stat-value">@reclamations.Count(r => IsStatut(r, "ENVOYEE"))</div>
                    <div class="stat-label">À traiter</div>
                </div>
            </div>
            <div class="stat-card @(selectedStatut == "EN_COURS" ? "stat-card--active" : "")" @onclick='() => SelectStatut("EN_COURS")'>
                <div class="stat-icon stat-icon--denim">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" />
                </div>
                <div>
                    <div class="stat-value">@reclamations.Count(r => IsStatut(r, "EN_COURS"))</div>
                    <div class="stat-label">En cours</div>
                </div>
            </div>
            <div class="stat-card @(selectedStatut == "RESOLUE" ? "stat-card--active" : "")" @onclick='() => SelectStatut("RESOLUE")'>
                <div class="stat-icon stat-icon--pine">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                </div>
                <div>
                    <div class="stat-value">@reclamations.Count(r => IsStatut(r, "RESOLUE"))</div>
                    <div class="stat-label">Résolues</div>
                </div>
            </div>
            <div class="stat-card @(selectedStatut == "REJETEE" ? "stat-card--active" : "")" @onclick='() => SelectStatut("REJETEE")'>
                <div class="stat-icon stat-icon--rust">
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                </div>
                <div>
                    <div class="stat-value">@reclamations.Count(r => IsStatut(r, "REJETEE"))</div>
                    <div class="stat-label">Rejetées</div>
                </div>
            </div>
        </div>

        <!-- FILTRES -->
        <div class="filters-card mb-6">
            <label class="filter-label" for="statut-filter">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
                Statut
            </label>
            <select id="statut-filter" class="filter-select" value="@selectedStatut" @onchange="OnFilterChanged">
                <option value="">Toutes</option>
                <option value="ENVOYEE">Envoyées</option>
                <option value="EN_COURS">En cours</option>
                <option value="RESOLUE">Résolues</option>
                <option value="REJETEE">Rejetées</option>
            </select>

            <div class="search-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="search-icon" />
                <input class="search-input" placeholder="Rechercher un client, un produit..." @bind="searchText" @bind:event="oninput" />
            </div>

            <span class="filter-count">@ReclamationsFiltrees.Count() résultat(s)</span>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex justify-center my-12">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (!reclamations.Any())
    {
        <div class="empty-card">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Class="empty-icon" />
            <h3 class="empty-title">Aucune réclamation pour le moment</h3>
            <p class="empty-subtitle">Les réclamations déposées par vos clients apparaîtront ici.</p>
        </div>
    }
    else if (!ReclamationsFiltrees.Any())
    {
        <div class="empty-card">
            <MudIcon Icon="@Icons.Material.Filled.FilterAltOff" Size="Size.Large" Class="empty-icon" />
            <h3 class="empty-title">Aucune réclamation ne correspond à ce filtre</h3>
            <p class="empty-subtitle">Essayez de modifier vos critères de recherche.</p>
        </div>
    }
    else
    {
        <div class="reclamations-grid">
            @foreach (var r in ReclamationsFiltrees)
            {
                <div class="reclamation-card @GetCardClass(r.Statut)">
                    <div class="card-header">
                        <span class="motif-pill">
                            <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" />
                            @r.Motif
                        </span>
                        <div class="d-flex align-center gap-1">
                            <button class="delete-btn" title="Supprimer cette réclamation" @onclick="() => DemanderSuppression(r)">
                                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                            </button>
                            <span class="status-pill @GetStatutClass(r.Statut)">
                                <MudIcon Icon="@GetStatutIcon(r.Statut)" Size="Size.Small" />
                                @GetStatutLabel(r.Statut)
                            </span>
                        </div>
                    </div>

                    <div class="card-body">
                        <!-- Client & Produit -->
                        <div class="meta-block">
                            <div class="meta-item meta-item--client">
                                <div class="meta-item-header">
                                    <span class="client-avatar">@GetInitiales(r.ClientNom)</span>
                                    <span class="meta-label">Client</span>
                                </div>
                                <div class="client-name">@r.ClientNom</div>
                                <div class="client-email">@r.ClientEmail</div>
                            </div>
                            <div class="meta-item">
                                <div class="meta-item-header">
                                    <MudIcon Icon="@Icons.Material.Filled.Checkroom" Size="Size.Small" Class="meta-icon" />
                                    <span class="meta-label">Produit</span>
                                </div>
                                <div class="product-name">@r.ProduitNom</div>
                                <span class="ref-code mt-1">@r.ProduitReference</span>
                            </div>
                            <div class="meta-item">
                                <div class="meta-item-header">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="meta-icon" />
                                    <span class="meta-label">Date de soumission</span>
                                </div>
                                <div class="meta-date">@r.DateCreation.ToString("dd MMMM yyyy à HH:mm")</div>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="desc-box mt-3">
                            <div class="desc-box-header">
                                <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Size="Size.Small" />
                                <span class="meta-label">Description du problème</span>
                            </div>
                            <p class="desc-text">@r.Description</p>
                        </div>

                        <!-- Photos -->
                        @if (!string.IsNullOrEmpty(r.PhotosUrls))
                        {
                            var photos = r.PhotosUrls.Split(',', StringSplitOptions.RemoveEmptyEntries);
                            <div class="photos-block mt-3">
                                <span class="meta-label">Photos jointes (@photos.Length)</span>
                                <div class="photos-grid mt-1">
                                    @foreach (var p in photos)
                                    {
                                        <a href="@GetFullImageUrl(p)" target="_blank" class="photo-item">
                                            <img src="@GetFullImageUrl(p)" alt="Photo réclamation" />
                                            <span class="photo-item-overlay">
                                                <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" />
                                            </span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Réponse admin existante -->
                        @if (!string.IsNullOrEmpty(r.ReponseAdmin))
                        {
                            <div class="reply-box mt-4">
                                <div class="d-flex align-center justify-between mb-1">
                                    <strong class="reply-title">
                                        <MudIcon Icon="@Icons.Material.Filled.Reply" Size="Size.Small" />
                                        Réponse apportée
                                    </strong>
                                    @if (r.DateReponse.HasValue)
                                    {
                                        <span class="reply-date">@r.DateReponse.Value.ToString("dd/MM/yyyy à HH:mm")</span>
                                    }
                                </div>
                                <p class="reply-text">@r.ReponseAdmin</p>
                            </div>
                        }
                    </div>

                    <div class="card-footer">
                        <button class="btn btn--primary" @onclick="() => OuvrirModalTraitement(r)">
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                            <span>@(string.IsNullOrEmpty(r.ReponseAdmin) ? "Traiter la réclamation" : "Modifier la réponse")</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ===== MODAL DE TRAITEMENT ===== -->
@if (selectedReclamation != null && showTraitementModal)
{
    <div class="wic-modal-overlay" @onclick="FermerModal">
        <div class="wic-modal-card" @onclick:stopPropagation="true">
            <div class="wic-modal-header">
                <div class="wic-modal-header-left">
                    <div class="wic-modal-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                    </div>
                    <div>
                        <h3 class="wic-modal-title">Traiter la réclamation</h3>
                        <p class="wic-modal-subtitle">@selectedReclamation.ClientNom — @selectedReclamation.ProduitNom</p>
                    </div>
                </div>
                <button class="wic-modal-close" @onclick="FermerModal">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </div>

            <div class="wic-modal-body">
                <!-- Rappel réclamation -->
                <div class="wic-recap-box mb-4">
                    <div class="wic-recap-row">
                        <span class="wic-recap-label">Motif</span>
                        <span class="motif-pill">@selectedReclamation.Motif</span>
                    </div>
                    <div class="wic-recap-row">
                        <span class="wic-recap-label">Produit</span>
                        <span class="wic-recap-value">@selectedReclamation.ProduitNom <span class="ref-code ml-1">@selectedReclamation.ProduitReference</span></span>
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label mb-2">Nouveau statut <span class="req-star">*</span></label>
                    <div class="statut-selector">
                        <button type="button" class="statut-option statut-option--progress @(nouveauStatut == "EN_COURS" ? "active" : "")"
                                @onclick='() => nouveauStatut = "EN_COURS"'>
                            <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" />
                            <span>En cours</span>
                        </button>
                        <button type="button" class="statut-option statut-option--done @(nouveauStatut == "RESOLUE" ? "active" : "")"
                                @onclick='() => nouveauStatut = "RESOLUE"'>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                            <span>Résolue</span>
                        </button>
                        <button type="button" class="statut-option statut-option--rejected @(nouveauStatut == "REJETEE" ? "active" : "")"
                                @onclick='() => nouveauStatut = "REJETEE"'>
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                            <span>Rejetée</span>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label mb-2">Réponse au client <span class="req-star">*</span></label>
                    <textarea class="form-control" rows="5" placeholder="Indiquez les mesures prises, les explications ou la solution proposée au client..."
                              @bind="reponseAdmin"></textarea>
                    <span class="form-hint">Cette réponse sera visible par le client et déclenchera une notification.</span>
                </div>
            </div>

            <div class="wic-modal-footer">
                <button class="btn btn--outline" @onclick="FermerModal" disabled="@isSubmitting">Annuler</button>
                <button class="btn btn--primary" @onclick="EnregistrerTraitement" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" Color="Color.Inherit" />
                        <span>Enregistrement...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                        <span>Valider la réponse</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ===== MODAL DE CONFIRMATION DE SUPPRESSION ===== -->
@if (reclamationASupprimer != null && showDeleteModal)
{
    <div class="wic-modal-overlay" @onclick="AnnulerSuppression">
        <div class="wic-confirm-card" @onclick:stopPropagation="true">
            <div class="wic-confirm-icon">
                <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Large" />
            </div>
            <h3 class="wic-confirm-title">Supprimer cette réclamation ?</h3>
            <p class="wic-confirm-text">
                Cette action est définitive et ne peut pas être annulée. La réclamation de
                <strong>@reclamationASupprimer.ClientNom</strong> concernant <strong>@reclamationASupprimer.ProduitNom</strong>
                sera supprimée.
            </p>
            <div class="wic-confirm-actions">
                <button class="btn btn--outline" @onclick="AnnulerSuppression" disabled="@isDeleting">Annuler</button>
                <button class="btn btn--danger" @onclick="ConfirmerSuppression" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" Color="Color.Inherit" />
                        <span>Suppression...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                        <span>Supprimer</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    .admin-page {
        --ink: #16233A;
        --ink-muted: #64748B;
        --paper: #FFFFFF;
        --sand: #F3F6FA;
        --border: #E1E7EF;
        --denim: #2B4C7E;
        --denim-dark: #1E3A63;
        --denim-soft: #E7EDF6;
        --rust: #B5563A;
        --rust-soft: #F9ECE8;
        --pine: #1E6B4C;
        --pine-soft: #E4F3EC;
        --amber: #D97706;
        --amber-soft: #FEF3C7;
        --radius-sm: 8px;
        --radius-md: 10px;
        --radius-lg: 16px;
        --font-display: "Sora", "Inter", sans-serif;
        --font-body: "Inter", sans-serif;
        --font-mono: "JetBrains Mono", monospace;
        font-family: var(--font-body);
    }

        .admin-page .admin-hero {
            margin-bottom: 20px;
        }

        .admin-page .page-title {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.75rem;
            color: var(--ink);
            margin: 0 0 6px 0;
            letter-spacing: -0.02em;
        }

        .admin-page .page-subtitle {
            color: var(--ink-muted);
            font-size: 0.95rem;
            margin: 0;
        }

        /* ===== Statistiques cliquables ===== */
        .admin-page .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 14px;
        }

        .admin-page .stat-card {
            background: var(--paper);
            border: 1.5px solid var(--border);
            border-radius: var(--radius-md);
            padding: 16px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 2px 8px rgba(22, 35, 58, 0.03);
            cursor: pointer;
            transition: all 0.15s ease;
        }

            .admin-page .stat-card:hover {
                border-color: var(--denim);
                transform: translateY(-1px);
            }

        .admin-page .stat-card--active {
            border-color: var(--denim);
            box-shadow: 0 0 0 3px rgba(43, 76, 126, 0.12);
        }

        .admin-page .stat-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .admin-page .stat-icon--denim {
            background: var(--denim-soft);
            color: var(--denim);
        }

        .admin-page .stat-icon--amber {
            background: var(--amber-soft);
            color: var(--amber);
        }

        .admin-page .stat-icon--pine {
            background: var(--pine-soft);
            color: var(--pine);
        }

        .admin-page .stat-icon--rust {
            background: var(--rust-soft);
            color: var(--rust);
        }

        .admin-page .stat-value {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--ink);
            line-height: 1.1;
        }

        .admin-page .stat-label {
            font-size: 0.78rem;
            color: var(--ink-muted);
            margin-top: 2px;
        }

        /* ===== Filtres ===== */
        .admin-page .filters-card {
            background: var(--paper);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .admin-page .filter-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--ink-muted);
            white-space: nowrap;
        }

        .admin-page .filter-select {
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 8px 14px;
            font-size: 0.875rem;
            font-weight: 600;
            font-family: var(--font-body);
            color: var(--ink);
            background: var(--paper);
            cursor: pointer;
            outline: none;
            min-width: 180px;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

            .admin-page .filter-select:focus {
                border-color: var(--denim);
                box-shadow: 0 0 0 3px rgba(43, 76, 126, 0.14);
            }

        .admin-page .search-wrap {
            position: relative;
            flex: 1;
            min-width: 220px;
        }

        .admin-page .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--ink-muted);
            pointer-events: none;
        }

        .admin-page .search-input {
            width: 100%;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 8px 14px 8px 36px;
            font-size: 0.875rem;
            font-family: var(--font-body);
            color: var(--ink);
            outline: none;
            box-sizing: border-box;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

            .admin-page .search-input:focus {
                border-color: var(--denim);
                box-shadow: 0 0 0 3px rgba(43, 76, 126, 0.14);
            }

        .admin-page .filter-count {
            font-size: 0.8rem;
            color: var(--ink-muted);
            font-weight: 600;
            white-space: nowrap;
        }

        .admin-page .reclamations-grid {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .admin-page .reclamation-card {
            background: var(--paper);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 24px;
            box-shadow: 0 2px 8px rgba(22, 35, 58, 0.03);
            transition: box-shadow 0.15s ease, border-color 0.15s ease;
        }

            .admin-page .reclamation-card:hover {
                box-shadow: 0 8px 20px -10px rgba(22, 35, 58, 0.18);
            }

        .admin-page .reclamation-card--pending {
            border-left: 3px solid var(--amber);
        }

        .admin-page .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 16px;
        }

        .admin-page .motif-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.8125rem;
            font-weight: 700;
            color: var(--rust);
            background: var(--rust-soft);
            padding: 4px 10px;
            border-radius: 6px;
            line-height: 1;
        }

        .admin-page .delete-btn {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: 1px solid var(--border);
            background: var(--paper);
            color: var(--ink-muted);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.15s ease;
            flex-shrink: 0;
        }

            .admin-page .delete-btn:hover {
                background: var(--rust-soft);
                border-color: var(--rust);
                color: var(--rust);
            }

        .admin-page .meta-block {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            background: var(--sand);
            padding: 14px 16px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
        }

        .admin-page .meta-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .admin-page .meta-item-header {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .admin-page .meta-icon {
            color: var(--ink-muted);
            flex-shrink: 0;
        }

        .admin-page .client-avatar {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--denim);
            color: #fff;
            font-size: 0.62rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-family: var(--font-display);
        }

        .admin-page .meta-label {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--ink-muted);
            text-transform: uppercase;
            letter-spacing: 0.03em;
            display: block;
            line-height: 1;
        }

        .admin-page .client-name,
        .admin-page .product-name,
        .admin-page .meta-date {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--ink);
            margin-top: 2px;
            font-family: var(--font-display);
        }

        .admin-page .client-email {
            font-size: 0.8rem;
            color: var(--ink-muted);
        }

        .admin-page .ref-code {
            display: inline-block;
