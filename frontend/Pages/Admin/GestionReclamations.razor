@code {
    private List<ReclamationDto> reclamations = new();
    private bool isLoading = true;
    private string selectedStatut = "";
    private string searchText = "";

    private ReclamationDto? selectedReclamation;
    private bool showTraitementModal = false;
    private string nouveauStatut = "EN_COURS";
    private string reponseAdmin = string.Empty;
    private bool isSubmitting = false;

    private ReclamationDto? reclamationASupprimer;
    private bool showDeleteModal = false;
    private bool isDeleting = false;

    private IEnumerable<ReclamationDto> ReclamationsFiltrees => reclamations.Where(r =>
        (string.IsNullOrEmpty(selectedStatut) || IsStatut(r, selectedStatut)) &&
        (string.IsNullOrWhiteSpace(searchText) ||
            (r.ClientNom?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (r.ClientEmail?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (r.ProduitNom?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (r.ProduitReference?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
    );

    private bool IsStatut(ReclamationDto r, string statut) =>
        string.Equals(r.Statut, statut, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await ChargerReclamations();
    }

    private async Task ChargerReclamations()
    {
        isLoading = true;
        try
        {
            // On charge la liste complète une seule fois : le filtrage par statut et la
            // recherche se font ensuite côté client, sans nouvel appel réseau.
            reclamations = await FeedbackService.ObtenirReclamationsAdmin(null);
        }
        catch { }
        finally { isLoading = false; }
    }

    private void SelectStatut(string statut)
    {
        selectedStatut = statut;
    }

    private Task OnFilterChanged(ChangeEventArgs e)
    {
        selectedStatut = e.Value?.ToString() ?? "";
        return Task.CompletedTask;
    }

    private void OuvrirModalTraitement(ReclamationDto r)
    {
        selectedReclamation = r;
        nouveauStatut = string.Equals(r.Statut, "ENVOYEE", StringComparison.OrdinalIgnoreCase) ? "EN_COURS" : r.Statut;
        reponseAdmin = r.ReponseAdmin ?? string.Empty;
        showTraitementModal = true;
    }

    private void FermerModal()
    {
        showTraitementModal = false;
        selectedReclamation = null;
    }

    private async Task EnregistrerTraitement()
    {
        if (selectedReclamation == null) return;
        if (string.IsNullOrWhiteSpace(reponseAdmin))
        {
            Snackbar.Add("Veuillez saisir une réponse pour le client.", Severity.Warning);
            return;
        }

        isSubmitting = true;
        var dto = new TraiterReclamationDto
        {
            Statut = nouveauStatut,
            ReponseAdmin = reponseAdmin
        };

        var ok = await FeedbackService.TraiterReclamation(selectedReclamation.Id, dto);
        isSubmitting = false;

        if (ok)
        {
            Snackbar.Add("Réclamation traitée et client notifié.", Severity.Success);
            FermerModal();
            await ChargerReclamations();
        }
        else
        {
            Snackbar.Add("Erreur lors de la mise à jour de la réclamation.", Severity.Error);
        }
    }

    private void DemanderSuppression(ReclamationDto r)
    {
        reclamationASupprimer = r;
        showDeleteModal = true;
    }

    private void AnnulerSuppression()
    {
        if (isDeleting) return;
        showDeleteModal = false;
        reclamationASupprimer = null;
    }

    private async Task ConfirmerSuppression()
    {
        if (reclamationASupprimer == null) return;

        isDeleting = true;
        try
        {
            var ok = await FeedbackService.SupprimerReclamationAdmin(reclamationASupprimer.Id);

            if (ok)
            {
                Snackbar.Add("Réclamation supprimée.", Severity.Success);
                showDeleteModal = false;
                reclamationASupprimer = null;
                await ChargerReclamations();
            }
            else
            {
                Snackbar.Add("Erreur lors de la suppression de la réclamation.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Erreur lors de la suppression de la réclamation.", Severity.Error);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private string GetFullImageUrl(string? url) =>
        string.IsNullOrEmpty(url) ? "" : $"{Http.BaseAddress}{url.TrimStart('/')}";

    private string GetInitiales(string? nom)
    {
        if (string.IsNullOrWhiteSpace(nom)) return "?";
        var parts = nom.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][0].ToString().ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }

    private string GetCardClass(string statut) => statut?.ToUpperInvariant() switch
    {
        "ENVOYEE" => "reclamation-card--pending",
        _ => ""
    };

    private string GetStatutClass(string statut) => statut?.ToUpperInvariant() switch
    {
        "RESOLUE" => "status-pill--done",
        "EN_COURS" => "status-pill--progress",
        "REJETEE" => "status-pill--rejected",
        _ => "status-pill--pending"
    };

    private string GetStatutIcon(string statut) => statut?.ToUpperInvariant() switch
    {
        "RESOLUE" => Icons.Material.Filled.CheckCircle,
        "EN_COURS" => Icons.Material.Filled.HourglassTop,
        "REJETEE" => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.MarkEmailUnread
    };

    private string GetStatutLabel(string statut) => statut?.ToUpperInvariant() switch
    {
        "ENVOYEE" => "Envoyée (À traiter)",
        "EN_COURS" => "En cours",
        "RESOLUE" => "Résolue",
        "REJETEE" => "Rejetée",
        _ => statut ?? string.Empty
    };
}

