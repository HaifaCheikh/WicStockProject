@code {
    private ProduitDto produit = new() { Stock = new StockDto() };
    private string? imagePreviewUrl;

    private List<AttributValeurDto> listGenres = new();
    private List<AttributValeurDto> listTailles = new();
    private List<AttributValeurDto> listCouleurs = new();

    private HashSet<string> selectedGenresGen = new();
    private HashSet<string> selectedTaillesGen = new();
    private HashSet<string> selectedCouleursGen = new();
    private int initialStockGen = 10;

    private int NombreCombinaisonsTotal =>
        (selectedGenresGen.Any() ? selectedGenresGen.Count : (selectedTaillesGen.Any() || selectedCouleursGen.Any() ? 1 : 0)) *
        (selectedTaillesGen.Any() ? selectedTaillesGen.Count : (selectedGenresGen.Any() || selectedCouleursGen.Any() ? 1 : 0)) *
        (selectedCouleursGen.Any() ? selectedCouleursGen.Count : (selectedGenresGen.Any() || selectedTaillesGen.Any() ? 1 : 0));

    protected override async Task OnInitializedAsync()
    {
        listGenres = await AttributService.ObtenirAttributsAsync("Genre");
        listTailles = await AttributService.ObtenirAttributsAsync("Taille");
        listCouleurs = await AttributService.ObtenirAttributsAsync("Couleur");
    }

    private void ToggleChip(ICollection<string> set, string value)
    {
        if (set.Contains(value)) set.Remove(value);
        else set.Add(value);
    }

    // Catégories dont les tailles s'expriment en chiffres (bas de corps)
    private static readonly HashSet<string> CategoriesTailleNumerique = new() { "Pants", "Shorts" };

    private bool EstCategorieNumerique(string? categorie) =>
        !string.IsNullOrWhiteSpace(categorie) && CategoriesTailleNumerique.Contains(categorie);

    private bool EstTailleNumerique(string valeur) => int.TryParse(valeur, out _);

    /// <summary>
    /// Tailles pertinentes pour la catégorie sélectionnée : numériques pour les bas
    /// (pantalon, short), lettres pour le reste. "Standard" reste toujours proposé.
    /// Si aucune catégorie n'est encore choisie, toutes les tailles sont affichées.
    /// </summary>
    private List<AttributValeurDto> TaillesFiltrees
    {
        get
        {
            if (string.IsNullOrWhiteSpace(produit.Categorie))
            {
                return listTailles;
            }

            bool numerique = EstCategorieNumerique(produit.Categorie);

            return listTailles
                .Where(t => t.Valeur.Equals("Standard", StringComparison.OrdinalIgnoreCase)
                            || EstTailleNumerique(t.Valeur) == numerique)
                .ToList();
        }
    }

    private void OnCategorieChanged(string val)
    {
        produit.Categorie = val;

        // On retire les tailles déjà cochées qui ne correspondent plus à la nouvelle catégorie
        var taillesValides = TaillesFiltrees.Select(t => t.Valeur).ToHashSet();
        selectedTaillesGen.RemoveWhere(t => !taillesValides.Contains(t));
    }

    private bool AllSelected(ICollection<string> set, List<AttributValeurDto> options)
    {
        return options.Any() && options.All(o => set.Contains(o.Valeur));
    }

    private void ToggleAllChips(ICollection<string> set, List<AttributValeurDto> options)
    {
        if (AllSelected(set, options))
        {
            set.Clear();
        }
        else
        {
            foreach (var o in options)
            {
                set.Add(o.Valeur);
            }
        }
    }

    private void GenererCombinaisonsEnMasse()
    {
        produit.Variantes ??= new();

        var genresList = selectedGenresGen.Any() ? selectedGenresGen.ToList() : new List<string> { "" };
        var taillesList = selectedTaillesGen.Any() ? selectedTaillesGen.ToList() : new List<string> { "" };
        var couleursList = selectedCouleursGen.Any() ? selectedCouleursGen.ToList() : new List<string> { "" };

        foreach (var g in genresList)
        {
            foreach (var t in taillesList)
            {
                foreach (var c in couleursList)
                {
                    var gVal = string.IsNullOrEmpty(g) ? null : g;
                    var tVal = string.IsNullOrEmpty(t) ? null : t;
                    var cVal = string.IsNullOrEmpty(c) ? null : c;

                    var existante = produit.Variantes.FirstOrDefault(v => v.Genre == gVal && v.Taille == tVal && v.Couleur == cVal);
                    if (existante == null)
                    {
                        var v = new VarianteDto
                        {
                            Genre = gVal,
                            Taille = tVal,
                            Couleur = cVal,
                            QuantiteActuelle = initialStockGen
                        };
                        AutoGenSKU(v);
                        produit.Variantes.Add(v);
                    }
                }
            }
        }
    }

    private void OnReferenceChanged(string newRef)
    {
        produit.Reference = newRef;
        if (produit.Variantes != null)
        {
            foreach (var v in produit.Variantes)
            {
                AutoGenSKU(v);
            }
        }
    }

    private void SupprimerVariante(VarianteDto v)
    {
        produit.Variantes?.Remove(v);
    }

    private void AutoGenSKU(VarianteDto v)
    {
        var baseRef = string.IsNullOrWhiteSpace(produit.Reference) ? "PROD" : produit.Reference;
        var genreCode = string.IsNullOrWhiteSpace(v.Genre) ? "U" : v.Genre.Substring(0, 1).ToUpperInvariant();
        var tailleCode = string.IsNullOrWhiteSpace(v.Taille) ? "STD" : v.Taille.Replace(" ", "").ToUpperInvariant();
        var couleurCode = string.IsNullOrWhiteSpace(v.Couleur) ? "DEF" : System.Text.RegularExpressions.Regex.Replace(v.Couleur, @"[^a-zA-Z0-9]", "").ToUpperInvariant();
        v.Reference = $"{baseRef}-{genreCode}-{tailleCode}-{couleurCode}";
    }

    private int CalculerStockTotal()
    {
        if (produit.Variantes != null && produit.Variantes.Any())
        {
            var sum = produit.Variantes.Sum(v => v.QuantiteActuelle);
            if (produit.Stock != null) produit.Stock.QuantiteActuelle = sum;
            return sum;
        }
        return produit.Stock?.QuantiteActuelle ?? 0;
    }

    private void ForceStock(int val)
    {
        if (produit.Stock != null) produit.Stock.QuantiteActuelle = val;
    }

    private (string Label, string CssClass) StockStatus
    {
        get
        {
            var quantite = CalculerStockTotal();

            if (quantite <= 0)
            {
                return produit.DisponibleSurCommande
                    ? ("Sur commande", "stock-pill--amber")
                    : ("Rupture", "stock-pill--rust");
            }

            if (quantite < 10)
            {
                return ("Stock faible", "stock-pill--amber");
            }

            return ("Disponible", "stock-pill--pine");
        }
    }

    private async Task OnFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var format = file.ContentType;
            var resizedImage = await file.RequestImageFileAsync(format, 400, 400);
            var buffer = new byte[resizedImage.Size];
            using (var stream = resizedImage.OpenReadStream(2 * 1024 * 1024))
            {
                await stream.ReadAsync(buffer);
            }

            produit.ImageBase64 = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
            imagePreviewUrl = produit.ImageBase64;
        }
    }

    private void SupprimerImage()
    {
        produit.ImageBase64 = null;
        imagePreviewUrl = null;
    }

    private async Task Enregistrer()
    {
        var succes = await ProduitService.Creer(produit);
        if (succes)
        {
            Navigation.NavigateTo("/produits");
        }
    }
}
