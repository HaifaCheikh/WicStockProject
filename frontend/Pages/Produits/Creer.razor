@page "/produits/creer"
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "RESPONSABLE_STOCK_PRODUCTION,ADMIN")]
@inject ProduitService ProduitService
@inject NavigationManager Navigation

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="produit-form-page">

    <div class="page-head">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" href="/produits" Class="back-btn" Size="Size.Medium" />
        <div>
            <div class="eyebrow">Catalogue &nbsp;/&nbsp; Nouvelle référence</div>
            <MudText Typo="Typo.h4" Class="page-title">Nouveau produit</MudText>
        </div>
        <div class="head-spacer"></div>
        <span class="status-chip status-chip--draft">Brouillon</span>
    </div>

    <div class="layout-grid">

        <!-- Colonne formulaire -->
        <div class="form-column">
            <EditForm Model="@produit" OnValidSubmit="Enregistrer">
                <DataAnnotationsValidator />

                <div class="form-card">

                    <!-- Section : Visuel -->
                    <section class="form-section">
                        <div class="section-label">Visuel</div>

                        <div class="uploader">
                            @if (!string.IsNullOrEmpty(imagePreviewUrl))
                            {
                                <div class="image-preview">
                                    <MudImage Src="@imagePreviewUrl" Width="72" Height="72" Alt="Aperçu" Class="preview-img" />
                                    <button type="button" class="remove-img-btn" @onclick="SupprimerImage" aria-label="Supprimer l'image">
                                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                                    </button>
                                </div>
                            }
                            else
                            {
                                <label for="fileInput" class="upload-placeholder">
                                    <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Size="Size.Medium" />
                                </label>
                            }

                            <div class="uploader-meta">
                                <label for="fileInput" class="upload-btn">
                                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" />
                                    <span>Choisir un fichier</span>
                                </label>
                                <InputFile id="fileInput" OnChange="OnFileChanged" accept=".jpg,.jpeg,.png,.webp" style="display: none;" />
                                <span class="hint-text">JPG, PNG ou WEBP — 2 Mo max.</span>
                            </div>
                        </div>
                    </section>

                    <!-- Section : Identification -->
                    <section class="form-section">
                        <div class="section-label">Identification</div>

                        <MudGrid Spacing="3">
                            <MudItem xs="12">
                                <MudTextField @bind-Value="produit.Reference"
                                              Label="Référence"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              Class="styled-field field-mono"
                                              Placeholder="Ex: TIS-COT-2026" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="produit.Nom"
                                              Label="Nom du produit"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              Class="styled-field"
                                              Placeholder="Ex: Coton Biologique Premium" />
                            </MudItem>
                        </MudGrid>
                    </section>

                    <!-- Section : Classification -->
                    <section class="form-section">
                        <div class="section-label">Classification</div>

                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="produit.TypeTissu"
                                              Label="Type de tissu"
                                              Variant="Variant.Outlined"
                                              Class="styled-field"
                                              Placeholder="Ex: Coton, Lin, Soie" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudSelect @bind-Value="produit.Categorie"
                                           Label="Catégorie"
                                           Variant="Variant.Outlined"
                                           Class="styled-field"
                                           Placeholder="Choisir une catégorie">
                                    <MudSelectItem Value="@("Jacket")">Jacket</MudSelectItem>
                                    <MudSelectItem Value="@("Pants")">Pants</MudSelectItem>
                                    <MudSelectItem Value="@("Set")">Set</MudSelectItem>
                                    <MudSelectItem Value="@("Shirt")">Shirt</MudSelectItem>
                                    <MudSelectItem Value="@("Dress")">Dress</MudSelectItem>
                                    <MudSelectItem Value="@("Coat")">Coat</MudSelectItem>
                                    <MudSelectItem Value="@("Skirt")">Skirt</MudSelectItem>
                                    <MudSelectItem Value="@("Shorts")">Shorts</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="produit.CycleDeVie"
                                              Label="Cycle de vie"
                                              Variant="Variant.Outlined"
                                              Class="styled-field"
                                              Placeholder="Ex: Actif, Obsolète" />
                            </MudItem>
                        </MudGrid>
                    </section>

                    <!-- Section : Stock & tarification -->
                    <section class="form-section">
                        <div class="section-label">Stock &amp; tarification</div>

                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="produit.Stock!.QuantiteActuelle"
                                                 Label="Quantité en stock (articles)"
                                                 Variant="Variant.Outlined"
                                                 Min="0"
                                                 Class="styled-field field-mono"
                                                 Placeholder="Ex: 250" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="produit.PrixUnitaire"
                                                 Label="Prix unitaire de vente (DT)"
                                                 Variant="Variant.Outlined"
                                                 Min="0m"
                                                 Step="0.50m"
                                                 Format="F2"
                                                 Class="styled-field field-mono"
                                                 Placeholder="Ex: 49.90" />
                            </MudItem>
                        </MudGrid>

                        <label class="option-row">
                            <MudCheckBox @bind-Value="produit.DisponibleSurCommande" Color="Color.Primary" Class="option-checkbox" />
                            <span>
                                <span class="option-title">Autoriser les commandes hors stock</span>
                                <span class="option-hint">Les clients pourront commander ce produit même à stock zéro ou insuffisant.</span>
                            </span>
                        </label>
                    </section>

                    <div class="form-actions">
                        <button type="button" class="btn btn--outline" @onclick='() => Navigation.NavigateTo("/produits")'>
                            Annuler
                        </button>
                        <button type="submit" class="btn btn--primary">
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            <span>Enregistrer le produit</span>
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>

        <!-- Colonne aperçu -->
        <div class="preview-column">
            <div class="preview-sticky">
                <div class="preview-label">
                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                    <span>Aperçu en temps réel</span>
                </div>

                <div class="preview-card">
                    <div class="preview-image">
                        @if (!string.IsNullOrEmpty(imagePreviewUrl))
                        {
                            <img src="@imagePreviewUrl" alt="Aperçu du produit" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Checkroom" Size="Size.Large" Class="preview-image-placeholder-icon" />
                        }
                    </div>

                    <div class="preview-body">
                        <div class="preview-ref">@(string.IsNullOrWhiteSpace(produit.Reference) ? "RÉFÉRENCE" : produit.Reference)</div>
                        <div class="preview-name">@(string.IsNullOrWhiteSpace(produit.Nom) ? "Nom du produit" : produit.Nom)</div>

                        <div class="preview-chips">
                            @if (!string.IsNullOrWhiteSpace(produit.Categorie))
                            {
                                <span class="chip chip--denim">@produit.Categorie</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(produit.TypeTissu))
                            {
                                <span class="chip chip--outline">@produit.TypeTissu</span>
                            }
                        </div>

                        <div class="preview-divider"></div>

                        <div class="preview-row">
                            <span class="preview-row-label">Prix</span>
                            <span class="preview-price">@produit.PrixUnitaire.ToString("F2") DT</span>
                        </div>

                        <div class="preview-row">
                            <span class="preview-row-label">Stock</span>
                            <span class="stock-pill @StockStatus.CssClass">@StockStatus.Label</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .produit-form-page {
        --ink: #16233A;
        --ink-muted: #64748B;
        --ink-soft: #94A3B8;
        --paper: #FFFFFF;
        --sand: #F7F9FC;
        --sand-deep: #EEF2F7;
        --border: #E1E7EF;
        --border-soft: #EDF1F6;
        --denim: #2B4C7E;
        --denim-dark: #14263F;
        --denim-tint: #E7EDF6;
        --rust: #A23B2E;
        --rust-tint: #F7E9E6;
        --pine: #2F6F4F;
        --pine-tint: #E6F1EB;
        --amber: #B8862F;
        --amber-tint: #FBF0DE;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --font-display: "Sora", "Inter", sans-serif;
        --font-body: "Inter", sans-serif;
        --font-mono: "JetBrains Mono", monospace;
        font-family: var(--font-body);
        color: var(--ink);
        max-width: 860px;
        margin: 0 auto;
        padding-bottom: 48px;
    }

        /* En-tête */
        .produit-form-page .page-head {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .produit-form-page .head-spacer {
            flex: 1;
        }

        .produit-form-page .back-btn {
            color: var(--ink-muted) !important;
        }

            .produit-form-page .back-btn:hover {
                color: var(--denim) !important;
                background: var(--denim-tint) !important;
            }

        .produit-form-page .eyebrow {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--ink-soft);
            margin-bottom: 2px;
        }

        .produit-form-page .page-title {
            font-family: var(--font-display);
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -0.02em;
        }

        .produit-form-page .status-chip {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            padding: 6px 12px;
            border-radius: 999px;
            white-space: nowrap;
        }

        .produit-form-page .status-chip--draft {
            background: var(--amber-tint);
            color: var(--amber);
        }

        /* Grille de mise en page */
        .produit-form-page .layout-grid {
            display: grid;
            grid-template-columns: 1fr 260px;
            gap: 20px;
            align-items: start;
        }

    @@media (max-width: 900px) {
        .produit-form-page .layout-grid {
            grid-template-columns: 1fr;
        }

        .produit-form-page .preview-column {
            order: -1;
        }
    }

    /* Carte formulaire */
    .produit-form-page .form-card {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: 0 1px 3px rgba(20,38,63,0.06);
        overflow: hidden;
    }

    .produit-form-page .form-section {
        padding: 16px 24px;
    }

        .produit-form-page .form-section + .form-section {
            border-top: 1px solid var(--border-soft);
        }

    .produit-form-page .section-label {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-bottom: 10px;
    }

    .produit-form-page .hint-text {
        color: var(--ink-muted);
        font-size: 0.75rem;
    }

    /* Champs */
    .produit-form-page .styled-field .mud-input-outlined-border {
        border-radius: var(--radius-sm) !important;
        border-color: var(--border) !important;
    }

    .produit-form-page .styled-field .mud-input-outlined.mud-shrink .mud-input-outlined-border,
    .produit-form-page .styled-field:focus-within .mud-input-outlined-border {
        border-color: var(--denim) !important;
    }

    .produit-form-page .styled-field .mud-input-label.mud-input-label-outlined.mud-shrink {
        color: var(--denim) !important;
    }

    .produit-form-page .field-mono input {
        font-family: var(--font-mono);
        font-size: 0.875rem;
    }

    /* Zone image */
    .produit-form-page .uploader {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .produit-form-page .upload-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 72px;
        height: 72px;
        background: var(--sand);
        border: 1.5px dashed var(--border);
        border-radius: var(--radius-lg);
        color: var(--ink-soft);
        cursor: pointer;
        transition: border-color 0.15s ease, color 0.15s ease;
    }

        .produit-form-page .upload-placeholder:hover {
            border-color: var(--denim);
            color: var(--denim);
        }

    .produit-form-page .image-preview {
        position: relative;
    }

    .produit-form-page .preview-img {
        border-radius: var(--radius-lg);
        object-fit: cover;
        border: 1px solid var(--border);
    }

    .produit-form-page .remove-img-btn {
        position: absolute;
        top: -8px;
        right: -8px;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--paper);
        color: var(--rust);
        border: 1px solid var(--border);
        border-radius: 50%;
        cursor: pointer;
        box-shadow: 0 2px 4px rgba(20,38,63,0.15);
    }

        .produit-form-page .remove-img-btn:hover {
            background: var(--rust-tint);
        }

    .produit-form-page .uploader-meta {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .produit-form-page .upload-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 34px;
        padding: 0 14px;
        background: var(--denim);
        color: #fff;
        border-radius: var(--radius-sm);
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.8125rem;
        cursor: pointer;
        width: fit-content;
        transition: background 0.15s ease;
    }

        .produit-form-page .upload-btn:hover {
            background: var(--denim-dark);
        }

    /* Option (checkbox) */
    .produit-form-page .option-row {
        display: flex;
        align-items: flex-start;
        gap: 4px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid var(--border-soft);
        cursor: pointer;
    }

    .produit-form-page .option-checkbox {
        margin-top: -8px;
    }

    .produit-form-page .option-title {
        display: block;
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--ink);
    }

    .produit-form-page .option-hint {
        display: block;
        font-size: 0.8125rem;
        color: var(--ink-muted);
        margin-top: 2px;
    }

    /* Actions */
    .produit-form-page .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 14px 24px;
        background: var(--sand);
        border-top: 1px solid var(--border-soft);
    }

    .produit-form-page .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: var(--radius-sm);
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.875rem;
        cursor: pointer;
        border: none;
        transition: all 0.15s ease;
    }

        .produit-form-page .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .produit-form-page .btn--primary {
        background: var(--denim);
        color: #fff;
        box-shadow: 0 6px 16px -6px rgba(43,76,126,0.4);
    }

        .produit-form-page .btn--primary:hover:not(:disabled) {
            background: var(--denim-dark);
        }

    .produit-form-page .btn--outline {
        background: transparent;
        color: var(--ink-muted);
        border: 1px solid var(--border);
    }

        .produit-form-page .btn--outline:hover {
            border-color: var(--denim);
            color: var(--denim);
        }

    /* Colonne aperçu */
    .produit-form-page .preview-sticky {
        position: sticky;
        top: 24px;
    }

    .produit-form-page .preview-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--ink-soft);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 12px;
    }

    .produit-form-page .preview-card {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(20,38,63,0.06);
    }

    .produit-form-page .preview-image {
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1.4 / 1;
        background: var(--sand-deep);
        color: var(--ink-soft);
    }

        .produit-form-page .preview-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .produit-form-page .preview-body {
        padding: 16px;
    }

    .produit-form-page .preview-ref {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--ink-soft);
    }

    .produit-form-page .preview-name {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.125rem;
        color: var(--ink);
        margin-top: 2px;
        line-height: 1.3;
    }

    .produit-form-page .preview-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 12px;
    }

    .produit-form-page .chip {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 999px;
    }

    .produit-form-page .chip--denim {
        background: var(--denim-tint);
        color: var(--denim);
    }

    .produit-form-page .chip--outline {
        background: transparent;
        color: var(--ink-muted);
        border: 1px solid var(--border);
    }

    .produit-form-page .preview-divider {
        height: 1px;
        background: var(--border-soft);
        margin: 16px 0;
    }

    .produit-form-page .preview-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

        .produit-form-page .preview-row:last-child {
            margin-bottom: 0;
        }

    .produit-form-page .preview-row-label {
        font-size: 0.8125rem;
        color: var(--ink-muted);
    }

    .produit-form-page .preview-price {
        font-family: var(--font-mono);
        font-weight: 600;
        font-size: 0.9375rem;
        color: var(--ink);
    }

    .produit-form-page .stock-pill {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 999px;
    }

    .produit-form-page .stock-pill--pine {
        background: var(--pine-tint);
        color: var(--pine);
    }

    .produit-form-page .stock-pill--amber {
        background: var(--amber-tint);
        color: var(--amber);
    }

    .produit-form-page .stock-pill--rust {
        background: var(--rust-tint);
        color: var(--rust);
    }
</style>

@code {
    private ProduitDto produit = new() { Stock = new StockDto() };
    private string? imagePreviewUrl;

    private (string Label, string CssClass) StockStatus
    {
        get
        {
            var quantite = produit.Stock?.QuantiteActuelle ?? 0;

            if (quantite <= 0)
            {
                return produit.DisponibleSurCommande
                    ? ("Sur commande", "stock-pill--amber")
                    : ("Rupture", "stock-pill--rust");
            }

            if (quantite < 10)
            {
                return ("Stock faible", "stock-pill--amber");
            }

            return ("Disponible", "stock-pill--pine");
        }
    }

    private async Task OnFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var format = file.ContentType;
            // Redimensionne à max 400x400 pour garder le payload base64 léger
            var resizedImage = await file.RequestImageFileAsync(format, 400, 400);
            var buffer = new byte[resizedImage.Size];
            using (var stream = resizedImage.OpenReadStream(2 * 1024 * 1024))
            {
                await stream.ReadAsync(buffer);
            }

            produit.ImageBase64 = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
            imagePreviewUrl = produit.ImageBase64;
        }
    }

    private void SupprimerImage()
    {
        produit.ImageBase64 = null;
        imagePreviewUrl = null;
    }

    private async Task Enregistrer()
    {
        var succes = await ProduitService.Creer(produit);
        if (succes)
        {
            Navigation.NavigateTo("/produits");
        }
    }
}
