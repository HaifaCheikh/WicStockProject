@page "/produits/creer"
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "RESPONSABLE_STOCK_PRODUCTION,ADMIN")]
@inject ProduitService ProduitService
@inject AttributService AttributService
@inject NavigationManager Navigation

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="produit-form-page">

    <div class="page-head">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" href="/produits" Class="back-btn" Size="Size.Medium" />
        <div>
            <div class="eyebrow">Catalogue &nbsp;/&nbsp; Nouvelle référence</div>
            <MudText Typo="Typo.h4" Class="page-title">Nouveau produit</MudText>
        </div>
        <div class="head-spacer"></div>
        <span class="status-chip status-chip--draft">Brouillon</span>
    </div>

    <div class="layout-grid">

        <!-- Colonne formulaire -->
        <div class="form-column">
            <EditForm Model="@produit" OnValidSubmit="Enregistrer">
                <DataAnnotationsValidator />

                <div class="form-card">

                    <!-- Section : Visuel -->
                    <section class="form-section">
                        <div class="section-label">Visuel</div>

                        <div class="uploader">
                            @if (!string.IsNullOrEmpty(imagePreviewUrl))
                            {
                                <div class="image-preview">
                                    <MudImage Src="@imagePreviewUrl" Width="72" Height="72" Alt="Aperçu" Class="preview-img" />
                                    <button type="button" class="remove-img-btn" @onclick="SupprimerImage" aria-label="Supprimer l'image">
                                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                                    </button>
                                </div>
                            }
                            else
                            {
                                <label for="fileInput" class="upload-placeholder">
                                    <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Size="Size.Medium" />
                                </label>
                            }

                            <div class="uploader-meta">
                                <label for="fileInput" class="upload-btn">
                                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" />
                                    <span>Choisir un fichier</span>
                                </label>
                                <InputFile id="fileInput" OnChange="OnFileChanged" accept=".jpg,.jpeg,.png,.webp" style="display: none;" />
                                <span class="hint-text">JPG, PNG ou WEBP — 2 Mo max.</span>
                            </div>
                        </div>
                    </section>

                    <!-- Section : Identification -->
                    <section class="form-section">
                        <div class="section-label">Identification</div>

                        <MudGrid Spacing="3">
                            <MudItem xs="12">
                                <MudTextField Value="@produit.Reference"
                                              ValueChanged="@((string val) => OnReferenceChanged(val))"
                                              Label="Référence produit"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              Class="styled-field field-mono"
                                              Placeholder="Ex: TIS-DNM-01" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="produit.Nom"
                                              Label="Nom du produit"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              Class="styled-field"
                                              Placeholder="Ex: Coton Biologique Premium" />
                            </MudItem>
                        </MudGrid>
                    </section>

                    <!-- Section : Classification -->
                    <section class="form-section">
                        <div class="section-label">Classification</div>

                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="produit.TypeTissu"
                                              Label="Type de tissu"
                                              Variant="Variant.Outlined"
                                              Class="styled-field"
                                              Placeholder="Ex: Coton, Lin, Soie" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudSelect Value="@produit.Categorie"
                                           ValueChanged="@((string val) => OnCategorieChanged(val))"
                                           Label="Catégorie"
                                           Variant="Variant.Outlined"
                                           Class="styled-field"
                                           Placeholder="Choisir une catégorie">
                                    <MudSelectItem Value="@("Jacket")">Jacket</MudSelectItem>
                                    <MudSelectItem Value="@("Pants")">Pants</MudSelectItem>
                                    <MudSelectItem Value="@("Set")">Set</MudSelectItem>
                                    <MudSelectItem Value="@("Shirt")">Shirt</MudSelectItem>
                                    <MudSelectItem Value="@("Dress")">Dress</MudSelectItem>
                                    <MudSelectItem Value="@("Coat")">Coat</MudSelectItem>
                                    <MudSelectItem Value="@("Skirt")">Skirt</MudSelectItem>
                                    <MudSelectItem Value="@("Shorts")">Shorts</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="produit.CycleDeVie"
                                              Label="Cycle de vie"
                                              Variant="Variant.Outlined"
                                              Class="styled-field"
                                              Placeholder="Ex: Actif, Obsolète" />
                            </MudItem>
                        </MudGrid>
                    </section>

                    <!-- Section : Attributs & Variantes -->
                    <section class="form-section">
                        <div class="section-label mb-0">Variantes du produit</div>
                        <span class="hint-text">Sélectionnez les genres, tailles et couleurs disponibles — le prix reste celui défini ci-dessous pour toutes les déclinaisons.</span>

                        <div class="builder-card">
                            <div class="builder-grid">
                                <details class="attr-group">
                                    <summary class="attr-summary">
                                        <span class="attr-group-label">Genre</span>
                                        <span class="attr-summary-value">
                                            @(selectedGenresGen.Any() ? $"{selectedGenresGen.Count} sélectionné(s)" : "Aucune sélection")
                                        </span>
                                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="attr-caret" />
                                    </summary>
                                    <div class="attr-panel">
                                        <button type="button" class="attr-group-toggle" @onclick="() => ToggleAllChips(selectedGenresGen, listGenres)">
                                            @(AllSelected(selectedGenresGen, listGenres) ? "Tout désélectionner" : "Tout sélectionner")
                                        </button>
                                        <div class="chip-list">
                                            @foreach (var g in listGenres)
                                            {
                                                <button type="button"
                                                        class="attr-chip @(selectedGenresGen.Contains(g.Valeur) ? "attr-chip--active" : "")"
                                                        @onclick="() => ToggleChip(selectedGenresGen, g.Valeur)">
                                                    @g.Valeur
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </details>

                                <details class="attr-group">
                                    <summary class="attr-summary">
                                        <span class="attr-group-label">Taille</span>
                                        <span class="attr-summary-value">
                                            @(selectedTaillesGen.Any() ? $"{selectedTaillesGen.Count} sélectionné(s)" : "Aucune sélection")
                                        </span>
                                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="attr-caret" />
                                    </summary>
                                    <div class="attr-panel">
                                        @if (!string.IsNullOrWhiteSpace(produit.Categorie))
                                        {
                                            <div class="attr-filter-note">
                                                Tailles @(EstCategorieNumerique(produit.Categorie) ? "numériques" : "lettres") proposées pour "@produit.Categorie"
                                            </div>
                                        }
                                        <button type="button" class="attr-group-toggle" @onclick="() => ToggleAllChips(selectedTaillesGen, TaillesFiltrees)">
                                            @(AllSelected(selectedTaillesGen, TaillesFiltrees) ? "Tout désélectionner" : "Tout sélectionner")
                                        </button>
                                        <div class="chip-list">
                                            @foreach (var t in TaillesFiltrees)
                                            {
                                                <button type="button"
                                                        class="attr-chip @(selectedTaillesGen.Contains(t.Valeur) ? "attr-chip--active" : "")"
                                                        @onclick="() => ToggleChip(selectedTaillesGen, t.Valeur)">
                                                    @t.Valeur
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </details>

                                <details class="attr-group">
                                    <summary class="attr-summary">
                                        <span class="attr-group-label">Couleur</span>
                                        <span class="attr-summary-value attr-summary-swatches">
                                            @if (selectedCouleursGen.Any())
                                            {
                                                @foreach (var val in selectedCouleursGen.Take(5))
                                                {
                                                    var hex = listCouleurs.FirstOrDefault(c => c.Valeur == val)?.CodeHex;
                                                    <span class="swatch-sm" style="background-color:@(hex ?? "#ccc")"></span>
                                                }
                                                @if (selectedCouleursGen.Count > 5)
                                                {
                                                    <span class="tag-more">+@(selectedCouleursGen.Count - 5)</span>
                                                }
                                            }
                                            else
                                            {
                                                <span>Aucune sélection</span>
                                            }
                                        </span>
                                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="attr-caret" />
                                    </summary>
                                    <div class="attr-panel">
                                        <button type="button" class="attr-group-toggle" @onclick="() => ToggleAllChips(selectedCouleursGen, listCouleurs)">
                                            @(AllSelected(selectedCouleursGen, listCouleurs) ? "Tout désélectionner" : "Tout sélectionner")
                                        </button>
                                        <div class="chip-list">
                                            @foreach (var c in listCouleurs)
                                            {
                                                <button type="button"
                                                        class="attr-chip attr-chip--color @(selectedCouleursGen.Contains(c.Valeur) ? "attr-chip--active" : "")"
                                                        @onclick="() => ToggleChip(selectedCouleursGen, c.Valeur)">
                                                    <span class="swatch" style="background-color:@(!string.IsNullOrEmpty(c.CodeHex) ? c.CodeHex : "#ccc")"></span>
                                                    @c.Valeur
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </details>
                            </div>

                            <div class="builder-footer">
                                <div class="builder-summary">
                                    <span class="builder-count">@NombreCombinaisonsTotal</span>
                                    <span>déclinaison(s) seront créées</span>
                                </div>

                                <div class="stock-input">
                                    <label>Stock initial</label>
                                    <input type="number" class="stock-input-field" @bind="initialStockGen" min="0" />
                                </div>

                                <button type="button" class="btn btn--primary btn--sm"
                                        @onclick="GenererCombinaisonsEnMasse"
                                        disabled="@(NombreCombinaisonsTotal == 0)">
                                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                    <span>Générer les variantes</span>
                                </button>
                            </div>
                        </div>

                        @if (produit.Variantes == null || !produit.Variantes.Any())
                        {
                            <div class="empty-state">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Class="empty-state-icon" />
                                <div class="empty-state-title">Aucune variante configurée</div>
                                <div class="empty-state-hint">
                                    Sélectionnez au moins un genre, une taille ou une couleur ci-dessus, puis cliquez sur <strong>"Générer les variantes"</strong>.
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="variant-table-wrap">
                                <table class="variant-table">
                                    <thead>
                                        <tr>
                                            <th>Genre</th>
                                            <th>Taille</th>
                                            <th>Couleur</th>
                                            <th>SKU (auto)</th>
                                            <th class="col-narrow">Stock</th>
                                            <th class="col-icon"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in produit.Variantes)
                                        {
                                            var hex = listCouleurs.FirstOrDefault(c => c.Valeur == v.Couleur)?.CodeHex;
                                            <tr>
                                                <td>
                                                    <select class="variant-select" @bind="v.Genre" @bind:after="() => AutoGenSKU(v)">
                                                        <option value="">—</option>
                                                        @foreach (var g in listGenres)
                                                        {
                                                            <option value="@g.Valeur">@g.Valeur</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <select class="variant-select" @bind="v.Taille" @bind:after="() => AutoGenSKU(v)">
                                                        <option value="">—</option>
                                                        @foreach (var t in listTailles)
                                                        {
                                                            <option value="@t.Valeur">@t.Valeur</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <div class="variant-color-cell">
                                                        @if (!string.IsNullOrEmpty(hex))
                                                        {
                                                            <span class="swatch-sm" style="background-color:@hex"></span>
                                                        }
                                                        <select class="variant-select" @bind="v.Couleur" @bind:after="() => AutoGenSKU(v)">
                                                            <option value="">—</option>
                                                            @foreach (var c in listCouleurs)
                                                            {
                                                                <option value="@c.Valeur">@c.Valeur</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </td>
                                                <td>
                                                    <input type="text" class="variant-sku" @bind="v.Reference" title="SKU généré automatiquement" />
                                                </td>
                                                <td>
                                                    <input type="number" class="variant-stock" @bind="v.QuantiteActuelle" min="0" />
                                                </td>
                                                <td class="col-icon">
                                                    <button type="button" class="variant-delete-btn" @onclick="() => SupprimerVariante(v)" aria-label="Supprimer la variante">
                                                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    <!-- Section : Stock & tarification -->
                    <section class="form-section">
                        <div class="section-label">Stock &amp; tarification globale</div>

                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudNumericField Value="@CalculerStockTotal()"
                                                 ValueChanged="@((int val) => ForceStock(val))"
                                                 Label="Quantité totale en stock (calculée)"
                                                 Variant="Variant.Outlined"
                                                 Min="0"
                                                 ReadOnly="@(produit.Variantes != null && produit.Variantes.Any())"
                                                 Class="styled-field field-mono"
                                                 Placeholder="Ex: 250" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="produit.PrixUnitaire"
                                                 Label="Prix unitaire de base (DT)"
                                                 Variant="Variant.Outlined"
                                                 Min="0m"
                                                 Step="0.50m"
                                                 Format="F2"
                                                 Class="styled-field field-mono"
                                                 Placeholder="Ex: 49.90" />
                            </MudItem>
                        </MudGrid>

                        <label class="option-row">
                            <MudCheckBox @bind-Value="produit.DisponibleSurCommande" Color="Color.Primary" Class="option-checkbox" />
                            <span>
                                <span class="option-title">Autoriser les commandes hors stock</span>
                                <span class="option-hint">Les clients pourront commander ce produit même si la variante est à stock zéro.</span>
                            </span>
                        </label>
                    </section>

                    <div class="form-actions">
                        <button type="button" class="btn btn--outline" @onclick='() => Navigation.NavigateTo("/produits")'>
                            Annuler
                        </button>
                        <button type="submit" class="btn btn--primary">
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            <span>Enregistrer le produit</span>
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>

        <!-- Colonne aperçu -->
        <div class="preview-column">
            <div class="preview-sticky">
                <div class="preview-label">
                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                    <span>Aperçu en temps réel</span>
                </div>

                <div class="preview-card">
                    <div class="preview-image">
                        @if (!string.IsNullOrEmpty(imagePreviewUrl))
                        {
                            <img src="@imagePreviewUrl" alt="Aperçu du produit" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Checkroom" Size="Size.Large" Class="preview-image-placeholder-icon" />
                        }
                    </div>

                    <div class="preview-body">
                        <div class="preview-ref">@(string.IsNullOrWhiteSpace(produit.Reference) ? "RÉFÉRENCE" : produit.Reference)</div>
                        <div class="preview-name">@(string.IsNullOrWhiteSpace(produit.Nom) ? "Nom du produit" : produit.Nom)</div>

                        <div class="preview-chips">
                            @if (!string.IsNullOrWhiteSpace(produit.Categorie))
                            {
                                <span class="chip chip--denim">@produit.Categorie</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(produit.TypeTissu))
                            {
                                <span class="chip chip--outline">@produit.TypeTissu</span>
                            }
                        </div>

                        <div class="preview-divider"></div>

                        <div class="preview-row">
                            <span class="preview-row-label">Prix</span>
                            <span class="preview-price">@produit.PrixUnitaire.ToString("F2") DT</span>
                        </div>

                        <div class="preview-row">
                            <span class="preview-row-label">Stock</span>
                            <span class="stock-pill @StockStatus.CssClass">@StockStatus.Label</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .produit-form-page {
        --ink: #16233A;
        --ink-muted: #64748B;
        --ink-soft: #94A3B8;
        --paper: #FFFFFF;
        --sand: #F7F9FC;
        --sand-deep: #EEF2F7;
        --border: #E1E7EF;
        --border-soft: #EDF1F6;
        --denim: #2B4C7E;
        --denim-dark: #14263F;
        --denim-tint: #E7EDF6;
        --rust: #A23B2E;
        --rust-tint: #F7E9E6;
        --pine: #2F6F4F;
        --pine-tint: #E6F1EB;
        --amber: #B8862F;
        --amber-tint: #FBF0DE;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --font-display: "Sora", "Inter", sans-serif;
        --font-body: "Inter", sans-serif;
        --font-mono: "JetBrains Mono", monospace;
        font-family: var(--font-body);
        color: var(--ink);
        max-width: 860px;
        margin: 0 auto;
        padding-bottom: 48px;
    }

    /* En-tête */
    .produit-form-page .page-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .produit-form-page .head-spacer { flex: 1; }

    .produit-form-page .back-btn { color: var(--ink-muted) !important; }
    .produit-form-page .back-btn:hover { color: var(--denim) !important; background: var(--denim-tint) !important; }

    .produit-form-page .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-bottom: 2px;
    }

    .produit-form-page .page-title {
        font-family: var(--font-display);
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -0.02em;
    }

    .produit-form-page .status-chip {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        padding: 6px 12px;
        border-radius: 999px;
        white-space: nowrap;
    }

    .produit-form-page .status-chip--draft { background: var(--amber-tint); color: var(--amber); }

    /* Grille de mise en page */
    .produit-form-page .layout-grid {
        display: grid;
        grid-template-columns: 1fr 260px;
        gap: 20px;
        align-items: start;
    }

    @@media (max-width: 900px) {
        .produit-form-page .layout-grid { grid-template-columns: 1fr; }
        .produit-form-page .preview-column { order: -1; }
    }

    /* Carte formulaire */
    .produit-form-page .form-card {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: 0 1px 3px rgba(20,38,63,0.06);
        overflow: hidden;
    }

    .produit-form-page .form-section { padding: 16px 24px; }
    .produit-form-page .form-section + .form-section { border-top: 1px solid var(--border-soft); }

    .produit-form-page .section-label {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-bottom: 10px;
    }

    .produit-form-page .hint-text { color: var(--ink-muted); font-size: 0.75rem; }

    .produit-form-page .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .produit-form-page .section-actions { display: flex; gap: 8px; flex-shrink: 0; }

    /* Champs MudBlazor */
    .produit-form-page .styled-field .mud-input-outlined-border {
        border-radius: var(--radius-sm) !important;
        border-color: var(--border) !important;
    }

    .produit-form-page .styled-field .mud-input-outlined.mud-shrink .mud-input-outlined-border,
    .produit-form-page .styled-field:focus-within .mud-input-outlined-border {
        border-color: var(--denim) !important;
    }

    .produit-form-page .styled-field .mud-input-label.mud-input-label-outlined.mud-shrink { color: var(--denim) !important; }

    .produit-form-page .field-mono input { font-family: var(--font-mono); font-size: 0.875rem; }

    /* Zone image */
    .produit-form-page .uploader { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }

    .produit-form-page .upload-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 72px;
        height: 72px;
        background: var(--sand);
        border: 1.5px dashed var(--border);
        border-radius: var(--radius-lg);
        color: var(--ink-soft);
        cursor: pointer;
        transition: border-color 0.15s ease, color 0.15s ease;
    }

    .produit-form-page .upload-placeholder:hover { border-color: var(--denim); color: var(--denim); }

    .produit-form-page .image-preview { position: relative; }

    .produit-form-page .preview-img {
        border-radius: var(--radius-lg);
        object-fit: cover;
        border: 1px solid var(--border);
    }

    .produit-form-page .remove-img-btn {
        position: absolute;
        top: -8px;
        right: -8px;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--paper);
        color: var(--rust);
        border: 1px solid var(--border);
        border-radius: 50%;
        cursor: pointer;
        box-shadow: 0 2px 4px rgba(20,38,63,0.15);
    }

    .produit-form-page .remove-img-btn:hover { background: var(--rust-tint); }

    .produit-form-page .uploader-meta { display: flex; flex-direction: column; gap: 6px; }

    .produit-form-page .upload-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 34px;
        padding: 0 14px;
        background: var(--denim);
        color: #fff;
