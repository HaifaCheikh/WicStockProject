@page "/produits"
@using System.Text.RegularExpressions
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "RESPONSABLE_STOCK_PRODUCTION,ADMIN")]
@inject ProduitService ProduitService
@inject CatalogueService CatalogueService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject AuthService AuthService

<PageTitle>Catalogue Produits | WicStock Admin</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="admin-page">
    <!-- En-tête -->
    <div class="admin-hero">
        <div class="hero-text">
            <h1 class="page-title">Catalogue des produits</h1>
            <p class="page-subtitle">Gérez vos références et consultez les recommandations d'analyse IA en temps réel.</p>
        </div>
        <div class="hero-actions">
            <AuthorizeView Roles="RESPONSABLE_STOCK_PRODUCTION,ADMIN">
                <Authorized>
                    <button class="btn btn--outline" @onclick='() => Navigation.NavigateTo("/commandes")'>
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" />
                        <span>Commandes clients</span>
                        @if (NombreCommandesEnAttente > 0)
                        {
                            <span class="order-notif-badge">@NombreCommandesEnAttente</span>
                        }
                    </button>
                    <button class="btn btn--primary" @onclick="AllerVersCreation">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        <span>Nouveau produit</span>
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @if (produits != null && produits.Any())
    {
        <!-- STATISTIQUES (cliquables pour filtrer par état de stock) — onglets texte, sans cadre -->
        <div class="stats-tabs mb-5">
            <button type="button" class="stat-tab @(statutIaFilter == "" ? "stat-tab--active" : "")" @onclick='() => SelectStatutIA("")'>
                <span class="stat-tab-label">Tous</span>
                <span class="stat-tab-count">@produits.Count(p => !p.EstArchive)</span>
            </button>
            <button type="button" class="stat-tab stat-tab--rust @(statutIaFilter == "RUPTURE" ? "stat-tab--active" : "")" @onclick='() => SelectStatutIA("RUPTURE")'>
                <span class="stat-dot"></span>
                <span class="stat-tab-label">Rupture</span>
                <span class="stat-tab-count">@produits.Count(p => !p.EstArchive && IsStatutIA(p, "RUPTURE"))</span>
            </button>
            <button type="button" class="stat-tab stat-tab--topaz @(statutIaFilter == "STOCK_FAIBLE" ? "stat-tab--active" : "")" @onclick='() => SelectStatutIA("STOCK_FAIBLE")'>
                <span class="stat-dot"></span>
                <span class="stat-tab-label">Stock faible</span>
                <span class="stat-tab-count">@produits.Count(p => !p.EstArchive && IsStatutIA(p, "STOCK_FAIBLE"))</span>
            </button>
            <button type="button" class="stat-tab stat-tab--amber @(statutIaFilter == "SURSTOCK" ? "stat-tab--active" : "")" @onclick='() => SelectStatutIA("SURSTOCK")'>
                <span class="stat-dot"></span>
                <span class="stat-tab-label">Surstock</span>
                <span class="stat-tab-count">@produits.Count(p => !p.EstArchive && IsStatutIA(p, "SURSTOCK"))</span>
            </button>
            <button type="button" class="stat-tab stat-tab--pine @(statutIaFilter == "OPTIMAL" ? "stat-tab--active" : "")" @onclick='() => SelectStatutIA("OPTIMAL")'>
                <span class="stat-dot"></span>
                <span class="stat-tab-label">Normal</span>
                <span class="stat-tab-count">@produits.Count(p => !p.EstArchive && IsStatutIA(p, "OPTIMAL"))</span>
            </button>
            <button type="button" class="stat-tab stat-tab--denim @(statutIaFilter == "SUR_COMMANDE" ? "stat-tab--active" : "")" @onclick='() => SelectStatutIA("SUR_COMMANDE")'>
                <span class="stat-dot"></span>
                <span class="stat-tab-label">Sur commande</span>
                <span class="stat-tab-count">@produits.Count(p => !p.EstArchive && IsStatutIA(p, "SUR_COMMANDE"))</span>
            </button>
        </div>

        <!-- FILTRES -->
        <div class="filters-card mb-6">
            <div class="filters-row">
                <div class="search-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="search-icon" />
                    <input class="search-input" placeholder="Rechercher par référence, nom, type..." @bind="searchString" @bind:event="oninput" />
                </div>

                <select class="filter-select" @bind="categoryFilter">
                    <option value="">Toutes les catégories</option>
                    @foreach (var cat in CategoriesDisponibles)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>

                <select class="filter-select" @bind="sortBy">
                    <option value="STATUT_IA">Trier : Priorité</option>
                    <option value="NOM">Trier : Nom (A-Z)</option>
                    <option value="STOCK_ASC">Trier : Stock ↑</option>
                    <option value="STOCK_DESC">Trier : Stock ↓</option>
                </select>

                <div class="view-toggle">
                    <button class="view-toggle-btn @(isGridView ? "active" : "")" @onclick="() => isGridView = true" aria-label="Vue grille" title="Vue grille">
                        <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                    </button>
                    <button class="view-toggle-btn @(!isGridView ? "active" : "")" @onclick="() => isGridView = false" aria-label="Vue tableau" title="Vue tableau">
                        <MudIcon Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small" />
                    </button>
                </div>
            </div>

            <div class="filters-footer">
                <label class="archive-toggle">
                    <input type="checkbox" @bind="afficherArchives" />
                    <span>Afficher les archivés (@produits.Count(p => p.EstArchive))</span>
                </label>
                <span class="filter-count">@FilteredProduits.Count() article(s)</span>
            </div>
        </div>
    }

    <!-- Contenu des produits -->
    @if (produits == null)
    {
        <div class="produits-grid">
            @for (int i = 0; i < 8; i++)
            {
                <div class="skeleton-card">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="176px" Class="skeleton-image" />
                    <div class="pa-4">
                        <MudSkeleton Width="70%" Height="20px" Class="mb-2" />
                        <MudSkeleton Width="45%" Height="16px" />
                    </div>
                </div>
            }
        </div>
    }
    else if (!produits.Any())
    {
        <div class="empty-card">
            <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Large" Class="empty-icon" />
            <h3 class="empty-title">Aucun produit enregistré</h3>
            <p class="empty-subtitle">Les produits que vous créez apparaîtront ici.</p>
        </div>
    }
    else if (!FilteredProduits.Any())
    {
        <div class="empty-card">
            <MudIcon Icon="@Icons.Material.Filled.FilterAltOff" Size="Size.Large" Class="empty-icon" />
            <h3 class="empty-title">Aucun produit ne correspond à ce filtre</h3>
            <p class="empty-subtitle">Essayez de réinitialiser la recherche ou de changer les critères de filtrage.</p>
        </div>
    }
    else if (isGridView)
    {
        <div class="produits-grid">
            @foreach (var prod in FilteredProduits)
            {
                <div class="produit-card @(prod.EstArchive ? "produit-card--archive" : "") @(IsHighlighted(prod) ? "produit-card--highlighted" : "")">
                    <div class="product-image">
                        @if (!string.IsNullOrEmpty(prod.ImageUrl))
                        {
                            <img src="@GetFullImageUrl(prod.ImageUrl)"
                                 alt="@prod.Nom"
                                 class="card-img"
                                 title="Cliquer pour agrandir"
                                 @onclick:stopPropagation="true"
                                 @onclick="() => OuvrirImageAgrandie(GetFullImageUrl(prod.ImageUrl), prod.Nom)" />
                        }
                        else
                        {
                            <div class="d-flex flex-column align-center justify-center h-100">
                                <MudIcon Icon="@Icons.Material.Filled.Layers" Style="font-size: 2.75rem; opacity: 0.3;" />
                                <span class="no-image-label">Aucune image</span>
                            </div>
                        }
                        <span class="ref-code ref-code--overlay">@prod.Reference</span>
                        <div class="badge-ia-overlay">
                            @if (prod.EstArchive)
                            {
                                <span class="ia-badge ia-badge--archive">Archivé</span>
                            }
                            else
                            {
                                <BadgeAnalyseIA StatutType="@prod.StatutIAType"
                                                BadgeText="@prod.StatutIABadgeText"
                                                OnClickSurstock="() => OuvrirAnalyseIa(prod)" />
                            }
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="d-flex align-center justify-space-between gap-2">
                            <strong class="product-title">@prod.Nom</strong>
                            <span class="product-price">@prod.PrixUnitaire.ToString("0.00") DT</span>
                        </div>

                        <div class="d-flex align-center gap-1 mt-1">
                            <MudIcon Icon="@Icons.Material.Filled.Texture" Size="Size.Small" Class="text-muted" />
                            <span class="product-detail">@(string.IsNullOrEmpty(prod.TypeTissu) ? "Non spécifié" : prod.TypeTissu)</span>
                        </div>

                        <div class="meta-footer mt-3">
                            <div class="d-flex align-center gap-2 flex-wrap">
                                @if (!string.IsNullOrEmpty(prod.Categorie))
                                {
                                    <span class="table-cat-tag" style="background:@GetCategoryColor(prod.Categorie)">@prod.Categorie</span>
                                }
                                <span class="stock-qty-badge @((prod.Stock?.QuantiteActuelle ?? 0) > 0 ? "stock-qty-ok" : "stock-qty-zero")">
                                    Stock : @(prod.Stock?.QuantiteActuelle ?? 0)
                                </span>
                            </div>

                            <AuthorizeView Roles="RESPONSABLE_STOCK_PRODUCTION,ADMIN" Context="authContext">
                                <Authorized>
                                    <div class="d-flex align-center gap-1 card-actions" @onclick:stopPropagation="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       Class="action-btn"
                                                       href="@($"/produits/modifier/{prod.Id}")" />
                                        @if (!prod.EstArchive)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Archive"
                                                           Size="Size.Small"
                                                           Class="action-btn"
                                                           Title="Archiver"
                                                           OnClick="() => DemanderArchivage(prod)" />
                                        }
                                        else
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Unarchive"
                                                           Size="Size.Small"
                                                           Class="action-btn"
                                                           Title="Désarchiver"
                                                           OnClick="() => DesarchiverProduit(prod)" />
                                        }
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Class="action-btn action-btn--danger"
                                                       OnClick="() => DemanderSuppression(prod)" />
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                        </div>

                        @if (!prod.EstArchive && !string.IsNullOrEmpty(prod.StatutIAActionTexte))
                        {
                            <button type="button"
                                    class="ia-action-line mt-2"
                                    title="@prod.StatutIAActionTexte"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => OuvrirAnalyseIa(prod)">
                                <span class="ia-action-kicker">IA</span>
                                <span class="ia-action-text">@GetActionCourte(prod.StatutIAActionTexte)</span>
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="ia-action-chevron" />
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="table-panel">
            <MudTable Items="@FilteredProduits" Hover="true" Elevation="0" Class="products-table" RowClassFunc="@((p, i) => IsHighlighted(p) ? "row--highlighted" : "")">
                <HeaderContent>
                    <MudTh Style="width: 64px;">Image</MudTh>
                    <MudTh>Référence</MudTh>
                    <MudTh>Nom</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Catégorie</MudTh>
                    <MudTh>Stock disponible</MudTh>
                    <MudTh>État de stock</MudTh>
                    <MudTh>Cycle de vie</MudTh>
                    <AuthorizeView Roles="RESPONSABLE_STOCK_PRODUCTION,ADMIN">
                        <Authorized>
                            <MudTh Style="text-align: right;">Actions</MudTh>
                        </Authorized>
                    </AuthorizeView>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Image">
                        @if (!string.IsNullOrEmpty(context.ImageUrl))
                        {
                            <div class="table-thumb-clickable"
                                 title="Cliquer pour agrandir"
                                 @onclick="() => OuvrirImageAgrandie(GetFullImageUrl(context.ImageUrl), context.Nom)">
                                <MudImage Src="@GetFullImageUrl(context.ImageUrl)" Width="40" Height="40" Alt="@context.Nom" Class="table-thumb" />
                            </div>
                        }
                        else
                        {
                            <div class="table-thumb table-thumb--empty">
                                <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Small" Style="opacity:0.4;" />
                            </div>
                        }
                    </MudTd>
                    <MudTd DataLabel="Référence">
                        <span class="ref-code">@context.Reference</span>
                    </MudTd>
                    <MudTd DataLabel="Nom" Class="cell-name">@context.Nom</MudTd>
                    <MudTd DataLabel="Type">@context.TypeTissu</MudTd>
                    <MudTd DataLabel="Catégorie">
                        <span class="table-cat-tag" style="background:@GetCategoryColor(context.Categorie)">@context.Categorie</span>
                    </MudTd>
                    <MudTd DataLabel="Stock disponible">
                        <span class="stock-qty-badge @((context.Stock?.QuantiteActuelle ?? 0) > 0 ? "stock-qty-ok" : "stock-qty-zero")">
                            @(context.Stock?.QuantiteActuelle ?? 0)
                        </span>
                    </MudTd>
                    <MudTd DataLabel="État de stock">
                        @if (context.EstArchive)
                        {
                            <span class="ia-badge ia-badge--archive">Archivé</span>
                        }
                        else
                        {
                            <BadgeAnalyseIA StatutType="@context.StatutIAType"
                                            BadgeText="@context.StatutIABadgeText"
                                            OnClickSurstock="() => OuvrirAnalyseIa(context)" />
                        }
                    </MudTd>
                    <MudTd DataLabel="Cycle de vie">@context.CycleDeVie</MudTd>
                    <AuthorizeView Roles="RESPONSABLE_STOCK_PRODUCTION,ADMIN" Context="authContext">
                        <Authorized>
                            <MudTd Style="text-align: right;">
                                <div class="d-flex justify-end gap-1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="action-btn" href="@($"/produits/modifier/{context.Id}")" />
                                    @if (!context.EstArchive)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Archive" Size="Size.Small" Class="action-btn" Title="Archiver" OnClick="() => DemanderArchivage(context)" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Unarchive" Size="Size.Small" Class="action-btn" Title="Désarchiver" OnClick="() => DesarchiverProduit(context)" />
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="action-btn action-btn--danger" OnClick="() => DemanderSuppression(context)" />
                                </div>
                            </MudTd>
                        </Authorized>
                    </AuthorizeView>
                </RowTemplate>
            </MudTable>
        </div>
    }
</div>

<!-- ===== MODAL CONFIRMATION SUPPRESSION PRODUIT ===== -->
@if (produitASupprimer != null)
{
    <div class="wic-modal-overlay" @onclick="FermerSuppression">
        <div class="wic-confirm-card" @onclick:stopPropagation="true">
            <div class="wic-confirm-icon">
                <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Large" />
            </div>
            <h3 class="wic-confirm-title">Supprimer ce produit ?</h3>
            <p class="wic-confirm-text">
                Cette action est définitive et ne peut pas être annulée. Le produit
                <strong>@produitASupprimer.Nom</strong> <span class="ref-code">@produitASupprimer.Reference</span>
                sera supprimé.
            </p>
            <div class="wic-confirm-actions">
                <button class="btn btn--outline" @onclick="FermerSuppression">Annuler</button>
                <button class="btn btn--danger" @onclick="ConfirmerSuppression">
                    <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                    <span>Supprimer</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- ===== MODAL CONFIRMATION ARCHIVAGE PRODUIT ===== -->
@if (produitAArchiver != null)
{
    <div class="wic-modal-overlay" @onclick="FermerArchivage">
        <div class="wic-confirm-card" @onclick:stopPropagation="true">
            <div class="wic-confirm-icon wic-confirm-icon--amber">
                <MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Large" />
            </div>
            <h3 class="wic-confirm-title">Archiver ce produit ?</h3>
            <p class="wic-confirm-text">
                <strong>@produitAArchiver.Nom</strong> <span class="ref-code">@produitAArchiver.Reference</span>
                sera masqué du catalogue actif. Vous pourrez le désarchiver à tout moment.
            </p>
            <div class="wic-confirm-actions">
                <button class="btn btn--outline" @onclick="FermerArchivage">Annuler</button>
                <button class="btn btn--warning" @onclick="ConfirmerArchivage">
                    <MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Small" />
                    <span>Archiver</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- ===== MODAL ANALYSE IA (RENDUE AU NIVEAU RACINE) ===== -->
@if (produitPourAnalyse != null)
{
    <AnalyseSurstockModal Produit="produitPourAnalyse"
                          OnClose="() => produitPourAnalyse = null"
                          OnActionExecuted="ChargerDonnees"
                          CurrentUserRole="@userRole" />
}

<!-- ===== VISIONNEUSE D'IMAGE PLEIN ÉCRAN (LIGHTBOX) ===== -->
@if (!string.IsNullOrEmpty(imageAgrandieUrl))
{
    <div class="image-lightbox-overlay" @onclick="FermerImageAgrandie">
        <button class="lightbox-close-btn" @onclick="FermerImageAgrandie" @onclick:stopPropagation="true" aria-label="Fermer">
            <MudIcon Icon="@Icons.Material.Filled.Close" />
        </button>
        <img src="@imageAgrandieUrl" alt="@imageAgrandieAlt" class="lightbox-img" @onclick:stopPropagation="true" />
        @if (!string.IsNullOrEmpty(imageAgrandieAlt))
        {
            <div class="lightbox-caption">@imageAgrandieAlt</div>
        }
    </div>
}

<style>
    .admin-page {
        --ink: #16233A;
        --ink-muted: #64748B;
        --paper: #FFFFFF;
        --sand: #F6F8FB;
        --border: #E7ECF3;
        --denim: #2B4C7E;
        --denim-dark: #1E3A63;
        --denim-soft: #EAF0F8;
        --rust: #B5563A;
        --rust-soft: #F9ECE8;
        --pine: #1E6B4C;
        --pine-soft: #E4F3EC;
        --amber: #D97706;
        --amber-soft: #FEF3C7;
        --gray-soft: #EEF0F3;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --font-display: "Sora", "Inter", sans-serif;
        --font-body: "Inter", sans-serif;
        --font-mono: "JetBrains Mono", monospace;
        font-family: var(--font-body);
        color: var(--ink);
    }

        /* ===== En-tête ===== */
        .admin-page .admin-hero {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }

        .admin-page .page-title {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.75rem;
            color: var(--ink);
            margin: 0 0 6px 0;
            letter-spacing: -0.02em;
        }

        .admin-page .page-subtitle {
            color: var(--ink-muted);
            font-size: 0.9rem;
            margin: 0;
        }

        .admin-page .hero-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* ===== Boutons ===== */
        .admin-page .btn {
            border: none;
            padding: 10px 18px;
            border-radius: var(--radius-sm);
            font-weight: 600;
            font-size: 0.875rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: var(--font-body);
            transition: all 0.15s ease;
            position: relative;
        }

            .admin-page .btn:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .admin-page .btn--primary {
            background: var(--denim);
            color: #fff;
            box-shadow: 0 2px 6px rgba(43, 76, 126, 0.25);
        }

            .admin-page .btn--primary:hover:not(:disabled) {
                background: var(--denim-dark);
                box-shadow: 0 4px 12px rgba(43, 76, 126, 0.35);
                transform: translateY(-1px);
            }

        .admin-page .btn--outline {
            background: #fff;
            border: 1.5px solid var(--border);
            color: var(--ink);
        }

            .admin-page .btn--outline:hover:not(:disabled) {
                border-color: var(--denim);
                color: var(--denim);
                background: var(--denim-soft);
            }

    /* La modale de confirmation est rendue hors de .admin-page dans le DOM :
                   les variables CSS de .admin-page ne sont pas héritées ici, donc on
                   fige les couleurs en valeurs fixes plutôt que d'utiliser var(...). */
    .wic-confirm-actions .btn--primary {
        background: #2B4C7E;
        color: #fff;
        box-shadow: 0 2px 6px rgba(43, 76, 126, 0.3);
    }

        .wic-confirm-actions .btn--primary:hover {
            background: #1E3A63;
        }

    .wic-confirm-actions .btn--outline {
        background: #fff;
        border: 1.5px solid #E7ECF3;
        color: #16233A;
    }

        .wic-confirm-actions .btn--outline:hover {
            background: #EAF0F8;
            border-color: #2B4C7E;
        }

    .wic-confirm-actions .btn--danger {
        background: #B5563A;
        color: #fff;
        box-shadow: 0 2px 6px rgba(181, 86, 58, 0.25);
    }

        .wic-confirm-actions .btn--danger:hover {
            background: #96412A;
        }

    .wic-confirm-actions .btn--warning {
        background: #D97706;
        color: #fff;
        box-shadow: 0 2px 6px rgba(217, 119, 6, 0.25);
    }

        .wic-confirm-actions .btn--warning:hover {
            background: #B45309;
        }

    .admin-page .order-notif-badge {
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 10px;
        background: var(--rust);
        color: #fff;
        font-size: 0.6875rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    /* ===== Onglets de statistiques (texte, sans cadre ni fond) ===== */
