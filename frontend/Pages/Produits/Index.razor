    // ===== VERSION COURTE ET INTELLIGENTE DE L'ACTION IA =====
    // Transforme le texte complet renvoyé par le backend (ex: "Promotion de 40%
    // appliquée sur 120 unités pendant 15 jours") en une étiquette courte et
    // toujours entièrement visible (ex: "Promo 40% • 120u/15j"), en détectant
    // le type d'action par mot-clé puis en extrayant les valeurs numériques
    // utiles (pourcentage, unités, jours) par expression régulière.
    private static string GetActionCourte(string? texteComplet)
    {
        if (string.IsNullOrWhiteSpace(texteComplet))
            return string.Empty;

        var texte = texteComplet.ToLowerInvariant();

        var pct = Regex.Match(texteComplet, @"(\d+)\s*%");
        var uni = Regex.Match(texteComplet, @"(\d+)\s*unit[ée]s?");
        var jrs = Regex.Match(texteComplet, @"(\d+)\s*jours?");

        string Pct() => pct.Success ? $"{pct.Groups[1].Value}%" : "";
        string Uni() => uni.Success ? $"{uni.Groups[1].Value}u" : "";
        string Jrs() => jrs.Success ? $"{jrs.Groups[1].Value}j" : "";

        if (texte.Contains("promo"))
        {
            var parts = new List<string>();
            if (pct.Success) parts.Add(Pct());

            var duree = string.Join("/", new[] { Uni(), Jrs() }.Where(s => s != ""));
            if (duree != "") parts.Add(duree);

            return parts.Count > 0 ? $"Promo {string.Join(" • ", parts)}" : "Promotion";
        }

        if (texte.Contains("recycl"))
            return uni.Success ? $"Recyclage {Uni()}" : "Recyclage";

        if (texte.Contains("solde") || texte.Contains("liquidation"))
        {
            var parts = new[] { Pct(), Uni() }.Where(s => s != "").ToList();
            return parts.Count > 0 ? $"Solde {string.Join(" • ", parts)}" : "Solde";
        }

        if (texte.Contains("transfert"))
            return uni.Success ? $"Transfert {Uni()}" : "Transfert";

        if (texte.Contains("réappro") || texte.Contains("reappro") || texte.Contains("commande"))
            return uni.Success ? $"Réappro {Uni()}" : "Réappro";

        return texteComplet.Length > 22 ? texteComplet[..22].TrimEnd() + "…" : texteComplet;
    }

