@code {
    [SupplyParameterFromQuery(Name = "statut")]
    public string? StatutQuery { get; set; }

    [SupplyParameterFromQuery(Name = "filtre")]
    public string? FiltreQuery { get; set; }

    [SupplyParameterFromQuery(Name = "categorie")]
    public string? CategorieQuery { get; set; }

    [SupplyParameterFromQuery(Name = "highlight")]
    public string? HighlightQuery { get; set; }

    private List<ProduitDto>? produits;
    private List<CommandeManagerDto>? commandesClients;
    private string searchString = "";
    private string categoryFilter = "";
    private string statutIaFilter = ""; // "", "RUPTURE", "SURSTOCK", "OPTIMAL", "SUR_COMMANDE"
    private string sortBy = "STATUT_IA"; // "STATUT_IA", "NOM", "STOCK_ASC", "STOCK_DESC"
    private string highlightRef = "";
    private bool isGridView = true;
    private bool afficherArchives = false;
    private string? userRole;

    protected override async Task OnInitializedAsync()
    {
        AppliquerFiltresQueryParams();
        await ChargerDonnees();
    }

    protected override void OnParametersSet()
    {
        AppliquerFiltresQueryParams();
    }

    private void AppliquerFiltresQueryParams()
    {
        var s = StatutQuery ?? FiltreQuery;
        if (!string.IsNullOrWhiteSpace(s))
        {
            var clean = s.ToUpperInvariant().Trim();
            statutIaFilter = clean switch
            {
                "RUPTURE" or "EN RUPTURE" => "RUPTURE",
                "STOCK_FAIBLE" or "STOCK FAIBLE" or "FAIBLE" or "FAIBLE STOCK" or "EN STOCK FAIBLE" => "STOCK_FAIBLE",
                "SURSTOCK" or "EN SURSTOCK" => "SURSTOCK",
                "OPTIMAL" or "NORMAL" or "STOCK NORMAL" => "OPTIMAL",
                "SUR_COMMANDE" or "SUR COMMANDE" => "SUR_COMMANDE",
                _ => clean
            };
        }

        if (!string.IsNullOrWhiteSpace(CategorieQuery))
        {
            categoryFilter = CategorieQuery.Trim();
        }

        if (!string.IsNullOrWhiteSpace(HighlightQuery))
        {
            highlightRef = HighlightQuery.Trim();
        }
    }

    private bool IsHighlighted(ProduitDto p)
    {
        if (string.IsNullOrWhiteSpace(highlightRef)) return false;
        return string.Equals(p.Reference, highlightRef, StringComparison.OrdinalIgnoreCase)
            || string.Equals(p.Nom, highlightRef, StringComparison.OrdinalIgnoreCase);
    }

    private async Task ChargerDonnees()
    {
        try
        {
            produits = await ProduitService.ObtenirTous();

            // Load current user role for role-based UI (e.g. notification action)
            try { userRole = await AuthService.ObtenirRole(); } catch { userRole = null; }

            // Si un produit est ciblé sans filtre de statut explicite, basculer sur son onglet de statut
            if (!string.IsNullOrWhiteSpace(highlightRef) && string.IsNullOrWhiteSpace(StatutQuery) && string.IsNullOrWhiteSpace(FiltreQuery))
            {
                var target = produits?.FirstOrDefault(p => IsHighlighted(p));
                if (target != null)
                {
                    statutIaFilter = target.StatutIAType;
                }
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }
        catch
        {
            produits = new List<ProduitDto>();
        }

        try
        {
            commandesClients = await CatalogueService.ObtenirToutesLesCommandes();
        }
        catch
        {
            commandesClients = new List<CommandeManagerDto>();
        }
    }

    private static readonly List<string> CategoriesParDefaut = new()
    {
        "Jacket", "Pants", "Set", "Shirt", "Shorts", "Dress", "Coat", "Skirt"
    };

    private IEnumerable<string> CategoriesDisponibles
    {
        get
        {
            var list = new List<string>(CategoriesParDefaut);
            if (produits != null)
            {
                foreach (var cat in produits.Select(p => p.Categorie).Where(c => !string.IsNullOrWhiteSpace(c)))
                {
                    if (!list.Contains(cat, StringComparer.OrdinalIgnoreCase))
                    {
                        list.Add(cat!);
                    }
                }
            }
            return list.Distinct().OrderBy(c => c);
        }
    }

    private IEnumerable<ProduitDto> FilteredProduits
    {
        get
        {
            if (produits == null) return Enumerable.Empty<ProduitDto>();

            var list = produits.Where(p => afficherArchives || !p.EstArchive)
                                .Where(p => FilterFunc(p));

            if (!string.IsNullOrEmpty(statutIaFilter))
            {
                list = list.Where(p => IsStatutIA(p, statutIaFilter));
            }

            return sortBy switch
            {
                "STATUT_IA" => list.OrderBy(p => p.StatutIAPriorite).ThenBy(p => p.Stock?.QuantiteActuelle ?? 0),
                "NOM" => list.OrderBy(p => p.Nom),
                "STOCK_ASC" => list.OrderBy(p => p.Stock?.QuantiteActuelle ?? 0),
                "STOCK_DESC" => list.OrderByDescending(p => p.Stock?.QuantiteActuelle ?? 0),
                _ => list.OrderBy(p => p.StatutIAPriorite)
            };
        }
    }

    private bool FilterFunc(ProduitDto p)
    {
        if (!string.IsNullOrEmpty(categoryFilter) && !string.Equals(p.Categorie, categoryFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        if (p.Nom?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.Reference?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.TypeTissu?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.Categorie?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.StatutIABadgeText?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;

        return false;
    }

    private void SelectStatutIA(string statut) => statutIaFilter = statut;

    private bool IsStatutIA(ProduitDto p, string statut) =>
        string.Equals(p.StatutIAType, statut, StringComparison.OrdinalIgnoreCase);

    private string GetCategoryColor(string? categorie)
    {
        if (string.IsNullOrWhiteSpace(categorie))
            return "#64748B";

        var palette = new[] { "#2B4C7E", "#B5563A", "#B8842C", "#4A6FA5", "#7C4A6E" };
        int hash = 0;
        foreach (var c in categorie) hash = (hash * 31 + c) & 0x7FFFFFFF;
        return palette[hash % palette.Length];
    }

