@code {
    [Parameter] public ProduitDto Produit { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnActionExecuted { get; set; }
    [Parameter] public string? CurrentUserRole { get; set; }

    private bool isLoading = false;
    private bool hasError = false;
    private bool isExecuting = false;
    private bool estEnModification = false;
    private bool afficherAutresSuggestions = false;

    private static readonly Dictionary<int, AnalyseProduitDto> CacheAnalyses = new();
    private AnalyseProduitDto? analyse;

    // RÈGLES DE PERMISSION HIÉRARCHIQUE (ADMIN > RESPONSABLE)
    private bool IsNotificationOnlyActive =>
        analyse?.ActionActive != null && (
            string.Equals(analyse.ActionActive.TypeAction, "NOTIFICATION_PRODUCTION", StringComparison.OrdinalIgnoreCase)
            || string.Equals(analyse.ActionActive.TypeAction, "NOTIFICATION", StringComparison.OrdinalIgnoreCase)
            || string.Equals(analyse.ActionActive.TypeAction, "NOTIFIER_PRODUCTION", StringComparison.OrdinalIgnoreCase)
            || (analyse.ActionActive.Label?.Contains("Notification", StringComparison.OrdinalIgnoreCase) ?? false)
            || (analyse.ActionActive.Label?.Contains("Notifier", StringComparison.OrdinalIgnoreCase) ?? false)
        );

    private bool IsResolutionActive => analyse?.ActionActive != null && !IsNotificationOnlyActive;
    private bool IsActiveActionByAdmin => IsResolutionActive && (string.Equals(analyse?.ActionActive?.InitieParRole, "ADMIN", StringComparison.OrdinalIgnoreCase) || analyse?.ActionActive?.InitieParRole == null);
    private bool IsResponsableUser => string.Equals(CurrentUserRole, "RESPONSABLE_STOCK_PRODUCTION", StringComparison.OrdinalIgnoreCase);
    private bool IsReadOnlyForResponsable => IsResponsableUser && IsActiveActionByAdmin;

    private bool HasResponsableReceivedNotification =>
        IsNotificationOnlyActive ||
        (NotificationService.Notifications != null && NotificationService.Notifications.Any(n =>
            n.UrlCible != null && Produit != null && (
                n.UrlCible.Contains(Produit.Reference ?? "___", StringComparison.OrdinalIgnoreCase)
                || n.UrlCible.Contains(Produit.Nom ?? "___", StringComparison.OrdinalIgnoreCase)
            )
        ));

    private bool CanResponsableExecuteActions =>
        !IsResponsableUser || HasResponsableReceivedNotification;

    // ÉTAPE DE CONFIRMATION INTERMÉDIAIRE
    private ActionRecommandeeIaDto? actionAConfirmer;

    // FORMULAIRE PROMOTION
    private int formRemisePourcentage = 20;
    private int formDureeJours = 14;
    private int formQuantiteCible = 50;

    // FORMULAIRE RECYCLAGE
    private int formQuantiteRecyclage = 10;
    private string formMotif = "Recyclage surstock persistant";
    private string formDestination = "Atelier interne";

    // FORMULAIRE NOTIFICATION
    private string formDestinataire = "RESPONSABLE_STOCK_PRODUCTION";
    private string formDestinataireUserId = "";
    private string formPriorite = "HAUTE";
    private string formMessage = string.Empty;
    private List<UtilisateurDto>? responsablesDisponibles;

    // PROPRIÉTÉS CALCULÉES EN DIRECT
    private decimal PrixPromoSolde => Math.Round(Produit.PrixUnitaire * (1 - (decimal)formRemisePourcentage / 100m), 2);
    private string DateDebutPromo => DateTime.Today.ToString("dd/MM/yyyy");
    private string DateFinPromo => DateTime.Today.AddDays(formDureeJours).ToString("dd/MM/yyyy");

    private decimal ValeurRecyclageLiberee => (decimal)formQuantiteRecyclage * (Produit.PrixUnitaire > 0 ? Produit.PrixUnitaire : 100m);
    private int NouveauStockApresRecyclage => Math.Max(0, (Produit.Stock?.QuantiteActuelle ?? 0) - formQuantiteRecyclage);

    protected override async Task OnInitializedAsync()
    {
        if (Produit != null)
        {
            await ChargerAnalyseAsync();
        }

        try
        {
            var tousUsers = await UtilisateurService.ObtenirTous();
            responsablesDisponibles = tousUsers?
                .Where(u => string.Equals(u.Role, "RESPONSABLE_STOCK_PRODUCTION", StringComparison.OrdinalIgnoreCase)
                         || string.Equals(u.Role, "RESPONSABLE", StringComparison.OrdinalIgnoreCase)
                         || string.Equals(u.Role, "MANAGER", StringComparison.OrdinalIgnoreCase))
                .ToList();

            if (responsablesDisponibles != null && responsablesDisponibles.Any())
            {
                formDestinataireUserId = responsablesDisponibles.First().Id.ToString();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MODAL] Erreur lors du chargement de la liste des responsables : {ex.Message}");
        }
    }

    private async Task Fermer()
    {
        await OnClose.InvokeAsync();
    }

    private async Task ChargerAnalyseAsync()
    {
        if (Produit == null) return;

        if (CacheAnalyses.TryGetValue(Produit.Id, out var cachedAnalyse))
        {
            analyse = cachedAnalyse;
            return;
        }

        isLoading = true;
        hasError = false;

        try
        {
            analyse = await ProduitService.ObtenirAnalyseSurstock(Produit.Id);
            if (analyse != null)
            {
                CacheAnalyses[Produit.Id] = analyse;
            }
            else
            {
                hasError = true;
            }
        }
        catch
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ModifierActionActive(ActionActiveDto act)
    {
        estEnModification = true;
        int stockDispo = Produit.Stock?.QuantiteActuelle ?? 100;
        string type = act.TypeAction.ToUpperInvariant();

        actionAConfirmer = new ActionRecommandeeIaDto
        {
            Id = act.Id.ToString(),
            TypeAction = act.TypeAction,
            Label = act.Label,
            Justification = act.Description
        };

        if (type == "PROMOTION_CIBLEE")
        {
            formRemisePourcentage = act.RemisePourcentage ?? 20;
            formDureeJours = act.DureeJours ?? 14;
            formQuantiteCible = act.QuantiteCible ?? Math.Min(stockDispo, 50);
        }
        else if (type == "RECYCLAGE_ANTICIPE")
        {
            formQuantiteRecyclage = act.QuantiteCible ?? Math.Min(stockDispo, Math.Max(10, 10));
            formMotif = act.Motif ?? "Recyclage surstock persistant";
            formDestination = act.Destination ?? "Atelier interne";
        }
        else
        {
            formDestinataire = act.Destinataire ?? "Chef de Production";
            formPriorite = act.Priorite ?? (analyse?.Metriques.EstTendanceCategorie == true ? "HAUTE" : "MOYENNE");
            formMessage = act.Description;
        }
    }

    private async Task AnnulerActionEnCours()
    {
        if (isExecuting || Produit == null) return;

        isExecuting = true;
        StateHasChanged();

        try
        {
            bool succes = await ProduitService.AnnulerActionSurstock(Produit.Id);
            if (succes)
            {
                Snackbar.Add("Action annulée avec succès. L'article est réinitialisé.", Severity.Success);

                // Restaurer les données locales selon le type d'action annulée
                if (analyse?.ActionActive != null)
                {
                    var typeAnnule = analyse.ActionActive.TypeAction?.ToUpperInvariant() ?? "";

                    if (typeAnnule == "PROMOTION_CIBLEE")
                    {
                        Produit.RemisePourcentage = null;
                        Produit.DateFinPromotion = null;
                    }
                    else if ((typeAnnule == "RECYCLAGE_ANTICIPE" || (analyse.ActionActive.Label?.Contains("Recyclage", StringComparison.OrdinalIgnoreCase) ?? false)) && Produit.Stock != null)
                    {
                        int qteRecyclee = analyse.ActionActive.QuantiteCible ?? 0;

                        // Si QuantiteCible n'était pas renseigné, extraire depuis la description (ex: "Recyclage 299 u." ou "Recyclage 299u")
                        if (qteRecyclee <= 0 && !string.IsNullOrWhiteSpace(analyse.ActionActive.Description))
                        {
                            var match = System.Text.RegularExpressions.Regex.Match(analyse.ActionActive.Description, @"(\d+)\s*(?:u|unités?|pièces?)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                            if (!match.Success)
                            {
                                match = System.Text.RegularExpressions.Regex.Match(analyse.ActionActive.Description, @"\d+");
                            }
                            if (match.Success && int.TryParse(match.Groups[match.Groups.Count > 1 ? 1 : 0].Value, out int qteParsed))
                            {
                                qteRecyclee = qteParsed;
                            }
                        }

                        if (qteRecyclee > 0)
                        {
                            Produit.Stock.QuantiteActuelle += qteRecyclee;
                            try
                            {
                                await ProduitService.Modifier(Produit.Id, Produit);
                            }
                            catch (Exception exMod)
                            {
                                Console.WriteLine($"[MODAL] Erreur persistance annulation stock : {exMod.Message}");
                            }
                        }
                    }
                }
                else
                {
                    // Fallback : réinitialiser seulement la promotion
                    Produit.RemisePourcentage = null;
                    Produit.DateFinPromotion = null;
                }

                CacheAnalyses.Remove(Produit.Id);
                if (analyse != null)
                {
                    analyse.ActionActive = null;
                }

                await OnActionExecuted.InvokeAsync();
            }
            else
            {
                Snackbar.Add("Erreur lors de l'annulation de l'action.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally
        {
            isExecuting = false;
        }
    }

    private void OuvrirFormulaireConfirmation(ActionRecommandeeIaDto act)
    {
        estEnModification = false;
        actionAConfirmer = act;
        int stockDispo = Produit.Stock?.QuantiteActuelle ?? 100;

        string type = act.TypeAction.ToUpperInvariant();
        if (type == "PROMOTION_CIBLEE")
        {
            formRemisePourcentage = GetParamInt(act, "remisePourcentage", 20);
            formDureeJours = GetParamInt(act, "dureeJours", 14);
            formQuantiteCible = Math.Min(stockDispo, GetParamInt(act, "quantiteCible", 50));
        }
        else if (type == "RECYCLAGE_ANTICIPE")
        {
            formQuantiteRecyclage = Math.Min(stockDispo, Math.Max(10, GetParamInt(act, "quantite", 10)));
            formMotif = "Recyclage surstock persistant";
            formDestination = "Atelier interne";
        }
        else
        {
            formDestinataire = GetParamString(act, "destinataire", "Chef de Production");
            formPriorite = analyse?.Metriques.EstTendanceCategorie == true ? "HAUTE" : "MOYENNE";
            formMessage = act.Justification;
        }
    }

    private void AnnulerConfirmation()
    {
        actionAConfirmer = null;
        estEnModification = false;
    }

    private async Task ValiderEtExecuterAction()
    {
        if (actionAConfirmer == null || isExecuting || Produit == null) return;

        isExecuting = true;
        StateHasChanged();

        try
        {
            var dictParams = new Dictionary<string, string>();
            string type = actionAConfirmer.TypeAction.ToUpperInvariant();

            if (type == "PROMOTION_CIBLEE")
            {
                dictParams["remisePourcentage"] = formRemisePourcentage.ToString();
                dictParams["dureeJours"] = formDureeJours.ToString();
                dictParams["quantiteCible"] = formQuantiteCible.ToString();
            }
            else if (type == "RECYCLAGE_ANTICIPE")
            {
                dictParams["quantite"] = formQuantiteRecyclage.ToString();
                dictParams["motif"] = formMotif;
                dictParams["destination"] = formDestination;
            }
            else if (type == "NOTIFICATION_PRODUCTION")
            {
                // Target role + specific user selection
                dictParams["destinataire"] = "RESPONSABLE_STOCK_PRODUCTION";
                int? userId = int.TryParse(formDestinataireUserId, out int parsedId) ? parsedId : null;

                if (!string.IsNullOrWhiteSpace(formDestinataireUserId))
                {
                    dictParams["destinataireUserId"] = formDestinataireUserId;
                    var respSelected = responsablesDisponibles?.FirstOrDefault(u => u.Id.ToString() == formDestinataireUserId);
                    if (respSelected != null)
                    {
                        dictParams["destinataireEmail"] = respSelected.Email;
                        dictParams["destinataireNom"] = $"{respSelected.Prenom} {respSelected.Nom}".Trim();
                    }
                }
                dictParams["priorite"] = formPriorite;
                // Build message with deep-link to the surstock product
                var lienProduit = $"/produits?statut=SURSTOCK&highlight={Uri.EscapeDataString(Produit.Reference ?? Produit.Nom ?? "")}";
                var messageComplet = string.IsNullOrWhiteSpace(formMessage)
                    ? $"Alerte surstock : le produit « {Produit.Nom} » (réf. {Produit.Reference}) nécessite une intervention (promotion ou recyclage)."
                    : formMessage;
                dictParams["message"] = messageComplet;
                dictParams["urlCible"] = lienProduit;

                // On envoie UNIQUEMENT via l'API → la notification sera récupérée
                // par le Responsable à sa prochaine connexion ou lors du polling.
                // On NE push PAS dans NotificationService ici car ce code s'exécute
                // dans le navigateur de l'Admin, pas dans celui du Responsable.
                var notifReq = new NotificationDto
                {
                    Id = Random.Shared.Next(1000, 999999),
                    Type = "ACTION_IA_A_VALIDER",
                    Message = messageComplet,
                    UrlCible = lienProduit,
                    RoleDestinataire = "RESPONSABLE_STOCK_PRODUCTION",
                    UtilisateurDestinataireId = userId,
                    DateCreation = DateTime.Now,
                    Lue = false
                };

                // Sauvegarder dans le stockage partagé
                await NotificationService.AjouterNotificationAsync(notifReq);

                // 2. Persistance serveur via API
                try
                {
                    await Http.PostAsJsonAsync("api/notification", notifReq);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[MODAL] Erreur envoi direct notification: {ex.Message}");
                }
            }
            else
            {
                dictParams["destinataire"] = formDestinataire;
                dictParams["priorite"] = formPriorite;
                dictParams["message"] = formMessage;
            }

            dictParams["initieParRole"] = CurrentUserRole ?? "ADMIN";

            bool succes = await ProduitService.ExecuterActionSurstock(Produit.Id, actionAConfirmer.TypeAction, actionAConfirmer.Label, dictParams);

            if (succes)
            {
                string msgSucces = estEnModification
                    ? $"Action « {actionAConfirmer.Label} » modifiée avec succès."
                    : $"Action « {actionAConfirmer.Label} » confirmée et exécutée avec succès.";

                Snackbar.Add(msgSucces, Severity.Success);

                if (type == "PROMOTION_CIBLEE")
                {
                    Produit.RemisePourcentage = formRemisePourcentage;
                    Produit.DateFinPromotion = DateTime.Today.AddDays(formDureeJours);
                }
                else if (type == "RECYCLAGE_ANTICIPE" && Produit.Stock != null)
                {
                    Produit.Stock.QuantiteActuelle = NouveauStockApresRecyclage;
                    try
                    {
                        await ProduitService.Modifier(Produit.Id, Produit);
                    }
                    catch (Exception exMod)
                    {
                        Console.WriteLine($"[MODAL] Erreur persistance exécution recyclage stock : {exMod.Message}");
                    }
                }

                if (analyse != null)
                {
                    analyse.ActionActive = new ActionActiveDto
                    {
                        TypeAction = actionAConfirmer.TypeAction,
                        Label = actionAConfirmer.Label,
                        Description = type == "RECYCLAGE_ANTICIPE"
                            ? $"Recyclage anticipé de {formQuantiteRecyclage} u. vers {formDestination}"
                            : $"Promotion de {formRemisePourcentage}% pendant {formDureeJours} jours",
                        QuantiteCible = formQuantiteRecyclage,
                        RemisePourcentage = formRemisePourcentage,
                        DureeJours = formDureeJours,
                        InitieParRole = CurrentUserRole ?? "ADMIN"
                    };
                }

                // ──────────────────────────────────────────────────────────────────────
                // FEEDBACK AU SUPER ADMIN : Le responsable informe l'Admin de son action
                // ──────────────────────────────────────────────────────────────────────
                if (IsResponsableUser && (type == "PROMOTION_CIBLEE" || type == "RECYCLAGE_ANTICIPE"))
                {
                    // Récupérer le nom du responsable depuis les claims JWT
                    string nomResponsable = "Le responsable";
                    try
                    {
                        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                        var nameClaim = authState.User.FindFirst(ClaimTypes.Name)
                            ?? authState.User.FindFirst("name")
                            ?? authState.User.FindFirst("given_name");
                        if (nameClaim != null && !string.IsNullOrWhiteSpace(nameClaim.Value))
                            nomResponsable = nameClaim.Value;
                    }
                    catch { }

                    var lienProduit = $"/produits?statut=SURSTOCK&highlight={Uri.EscapeDataString(Produit.Reference ?? Produit.Nom ?? "")}";

                    // Construire un message détaillé selon le type d'action
                    string msgAdmin;
                    if (type == "PROMOTION_CIBLEE")
                    {
                        msgAdmin = $"{nomResponsable} a appliqué une promotion ciblée de {formRemisePourcentage}% (durée : {formDureeJours} jours) sur le produit « {Produit.Nom} » (réf. {Produit.Reference}).";
                    }
                    else
                    {
                        var dest = string.IsNullOrWhiteSpace(formDestination) ? "atelier" : formDestination;
                        msgAdmin = $"{nomResponsable} a effectué un recyclage anticipé de {formQuantiteRecyclage} unité(s) vers {dest} sur le produit « {Produit.Nom} » (réf. {Produit.Reference}).";
                    }

                    var notifAdmin = new NotificationDto
                    {
                        Id = Random.Shared.Next(1000, 999999),
                        Type = "ACTION_RESPONSABLE_EXECUTEE",
                        Message = msgAdmin,
                        UrlCible = lienProduit,
                        RoleDestinataire = "ADMIN",
                        DateCreation = DateTime.Now,
                        Lue = false
                    };

                    // Sauvegarder dans le stockage partagé (sera affiché uniquement aux Admins)
                    await NotificationService.AjouterNotificationAsync(notifAdmin);

                    // 2. Persistance serveur via API
                    try
                    {
                        await Http.PostAsJsonAsync("api/notification", notifAdmin);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[MODAL] Erreur envoi notif Admin : {ex.Message}");
                    }
                }

                CacheAnalyses.Remove(Produit.Id);
                actionAConfirmer = null;
                estEnModification = false;

                await OnActionExecuted.InvokeAsync();
                await OnClose.InvokeAsync();
            }
            else
            {
                Snackbar.Add("Erreur lors de l'exécution de l'action.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally
        {
            isExecuting = false;
        }
    }

    private int GetParamInt(ActionRecommandeeIaDto act, string key, int defaultVal)
    {
        if (act.Params != null && act.Params.TryGetValue(key, out var val) && val != null && int.TryParse(val.ToString(), out int parsed))
        {
            return parsed;
        }
        return defaultVal;
    }

    private string GetParamString(ActionRecommandeeIaDto act, string key, string defaultVal)
    {
        if (act.Params != null && act.Params.TryGetValue(key, out var val) && val != null && !string.IsNullOrWhiteSpace(val.ToString()))
        {
            return val.ToString()!;
        }
        return defaultVal;
    }

    private string GetConfirmHeaderIcon(string typeAction) => typeAction.ToUpperInvariant() switch
    {
        "PROMOTION_CIBLEE" => Icons.Material.Filled.LocalOffer,
        "RECYCLAGE_ANTICIPE" => Icons.Material.Filled.Recycling,
        _ => Icons.Material.Filled.NotificationsActive
    };
}
