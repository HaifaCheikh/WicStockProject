@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject ProduitService ProduitService
@inject UtilisateurService UtilisateurService
@inject NotificationClientService NotificationService
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<!-- FENÊTRE POP-UP MODAL CENTRÉE (RENDUE AU NIVEAU RACINE DE LA PAGE) -->
<div class="dialog-overlay-root" @onclick="Fermer">
    <div class="dialog-card-root animate-pop-modal" @onclick:stopPropagation="true">

        <div class="dialog-accent-strip-root"></div>

        <!-- EN-TÊTE MODAL -->
        <div class="dialog-header-root d-flex align-center justify-space-between pa-4">
            <div class="d-flex align-center gap-3">
                <div class="modal-icon-badge-root">
                    <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Medium" />
                </div>
                <div>
                    <div class="modal-eyebrow-root">ANALYSE IA &bull; SURSTOCK</div>
                    <div class="modal-title-root">@Produit.Nom</div>
                </div>
            </div>
            <button class="dialog-close-btn-root" @onclick="Fermer" aria-label="Fermer">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
            </button>
        </div>

        <!-- CORPS MODAL -->
        <div class="dialog-body-root pa-4">
            @if (isLoading)
            {
                <div class="pa-6 text-center">
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-3" Style="border-radius:6px;" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Analyse en cours...
                    </MudText>
                </div>
            }
            else if (hasError || analyse == null)
            {
                <div class="pa-4 text-center">
                    <MudText Typo="Typo.body2" Color="Color.Error" Class="mb-3">
                        Impossible de générer l'analyse IA pour ce produit.
                    </MudText>
                    <button class="btn-retry-root" @onclick="ChargerAnalyseAsync">Réessayer</button>
                </div>
            }
            else
            {
                @if (analyse.EstModeDegrade)
                {
                    <div class="degrade-banner-root mb-3 pa-2 rounded d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="degrade-icon-root" />
                        <span class="degrade-text-root">Mode dégradé : affichage des métriques SQL brutes (IA indisponible).</span>
                    </div>
                }

                <!-- BLOC DIAGNOSTIC IA -->
                <div class="diagnostic-card-root mb-4 pa-3">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <div class="d-flex align-center gap-2">
                            <span class="diag-title-root">Diagnostic</span>
                        </div>
                        <span class="trend-badge-root @(analyse.Metriques.EstTendanceCategorie ? "trend-cat" : "trend-isolated")">
                            @(analyse.Metriques.EstTendanceCategorie ? "Tendance catégorie" : "Cas isolé")
                        </span>
                    </div>
                    <p class="diag-text-root mb-0">@analyse.Diagnostic</p>
                </div>

                <!-- GRILLE DES MÉTRIQUES CLÉS (VERSION MODERNISÉE) -->
                <div class="metrics-grid-root mb-4">
                    <div class="metric-box-root">
                        <div class="metric-box-icon-root">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                        </div>
                        <div class="metric-box-lbl-root">Stock actuel</div>
                        <div class="metric-box-val-root">
                            @analyse.Metriques.StockActuel<span class="metric-box-unit-root">u.</span>
                        </div>
                        @if (analyse.Metriques.SurplusUnites > 0)
                        {
                            <span class="surplus-tag-root">+@analyse.Metriques.SurplusUnites u. en surplus</span>
                        }
                    </div>

                    <div class="metric-box-root">
                        <div class="metric-box-icon-root">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
                        </div>
                        <div class="metric-box-lbl-root">Entrée & inactivité</div>
                        <div class="metric-box-val-root metric-box-val-sm">@analyse.Metriques.DateAjoutFormatee</div>
                        <span class="inactive-badge-root">@analyse.Metriques.JoursDepuisDerniereSortie j. inactif</span>
                    </div>

                    <div class="metric-box-root">
                        <div class="metric-box-icon-root">
                            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" />
                        </div>
                        <div class="metric-box-lbl-root">Durée d'action</div>
                        <div class="metric-box-val-root metric-box-val-sm text-pine">Promo 14 jours</div>
                        <span class="duration-tag-root">Valable jusqu'au @DateTime.Today.AddDays(14).ToString("dd/MM")</span>
                    </div>
                </div>

                <!-- FORMULAIRE DE CONFIRMATION / MODIFICATION INTERMÉDIAIRE -->
                @if (actionAConfirmer != null)
                {
                    <div class="confirm-panel-card mb-4 pa-3 animate-fade-in">
                        <div class="d-flex align-center justify-space-between mb-3 confirm-panel-head">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@GetConfirmHeaderIcon(actionAConfirmer.TypeAction)" Size="Size.Small" Class="confirm-panel-icon" />
                                <span class="confirm-panel-title">@(estEnModification ? "Modifier l'action :" : "") @actionAConfirmer.Label</span>
                            </div>
                            <button class="btn-cancel-sm" @onclick="AnnulerConfirmation">
                                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                                <span>Retour</span>
                            </button>
                        </div>

                        <!-- 1. FORMULAIRE PROMOTION CIBLEE -->
                        @if (string.Equals(actionAConfirmer.TypeAction, "PROMOTION_CIBLEE", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="confirm-form-grid mb-3">
                                <div class="form-group-root">
                                    <label class="form-label-root">Remise (%)</label>
                                    <input type="number" min="5" max="90" class="form-input-root" @bind="formRemisePourcentage" @bind:event="oninput" />
                                </div>
                                <div class="form-group-root">
                                    <label class="form-label-root">Durée (jours)</label>
                                    <input type="number" min="1" max="180" class="form-input-root" @bind="formDureeJours" @bind:event="oninput" />
                                </div>
                                <div class="form-group-root">
                                    <label class="form-label-root">Quantité ciblée (u.)</label>
                                    <input type="number" min="1" max="@(Produit.Stock?.QuantiteActuelle ?? 100)" class="form-input-root" @bind="formQuantiteCible" @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="recap-preview-box pa-3 mb-3 rounded">
                                <div class="recap-row d-flex justify-space-between mb-1">
                                    <span class="recap-lbl">Prix unitaire actuel</span>
                                    <span class="recap-val-old">@Produit.PrixUnitaire.ToString("F2") DT</span>
                                </div>
                                <div class="recap-row d-flex justify-space-between mb-1">
                                    <span class="recap-lbl">Prix promotionnel (-@formRemisePourcentage%)</span>
                                    <span class="recap-val-new">@PrixPromoSolde.ToString("F2") DT</span>
                                </div>
                                <div class="recap-row d-flex justify-space-between mb-1">
                                    <span class="recap-lbl">Période</span>
                                    <span class="recap-val">Du @DateDebutPromo au @DateFinPromo (@formDureeJours j.)</span>
                                </div>
                                <div class="recap-row d-flex justify-space-between">
                                    <span class="recap-lbl">Stock concerné</span>
                                    <span class="recap-val">@formQuantiteCible / @(Produit.Stock?.QuantiteActuelle ?? 0) u. dispo.</span>
                                </div>
                            </div>
                        }
                        @if (string.Equals(actionAConfirmer.TypeAction, "RECYCLAGE_ANTICIPE", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="confirm-form-grid mb-3">
                                <div class="form-group-root">
                                    <label class="form-label-root">Quantité à recycler (u.)</label>
                                    <input type="number" min="1" max="@(Produit.Stock?.QuantiteActuelle ?? 100)" class="form-input-root" @bind="formQuantiteRecyclage" @bind:event="oninput" />
                                </div>
                                <div class="form-group-root">
                                    <label class="form-label-root">Motif du déstockage</label>
                                    <select class="form-select-root" @bind="formMotif">
                                        <option value="Recyclage surstock persistant">Recyclage surstock persistant</option>
                                        <option value="Déstockage fin de saison">Déstockage fin de saison</option>
                                        <option value="Défaut de fabrication / Retouche">Défaut de fabrication / Retouche</option>
                                        <option value="Don anti-gaspillage">Don anti-gaspillage</option>
                                    </select>
                                </div>
                                <div class="form-group-root">
                                    <label class="form-label-root">Destination / Filière</label>
                                    <select class="form-select-root" @bind="formDestination">
                                        <option value="Atelier interne">Atelier interne (réemploi fil)</option>
                                        <option value="Prestataire externe de recyclage">Prestataire externe de recyclage</option>
                                        <option value="Filière de réemploi solidaire">Filière de réemploi solidaire</option>
                                    </select>
                                </div>
                            </div>

                            <div class="warning-banner-recyclage pa-3 mb-3 rounded d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" Class="warning-icon-recyclage" />
                                <span class="warning-text-recyclage">
                                    Action irréversible : cette opération réduira le stock réel de <strong>@formQuantiteRecyclage unités</strong> de façon définitive.
                                </span>
                            </div>

                            <div class="recap-preview-box pa-3 mb-3 rounded">
                                <div class="recap-row d-flex justify-space-between mb-1">
                                    <span class="recap-lbl">Valeur immobilisée libérée</span>
                                    <span class="recap-val-new">@ValeurRecyclageLiberee.ToString("N0") DT</span>
                                </div>
                                <div class="recap-row d-flex justify-space-between">
                                    <span class="recap-lbl">Nouveau stock après recyclage</span>
                                    <span class="recap-val"><strong>@NouveauStockApresRecyclage u.</strong> (actuellement @(Produit.Stock?.QuantiteActuelle ?? 0) u.)</span>
                                </div>
                            </div>
                        }
                        @if (string.Equals(actionAConfirmer.TypeAction, "NOTIFICATION_PRODUCTION", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="confirm-form-grid mb-3">
                                <div class="form-group-root">
                                    <label class="form-label-root">Choisir le Responsable destinataire</label>
                                    @if (responsablesDisponibles != null && responsablesDisponibles.Any())
                                    {
                                        <select class="form-select-root" @bind="formDestinataireUserId">
                                            <option value="">Tous les responsables de stock</option>
                                            @foreach (var resp in responsablesDisponibles)
                                            {
                                                <option value="@resp.Id">@resp.Prenom @resp.Nom (@resp.Email)</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <div class="destinataire-fixed-badge">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                            <span>Responsable stock & production</span>
                                        </div>
                                    }
                                </div>
                                <div class="form-group-root">
                                    <label class="form-label-root">Niveau de priorité</label>
                                    <div class="priority-picker-root">
                                        <label class="priority-opt-root priority-opt--basse @(formPriorite == "BASSE" ? "is-active" : "")">
                                            <input type="radio" name="priorite" value="BASSE" checked="@(formPriorite == "BASSE")" @onchange="@(() => formPriorite = "BASSE")" />
                                            <span class="priority-dot-root"></span> Basse
                                        </label>
                                        <label class="priority-opt-root priority-opt--moyenne @(formPriorite == "MOYENNE" ? "is-active" : "")">
                                            <input type="radio" name="priorite" value="MOYENNE" checked="@(formPriorite == "MOYENNE")" @onchange="@(() => formPriorite = "MOYENNE")" />
                                            <span class="priority-dot-root"></span> Moyenne
                                        </label>
                                        <label class="priority-opt-root priority-opt--haute @(formPriorite == "HAUTE" ? "is-active" : "")">
                                            <input type="radio" name="priorite" value="HAUTE" checked="@(formPriorite == "HAUTE")" @onchange="@(() => formPriorite = "HAUTE")" />
                                            <span class="priority-dot-root"></span> Haute
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group-root mb-3">
                                <label class="form-label-root">Message / consigne pour l'atelier</label>
                                <textarea rows="3" class="form-textarea-root" @bind="formMessage" placeholder="Rédigez la consigne d'ajustement..."></textarea>
                            </div>
                        }

                        <!-- BOUTONS DE VALIDATION DU FORMULAIRE -->
                        <div class="d-flex justify-end gap-2 pt-2 confirm-panel-foot">
                            <button class="btn-cancel-modal-root" @onclick="AnnulerConfirmation" disabled="@isExecuting">
                                Annuler
                            </button>
                            <button class="btn-submit-confirm-root"
                                    @onclick="ValiderEtExecuterAction"
                                    disabled="@isExecuting">
                                @if (isExecuting)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width:14px;height:14px;color:#fff;" />
                                    <span>Enregistrement en cours...</span>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                    <span>@(estEnModification ? "Enregistrer les modifications" : "Confirmer & exécuter")</span>
                                }
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <!-- CAS 1 : UNE ACTION DE RÉSOLUTION EST DÉJÀ ACTIVE SUR CE PRODUIT -->
                    @if (analyse.ActionActive != null && !IsNotificationOnlyActive)
                    {
                        <div class="active-action-card mb-4 pa-3 animate-fade-in">
                            <div class="d-flex align-center justify-space-between mb-2">
                                <div class="d-flex align-center gap-2">
                                    <span class="active-action-title">Action en cours d'application</span>
                                    @if (IsReadOnlyForResponsable)
                                    {
                                        <span class="active-action-badge-readonly" title="Seul un Administrateur peut modifier ou annuler cette décision">
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="font-size:13px;" />
                                            Décision Admin (Lecture seule)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="active-action-badge">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="font-size:13px;" />
                                            Active
                                        </span>
                                    }
                                </div>
                                <span class="active-action-type">@analyse.ActionActive.Label</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(analyse.ActionActive.NomAuteur))
                            {
                                <div class="d-flex align-center gap-1 mb-2" style="font-size:0.78rem; color:#64748B;">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Style="font-size:14px; color:#6366F1;" />
                                    <span>Appliquée par <strong style="color:#1E293B;">@analyse.ActionActive.NomAuteur</strong></span>
                                </div>
                            }

                            <p class="active-action-desc mb-3">@analyse.ActionActive.Description</p>

                            @if (!IsReadOnlyForResponsable)
                            {
                                <div class="d-flex align-center justify-space-between pt-2 active-action-foot">
                                    <button class="btn-action-cancel" @onclick="AnnulerActionEnCours" disabled="@isExecuting">
                                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />
                                        <span>Annuler cette action</span>
                                    </button>
                                    <button class="btn-action-modify" @onclick="() => ModifierActionActive(analyse.ActionActive)" disabled="@isExecuting">
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                        <span>Modifier l'action</span>
                                    </button>
                                </div>
                            }
                        </div>

                        @if (!IsReadOnlyForResponsable)
                        {
                            <!-- ACCORDÉON POUR VOIR D'AUTRES PROPOSITIONS -->
                            <div class="d-flex align-center justify-space-between mb-2">
                                <div class="actions-section-title-root mb-0">Autres suggestions IA</div>
                                <button class="btn-toggle-suggestions" @onclick="() => afficherAutresSuggestions = !afficherAutresSuggestions">
                                    <span>@(afficherAutresSuggestions ? "Masquer les alternatives" : "Voir d'autres propositions")</span>
                                    <MudIcon Icon="@(afficherAutresSuggestions ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                                </button>
                            </div>
                        }
                    }

                    <!-- CAS 2 : LISTE DES ACTIONS RECOMMANDÉES -->
                    @if ((!IsResolutionActive || afficherAutresSuggestions) && !IsReadOnlyForResponsable && analyse.Actions != null && analyse.Actions.Any())
                    {
                        @if (!IsResolutionActive)
                        {
                            <div class="actions-section-title-root mb-2">Actions recommandées</div>
                        }

                        @if (IsResponsableUser && !HasResponsableReceivedNotification)
                        {
                            <div class="pa-3 mb-3 d-flex align-center gap-2" style="background:#FFFBEB; border:1px solid #FCD34D; color:#92400E; font-size:0.85rem; border-radius:8px;">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                                <span>En attente d'une notification de l'Administrateur pour intervenir sur ce surstock.</span>
                            </div>
                        }

                        <div class="d-flex flex-column gap-2 mb-3 animate-fade-in">
                            @foreach (var act in analyse.Actions.Where(a =>
                                a.TypeAction.ToUpperInvariant() != "NOTIFICATION_PRODUCTION"
                                || string.Equals(CurrentUserRole, "ADMIN", StringComparison.OrdinalIgnoreCase)))
                            {
                                bool isSelected = actionAConfirmer?.Id == act.Id;
                                <div class="action-item-card-root d-flex align-center justify-space-between pa-3 @(isSelected ? "action-item-selected" : "")">
                                    <div class="action-item-info-root">
                                        <div class="action-item-title-root">@act.Label</div>
                                        <div class="action-item-justif-root">
                                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Class="action-item-justif-icon" />
                                            <span>@act.Justification</span>
                                        </div>
                                    </div>
                                    <button class="btn-exec-action-root"
                                            @onclick="() => OuvrirFormulaireConfirmation(act)"
                                            disabled="@(isExecuting || !CanResponsableExecuteActions)">
                                        <span>@(analyse.ActionActive != null ? "Remplacer" : "Exécuter")</span>
                                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            }
        </div>

        <!-- PIED MODAL -->
        <div class="dialog-footer-root pa-3 d-flex justify-end">
            <button class="btn-close-modal-root" @onclick="Fermer">Fermer</button>
        </div>

    </div>
</div>

<style>
    /* ===== Design tokens ===== */
    .dialog-overlay-root {
        --ink: #0F172A;
        --ink-muted: #64748B;
        --ink-subtle: #94A3B8;
        --paper: #FFFFFF;
        --denim: #2B4C7E;
        --denim-hover: #1E3A60;
        --denim-light: #EEF3F9;
        --rust: #D96B43;
        --sand: #F8F9FB;
        --sand-border: #E7EAEF;
        --border-subtle: #E5E9F0;
        --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.06);
        --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.08), 0 1px 3px rgba(15, 23, 42, 0.06);
        --shadow-lg: 0 20px 50px -12px rgba(15, 23, 42, 0.25), 0 8px 20px -6px rgba(15, 23, 42, 0.12);
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        position: fixed;
        inset: 0;
        z-index: 1300;
        background: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        animation: fadeInRoot 0.18s var(--ease) both;
    }

    .dialog-card-root {
        background: var(--paper);
        border: 1px solid var(--sand-border);
        border-radius: 16px;
        width: 100%;
        max-width: 580px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: var(--shadow-lg);
        display: flex;
        flex-direction: column;
    }

        .dialog-card-root::-webkit-scrollbar {
            width: 6px;
        }

        .dialog-card-root::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 10px;
        }

    .dialog-accent-strip-root {
        height: 3px;
        background: linear-gradient(90deg, var(--denim) 0%, #4A6FA5 50%, var(--rust) 100%);
        border-radius: 16px 16px 0 0;
        flex-shrink: 0;
    }

    .dialog-header-root {
        border-bottom: 1px solid var(--border-subtle);
        background: var(--paper);
        flex-shrink: 0;
    }

    .modal-icon-badge-root {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: linear-gradient(135deg, var(--denim-light), #E3ECF6);
        color: var(--denim);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: inset 0 0 0 1px rgba(43, 76, 126, 0.08);
    }

    .modal-eyebrow-root {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: var(--denim);
        margin-bottom: 1px;
    }

    .modal-title-root {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.25;
        letter-spacing: -0.01em;
    }

    .dialog-close-btn-root {
        background: var(--sand);
        border: 1px solid transparent;
        color: var(--ink-muted);
        cursor: pointer;
        padding: 7px;
        border-radius: 9px;
        transition: all 0.15s var(--ease);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .dialog-close-btn-root:hover {
            background: #F1F5F9;
            border-color: var(--border-subtle);
            color: var(--ink);
        }

    .diagnostic-card-root {
        background: var(--sand);
        border: 1px solid var(--sand-border);
        border-radius: 12px;
        box-shadow: var(--shadow-sm);
    }

    .diag-title-root {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -0.01em;
    }

    .trend-badge-root {
        font-size: 0.64rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 4px 9px;
        border-radius: 20px;
    }

    .trend-cat {
        background: #FEF2F2;
        color: #DC2626;
        border: 1px solid #FECACA;
    }

    .trend-isolated {
        background: var(--denim-light);
        color: var(--denim);
        border: 1px solid rgba(43, 76, 126, 0.15);
    }

    .diag-text-root {
        font-size: 0.86rem;
        color: #334155;
        line-height: 1.6;
    }

    /* ===== GRILLE DES MÉTRIQUES (VERSION MODERNISÉE) ===== */
