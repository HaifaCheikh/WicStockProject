    private async Task EnsureIdentityResolvedAsync()
    {
        if (utilisateurId.HasValue && utilisateurId.Value > 0 && !string.IsNullOrEmpty(role))
        {
            return;
        }

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (string.IsNullOrEmpty(role))
            {
                role = await AuthService.ObtenirRole();
            }

            var idClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                          ?? authState.User.FindFirst("sub")?.Value
                          ?? authState.User.FindFirst("nameid")?.Value
                          ?? authState.User.FindFirst("id")?.Value;
            if (int.TryParse(idClaim, out var id))
            {
                utilisateurId = id;
            }

            if (!utilisateurId.HasValue || utilisateurId.Value <= 0)
            {
                var profil = await ProfilService.ObtenirMonProfil();
                if (profil != null)
                {
                    utilisateurId = profil.Id;
                    if (string.IsNullOrEmpty(role))
                    {
                        role = profil.Role;
                    }
                }
            }

            userIdentifier = utilisateurId?.ToString()
                            ?? idClaim
                            ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                            ?? authState.User.FindFirst("email")?.Value
                            ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                            ?? authState.User.Identity?.Name;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[EnsureIdentityResolved Error] {ex.Message}");
        }
    }

