    .assistant-page .item-conv-titre {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    }

    .assistant-page .item-conv-date {
    font-size: 0.72rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    }

    .assistant-page .item-conv-input-renommer {
