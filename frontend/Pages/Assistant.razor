    private async Task EnvoyerVersAssistantAvecCible(string question, MessageChat? msgCible = null)
    {
        if (conversationActive is null) return;

        var targetMsg = msgCible;
        bool estModificationEnPlace = targetMsg is not null;

        var generation = ++generationRequete;
        enChargement = true;
        await ScrollEnBas();

        // Sécurité : intercepter les questions d'inventaire interne et financières pour le rôle CLIENT
        if (string.Equals(role, "CLIENT", StringComparison.OrdinalIgnoreCase))
        {
            var qLower = question.ToLowerInvariant();
            if (qLower.Contains("chiffre d'affaire") || qLower.Contains("chiffre d'affaires") ||
                qLower.Contains("bénéfice") || qLower.Contains("marge") || qLower.Contains("cout de stockage") ||
                qLower.Contains("coût de stockage") || qLower.Contains("surstock") || qLower.Contains("rupture"))
            {
                if (generation == generationRequete)
                {
                    enChargement = false;
                }
                conversationActive.Messages.Add(new MessageChat
                {
                    Texte = "En tant que client, les données d'inventaire interne et financières ne sont pas accessibles. Vous pouvez consulter l'état de vos commandes, parcourir notre catalogue de vêtements et voir les articles les mieux notés !",
                    EstUtilisateur = false
                });
                conversationActive.DateModification = DateTime.Now;
                await SauvegarderConversationsDansStockage();
                await ScrollEnBas();
                StateHasChanged();
                return;
            }
        }

        var requeteToSend = new QuestionIARequest
        {
            SessionId = conversationActive.Id,
            Question = question,
            Role = role,
            UtilisateurId = utilisateurId
        };

        AssistantResponseDto? reponse = null;
        try
        {
            var chatReq = new ChatRequest
            {
                SessionId = conversationActive.Id,
                Message = question,
                Role = role,
                UtilisateurId = utilisateurId
            };
            reponse = await AssistantIAService.ChatAsync(chatReq);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[EnvoyerVersAssistant Error] {ex.Message}");
        }
        finally
        {
            if (generation == generationRequete)
            {
                enChargement = false;
                StateHasChanged();
            }
        }

        if (generation != generationRequete) return;

        var texteReponse = reponse?.Text;

        // Secours spécifique aux requêtes Client uniquement si le backend n'a renvoyé aucune réponse
        if (string.Equals(role, "CLIENT", StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(texteReponse))
        {
            var qLower = question.ToLowerInvariant();
            if (qLower.Contains("commande") || qLower.Contains("mes commandes"))
            {
                texteReponse = "Vous pouvez suivre à tout moment l'état et l'avancement de vos commandes en cours depuis l'espace 'Mes commandes'.";
            }
            else if (qLower.Contains("mieux noté") || qLower.Contains("notés") || qLower.Contains("avis"))
            {
                texteReponse = "Les articles les mieux notés par nos clients sont disponibles dans le catalogue produits ! Vous pouvez consulter les avis et évaluations détaillés sur chaque fiche produit.";
            }
            else
            {
                texteReponse = "Découvrez l'ensemble de notre collection ainsi que nos articles disponibles sur commande directement dans le catalogue produits !";
            }
        }
        else if (string.IsNullOrWhiteSpace(texteReponse))
        {
            texteReponse = "Erreur : impossible de contacter l'assistant. Veuillez vérifier que le service IA est en cours d'exécution.";
        }

        // Nettoyage de la question binaire superflue à la fin du texte
        if (!string.IsNullOrEmpty(texteReponse))
        {
            texteReponse = texteReponse
                .Replace("\n\n**Souhaitez-vous afficher ces résultats sous forme de graphique ?**", "")
                .Replace("\n**Souhaitez-vous afficher ces résultats sous forme de graphique ?**", "")
                .Replace("**Souhaitez-vous afficher ces résultats sous forme de graphique ?**", "")
                .TrimEnd();
        }

        // Harmonisation dynamique avec les données réelles du catalogue et du dashboard
        if (!string.IsNullOrEmpty(texteReponse) && texteReponse.Contains("surstock", StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                var tousProds = await ProduitService.ObtenirTous();
                var surstocksReels = tousProds.Where(p => !p.EstArchive && string.Equals(p.StatutIAType, "SURSTOCK", StringComparison.OrdinalIgnoreCase)).ToList();

                if (surstocksReels.Any())
                {
                    var matchHeader = System.Text.RegularExpressions.Regex.Match(texteReponse, @"Voici le\(s\)\s*\d+\s*produit\(s\)\s*en surstock\s*:", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                    if (matchHeader.Success)
                    {
                        var newHeader = $"Voici le(s) {surstocksReels.Count} produit(s) en surstock :";
                        texteReponse = texteReponse.Replace(matchHeader.Value, newHeader);

                        var lines = texteReponse.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None);
                        var filteredLines = new List<string>();
                        foreach (var line in lines)
                        {
                            var trimmed = line.Trim();
                            if (trimmed.StartsWith("-") || trimmed.StartsWith("*"))
                            {
                                bool isRealSurstock = surstocksReels.Any(p =>
                                    (!string.IsNullOrEmpty(p.Nom) && line.Contains(p.Nom, StringComparison.OrdinalIgnoreCase)) ||
                                    (!string.IsNullOrEmpty(p.Reference) && line.Contains(p.Reference, StringComparison.OrdinalIgnoreCase)));
                                if (isRealSurstock)
                                {
                                    filteredLines.Add(line);
                                }
                            }
                            else
                            {
                                filteredLines.Add(line);
                            }
                        }
                        texteReponse = string.Join("\n", filteredLines);
                    }
                }
            }
            catch (Exception exSync)
            {
                Console.WriteLine($"[ASSISTANT SYNC SURSTOCK ERROR] {exSync.Message}");
            }
        }

        var optionsCompletes = ObtenirOptionsFormatEtCouleur(reponse);
        var pendingStateFinal = reponse?.PendingState ?? (reponse?.Chart is not null ? "CHART_ACTIVE" : null);

        if (estModificationEnPlace && targetMsg is not null)
        {
            // METTRE À JOUR LE MESSAGE EXISTANT EN PLACE, SANS JAMAIS ÉCRASER SON TEXTE.
            // (déclenché uniquement par un clic sur un bouton d'option lié à CE message précis :
            // "Voir en graphique", choix de forme, choix de couleur…)
            // La réponse textuelle déjà affichée reste intacte ; seuls le graphique et les
            // options de configuration (forme/couleur) évoluent au fil des choix de l'utilisateur.
            if (reponse?.Chart is not null)
            {
                targetMsg.Chart = reponse.Chart;
            }
            else if (!string.IsNullOrWhiteSpace(texteReponse))
            {
                // Pas de graphique renvoyé à cette étape (ex: couleur non reconnue) :
                // on informe l'utilisateur via un toast plutôt que de remplacer le texte affiché.
                _ = AfficherToast(texteReponse);
            }

            targetMsg.Options = optionsCompletes;
            targetMsg.PendingState = pendingStateFinal;
            targetMsg.Horodatage = DateTime.Now;
        }
        else
        {
            // NOUVEAU MESSAGE POUR UNE NOUVELLE REQUÊTE
            conversationActive.Messages.Add(new MessageChat
            {
                Texte = texteReponse,
                EstUtilisateur = false,
                Chart = reponse?.Chart,
                Options = optionsCompletes,
                PendingState = pendingStateFinal
            });
        }

        conversationActive.DateModification = DateTime.Now;

        await SauvegarderConversationsDansStockage();
        await ScrollEnBas();
        StateHasChanged();
    }

    private void ArreterReflexion()
    {
        generationRequete++;
        enChargement = false;
    }

    // ===================== EDITION D'UN MESSAGE =====================

    private void EditerMessage(MessageChat msg)
    {
        messageEnEditionId = msg.Id;
        texteEdition = msg.Texte;
    }

    private void AnnulerEdition()
    {
        messageEnEditionId = null;
        texteEdition = string.Empty;
    }

    private async Task SauvegarderEdition(MessageChat msg)
    {
        if (string.IsNullOrWhiteSpace(texteEdition) || conversationActive is null) return;

        var index = conversationActive.Messages.IndexOf(msg);
        if (index < 0) return;

        var nouveauTexte = texteEdition.Trim();
        msg.Texte = nouveauTexte;
        messageEnEditionId = null;
        texteEdition = string.Empty;

        if (index + 1 < conversationActive.Messages.Count)
        {
            conversationActive.Messages.RemoveRange(index + 1, conversationActive.Messages.Count - index - 1);
        }

        conversationActive.DateModification = DateTime.Now;
        await SauvegarderConversationsDansStockage();
        await ScrollEnBas();

        await EnvoyerVersAssistant(nouveauTexte);
    }

    // ===================== SUPPRESSION D'UN MESSAGE =====================

    private void DemanderSuppressionMessage(string messageId)
    {
        messageIdASupprimer = messageId;
    }

    private void AnnulerSuppressionMessage()
    {
        messageIdASupprimer = null;
    }

    private async Task ConfirmerSuppressionMessage()
    {
        if (messageIdASupprimer is null || conversationActive is null)
        {
            messageIdASupprimer = null;
            return;
        }

        var msg = conversationActive.Messages.FirstOrDefault(m => m.Id == messageIdASupprimer);
        if (msg is not null)
        {
            var index = conversationActive.Messages.IndexOf(msg);
            if (index >= 0)
            {
                if (msg.EstUtilisateur &&
                    index + 1 < conversationActive.Messages.Count &&
                    !conversationActive.Messages[index + 1].EstUtilisateur)
                {
                    conversationActive.Messages.RemoveAt(index + 1);
                }

                conversationActive.Messages.RemoveAt(index);
                conversationActive.DateModification = DateTime.Now;

                await SauvegarderConversationsDansStockage();
            }
        }

        messageIdASupprimer = null;
    }

