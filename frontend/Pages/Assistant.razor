    private MarkupString FormaterMessageHtml(string? texteBrut)
    {
        if (string.IsNullOrWhiteSpace(texteBrut))
            return new MarkupString(string.Empty);

        var texte = NettoyerEncodage(texteBrut);

        texte = texte
            .Replace("\n\n**Souhaitez-vous afficher ces résultats sous forme de graphique ?**", "")
            .Replace("\n**Souhaitez-vous afficher ces résultats sous forme de graphique ?**", "")
            .Replace("**Souhaitez-vous afficher ces résultats sous forme de graphique ?**", "")
            .Trim();

        var html = System.Net.WebUtility.HtmlEncode(texte);

        html = System.Text.RegularExpressions.Regex.Replace(html, @"^###\s+(.*)$", "<h4>$1</h4>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^##\s+(.*)$", "<h3>$1</h3>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^#\s+(.*)$", "<h2>$1</h2>", System.Text.RegularExpressions.RegexOptions.Multiline);

        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.*?)\*\*", "<strong>$1</strong>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.*?)\*", "<em>$1</em>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"`(.*?)`", "<code class=\"inline-code\">$1</code>");

        var lines = html.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None);
        var sb = new System.Text.StringBuilder();
        bool inList = false;

        foreach (var line in lines)
        {
            var trimmed = line.Trim();
            if (trimmed.StartsWith("- ") || trimmed.StartsWith("* "))
            {
                if (!inList)
                {
                    sb.Append("<ul class=\"chat-msg-list\">");
                    inList = true;
                }
                var content = trimmed.Substring(2);
                sb.Append($"<li>{content}</li>");
            }
            else
            {
                if (inList)
                {
                    sb.Append("</ul>");
                    inList = false;
                }

                if (trimmed.StartsWith("<h2") || trimmed.StartsWith("<h3") || trimmed.StartsWith("<h4"))
                {
                    sb.Append(line);
                }
                else if (string.IsNullOrWhiteSpace(line))
                {
                    sb.Append("<div class=\"chat-msg-gap\"></div>");
                }
                else
                {
                    sb.Append($"<p>{line}</p>");
                }
            }
        }

        if (inList)
        {
            sb.Append("</ul>");
        }

        return new MarkupString(sb.ToString());
    }

