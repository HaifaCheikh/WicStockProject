<script>
    // Dictee vocale basee sur la Web Speech API
    window.wicstockVoice = window.wicstockVoice || (function () {
    let recognition = null;
    let dotNetRef = null;

    function estSupporte() {
    return ('webkitSpeechRecognition' in window) || ('SpeechRecognition' in window);
    }

    function demarrer(ref) {
    if (!estSupporte()) return false;
    const SpeechRecognitionCtor = window.SpeechRecognition || window.webkitSpeechRecognition;
    recognition = new SpeechRecognitionCtor();
    recognition.lang = 'fr-FR';
    recognition.continuous = false;
    recognition.interimResults = false;
    dotNetRef = ref;

    recognition.onresult = function (event) {
    const texte = event.results[0][0].transcript;
    if (dotNetRef) {
    dotNetRef.invokeMethodAsync('RecevoirTexteVocal', texte);
    }
    };

    recognition.onerror = function () {
    if (dotNetRef) {
    dotNetRef.invokeMethodAsync('SignalerErreurVocale');
    }
    };

    recognition.onend = function () {
    if (dotNetRef) {
    dotNetRef.invokeMethodAsync('SignalerFinEcoute');
    }
    };

    try {
    recognition.start();
    return true;
    } catch (e) {
    return false;
    }
    }

    function arreter() {
    if (recognition) {
    try { recognition.stop(); } catch (e) {}
    recognition = null;
    }
    }

    return {
    estSupporte: estSupporte,
    demarrer: demarrer,
    arreter: arreter
    };
    })();
</script>

