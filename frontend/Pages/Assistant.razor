<script>
    // Export Image PNG Haute Resolution
    window.wicstockExportPng = async function (elementId, titre) {
    const el = document.getElementById(elementId);
    if (!el) return;

    const nomFichier = (titre || 'Graphique_WicStock')
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '_')
