@page "/assistant"
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@using System.Text.Json
@using Microsoft.JSInterop
@using WicStock.Web.Models
@using WicStock.Web.Components
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ADMIN,RESPONSABLE_STOCK_PRODUCTION,CLIENT")]
@inject AssistantIAService AssistantIAService
@inject ProduitService ProduitService
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthService AuthService
@inject ProfilService ProfilService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Assistant IA - WicStock</PageTitle>

<HeadContent>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
</HeadContent>

<div class="assistant-page">
    <!-- ===================== SIDEBAR ===================== -->
    <aside class="sidebar">
        <button class="btn-nouvelle-conv" @onclick="() => DemarrerNouvelleConversation(sauvegarder: true)">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            <span>Nouvelle conversation</span>
        </button>

        <div class="liste-conversations">
            @if (!conversations.Any())
            {
                <div class="aucune-conv">Aucune conversation enregistr&#233;e</div>
            }
            else
            {
                @foreach (var conv in conversations.OrderByDescending(c => c.DateModification))
                {
                    var estActive = conversationActive?.Id == conv.Id;
                    var enRenommage = conversationIdEnRenommage == conv.Id;
                    <div class="item-conv @(estActive ? "item-conv--actif" : "")"
                         @onclick="() => { if (!enRenommage) SelectionnerConversation(conv); }">
                        <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Size="Size.Small" Class="item-conv-icon" />

                        <div class="item-conv-corps">
                            @if (enRenommage)
                            {
                                <input type="text" class="item-conv-input-renommer"
                                       @bind="texteRenommage"
                                       @bind:event="oninput"
                                       @onkeydown="(e) => GererToucheRenommage(e, conv)"
                                       @onblur="() => SauvegarderRenommage(conv)"
                                       @onclick:stopPropagation="true"
                                       @ref="inputRenommageRef" />
                            }
                            else
                            {
                                <div class="item-conv-titre" title="@conv.Titre">@conv.Titre</div>
                                <div class="item-conv-date">@conv.DateModification.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                        </div>

                        <div class="item-conv-actions" @onclick:stopPropagation="true">
                            @if (!enRenommage)
                            {
                                <button class="btn-conv-action" title="Renommer" @onclick="() => DemarrerRenommage(conv)">
                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                </button>
                                <button class="btn-conv-action btn-conv-action--danger" title="Supprimer" @onclick="() => DemanderSuppressionConversation(conv.Id)">
                                    <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </aside>

    <!-- ===================== CHAT CONTAINER ===================== -->
    <div class="chat-container">
        <div class="chat-header">
            <div class="assistant-avatar">
                <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Medium" />
            </div>
            <div>
                <h2>Assistant WicStock</h2>
                <p>Toujours pr&#234;t &#224; vous aider avec votre inventaire</p>
            </div>
        </div>

        <div class="chat-messages" id="zoneMessages">
            @if (conversationActive is not null)
            {
                @foreach (var msg in conversationActive.Messages)
                {
                    <div class="msg-ligne @(msg.EstUtilisateur ? "msg-ligne-user" : "msg-ligne-ia")">
                        <div class="avatar @(msg.EstUtilisateur ? "avatar-user" : "avatar-ia")">
                            <MudIcon Icon="@(msg.EstUtilisateur ? Icons.Material.Filled.Person : Icons.Material.Filled.SmartToy)" Size="Size.Small" />
                        </div>

                        <div class="msg-bloc">
                            <div class="msg-header">
                                <span class="msg-auteur">@(msg.EstUtilisateur ? "Vous" : "Assistant WicStock")</span>
                                <span class="msg-heure">@msg.Horodatage.ToString("HH:mm")</span>
                            </div>

                            @if (messageEnEditionId == msg.Id)
                            {
                                <div class="msg-edition">
                                    <textarea class="msg-edition-textarea" @bind="texteEdition" @bind:event="oninput"></textarea>
                                    <div class="msg-edition-actions">
                                        <button class="btn-mini btn-annuler" @onclick="AnnulerEdition">Annuler</button>
                                        <button class="btn-mini btn-valider" @onclick="() => SauvegarderEdition(msg)">Enregistrer</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="msg-content">
                                    @FormaterMessageHtml(msg.Texte)
                                </div>

                                @if (!msg.EstUtilisateur && msg.Options is not null && msg.PendingState is not null)
                                {
                                    <ChatOptionsButtons Options="@msg.Options"
                                                        PendingState="@msg.PendingState"
                                                        OnOptionSelected="(opt) => EnvoyerVersAssistantAvecCible(opt, msg)"
                                                        Disabled="@enChargement" />
                                }

                                @if (!msg.EstUtilisateur && msg.Chart is not null && msg.Chart.Labels.Any())
                                {
                                    var chartId = $"chart-box-{msg.Id}";
                                    var palette = msg.Chart.Colors ?? msg.Chart.CustomPalette;
                                    var chartKey = $"{msg.Chart.Type}-{msg.Id}-{string.Join("-", palette ?? Array.Empty<string>())}";
                                    <div class="msg-chart-container" id="@chartId">
                                        <div class="msg-chart-header">
                                            <div class="msg-chart-title">
                                                <MudIcon Icon="@(msg.Chart.Type == "donut" ? Icons.Material.Filled.DonutLarge : (msg.Chart.Type == "line" ? Icons.Material.Filled.ShowChart : Icons.Material.Filled.BarChart))" Size="Size.Small" Class="chart-title-icon" />
                                                <span>@msg.Chart.Title</span>
                                            </div>
                                            <div class="msg-chart-actions">
                                                <div class="btn-chart-action-wrap">
                                                    <button type="button" class="btn-chart-action btn-chart-action--zoom" title="Agrandir le graphique"
                                                            @onclick="() => OuvrirModalZoom(msg.Chart)">
                                                        <MudIcon Icon="@Icons.Material.Filled.Fullscreen" Size="Size.Small" />
                                                    </button>
                                                    <span class="btn-chart-tooltip" role="tooltip">Agrandir</span>
                                                </div>
                                                <div class="btn-chart-action-wrap">
                                                    <button type="button" class="btn-chart-action btn-chart-action--png" title="Enregistrer en Image PNG"
                                                            @onclick="() => ExporterChartPng(chartId, msg.Chart.Title)">
                                                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" />
                                                    </button>
                                                    <span class="btn-chart-tooltip" role="tooltip">Image PNG</span>
                                                </div>
                                                <div class="btn-chart-action-wrap">
                                                    <button type="button" class="btn-chart-action btn-chart-action--pdf" title="Exporter en Document PDF"
                                                            @onclick="() => ExporterChartPdf(chartId, msg.Chart.Title)">
                                                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" />
                                                    </button>
                                                    <span class="btn-chart-tooltip" role="tooltip">Document PDF</span>
                                                </div>
                                            </div>
                                        </div>

                                        @if (msg.Chart.Type == "donut")
                                        {
                                            <WicStockDonutChart @key="chartKey"
                                                                Labels="@msg.Chart.Labels"
                                                                Series="@msg.Chart.Series"
                                                                CustomPalette="@palette"
                                                                Title="@msg.Chart.Title"
                                                                Width="100%"
                                                                Height="260px"
                                                                MaxChartSize="320"
                                                                UserRole="@role"
                                                                OnDrillDown="NaviguerDrillDown" />
                                        }
                                        else if (msg.Chart.Type == "line")
                                        {
                                            <WicStockLineChart @key="chartKey"
                                                               Labels="@msg.Chart.Labels"
                                                               Series="@msg.Chart.Series"
                                                               CustomPalette="@palette"
                                                               Width="100%" />
                                        }
                                        else if (msg.Chart.Type == "boxplot")
                                        {
                                            <WicStockBoxPlotChart @key="chartKey"
                                                                  Labels="@msg.Chart.Labels"
                                                                  Series="@msg.Chart.Series"
                                                                  CustomPalette="@palette"
                                                                  Width="100%" />
                                        }
                                        else if (msg.Chart.Type == "waterfall")
                                        {
                                            <WicStockWaterfallChart @key="chartKey"
                                                                    Labels="@msg.Chart.Labels"
                                                                    Series="@msg.Chart.Series"
                                                                    CustomPalette="@palette"
                                                                    Width="100%" />
                                        }
                                        else if (msg.Chart.Type == "gauge")
                                        {
                                            <WicStockGaugeChart @key="chartKey"
                                                                Labels="@msg.Chart.Labels"
                                                                Series="@msg.Chart.Series"
                                                                CustomPalette="@palette"
                                                                Width="100%" />
                                        }
                                        else if (msg.Chart.Type == "radar")
                                        {
                                            <WicStockRadarChart @key="chartKey"
                                                                Labels="@msg.Chart.Labels"
                                                                Series="@msg.Chart.Series"
                                                                CustomPalette="@palette"
                                                                Width="100%" />
                                        }
                                        else if (msg.Chart.Type == "treemap")
                                        {
                                            <WicStockTreemapChart @key="chartKey"
                                                                  Labels="@msg.Chart.Labels"
                                                                  Series="@msg.Chart.Series"
                                                                  CustomPalette="@palette"
                                                                  Width="100%" />
                                        }
                                        else if (msg.Chart.Type == "funnel")
                                        {
                                            <WicStockFunnelChart @key="chartKey"
                                                                 Labels="@msg.Chart.Labels"
                                                                 Series="@msg.Chart.Series"
                                                                 CustomPalette="@palette"
                                                                 Width="100%" />
                                        }
                                        else if (msg.Chart.Type == "scatter")
                                        {
                                            <WicStockScatterChart @key="chartKey"
                                                                  Labels="@msg.Chart.Labels"
                                                                  Series="@msg.Chart.Series"
                                                                  CustomPalette="@palette"
                                                                  Width="100%" />
                                        }
                                        else
                                        {
                                            <WicStockBarChart @key="chartKey"
                                                              Labels="@msg.Chart.Labels"
                                                              Series="@msg.Chart.Series"
                                                              CustomPalette="@palette"
                                                              Width="100%"
                                                              MaxBars="8"
                                                                UserRole="@role"
                                                                OnDrillDown="NaviguerDrillDown" />
                                        }
                                    </div>
                                }

                                <div class="msg-actions @(msg.EstUtilisateur ? "msg-actions--user" : "msg-actions--ia")">
                                    <button class="btn-icone" title="Copier le message" @onclick="() => CopierMessage(msg)">
                                        <MudIcon Icon="@(messageIdCopie == msg.Id ? Icons.Material.Filled.Check : Icons.Material.Filled.ContentCopy)" Size="Size.Small" />
                                    </button>

                                    @if (msg.EstUtilisateur)
                                    {
                                        <button class="btn-icone" title="Modifier" @onclick="() => EditerMessage(msg)">
                                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                        </button>
                                        <button class="btn-icone" title="Supprimer" @onclick="() => DemanderSuppressionMessage(msg.Id)">
                                            <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            @if (enChargement)
            {
                <div class="msg-ligne msg-ligne-ia">
                    <div class="avatar avatar-ia avatar-sans-header">
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" />
                    </div>
                    <div class="msg-bloc">
                        <div class="msg-content msg-typing">
                            <span class="dot"></span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ===================== QUICK PROMPTS (SUGGESTIONS) ===================== -->
        @{
            var suggestions = WicStockChartConfig.ObtenirSuggestionsParRole(role);
            var suggestionsAffichees = afficherToutesSuggestions ? suggestions : suggestions.Take(4).ToList();
        }
        @if (suggestions.Any())
        {
            <div class="quick-prompts-bar">
                <div class="quick-prompts-list">
                    @foreach (var prompt in suggestionsAffichees)
                    {
                        <button type="button" class="chip-prompt" @onclick="() => EnvoyerQuestionSuggeree(prompt.Question)" disabled="@enChargement" title="@prompt.Question">
                            <MudIcon Icon="@prompt.Icon" Size="Size.Small" Class="chip-icon" />
                            <span>@prompt.Label</span>
                        </button>
                    }
                    @if (suggestions.Count > 4)
                    {
                        <button type="button" class="chip-prompt chip-prompt--toggle" @onclick="() => afficherToutesSuggestions = !afficherToutesSuggestions">
                            <MudIcon Icon="@(afficherToutesSuggestions ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                            <span>@(afficherToutesSuggestions ? "Réduire" : $"+{suggestions.Count - 4} suggestions")</span>
                        </button>
                    }
                </div>
            </div>
        }

        <EditForm Model="@modele" OnValidSubmit="Envoyer" class="chat-input-form">
            <InputText class="form-control" @bind-Value="modele.Question"
                       placeholder="@(enregistrementVocalEnCours ? "Je vous écoute..." : "Posez votre question (ex: Quels sont les produits en rupture de stock ?)...")" />

            <button type="button" class="btn btn-mic @(enregistrementVocalEnCours ? "btn-mic--actif" : "")"
                    title="@(enregistrementVocalEnCours ? "Arrêter l'enregistrement" : "Dicter un message vocal")"
                    @onclick="BasculerEnregistrementVocal" disabled="@enChargement">
                <MudIcon Icon="@(enregistrementVocalEnCours ? Icons.Material.Filled.Stop : Icons.Material.Filled.Mic)" Size="Size.Small" />
            </button>

            @if (enChargement)
            {
                <button type="button" class="btn btn-stop" title="Arrêter la génération" @onclick="ArreterReflexion">
                    <MudIcon Icon="@Icons.Material.Filled.Stop" Size="Size.Small" />
                </button>
            }
            else
            {
                <button type="submit" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(modele.Question)">
                    <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />
                </button>
            }
        </EditForm>
    </div>

    <!-- ===================== MODAL ZOOM GRAPHIQUE ===================== -->
    @if (chartZoom is not null)
    {
        <div class="modal-overlay" @onclick="FermerModalZoom">
            <div class="modal-box modal-box--chart-zoom" id="modal-zoom-box" @onclick:stopPropagation="true">
                <div class="modal-zoom-header">
                    <div class="modal-zoom-title">
                        <MudIcon Icon="@(chartZoom.Type == "donut" ? Icons.Material.Filled.DonutLarge : (chartZoom.Type == "line" ? Icons.Material.Filled.ShowChart : Icons.Material.Filled.BarChart))" Size="Size.Medium" Class="chart-title-icon" />
                        <h3>@chartZoom.Title</h3>
                    </div>
                    <div class="modal-zoom-actions">
                        <button type="button" class="btn-zoom-action btn-zoom-action--png" title="Enregistrer en image PNG"
                                @onclick='() => ExporterChartPng("modal-zoom-box", chartZoom.Title)'>
                            <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" />
                            <span>Image PNG</span>
                        </button>
                        <button type="button" class="btn-zoom-action btn-zoom-action--pdf" title="Exporter en document PDF"
                                @onclick='() => ExporterChartPdf("modal-zoom-box", chartZoom.Title)'>
                            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" />
                            <span>Document PDF</span>
                        </button>
                        <button type="button" class="btn-icone-fermer" title="Fermer" @onclick="FermerModalZoom">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        </button>
                    </div>
                </div>
                <div class="modal-zoom-body" id="modal-zoom-container">
                    @if (chartZoom.Type == "donut")
                    {
                        var zoomPalette = chartZoom.Colors ?? chartZoom.CustomPalette;
                        <WicStockDonutChart Labels="@chartZoom.Labels"
                                            Series="@chartZoom.Series"
                                            CustomPalette="@zoomPalette"
                                            Title="@chartZoom.Title"
                                            Width="100%"
                                            Height="380px"
                                            MaxChartSize="420"
                                            UserRole="@role"
                                            OnDrillDown="NaviguerDrillDown" />
                    }
                    else if (chartZoom.Type == "line")
                    {
                        var zoomPalette = chartZoom.Colors ?? chartZoom.CustomPalette;
                        <WicStockLineChart Labels="@chartZoom.Labels"
                                           Series="@chartZoom.Series"
                                           CustomPalette="@zoomPalette"
                                           Width="100%"
                                           MaxPoints="15" />
                    }
                    else if (chartZoom.Type == "boxplot")
                    {
                        var zoomPalette = chartZoom.Colors ?? chartZoom.CustomPalette;
                        <WicStockBoxPlotChart Labels="@chartZoom.Labels"
                                              Series="@chartZoom.Series"
                                              CustomPalette="@zoomPalette"
                                              Width="100%"
                                              MaxItems="15" />
                    }
                    else if (chartZoom.Type == "waterfall")
                    {
                        var zoomPalette = chartZoom.Colors ?? chartZoom.CustomPalette;
                        <WicStockWaterfallChart Labels="@chartZoom.Labels"
                                                Series="@chartZoom.Series"
                                                CustomPalette="@zoomPalette"
                                                Width="100%"
                                                MaxItems="15" />
                    }
                    else if (chartZoom.Type == "gauge")
                    {
                        var zoomPalette = chartZoom.Colors ?? chartZoom.CustomPalette;
                        <WicStockGaugeChart Labels="@chartZoom.Labels"
                                            Series="@chartZoom.Series"
                                            CustomPalette="@zoomPalette"
                                            Width="100%" />
                    }
                    else if (chartZoom.Type == "radar")
                    {
                        var zoomPalette = chartZoom.Colors ?? chartZoom.CustomPalette;
                        <WicStockRadarChart Labels="@chartZoom.Labels"
                                            Series="@chartZoom.Series"
                                            CustomPalette="@zoomPalette"
                                            Width="100%" />
                    }
                    else if (chartZoom.Type == "treemap")
                    {
                        var zoomPalette = chartZoom.Colors ?? chartZoom.CustomPalette;
                        <WicStockTreemapChart Labels="@chartZoom.Labels"
                                              Series="@chartZoom.Series"
                                              CustomPalette="@zoomPalette"
                                              Width="100%"
                                              MaxTiles="15" />
                    }
                    else if (chartZoom.Type == "funnel")
                    {
                        var zoomPalette = chartZoom.Colors ?? chartZoom.CustomPalette;
                        <WicStockFunnelChart Labels="@chartZoom.Labels"
                                             Series="@chartZoom.Series"
                                             CustomPalette="@zoomPalette"
                                             Width="100%"
                                             MaxSteps="10" />
                    }
                    else if (chartZoom.Type == "scatter")
                    {
                        var zoomPalette = chartZoom.Colors ?? chartZoom.CustomPalette;
                        <WicStockScatterChart Labels="@chartZoom.Labels"
                                              Series="@chartZoom.Series"
                                              CustomPalette="@zoomPalette"
                                              Width="100%"
                                              MaxPoints="15" />
                    }
                    else
                    {
                        var zoomPalette = chartZoom.Colors ?? chartZoom.CustomPalette;
                        <WicStockBarChart Labels="@chartZoom.Labels"
                                          Series="@chartZoom.Series"
                                          CustomPalette="@zoomPalette"
                                          Width="100%"
                                          MaxBars="15"
                                            UserRole="@role"
                                            OnDrillDown="NaviguerDrillDown" />
                    }
                </div>
            </div>
        </div>
    }

    <!-- ===================== MODAL CONFIRMATION SUPPRESSION CONVERSATION ===================== -->
    @if (conversationIdASupprimer is not null)
    {
        <div class="modal-overlay" @onclick="AnnulerSuppressionConversation">
            <div class="modal-box" @onclick:stopPropagation="true">
                <div class="modal-icon-danger">
                    <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Medium" />
                </div>
                <h4>Supprimer cette conversation ?</h4>
                <p>Cette action est irr&#233;versible. Tous les messages de cette conversation seront d&#233;finitivement supprim&#233;s.</p>
                <div class="modal-actions">
                    <button class="btn-mini btn-annuler" @onclick="AnnulerSuppressionConversation">Annuler</button>
                    <button class="btn-mini btn-danger" @onclick="ConfirmerSuppressionConversation">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" Class="mr-1" />
                        Supprimer
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ===================== MODAL CONFIRMATION SUPPRESSION MESSAGE ===================== -->
    @if (messageIdASupprimer is not null)
    {
        <div class="modal-overlay" @onclick="AnnulerSuppressionMessage">
            <div class="modal-box" @onclick:stopPropagation="true">
                <div class="modal-icon-danger">
                    <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Medium" />
                </div>
                <h4>Supprimer ce message ?</h4>
                <p>Cette action est irr&#233;versible. S'il s'agit de votre question, la r&#233;ponse de l'assistant qui la suit sera &#233;galement supprim&#233;e.</p>
                <div class="modal-actions">
                    <button class="btn-mini btn-annuler" @onclick="AnnulerSuppressionMessage">Annuler</button>
                    <button class="btn-mini btn-danger" @onclick="ConfirmerSuppressionMessage">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" Class="mr-1" />
                        Supprimer
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ===================== TOAST NOTIFICATION ===================== -->
    @if (messageToast is not null)
    {
        <div class="toast-notification">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
            <span>@messageToast</span>
        </div>
    }
</div>

<style>
    .assistant-page {
    --ink: #16233A;
    --ink-muted: #64748B;
    --paper: #FFFFFF;
    --bg: #F8FAFC;
    --sand: #F6F8FB;
    --sand-tint: #F1F5F9;
    --border: #E2E8F0;
    --denim: #2B4C7E;
    --denim-dark: #1E3A63;
    --denim-tint: #EAF0F8;
    --rust: #B5563A;
    --rust-soft: #F9ECE8;
    --pine: #1E6B4C;
    --amber: #D97706;
    --danger: #EF4444;
    --danger-tint: #FEE2E2;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --font-heading: "Sora", "Inter", sans-serif;
    --font-body: "Inter", sans-serif;
    --font-mono: "JetBrains Mono", monospace;
    display: flex;
    height: calc(100vh - 84px);
    background: var(--bg);
    gap: 16px;
    padding: 16px;
    box-sizing: border-box;
    font-family: var(--font-body);
    color: var(--ink);
    }

    /* ---------- SIDEBAR ---------- */
    .assistant-page .sidebar {
    width: 280px;
    min-width: 280px;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    }

    .assistant-page .btn-nouvelle-conv {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px;
    border: none;
    border-radius: var(--radius-sm);
    background: var(--denim);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.15s ease;
    box-shadow: 0 6px 16px -6px rgba(43, 76, 126, 0.4);
    }

    .assistant-page .btn-nouvelle-conv:hover {
    background: var(--denim-dark);
    }

    .assistant-page .liste-conversations {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-right: 2px;
    }

    .assistant-page .aucune-conv {
    color: var(--ink-muted);
    font-size: 0.85rem;
    text-align: center;
    margin-top: 24px;
    }

    .assistant-page .item-conv {
