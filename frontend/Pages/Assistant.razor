    .trim();

    const btns = el.querySelectorAll('.msg-chart-actions, .btn-chart-action-wrap, .modal-zoom-actions, .btn-export-pdf-wrap, .btn-icone-fermer');
    btns.forEach(b => b.style.visibility = 'hidden');

    try {
    if (!window.html2canvas) {
    console.error('html2canvas non charge');
    return;
    }

    const canvas = await html2canvas(el, {
    scale: 2.5,
    backgroundColor: '#ffffff',
    useCORS: true,
    logging: false,
    scrollX: 0,
    scrollY: 0
    });

    const a = document.createElement('a');
    a.download = nomFichier + '.png';
    a.href = canvas.toDataURL('image/png', 1.0);
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    } catch (e) {
    console.error('[wicstockExportPng]', e);
    } finally {
    btns.forEach(b => b.style.visibility = '');
    }
    };

    // Export Document PDF Haute Definition A4 Paysage
    window.wicstockExportPdf = async function (elementId, titre) {
    const el = document.getElementById(elementId);
    if (!el) return;

    const nomFichier = (titre || 'Graphique_WicStock')
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '_')
    .replace(/_+/g, '_')
    .trim();

    const btns = el.querySelectorAll('.msg-chart-actions, .btn-chart-action-wrap, .modal-zoom-actions, .btn-export-pdf-wrap, .btn-icone-fermer');
    btns.forEach(b => b.style.visibility = 'hidden');

    try {
    if (!window.html2canvas) {
    console.error('html2canvas non charge');
    return;
    }

    const canvas = await html2canvas(el, {
    scale: 2.5,
    backgroundColor: '#ffffff',
    useCORS: true,
    logging: false,
    scrollX: 0,
    scrollY: 0
    });

    const jspdfModule = window.jspdf ? window.jspdf.jsPDF : (window.jsPDF || null);
    if (!jspdfModule) {
    console.error('jsPDF non charge');
    return;
    }

    const pdf = new jspdfModule({ orientation: 'landscape', unit: 'mm', format: 'a4' });
    const pdfW = 297;
    const pdfH = 210;
    const margin = 15;
    const maxW = pdfW - margin * 2;
    const maxH = pdfH - margin * 2;

    const ratio = Math.min(maxW / canvas.width, maxH / canvas.height);
    const imgW = canvas.width * ratio;
    const imgH = canvas.height * ratio;
    const posX = (pdfW - imgW) / 2;
    const posY = (pdfH - imgH) / 2;

    const imgData = canvas.toDataURL('image/png', 1.0);
    pdf.addImage(imgData, 'PNG', posX, posY, imgW, imgH);
    pdf.save(nomFichier + '.pdf');
    } catch (e) {
    console.error('[wicstockExportPdf]', e);
    } finally {
    btns.forEach(b => b.style.visibility = '');
    }
    };
