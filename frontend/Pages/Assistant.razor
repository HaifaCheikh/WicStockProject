    // ===================== ASSISTANT VOCAL =====================

    private async Task BasculerEnregistrementVocal()
    {
        if (enregistrementVocalEnCours)
        {
            await JS.InvokeVoidAsync("wicstockVoice.arreter");
            return;
        }

        var supporte = await JS.InvokeAsync<bool>("wicstockVoice.estSupporte");
        if (!supporte)
        {
            await AfficherToast("La dictée vocale n'est pas prise en charge par ce navigateur.");
            return;
        }

        enregistrementVocalEnCours = true;
        var demarre = await JS.InvokeAsync<bool>("wicstockVoice.demarrer", refDotNet);
        if (!demarre)
        {
            enregistrementVocalEnCours = false;
            await AfficherToast("Impossible de démarrer le microphone.");
        }
    }

    [JSInvokable]
    public void RecevoirTexteVocal(string texte)
    {
        if (!string.IsNullOrWhiteSpace(texte))
        {
            modele.Question = string.IsNullOrWhiteSpace(modele.Question)
                ? texte
                : $"{modele.Question.TrimEnd()} {texte}";
        }

        enregistrementVocalEnCours = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void SignalerErreurVocale()
    {
        enregistrementVocalEnCours = false;
        _ = AfficherToast("La reconnaissance vocale a rencontré une erreur. Veuillez réessayer.");
    }

    [JSInvokable]
    public void SignalerFinEcoute()
    {
        enregistrementVocalEnCours = false;
        StateHasChanged();
    }

    // ===================== STOCKAGE LOCAL (LocalStorage) =====================

    private async Task ChargerConversationsDepuisStockage()
    {
        try
        {
            await EnsureIdentityResolvedAsync();

            try
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", "wicstock_assistant_conversations_v1");
            }
            catch { }

            var cle = ObtenirCleStockage();
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", cle);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var chargees = JsonSerializer.Deserialize<List<Conversation>>(json, options);
                if (chargees is not null && chargees.Any())
                {
                    conversations = chargees;
                    conversationActive = conversations.OrderByDescending(c => c.DateModification).First();
                    modele = new QuestionIARequest { SessionId = conversationActive.Id };
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ChargerConversations Error] {ex.Message}");
        }

        DemarrerNouvelleConversation(sauvegarder: true);
    }

    private async Task SauvegarderConversationsDansStockage()
    {
        try
        {
            await EnsureIdentityResolvedAsync();
            var cle = ObtenirCleStockage();
            var options = new JsonSerializerOptions { WriteIndented = false };
            var json = JsonSerializer.Serialize(conversations, options);
            await JS.InvokeVoidAsync("localStorage.setItem", cle, json);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SauvegarderConversations Error] {ex.Message}");
        }
    }

    private async Task ScrollEnBas()
    {
        try
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("eval", "var el = document.getElementById('zoneMessages'); if(el) el.scrollTop = el.scrollHeight;");
        }
        catch { }
    }

    private async Task AfficherToast(string message)
    {
        messageToast = message;
        StateHasChanged();
        await Task.Delay(3000);
        if (messageToast == message)
        {
            messageToast = null;
            StateHasChanged();
        }
    }

