@page "/forgot-password"
@layout WicStock.Web.Layout.AuthLayout
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="auth-page">
    <div class="d-flex justify-center align-center mud-width-full" style="min-height: 80vh; position: relative; z-index: 1;">
        <div class="auth-card">
            <div class="auth-header">
                <span class="brand-mark">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
                        <path d="M3 8 L21 8 M3 12 L21 12 M3 16 L21 16" stroke="#fff" stroke-width="2" stroke-linecap="round" />
                        <path d="M7 4 L7 20 M12 4 L12 20 M17 4 L17 20" stroke="rgba(255,255,255,0.55)" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                </span>
                <MudText Typo="Typo.h4" Align="Align.Center" Class="auth-title">Mot de passe oublié</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="auth-subtitle mt-1">
                    @(step == 1 ? "Choisissez votre méthode pour recevoir un code de réinitialisation" : "Saisissez le code reçu et votre nouveau mot de passe")
                </MudText>
            </div>

            @if (step == 1)
            {
                <EditForm Model="@forgotModel" OnValidSubmit="RequestCode">
                    <DataAnnotationsValidator />

                    <MudSelect T="string" @bind-Value="forgotModel.Methode"
                               Label="Méthode de récupération"
                               Variant="Variant.Outlined"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.Send"
                               Class="soft-field mb-4">
                        <MudSelectItem Value="@("Email")">E-mail</MudSelectItem>
                        <MudSelectItem Value="@("WhatsApp")">WhatsApp</MudSelectItem>
                    </MudSelect>

                    @if (forgotModel.Methode == "Email")
                    {
                        <MudTextField @bind-Value="forgotModel.Identifiant"
                                      Label="Adresse email"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      Class="soft-field mb-4" />
                    }
                    else
                    {
                        <MudTextField @bind-Value="forgotModel.Identifiant"
                                      Label="Numéro WhatsApp"
                                      Variant="Variant.Outlined"
                                      Placeholder="Ex: +21625896532"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Phone"
                                      Class="soft-field mb-4" />
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="error-alert my-4">@errorMessage</div>
                    }

                    <button type="submit" class="btn btn--primary btn--full" disabled="@isLoading">
                        @(isLoading ? "Envoi en cours..." : "Obtenir le code")
                    </button>
                </EditForm>
            }
            else
            {
                <EditForm Model="@resetModel" OnValidSubmit="ResetPassword">
                    <DataAnnotationsValidator />

                    <div class="success-alert mb-4">
                        @(string.IsNullOrEmpty(successMessage) ? $"Un code a été généré pour {forgotModel.Identifiant} via {forgotModel.Methode}." : successMessage)
                    </div>

                    @if (!string.IsNullOrEmpty(whatsAppLink))
                    {
                        <a href="@whatsAppLink" target="_blank" class="btn btn--whatsapp btn--full mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                            <span>Ouvrir WhatsApp pour tester le message</span>
                        </a>
                    }

                    <MudTextField @bind-Value="resetModel.Code"
                                  Label="Code de validation (6 chiffres)"
                                  Variant="Variant.Outlined"
                                  MaxLength="6"
                                  Required="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Pin"
                                  UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "off" } })"
                                  Class="soft-field mb-4" />

                    <div class="password-wrapper mb-4">
                        <MudTextField @bind-Value="resetModel.NouveauMotDePasse"
                                      Label="Nouveau mot de passe"
                                      Variant="Variant.Outlined"
                                      InputType="@passwordInputType"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock"
                                      UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "new-password" } })"
                                      Class="soft-field password-input" />
                        <button type="button"
                                class="password-toggle-btn"
                                @onclick="TogglePasswordVisibility"
                                aria-label="Afficher/masquer le mot de passe">
                            <MudIcon Icon="@passwordIcon" Size="Size.Small" />
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="error-alert my-4">@errorMessage</div>
                    }

                    <button type="submit" class="btn btn--primary btn--full" disabled="@isLoading">
                        @(isLoading ? "Enregistrement..." : "Réinitialiser le mot de passe")
                    </button>

                    <button type="button" class="btn btn--text btn--full mt-2" @onclick="() => { step = 1; errorMessage = null; }">
                        Retour
                    </button>
                </EditForm>
            }

            <div class="auth-footer">
                <a href="/login" class="link link--strong">Retour à la connexion</a>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-page {
        --ink: #16233A;
        --ink-muted: #64748B;
        --paper: #FFFFFF;
        --border-soft: #E1E7EF;
        --primary: #2B4C7E;
        --primary-dark: #14263F;
        --primary-tint: #E7EDF6;
        --danger: #A23B2E;
        --danger-tint: #F7E9E6;
        --success: #1D7A4C;
        --success-tint: #E5F3EB;
        --radius-sm: 14px;
        --radius-lg: 26px;
        --font-display: "Sora", "Inter", sans-serif;
        --font-body: "Inter", sans-serif;
        position: relative;
        overflow: hidden;
        width: 100%;
        height: 100%;
        font-family: var(--font-body);
        color: var(--ink);
        background: transparent;
    }

        .auth-page .auth-card {
            width: 100%;
            max-width: 440px;
            background: var(--paper);
            border-radius: var(--radius-lg);
            padding: 44px 40px;
            box-shadow: 0 30px 60px -30px rgba(43,76,126,0.25), 0 2px 8px rgba(22,35,58,0.04);
        }

        .auth-page .auth-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .auth-page .brand-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: var(--primary);
            margin-bottom: 18px;
            box-shadow: 0 10px 22px -8px rgba(43,76,126,0.45);
        }

        .auth-page .auth-title {
            font-family: var(--font-display);
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -0.02em;
        }

        .auth-page .auth-subtitle {
            color: var(--ink-muted);
        }

        .auth-page .soft-field .mud-input-outlined-border {
            border-radius: var(--radius-sm) !important;
            border-color: var(--border-soft) !important;
            border-width: 1.5px !important;
        }

        .auth-page .soft-field:hover .mud-input-outlined-border {
            border-color: var(--primary) !important;
        }

        .auth-page .soft-field:focus-within .mud-input-outlined-border {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 3px var(--primary-tint);
        }

        .auth-page .soft-field .mud-input-label {
            color: var(--ink-muted) !important;
        }

            .auth-page .soft-field:focus-within .mud-input-label,
            .auth-page .soft-field .mud-input-label.mud-input-label-outlined.mud-shrink {
                color: var(--primary) !important;
            }

        .auth-page .soft-field .mud-icon-root {
            color: var(--ink-muted);
        }

        .auth-page .soft-field:focus-within .mud-icon-root {
            color: var(--primary);
        }

        .auth-page .soft-field .mud-input-root {
            padding-top: 14px;
            padding-bottom: 14px;
        }

        .auth-page .password-wrapper {
            position: relative;
        }

        .auth-page .password-toggle-btn {
            position: absolute;
            top: 50%;
            right: 14px;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--ink-muted);
            z-index: 2;
        }

            .auth-page .password-toggle-btn:hover {
                color: var(--primary);
            }

        .auth-page .password-input input {
            padding-right: 40px !important;
        }

        .auth-page .link {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--primary);
            text-decoration: none;
        }

            .auth-page .link:hover {
                text-decoration: underline;
            }

        .auth-page .link--strong {
            font-weight: 600;
        }

        .auth-page .error-alert {
            background: var(--danger-tint);
            color: var(--danger);
            border-radius: var(--radius-sm);
            padding: 12px 16px;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .auth-page .success-alert {
            background: var(--success-tint);
            color: var(--success);
            border-radius: var(--radius-sm);
            padding: 12px 16px;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .auth-page .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            border-radius: var(--radius-sm);
            padding: 14px 20px;
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 0.9375rem;
            cursor: pointer;
            transition: background-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
            margin-top: 16px;
        }

            .auth-page .btn:disabled {
                opacity: 0.6;
                cursor: not-allowed;
                transform: none;
            }

        .auth-page .btn--full {
            width: 100%;
        }

        .auth-page .btn--primary {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 6px 16px -6px rgba(43,76,126,0.4);
        }

            .auth-page .btn--primary:hover:not(:disabled) {
                background: var(--primary-dark);
                transform: translateY(-1px);
            }

        .auth-page .btn--whatsapp {
            background: var(--success);
            color: #fff;
            box-shadow: 0 12px 24px -10px rgba(29,122,76,0.45);
        }

            .auth-page .btn--whatsapp:hover {
                background: #16613C;
            }

        .auth-page .btn--text {
            background: transparent;
            color: var(--ink-muted);
            box-shadow: none;
            margin-top: 4px;
        }

            .auth-page .btn--text:hover {
                color: var(--primary);
            }

        .auth-page .auth-footer {
            text-align: center;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid var(--border-soft);
        }

    @@media (prefers-reduced-motion: reduce) {
        .auth-page .btn {
            transition: none;
        }
    }
</style>

@code {
    private ForgotPasswordDto forgotModel = new();
    private ResetPasswordDto resetModel = new();
    private int step = 1;
    private bool isLoading = false;
    private string? errorMessage;
    private string? successMessage;
    private string? whatsAppLink;

    private bool afficherMotDePasse = false;
    private InputType passwordInputType = InputType.Password;
    private string passwordIcon = Icons.Material.Filled.VisibilityOff;

    protected override void OnInitialized()
    {
        forgotModel = new ForgotPasswordDto();
        resetModel = new ResetPasswordDto();
        step = 1;
        errorMessage = null;
        successMessage = null;
        whatsAppLink = null;
        afficherMotDePasse = false;
        passwordInputType = InputType.Password;
        passwordIcon = Icons.Material.Filled.VisibilityOff;
    }

    private void TogglePasswordVisibility()
    {
        afficherMotDePasse = !afficherMotDePasse;
        passwordInputType = afficherMotDePasse ? InputType.Text : InputType.Password;
        passwordIcon = afficherMotDePasse ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task RequestCode()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        var (success, msg, link) = await AuthService.ForgotPassword(forgotModel);

        isLoading = false;

        if (success)
        {
            successMessage = msg;
            whatsAppLink = link;
            resetModel = new ResetPasswordDto { Identifiant = forgotModel.Identifiant };
            step = 2;
            Snackbar.Add("Code généré avec succès !", Severity.Success);
        }
        else
        {
            errorMessage = msg;
        }
    }

    private async Task ResetPassword()
    {
        isLoading = true;
        errorMessage = null;

        var (success, msg) = await AuthService.ResetPassword(resetModel);

        isLoading = false;

        if (success)
        {
            Snackbar.Add("Votre mot de passe a été modifié avec succès.", Severity.Success);
            Navigation.NavigateTo("/login");
        }
        else
        {
            errorMessage = msg;
        }
    }
}
