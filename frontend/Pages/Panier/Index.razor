@code {
    private List<CartItemDto> items = new();
    private bool commandeEnCours = false;
    private CommandeStockErrorClientDto? erreurStock = null;
    private CommandeMultiResultClientDto? commandeSucces = null;
    private HashSet<int> suppressionsEnCours = new();

    protected override async Task OnInitializedAsync()
    {
        items = await CartService.GetItemsAsync();
        CartService.OnCartChanged += HandleCartChanged;
    }

    private async void HandleCartChanged() => await RechercherItems();

    private async Task RechercherItems()
    {
        items = await CartService.GetItemsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ChangerQuantite(CartItemDto item, int nouvelleQty)
    {
        await CartService.UpdateQuantityAsync(item.ProduitId, nouvelleQty);
        items = await CartService.GetItemsAsync();
        StateHasChanged();
    }

    private async Task SupprimerArticle(int produitId)
    {
        suppressionsEnCours.Add(produitId);
        StateHasChanged();
        await Task.Delay(250);
        await CartService.RemoveFromCartAsync(produitId);
        suppressionsEnCours.Remove(produitId);
        items = await CartService.GetItemsAsync();
        StateHasChanged();
    }

    private bool showConfirmVider = false;
    private int? itemASupprimerId = null;
    private string? itemASupprimerNom = null;

    private void DemanderSuppressionItem(int produitId, string nom)
    {
        itemASupprimerId = produitId;
        itemASupprimerNom = nom;
    }

    private void AnnulerSuppressionItem()
    {
        itemASupprimerId = null;
        itemASupprimerNom = null;
    }

    private async Task ConfirmerSuppressionItem()
    {
        if (itemASupprimerId.HasValue)
        {
            var id = itemASupprimerId.Value;
            itemASupprimerId = null;
            itemASupprimerNom = null;
            await SupprimerArticle(id);
        }
    }

    private void AnnulerVider()
    {
        showConfirmVider = false;
    }

    private async Task ConfirmerVider()
    {
        showConfirmVider = false;
        await CartService.ClearCartAsync();
        items = new List<CartItemDto>();
        erreurStock = null;
        StateHasChanged();
    }

    private async Task ValiderCommande()
    {
        // Vérifier si l'utilisateur est authentifié
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var estConnecte = authState.User.Identity?.IsAuthenticated ?? false;

        if (!estConnecte)
        {
            // Sauvegarder l'intention de checkout en sessionStorage
            await JS.InvokeVoidAsync("sessionStorage.setItem", "checkout_intent", "true");
            // Rediriger vers login avec paramètre redirect
            Navigation.NavigateTo("/login?redirect=/panier");
            return;
        }

        // Utilisateur connecté → soumettre la commande
        commandeEnCours = true;
        erreurStock = null;
        StateHasChanged();

        var dto = new CommandeMultiCreateClientDto
        {
            Lignes = items.Select(i => new LigneCommandeClientDto
            {
                ProduitId = i.ProduitId,
                Quantite = i.Quantite
            }).ToList()
        };

        var (succes, resultat, erreur, msgErreur) = await BoutiqueService.PasserCommandeMulti(Http, dto);

        commandeEnCours = false;

        if (succes && resultat != null)
        {
            commandeSucces = resultat;
            await CartService.ClearCartAsync();
            items = new List<CartItemDto>();
            // Nettoyer l'intention de checkout si elle était là
            await JS.InvokeVoidAsync("sessionStorage.removeItem", "checkout_intent");
        }
        else if (erreur != null)
        {
            erreurStock = erreur;
            // Ajuster les quantités dans le panier
            await CartService.AppliquerCorrectionsStockAsync(erreur.LignesEnErreur);
            items = await CartService.GetItemsAsync();
            Snackbar.Add("Certains articles ont été ajustés en raison d'un stock insuffisant.", Severity.Warning,
                config => { config.VisibleStateDuration = 4000; });
        }
        else
        {
            Snackbar.Add($"Erreur : {msgErreur}", Severity.Error);
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= HandleCartChanged;
    }
}
