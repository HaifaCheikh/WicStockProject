@page "/panier"
@layout WicStock.Web.Layout.HomeLayout
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject CartService CartService
@inject BoutiqueService BoutiqueService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Mon panier — WicStock</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="boutique-page">

    <!-- NAVBAR (identique aux autres pages Boutique) -->
    <header class="b-navbar">
        <div class="b-nav-inner">
            <a href="/" class="b-brand">
                <span class="b-brand-mark">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                        <path d="M3 8 L21 8 M3 12 L21 12 M3 16 L21 16" stroke="#fff" stroke-width="2" stroke-linecap="round" />
                        <path d="M7 4 L7 20 M12 4 L12 20 M17 4 L17 20" stroke="rgba(255,255,255,0.55)" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                </span>
                <span class="b-brand-name">WicStock</span>
            </a>
            <nav class="b-nav-links">
                <a href="/">Accueil</a>
                <a href="/boutique">Boutique</a>
                <a href="/panier" class="active">Panier</a>
            </nav>
            <div class="b-nav-actions">
                <a href="/panier" class="b-cart-btn" title="Mon panier">
                    <svg viewBox="0 0 24 24" width="19" height="19" fill="none">
                        <path d="M6 2 L3 6 V20 C3 21.1 3.9 22 5 22 H19 C20.1 22 21 21.1 21 20 V6 L18 2 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M3 6 H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M16 10 C16 12.2 14.2 14 12 14 C9.8 14 8 12.2 8 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    @if (items.Any())
                    {
                        <span class="b-cart-badge">@items.Sum(i => i.Quantite)</span>
                    }
                </a>
                <AuthorizeView>
                    <Authorized>
                        <a href="/catalogue" class="b-btn b-btn--outline">Mon espace</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="b-btn b-btn--outline">Se connecter</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <!-- BREADCRUMB -->
    <nav class="b-breadcrumb">
        <div class="b-breadcrumb-inner">
            <a href="/boutique" class="b-btn-back-icon" title="Retour à la boutique">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                    <path d="M19 12 H5 M11 18 L5 12 L11 6" stroke="var(--b-denim)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>
    </nav>

    <main class="panier-main">
        <div class="panier-inner">

            @if (commandeSucces == null)
            {
                <div class="panier-header">
                    <h1 class="panier-title">Mon panier</h1>
                    @if (items.Any())
                    {
                        <span class="panier-count">@items.Sum(i => i.Quantite) article(s)</span>
                    }
                </div>
            }

            <!-- ===== ERREUR DE STOCK 409 ===== -->
            @if (erreurStock != null)
            {
                <div class="panier-alert panier-alert--stock">
                    <div class="panier-alert-header">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/>
                            <path d="M12 8 V12 M12 16 H12.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <strong>@erreurStock.Message</strong>
                    </div>
                    <ul class="panier-alert-list">
                        @foreach (var ligne in erreurStock.LignesEnErreur)
                        {
                            <li>
                                <strong>@ligne.ProduitNom</strong>
                                @if (ligne.QuantiteDisponible <= 0)
                                {
                                    <span>: en rupture totale (retiré de votre panier)</span>
                                }
                                else
                                {
                                    <span>: @ligne.QuantiteDemandee demandé(es), @ligne.QuantiteDisponible disponible(s) → quantité ajustée</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- ===== SUCCÈS COMMANDE ===== -->
            @if (commandeSucces != null)
            {
                <div class="commande-succes-card">
                    <div class="succes-icon-badge">
                        <svg viewBox="0 0 24 24" width="36" height="36" fill="none">
                            <circle cx="12" cy="12" r="10" fill="#E4F3EC" stroke="#1E6B4C" stroke-width="1.8"/>
                            <path d="M8 12 L11 15 L16 9" stroke="#1E6B4C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>

                    <h2 class="succes-title">Commande enregistrée avec succès !</h2>

                    <p class="succes-subtext">
                        Merci pour votre achat. Votre commande a bien été prise en compte et est actuellement en cours de traitement.
                    </p>

                    <div class="succes-summary-pill">
                        <span class="succes-summary-label">Montant total réglé</span>
                        <span class="succes-summary-val">@commandeSucces.MontantTotal.ToString("0.00") DT</span>
                    </div>

                    <div class="succes-actions">
                        <a href="/mes-commandes" class="b-btn b-btn-primary b-btn-succes-primary">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                                <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>Voir mes commandes</span>
                        </a>
                        <a href="/boutique" class="b-btn b-btn--outline b-btn-succes-secondary">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                                <path d="M3 12h18M3 12l6-6M3 12l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>Continuer mes achats</span>
                        </a>
                    </div>
                </div>
            }

            @if (!items.Any() && commandeSucces == null)
            {
                <!-- PANIER VIDE -->
                <div class="panier-vide">
                    <svg viewBox="0 0 24 24" width="60" height="60" fill="none">
                        <path d="M6 2 L3 6 V20 C3 21.1 3.9 22 5 22 H19 C20.1 22 21 21.1 21 20 V6 L18 2 Z" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M3 6 H21" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round"/>
                        <path d="M16 10 C16 12.2 14.2 14 12 14 C9.8 14 8 12.2 8 10" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    <h2>Votre panier est vide</h2>
                    <p>Découvrez notre catalogue et ajoutez des articles à votre panier.</p>
                    <a href="/boutique" class="panier-cta-btn">Découvrir la boutique</a>
                </div>
            }
            else if (items.Any())
            {
                <div class="panier-layout">

                    <!-- ===== LISTE DES ARTICLES ===== -->
                    <div class="panier-articles">
                        @foreach (var item in items)
                        {
                            <div class="panier-item @(suppressionsEnCours.Contains(item.ProduitId) ? "panier-item--removing" : "")">

                                <!-- Image -->
                                <div class="panier-item-img">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Nom" />
                                    }
                                    else
                                    {
                                        <div class="panier-item-img-placeholder">
                                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
                                                <rect x="3" y="3" width="18" height="18" rx="3" stroke="#cbd5e1" stroke-width="1.5"/>
                                            </svg>
                                        </div>
                                    }
                                </div>

                                <!-- Infos -->
                                <div class="panier-item-info">
                                    <p class="panier-item-ref">@item.Reference</p>
                                    <h3 class="panier-item-name">@item.Nom</h3>
                                    @if (!string.IsNullOrEmpty(item.TypeTissu))
                                    {
                                        <p class="panier-item-tissu">@item.TypeTissu</p>
                                    }
                                    @if (item.EstEnPromotion)
                                    {
                                        <span class="panier-item-promo-badge">Promo -@item.RemisePourcentage%</span>
                                    }
                                    @if (item.DisponibleSurCommande && item.QuantiteDisponible <= 0)
                                    {
                                        <span class="panier-item-surcommande">Sur commande</span>
                                    }
                                </div>

                                <!-- Prix unitaire -->
                                <div class="panier-item-prix">
                                    @if (item.EstEnPromotion)
                                    {
                                        <span class="panier-prix-promo">@item.PrixEffectif.ToString("0.00") DT</span>
                                        <span class="panier-prix-barre">@item.PrixUnitaire.ToString("0.00")</span>
                                    }
                                    else
                                    {
                                        <span class="panier-prix">@item.PrixEffectif.ToString("0.00") DT</span>
                                    }
                                </div>

                                <!-- Quantité -->
                                <div class="panier-item-qty">
                                    <button class="panier-qty-btn" @onclick="() => ChangerQuantite(item, item.Quantite - 1)" disabled="@(item.Quantite <= 1)">−</button>
                                    <span class="panier-qty-val">@item.Quantite</span>
                                    <button class="panier-qty-btn"
                                            @onclick="() => ChangerQuantite(item, item.Quantite + 1)"
                                            disabled="@(!item.DisponibleSurCommande && item.Quantite >= item.QuantiteDisponible)">+</button>
                                </div>

                                <!-- Sous-total -->
                                <div class="panier-item-total">
                                    @item.SousTotal.ToString("0.00") DT
                                </div>

                                <!-- Supprimer -->
                                <button class="panier-suppr-btn" @onclick="() => DemanderSuppressionItem(item.ProduitId, item.Nom)" title="Retirer du panier">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
                                        <path d="M3 6 H21 M8 6 V4 H16 V6 M19 6 L18 20 H6 L5 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                            </div>
                        }

                        <div class="panier-articles-footer">
                            <button class="panier-vider-btn" @onclick="() => showConfirmVider = true">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                                    <path d="M3 6 H21 M8 6 V4 H16 V6 M19 6 L18 20 H6 L5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                Vider le panier
                            </button>
                            <a href="/boutique" class="panier-continuer-btn">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
                                    <path d="M19 12 H5 M11 18 L5 12 L11 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <span>Continuer mes achats</span>
                            </a>
                        </div>
                    </div>

                    <!-- ===== MODALE CONFIRMATION VIDER ===== -->
                    @if (showConfirmVider)
                    {
                        <div class="confirm-overlay" @onclick="AnnulerVider">
                            <div class="confirm-modal" @onclick:stopPropagation="true">
                                <div class="confirm-icon">
                                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none">
                                        <path d="M3 6 H21 M8 6 V4 H16 V6 M19 6 L18 20 H6 L5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M10 11 V17 M14 11 V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                                    </svg>
                                </div>
                                <h3 class="confirm-title">Vider le panier ?</h3>
                                <p class="confirm-body">Tous les articles de votre panier seront supprimés. Cette action est irréversible.</p>
                                <div class="confirm-actions">
                                    <button class="confirm-btn-cancel" @onclick="AnnulerVider">Annuler</button>
                                    <button class="confirm-btn-ok" @onclick="ConfirmerVider">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none">
                                            <path d="M3 6 H21 M8 6 V4 H16 V6 M19 6 L18 20 H6 L5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        Oui, vider
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- ===== MODALE CONFIRMATION SUPPRESSION ARTICLE ===== -->
                    @if (itemASupprimerId.HasValue)
                    {
                        <div class="confirm-overlay" @onclick="AnnulerSuppressionItem">
                            <div class="confirm-modal" @onclick:stopPropagation="true">
                                <div class="confirm-icon">
                                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none">
                                        <path d="M3 6 H21 M8 6 V4 H16 V6 M19 6 L18 20 H6 L5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M10 11 V17 M14 11 V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                                    </svg>
                                </div>
                                <h3 class="confirm-title">Retirer du panier ?</h3>
                                <p class="confirm-body">Voulez-vous vraiment retirer « @itemASupprimerNom » de votre panier ?</p>
                                <div class="confirm-actions">
                                    <button class="confirm-btn-cancel" @onclick="AnnulerSuppressionItem">Annuler</button>
                                    <button class="confirm-btn-ok" @onclick="ConfirmerSuppressionItem">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none">
                                            <path d="M3 6 H21 M8 6 V4 H16 V6 M19 6 L18 20 H6 L5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        Oui, retirer
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- ===== RÉCAPITULATIF ===== -->
                    <div class="panier-recap">
                        <div class="panier-recap-card">
                            <h2 class="panier-recap-title">Récapitulatif</h2>

                            <div class="panier-recap-rows">
                                @foreach (var item in items)
                                {
                                    <div class="panier-recap-row">
                                        <span class="panier-recap-label">@item.Nom × @item.Quantite</span>
                                        <span class="panier-recap-val">@item.SousTotal.ToString("0.00") DT</span>
                                    </div>
                                }
                            </div>

                            <div class="panier-recap-divider"></div>

                            <div class="panier-recap-total">
                                <span>Total</span>
                                <span class="panier-recap-total-val">@CartService.GetTotal().ToString("0.00") DT</span>
                            </div>

                            <p class="panier-recap-note">
                                Le paiement s'effectue à la confirmation.
                            </p>

                            <!-- Bouton Valider -->
                            <button class="panier-valider-btn"
                                    @onclick="ValiderCommande"
                                    disabled="@commandeEnCours">
                                @if (commandeEnCours)
                                {
                                    <svg class="b-spinner" viewBox="0 0 24 24" width="18" height="18">
                                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" stroke-dasharray="60" stroke-dashoffset="15" fill="none"/>
                                    </svg>
                                    <span>Traitement...</span>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                                        <path d="M9 12 L11 14 L15 10 M21 12 C21 16.97 16.97 21 12 21 C7.03 21 3 16.97 3 12 C3 7.03 7.03 3 12 3 C16.97 3 21 7.03 21 12 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <span>Valider ma commande</span>
                                }
                            </button>

                            <AuthorizeView>
                                <NotAuthorized>
                                    <p class="panier-auth-note">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                                            <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.6"/>
                                            <path d="M7 11 V7 C7 4.79 8.79 3 11 3 H13 C15.21 3 17 4.79 17 7 V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                                        </svg>
                                        Une connexion est requise pour valider votre commande.
                                    </p>
                                </NotAuthorized>
                            </AuthorizeView>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>

    <footer class="b-footer">
        <p>© 2026 WicStock — Gestion d'inventaire textile</p>
    </footer>
</div>

<style>
    /* Même palette que le reste de la Boutique et la Home */
    :root {
        --b-ink: #16233A; --b-ink-muted: #64748B; --b-paper: #FFFFFF; --b-sand: #F3F6FA; --b-border: #E1E7EF;
        --b-denim: #2B4C7E; --b-denim-dark: #14263F; --b-denim-tint: #E7EDF6; --b-denim-soft: #EAF0F8;
        --b-rust: #B5563A; --b-rust-soft: #F9ECE8; --b-pine: #1E6B4C; --b-pine-soft: #E4F3EC; --b-amber-soft: #FEF3C7;
        --b-violet: #5B21B6; --b-violet-soft: #EDE9FE;
        --b-radius: 16px; --b-radius-sm: 8px;
        --font-head: 'Sora', 'Inter', sans-serif; --font-body: 'Inter', sans-serif; --font-mono: 'JetBrains Mono', monospace;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    .boutique-page { font-family: var(--font-body); background: var(--b-sand); min-height: 100vh; color: var(--b-ink); display: flex; flex-direction: column; }

    /* NAVBAR */
    .b-navbar { background: var(--b-paper); border-bottom: 1px solid var(--b-border); position: sticky; top: 0; z-index: 100; }
    .b-nav-inner { max-width: 1160px; margin: 0 auto; padding: 0 24px; height: 64px; display: flex; align-items: center; gap: 24px; }
    .b-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .b-brand-mark { width: 32px; height: 32px; background: var(--b-denim); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
    .b-brand-name { font-family: var(--font-head); font-weight: 700; font-size: 1.125rem; color: var(--b-ink); }
    .b-nav-links { display: flex; gap: 28px; margin-left: 24px; flex: 1; }
    .b-nav-links a { color: var(--b-ink-muted); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 0.15s; }
    .b-nav-links a:hover, .b-nav-links a.active { color: var(--b-denim); }
    .b-nav-actions { display: flex; align-items: center; gap: 12px; }
    .b-cart-btn { position: relative; width: 38px; height: 38px; border-radius: var(--b-radius-sm); background: var(--b-sand); color: var(--b-ink-muted); display: flex; align-items: center; justify-content: center; text-decoration: none; transition: background 0.15s, color 0.15s; }
    .b-cart-btn:hover { background: var(--b-denim-soft); color: var(--b-denim); }
    .b-cart-badge { position: absolute; top: -4px; right: -4px; background: var(--b-rust); color: #fff; font-size: 0.65rem; font-weight: 700; min-width: 18px; height: 18px; border-radius: 9px; display: flex; align-items: center; justify-content: center; padding: 0 4px; border: 2px solid var(--b-paper); }
    .b-btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; border-radius: var(--b-radius-sm); font-family: var(--font-body); font-size: 0.875rem; font-weight: 600; cursor: pointer; text-decoration: none; transition: all 0.15s; border: none; }
    .b-btn--outline { background: transparent; color: var(--b-ink); border: 1.5px solid var(--b-border); }
    .b-btn--outline:hover { border-color: var(--b-denim); color: var(--b-denim); background: var(--b-denim-soft); }
    .b-btn-primary-sm { background: var(--b-denim); color: #fff; padding: 8px 16px; border-radius: var(--b-radius-sm); font-size: 0.875rem; font-weight: 600; text-decoration: none; }
    .b-btn-primary-sm:hover { background: var(--b-denim-dark); }
    .b-btn-ghost-sm { background: transparent; color: var(--b-ink-muted); padding: 8px 16px; border-radius: var(--b-radius-sm); font-size: 0.875rem; font-weight: 600; text-decoration: none; border: 1.5px solid var(--b-border); }
    .b-btn-ghost-sm:hover { background: var(--b-sand); color: var(--b-ink); }

    /* BREADCRUMB */
    .b-breadcrumb { background: var(--b-sand); padding: 12px 24px; }
    .b-breadcrumb-inner { max-width: 1160px; margin: 0 auto; display: flex; align-items: center; }
    .b-btn-back-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        color: var(--b-denim);
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .b-btn-back-icon:hover {
        background: var(--b-denim-soft);
        transform: translateX(-3px);
    }

    /* MAIN */
    .panier-main { padding: 36px 24px 80px; }
    .panier-inner { max-width: 1160px; margin: 0 auto; }
    .panier-header { display: flex; align-items: center; gap: 14px; margin-bottom: 26px; }
    .panier-title { font-family: var(--font-head); font-size: 1.7rem; font-weight: 800; color: var(--b-ink); letter-spacing: -0.02em; }
    .panier-count { background: var(--b-denim); color: #fff; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; }

    /* ALERTES */
    .panier-alert { border-radius: var(--b-radius-sm); padding: 18px 20px; margin-bottom: 24px; }
    .panier-alert--stock { background: var(--b-rust-soft); border: 1.5px solid #F0C7BB; color: #991b1b; }
    .panier-alert--success { background: var(--b-pine-soft); border: 1.5px solid #bbf7d0; color: var(--b-pine); }
    .panier-alert-header { display: flex; align-items: center; gap: 10px; font-size: 0.95rem; margin-bottom: 10px; }
    .panier-alert-list { padding-left: 20px; font-size: 0.875rem; line-height: 1.8; }
    .panier-alert-total { font-size: 1rem; font-weight: 700; margin: 10px 0; }
