@code {
    private AdminDashboardDto? data;
    private bool isLoading;
    private DateTime? derniereMiseAJour;
    private decimal? tendanceRevenu;

    protected override async Task OnInitializedAsync()
    {
        await ChargerDonnees();
    }

    private async Task ChargerDonnees()
    {
        isLoading = true;
        try
        {
            data = await DashboardService.GetAdminDashboard();

            if (data?.ProduitsEnSurstock != null && data.ProduitsEnSurstock.Any())
            {
                try
                {
                    var tousProduits = await ProduitService.ObtenirTous();
                    if (tousProduits != null && tousProduits.Any())
                    {
                        var refsSurstockReels = tousProduits
                            .Where(p => !p.EstArchive && p.StatutIAType == "SURSTOCK")
                            .Select(p => p.Reference)
                            .ToHashSet(StringComparer.OrdinalIgnoreCase);

                        var idsSurstockReels = tousProduits
                            .Where(p => !p.EstArchive && p.StatutIAType == "SURSTOCK")
                            .Select(p => p.Id)
                            .ToHashSet();

                        data.ProduitsEnSurstock = data.ProduitsEnSurstock
                            .Where(ps => idsSurstockReels.Contains(ps.Id) || refsSurstockReels.Contains(ps.Reference))
                            .ToList();
                    }
                }
                catch (Exception exVal)
                {
                    Console.WriteLine($"[DASHBOARD ADMIN] Erreur filtrage surstock : {exVal.Message}");
                }
            }

            derniereMiseAJour = DateTime.Now;
            tendanceRevenu = CalculerTendanceRevenu(data);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement dashboard admin: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Calcule la variation en % du dernier mois par rapport au mois précédent,
    /// à partir de la série déjà fournie par EvolutionRevenus (aucun appel supplémentaire au backend).
    /// </summary>
    private static decimal? CalculerTendanceRevenu(AdminDashboardDto? source)
    {
        var serie = source?.EvolutionRevenus;
        if (serie == null || serie.Count < 2) return null;

        var moisPrecedent = serie[^2].Montant;
        var moisActuel = serie[^1].Montant;

        if (moisPrecedent == 0) return null;

        var variation = Math.Round(((moisActuel - moisPrecedent) / moisPrecedent) * 100m, 1);

        // Limiter les valeurs extrêmes pour garder un affichage sobre et crédible
        if (variation > 999) return 999m;
        if (variation < -999) return -999m;

        return variation;
    }
}
