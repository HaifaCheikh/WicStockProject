@page "/admin/dashboard"
@attribute [Authorize(Roles = "ADMIN")]
@inject DashboardService DashboardService
@inject ProduitService ProduitService
@inject NavigationManager Navigation

<PageTitle>Tableau de bord Admin | WicStock</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="dashboard-page pa-4 pa-md-6">

    <!-- ===== HEADER ===== -->
    <div class="dashboard-header mb-6">
        <div>
            <span class="dashboard-kicker">Vue d'ensemble</span>
            <h1 class="dashboard-title">Tableau de bord Administration</h1>
            <p class="dashboard-subtitle">Activité, stock et ventes en un coup d'œil</p>
        </div>
        <div class="header-actions">
            @if (derniereMiseAJour.HasValue)
            {
                <span class="last-updated">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                    Mis à jour à @derniereMiseAJour.Value.ToString("HH:mm")
                </span>
            }
            <button class="btn btn--outline" @onclick="ChargerDonnees" disabled="@isLoading">
                <MudIcon Icon="@(isLoading ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.Refresh)" Size="Size.Small" />
                <span>@(isLoading ? "Actualisation..." : "Actualiser")</span>
            </button>
        </div>
    </div>

    @if (data == null)
    {
        <div class="skeleton-wrap">
            <div class="skeleton-row mb-6">
                <div class="skeleton skeleton-kpi"></div>
                <div class="skeleton skeleton-kpi"></div>
                <div class="skeleton skeleton-kpi"></div>
                <div class="skeleton skeleton-kpi"></div>
            </div>
            <div class="skeleton skeleton-chart"></div>
        </div>
    }
    else
    {
        @if (data.ProduitsEnRupture > 0)
        {
            <div class="alert-rupture mb-6">
                <span class="alert-icon"><MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" /></span>
                <span class="alert-text"><strong>Attention :</strong> @data.ProduitsEnRupture produit(s) en rupture de stock totale.</span>
                <a href="/produits?filtre=rupture" class="alert-action">Voir l'inventaire <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></a>
            </div>
        }

        <!-- ===== KPI CARDS ===== -->
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="3">
                <div class="kpi-card kpi-card--clickable" @onclick='() => Navigation.NavigateTo("/produits")' title="Cliquer pour gérer le catalogue de produits">
                    <div class="kpi-top">
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                        </div>
                        <span class="kpi-label">Total Produits</span>
                    </div>
                    <h2 class="kpi-value">@data.TotalProduits.ToString("N0")</h2>
                    <span class="kpi-sub">Articles enregistrés &rarr;</span>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <div class="kpi-card">
                    <div class="kpi-top">
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" />
                        </div>
                        <span class="kpi-label">Chiffre d'Affaires</span>
                    </div>
                    <h2 class="kpi-value">@data.RevenuTotal.ToString("N2") <small>DT</small></h2>
                    <div class="kpi-sub-row">
                        <span class="kpi-sub">@data.TotalProduitsVendus.ToString("N0") articles vendus</span>
                        @if (tendanceRevenu.HasValue)
                        {
                            <span class="trend-badge @(tendanceRevenu.Value >= 0 ? "trend-up" : "trend-down")">
                                <MudIcon Icon="@(tendanceRevenu.Value >= 0 ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)" Size="Size.Small" />
                                <span>@(tendanceRevenu.Value >= 0 ? "+" : "")@tendanceRevenu.Value.ToString("N0")%</span>
                            </span>
                        }
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <div class="kpi-card kpi-card--clickable" @onclick='() => Navigation.NavigateTo("/utilisateurs")' title="Cliquer pour gérer les utilisateurs">
                    <div class="kpi-top">
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
                        </div>
                        <span class="kpi-label">Utilisateurs</span>
                    </div>
                    <h2 class="kpi-value">@data.TotalUtilisateurs.ToString("N0")</h2>
                    <span class="kpi-sub">Comptes enregistrés &rarr;</span>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <div class="kpi-card kpi-card--clickable" @onclick='() => Navigation.NavigateTo("/commandes")' title="Cliquer pour gérer les commandes">
                    <div class="kpi-top">
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Small" />
                        </div>
                        <span class="kpi-label">Commandes</span>
                    </div>
                    <h2 class="kpi-value">@data.TotalCommandes.ToString("N0")</h2>
                    <span class="kpi-sub">Toutes demandes confondues &rarr;</span>
                </div>
            </MudItem>
        </MudGrid>

        <!-- ===== GRAPHIQUES & REPARTITIONS ===== -->
        <MudGrid Class="mb-6">
            <!-- Graphique Revenus -->
            <MudItem xs="12" lg="8">
                <div class="chart-card">
                    <div class="chart-header d-flex justify-space-between align-center flex-wrap gap-3">
                        <div>
                            <h3 class="chart-title">Évolution des Revenus Mensuels</h3>
                            <span class="chart-subtitle">Suivi mois par mois du chiffre d'affaires généré</span>
                        </div>
                        <div class="chart-badge">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" />
                            <span>@data.RevenuTotal.ToString("N0") DT cumulés</span>
                        </div>
                    </div>

                    <div class="chart-body">
                        @if (data.EvolutionRevenus != null && data.EvolutionRevenus.Any())
                        {
                            var maxRevenu = Math.Max(100m, data.EvolutionRevenus.Max(r => r.Montant));

                            <div class="bar-chart-container">
                                <div class="bar-chart-grid">
                                    <div class="grid-line" style="bottom: 100%;"><span>@maxRevenu.ToString("N0") DT</span></div>
                                    <div class="grid-line" style="bottom: 75%;"><span>@((maxRevenu * 0.75m).ToString("N0")) DT</span></div>
                                    <div class="grid-line" style="bottom: 50%;"><span>@((maxRevenu * 0.5m).ToString("N0")) DT</span></div>
                                    <div class="grid-line" style="bottom: 25%;"><span>@((maxRevenu * 0.25m).ToString("N0")) DT</span></div>
                                    <div class="grid-line grid-line--base" style="bottom: 0%;"><span>0 DT</span></div>
                                </div>

                                <div class="bar-chart-bars">
                                    @foreach (var item in data.EvolutionRevenus)
                                    {
                                        var heightPct = (double)(item.Montant / maxRevenu * 100m);
                                        if (heightPct < 3 && item.Montant > 0) heightPct = 3;

                                        <div class="bar-column">
                                            <div class="bar-wrapper">
                                                @if (item.Montant > 0)
                                                {
                                                    <span class="bar-tooltip">@item.Montant.ToString("N0") DT</span>
                                                }
                                                <div class="bar-fill @(item.Montant > 0 ? "active" : "empty")" style="--bar-h: @(heightPct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                            </div>
                                            <span class="bar-label">@item.Mois</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <MudIcon Icon="@Icons.Material.Filled.ShowChart" />
                                <p>Aucun historique de vente pour l'instant.</p>
                                <span class="empty-state-hint">Les revenus apparaîtront ici dès les premières commandes validées.</span>
                            </div>
                        }
                    </div>
                </div>
            </MudItem>

            <!-- Répartition des Statuts de Commandes -->
            <MudItem xs="12" lg="4">
                <div class="chart-card h-100 d-flex flex-column">
                    <div class="chart-header">
                        <h3 class="chart-title">Statut des Commandes</h3>
                        <span class="chart-subtitle">Répartition globale selon l'état</span>
                    </div>

                    <div class="chart-body flex-1 d-flex flex-column justify-center">
                        @if (data.TotalCommandes > 0)
                        {
                            var total = (double)data.TotalCommandes;
                            var accepteesPct = Math.Round((data.StatutCommandes.Acceptees / total) * 100);
                            var enAttentePct = Math.Round((data.StatutCommandes.EnAttente / total) * 100);
                            var refuseesPct = Math.Round((data.StatutCommandes.Refusees / total) * 100);

                            <div class="donut-wrapper mb-4">
                                <svg viewBox="0 0 36 36" class="donut-svg">
                                    <path class="donut-ring" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />

                                    @if (data.StatutCommandes.Acceptees > 0)
                                    {
                                        <path class="donut-segment segment-green"
                                              stroke-dasharray="@(accepteesPct.ToString(System.Globalization.CultureInfo.InvariantCulture)), 100"
                                              stroke-dashoffset="0"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    }
                                    @if (data.StatutCommandes.EnAttente > 0)
                                    {
                                        <path class="donut-segment segment-ochre"
                                              stroke-dasharray="@(enAttentePct.ToString(System.Globalization.CultureInfo.InvariantCulture)), 100"
                                              stroke-dashoffset="@((-accepteesPct).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    }
                                    @if (data.StatutCommandes.Refusees > 0)
                                    {
                                        <path class="donut-segment segment-rust"
                                              stroke-dasharray="@(refuseesPct.ToString(System.Globalization.CultureInfo.InvariantCulture)), 100"
                                              stroke-dashoffset="@((-(accepteesPct + enAttentePct)).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    }
                                </svg>
                                <div class="donut-center">
                                    <span class="donut-number">@data.TotalCommandes</span>
                                    <span class="donut-label">Commandes</span>
                                </div>
                            </div>

                            <div class="status-list">
                                <div class="status-item status-item--clickable mb-3" @onclick='() => Navigation.NavigateTo("/commandes?statut=ACCEPTEE")' title="Voir les commandes acceptées">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <span class="status-label"><span class="dot dot-green"></span>Validées / Acceptées</span>
                                        <span class="status-count">@data.StatutCommandes.Acceptees <small>(@accepteesPct%)</small></span>
                                    </div>
                                    <div class="progress-bar-bg">
                                        <div class="progress-bar-fill fill-green" style="width: @(accepteesPct)%;"></div>
                                    </div>
                                </div>

                                <div class="status-item status-item--clickable mb-3" @onclick='() => Navigation.NavigateTo("/commandes?statut=EN_ATTENTE")' title="Voir les commandes en attente">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <span class="status-label"><span class="dot dot-ochre"></span>En attente de validation</span>
                                        <span class="status-count">@data.StatutCommandes.EnAttente <small>(@enAttentePct%)</small></span>
                                    </div>
                                    <div class="progress-bar-bg">
                                        <div class="progress-bar-fill fill-ochre" style="width: @(enAttentePct)%;"></div>
                                    </div>
                                </div>

                                <div class="status-item status-item--clickable" @onclick='() => Navigation.NavigateTo("/commandes?statut=REFUSEE")' title="Voir les commandes refusées">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <span class="status-label"><span class="dot dot-rust"></span>Refusées</span>
                                        <span class="status-count">@data.StatutCommandes.Refusees <small>(@refuseesPct%)</small></span>
                                    </div>
                                    <div class="progress-bar-bg">
                                        <div class="progress-bar-fill fill-rust" style="width: @(refuseesPct)%;"></div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" />
                                <p>Aucune commande pour le moment.</p>
                                <span class="empty-state-hint">La répartition par statut s'affichera dès la première commande reçue.</span>
                            </div>
                        }
                    </div>
                </div>
            </MudItem>
        </MudGrid>

        <!-- ===== TOP PRODUITS VENDUS ET SURSTOCKS ===== -->
        <MudGrid>
            <MudItem xs="12" md="6">
                <div class="table-card h-100 d-flex flex-column">
                    <div class="chart-header">
                        <h3 class="chart-title">Top 5 des Ventes</h3>
                        <span class="chart-subtitle">Références les plus demandées ce trimestre</span>
                    </div>
                    <div class="table-responsive flex-1">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Quantité vendue</th>
                                    <th>Total généré</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (data.TopProduitsVendus != null && data.TopProduitsVendus.Any())
                                {
                                    @foreach (var prod in data.TopProduitsVendus)
                                    {
                                        <tr class="table-row--clickable" @onclick='() => Navigation.NavigateTo($"/produits?highlight={Uri.EscapeDataString(prod.Nom)}")' title="Cliquer pour voir le produit au catalogue">
                                            <td class="cell-strong">@prod.Nom</td>
                                            <td><span class="badge-statut statut-acceptee">@prod.QuantiteVendue</span></td>
                                            <td class="cell-amount">@prod.TotalVentes.ToString("N2") <small>DT</small></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3">
                                            <div class="empty-state empty-state--inline">
                                                <MudIcon Icon="@Icons.Material.Filled.PointOfSale" />
                                                <p>Pas encore de vente à afficher.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" md="6">
                <div class="table-card h-100 d-flex flex-column">
                    <div class="chart-header d-flex justify-space-between align-center">
                        <div>
                            <h3 class="chart-title">Alertes de Surstock</h3>
                            <span class="chart-subtitle">Top 5 des références à écouler en priorité</span>
                        </div>
                    </div>
                    <div class="table-responsive flex-1">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Référence</th>
                                    <th>Produit</th>
                                    <th>Stock actuel</th>
                                    <th>Excédent (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (data.ProduitsEnSurstock != null && data.ProduitsEnSurstock.Any())
                                {
                                    @foreach (var prod in data.ProduitsEnSurstock)
                                    {
                                        <tr class="table-row--clickable" @onclick='() => Navigation.NavigateTo($"/produits?statut=SURSTOCK&highlight={Uri.EscapeDataString(prod.Reference)}")' title="Cliquer pour voir le produit en surstock au catalogue">
                                            <td><span class="ref-code">@prod.Reference</span></td>
                                            <td class="cell-strong">@prod.Nom</td>
                                            <td>@prod.QuantiteActuelle</td>
                                            <td><span class="badge-statut statut-ochre" title="Surplus par rapport au seuil de surstock">+@prod.PourcentageSurstock%</span></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4">
                                            <div class="empty-state empty-state--inline">
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" />
                                                <p>Aucun surstock détecté — niveaux de stock sains.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    }
</div>

<style>
    .dashboard-page {
        --ink: #16233A;
        --ink-muted: #64748B;
        --paper: #FFFFFF;
        --sand: #F3F6FA;
        --border: #E1E7EF;
        --denim: #2B4C7E;
        --denim-dark: #14263F;
        --denim-tint: #E7EDF6;
        --pine: #1E8E3E;
        --pine-tint: #E6F4EA;
        --ochre: #B45309;
        --ochre-tint: #FEF3C7;
        --rust: #DC2626;
        --rust-tint: #FEE2E2;
        --font-display: "Sora", "Inter", sans-serif;
        --font-body: "Inter", sans-serif;
        --font-mono: "JetBrains Mono", monospace;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --shadow-sm: 0 1px 2px rgba(16,24,40,0.04), 0 1px 3px rgba(16,24,40,0.06);
        --shadow-md: 0 8px 24px -12px rgba(20,38,63,0.18);
        font-family: var(--font-body);
        color: var(--ink);
    }

    /* ===== Header ===== */
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 16px;
    }

    .dashboard-kicker {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--denim);
        margin-bottom: 6px;
    }

    .dashboard-title {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.625rem;
        letter-spacing: -0.01em;
        color: var(--ink);
        margin: 0;
    }

    .dashboard-subtitle {
        font-size: 0.875rem;
        color: var(--ink-muted);
        margin: 4px 0 0 0;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .last-updated {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8125rem;
        color: var(--ink-muted);
    }

        .last-updated .mud-icon-root {
            font-size: 1rem;
        }

    /* ===== Buttons ===== */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: var(--radius-sm);
        font-family: var(--font-body);
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: all 0.15s ease;
        text-decoration: none;
    }

    .btn--outline {
        border: 1px solid var(--border);
        background: var(--paper);
        color: var(--ink);
    }

        .btn--outline:hover {
            background: var(--sand);
            border-color: var(--denim);
            color: var(--denim);
        }

        .btn--outline:disabled {
            opacity: 0.6;
            cursor: default;
        }

    /* ===== Alert ===== */
    .alert-rupture {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        background: var(--rust-tint);
        border: 1px solid #FCA5A5;
        border-radius: var(--radius-md);
        color: #991B1B;
        font-size: 0.875rem;
        flex-wrap: wrap;
    }

    .alert-icon {
        display: flex;
        color: var(--rust);
        flex-shrink: 0;
    }

    .alert-text {
        flex: 1;
        min-width: 200px;
    }

    .alert-action {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-weight: 700;
        color: var(--rust);
        text-decoration: none;
        white-space: nowrap;
    }

        .alert-action:hover {
            text-decoration: underline;
        }

    /* ===== KPI Cards (design uniforme — un seul accent, une seule identité) ===== */
    .kpi-card {
        position: relative;
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 20px 22px;
        box-shadow: var(--shadow-sm);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            border-color: #D5DEEA;
        }

    .kpi-card--clickable {
        cursor: pointer;
    }

    .kpi-card--clickable:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 24px -6px rgba(43, 76, 126, 0.2) !important;
        border-color: var(--denim) !important;
    }

    .status-item--clickable {
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 6px 8px;
        border-radius: var(--radius-sm);
        margin-left: -8px;
        margin-right: -8px;
    }

    .status-item--clickable:hover {
        background-color: var(--sand);
        box-shadow: inset 0 0 0 1px var(--border);
    }

    .table-row--clickable {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

    .table-row--clickable:hover {
        background-color: rgba(43, 76, 126, 0.08) !important;
    }

    .kpi-top {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }

    .kpi-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--denim-tint);
        color: var(--denim);
    }

    .kpi-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--ink-muted);
    }

    .kpi-value {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.85rem;
        color: var(--ink);
        margin: 0 0 4px 0;
        letter-spacing: -0.01em;
        line-height: 1.1;
    }

        .kpi-value small {
            font-size: 1rem;
            font-weight: 600;
            color: var(--ink-muted);
        }

    .kpi-sub {
        font-size: 0.8125rem;
        color: var(--ink-muted);
    }

    .kpi-sub-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
