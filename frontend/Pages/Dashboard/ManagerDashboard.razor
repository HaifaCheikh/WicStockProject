@code {
    private ManagerDashboardDto? data;
    private bool isLoading;
    private DateTime? derniereMiseAJour;

    private int mouvementsAujourdhui;
    private int entreesAujourdhui;
    private int sortiesAujourdhui;

    // ===== Alerte : nombre réel de produits en RUPTURE uniquement (stock = 0) =====
    private int produitsEnRuptureCount;

    // ===== Donut "Répartition du stock" (construit en SVG maison, comme l'Admin) =====
    private List<StatutDonutItem> statutsDonutData = new();
    private int totalStatuts;

    // ===== Bar chart "Mouvements 7 jours" (construit en CSS maison, comme l'Admin) =====
    private List<string> mouvementsJoursLabels = new();
    private List<double> mouvementsJoursSeries = new();
    private int maxMouvementNice = 4;

    private static readonly (string Code, string Label, string SegmentClass, string DotClass, string FillClass)[] MappingStatuts =
    {
        ("OPTIMAL", "Optimal", "segment-green", "dot-green", "fill-green"),
        ("STOCK_FAIBLE", "Stock faible", "segment-ochre", "dot-ochre", "fill-ochre"),
        ("RUPTURE", "Rupture", "segment-rust", "dot-rust", "fill-rust"),
        ("SUR_COMMANDE", "Sur commande", "segment-denim", "dot-denim", "fill-denim"),
        ("SURSTOCK", "Surstock", "segment-slate", "dot-slate", "fill-slate"),
    };

    private class StatutDonutItem
    {
        public string StatutCode { get; set; } = "";
        public string Label { get; set; } = "";
        public int Count { get; set; }
        public double Pct { get; set; }
        public double Offset { get; set; }
        public string CssClass { get; set; } = "";
        public string DotClass { get; set; } = "";
        public string FillClass { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await ChargerDonnees();
    }

    private async Task ChargerDonnees()
    {
        isLoading = true;
        try
        {
            data = await DashboardService.GetManagerDashboard();

            List<ProduitDto>? tousProduits = null;
            try
            {
                tousProduits = await ProduitService.ObtenirTous();
            }
            catch (Exception exProd)
            {
                Console.WriteLine($"[DASHBOARD MANAGER] Erreur chargement produits : {exProd.Message}");
            }

            if (data?.ProduitsEnSurstock != null && data.ProduitsEnSurstock.Any() && tousProduits != null && tousProduits.Any())
            {
                var refsSurstockReels = tousProduits
                    .Where(p => !p.EstArchive && p.StatutIAType == "SURSTOCK")
                    .Select(p => p.Reference)
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);

                var idsSurstockReels = tousProduits
                    .Where(p => !p.EstArchive && p.StatutIAType == "SURSTOCK")
                    .Select(p => p.Id)
                    .ToHashSet();

                data.ProduitsEnSurstock = data.ProduitsEnSurstock
                    .Where(ps => idsSurstockReels.Contains(ps.Id) || refsSurstockReels.Contains(ps.Reference))
                    .ToList();
            }

            // Uniquement les vraies ruptures (quantité = 0), pas les stocks simplement "faibles"
            produitsEnRuptureCount = data?.ProduitsAlerte?.Count(p => p.QuantiteActuelle == 0) ?? 0;

            derniereMiseAJour = DateTime.Now;
            CalculerMouvementsDuJour(data);
            PreparerDonutStatuts(tousProduits);
            PreparerBarChartMouvementsSemaine(data);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement dashboard manager: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void PreparerDonutStatuts(List<ProduitDto>? produits)
    {
        statutsDonutData = new();
        totalStatuts = 0;

        if (produits == null || !produits.Any()) return;

        var groupes = produits
            .Where(p => !p.EstArchive && !string.IsNullOrWhiteSpace(p.StatutIAType))
            .GroupBy(p => p.StatutIAType!.ToUpperInvariant())
            .ToDictionary(g => g.Key, g => g.Count());

        totalStatuts = groupes.Values.Sum();
        if (totalStatuts == 0) return;

        double cumulative = 0;
        foreach (var (code, label, segmentClass, dotClass, fillClass) in MappingStatuts)
        {
            if (!groupes.TryGetValue(code, out var count) || count <= 0) continue;

            var pct = Math.Round((count / (double)totalStatuts) * 100, 0, MidpointRounding.AwayFromZero);

            statutsDonutData.Add(new StatutDonutItem
            {
                StatutCode = code,
                Label = label,
                Count = count,
                Pct = pct,
                Offset = cumulative,
                CssClass = segmentClass,
                DotClass = dotClass,
                FillClass = fillClass
            });

            cumulative += pct;
        }
    }

    private void PreparerBarChartMouvementsSemaine(ManagerDashboardDto? source)
    {
        mouvementsJoursLabels = new();
        mouvementsJoursSeries = new();

        var mouvements = source?.MouvementsRecents;
        if (mouvements != null)
        {
            var debut = DateTime.Today.AddDays(-6);
            for (var jour = debut; jour <= DateTime.Today; jour = jour.AddDays(1))
            {
                var count = mouvements.Count(m => m.DateMouvement.Date == jour);
                mouvementsJoursLabels.Add(jour.ToString("dd/MM"));
                mouvementsJoursSeries.Add(count);
            }
        }

        // Arrondit le maximum au multiple de 4 supérieur pour que les graduations
        // du quadrillage (100% / 75% / 50% / 25%) restent des nombres entiers propres,
        // au lieu de valeurs décimales comme "0,8 / 1,6 / 2,4".
        var rawMax = mouvementsJoursSeries.Any() ? mouvementsJoursSeries.Max() : 0;
        maxMouvementNice = Math.Max(4, (int)(Math.Ceiling(rawMax / 4.0) * 4));
    }

    /// <summary>
    /// Détermine si un mouvement est une entrée de stock, de façon tolérante
    /// à la casse et aux accents (ex: "ENTREE", "Entrée", "entree" sont tous reconnus).
    /// Si votre backend utilise une valeur différente (ex: "IN", un enum numérique...),
    /// ajoutez-la dans la comparaison ci-dessous.
    /// </summary>
    private static bool EstEntree(string? typeMouvement)
    {
        if (string.IsNullOrWhiteSpace(typeMouvement)) return false;

        var normalise = typeMouvement
            .Trim()
            .Normalize(System.Text.NormalizationForm.FormD);

        var sansAccents = new string(normalise
            .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
            .ToArray());

        return sansAccents.Equals("ENTREE", StringComparison.OrdinalIgnoreCase)
            || sansAccents.Equals("IN", StringComparison.OrdinalIgnoreCase)
            || sansAccents.Equals("ENTREE_STOCK", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Dérive le nombre d'entrées/sorties du jour à partir de MouvementsRecents
    /// et des ventes du jour (les ventes sont comptées comme des sorties).
    /// </summary>
    private void CalculerMouvementsDuJour(ManagerDashboardDto? source)
    {
        var mouvements = source?.MouvementsRecents;
        if (mouvements == null)
        {
            mouvementsAujourdhui = 0;
            entreesAujourdhui = 0;
            sortiesAujourdhui = 0;
            return;
        }

        var aujourdhui = mouvements.Where(m => m.DateMouvement.Date == DateTime.Today).ToList();
        entreesAujourdhui = aujourdhui.Count(m => EstEntree(m.TypeMouvement));
        sortiesAujourdhui = aujourdhui.Count - entreesAujourdhui;

        // Ajouter les ventes du jour comme sorties
        var ventesDuJour = source?.TotalProduitsVendus ?? 0;
        sortiesAujourdhui += ventesDuJour;

        mouvementsAujourdhui = entreesAujourdhui + sortiesAujourdhui;
    }

    private void OnKpiKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, string url)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            Navigation.NavigateTo(url);
        }
    }
}
