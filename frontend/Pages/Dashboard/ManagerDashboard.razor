@page "/manager/dashboard"
@attribute [Authorize(Roles = "RESPONSABLE_STOCK_PRODUCTION,ADMIN")]
@using System.Globalization
@inject DashboardService DashboardService
@inject ProduitService ProduitService
@inject NavigationManager Navigation

<PageTitle>Tableau de bord Responsable | WicStock</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="dashboard-page pa-4 pa-md-6">

    <!-- ===== HEADER ===== -->
    <div class="dashboard-header mb-6">
        <div>
            <span class="dashboard-kicker">Suivi opérationnel</span>
            <h1 class="dashboard-title">Tableau de bord Responsable Stock &amp; Production</h1>
            <p class="dashboard-subtitle">Stock, alertes de réapprovisionnement et mouvements récents</p>
        </div>
        <div class="header-actions">
            @if (derniereMiseAJour.HasValue)
            {
                <span class="last-updated">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                    Mis à jour à @derniereMiseAJour.Value.ToString("HH:mm")
                </span>
            }
            <a class="btn btn--primary" href="/commandes">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" />
                <span>Commandes à traiter</span>
            </a>
            <button class="btn btn--outline" @onclick="ChargerDonnees" disabled="@isLoading">
                <MudIcon Icon="@(isLoading ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.Refresh)" Size="Size.Small" />
                <span>@(isLoading ? "Actualisation..." : "Actualiser")</span>
            </button>
        </div>
    </div>

    @if (data == null)
    {
        <div class="skeleton-wrap">
            <div class="skeleton-row mb-6">
                <div class="skeleton skeleton-kpi"></div>
                <div class="skeleton skeleton-kpi"></div>
                <div class="skeleton skeleton-kpi"></div>
                <div class="skeleton skeleton-kpi"></div>
            </div>
            <div class="skeleton skeleton-chart"></div>
        </div>
    }
    else
    {
        @* ===== ALERTE : uniquement les vraies ruptures (stock = 0) ===== *@
        @if (produitsEnRuptureCount > 0)
        {
            <div class="alert-rupture mb-6">
                <span class="alert-icon"><MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" /></span>
                <span class="alert-text"><strong>Attention :</strong> @produitsEnRuptureCount produit(s) en rupture de stock totale.</span>
                <a href="/produits?filtre=rupture" class="alert-action">Voir l'inventaire <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></a>
            </div>
        }

        <!-- ===== KPI CARDS ===== -->
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="3">
                <div class="kpi-card kpi-card--clickable"
                     role="button" tabindex="0"
                     @onclick='() => Navigation.NavigateTo("/produits")'
                     @onkeydown="@(e => OnKpiKeydown(e, "/produits"))"
                     title="Cliquer pour voir le catalogue">
                    <div class="kpi-top">
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Small" />
                        </div>
                        <span class="kpi-label">Stock Total</span>
                    </div>
                    <h2 class="kpi-value">@data.TotalStockArticles.ToString("N0")</h2>
                    <span class="kpi-sub">Articles physiques disponibles &rarr;</span>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <div class="kpi-card kpi-card--clickable"
                     role="button" tabindex="0"
                     @onclick='() => Navigation.NavigateTo("/produits")'
                     @onkeydown="@(e => OnKpiKeydown(e, "/produits"))"
                     title="Cliquer pour voir le catalogue">
                    <div class="kpi-top">
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Sell" Size="Size.Small" />
                        </div>
                        <span class="kpi-label">Produits Vendus</span>
                    </div>
                    <h2 class="kpi-value">@data.TotalProduitsVendus.ToString("N0")</h2>
                    <span class="kpi-sub">Total des articles vendus &rarr;</span>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <div class="kpi-card kpi-card--clickable"
                     role="button" tabindex="0"
                     @onclick='() => Navigation.NavigateTo("/commandes")'
                     @onkeydown="@(e => OnKpiKeydown(e, "/commandes"))">
                    <div class="kpi-top">
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" />
                        </div>
                        <span class="kpi-label">Commandes à Traiter</span>
                    </div>
                    <h2 class="kpi-value">@data.CommandesEnAttenteCount.ToString("N0")</h2>
                    <span class="kpi-sub">En attente de validation &rarr;</span>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <div class="kpi-card">
                    <div class="kpi-top">
                        <div class="kpi-icon">
                            <MudIcon Icon="@Icons.Material.Filled.SwapVert" Size="Size.Small" />
                        </div>
                        <span class="kpi-label">Mouvements Aujourd'hui</span>
                    </div>
                    <h2 class="kpi-value">@mouvementsAujourdhui.ToString("N0")</h2>
                    <div class="kpi-sub-row">
                        <span class="trend-badge trend-up">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" />
                            <span>@entreesAujourdhui Entrée@(entreesAujourdhui > 1 ? "s" : "")</span>
                        </span>
                        <span class="trend-badge trend-down">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" />
                            <span>@sortiesAujourdhui Sortie@(sortiesAujourdhui > 1 ? "s" : "")</span>
                        </span>
                    </div>
                </div>
            </MudItem>
        </MudGrid>

        <!-- ===== GRAPHIQUES & REPARTITIONS ===== -->
        <div class="mb-6 dashboard-charts-row">
            <!-- Mouvements de la semaine -->
            <div class="chart-card">
                <div class="chart-header d-flex justify-space-between align-center flex-wrap gap-3">
                    <div>
                        <h3 class="chart-title">Mouvements des 7 Derniers Jours</h3>
                        <span class="chart-subtitle">Volume quotidien d'entrées et de sorties de stock</span>
                    </div>
                    <div class="chart-badge">
                        <MudIcon Icon="@Icons.Material.Filled.SwapVert" Size="Size.Small" />
                        <span>@mouvementsJoursSeries.Sum(v => (int)v) mouvement(s) cumulés</span>
                    </div>
                </div>

                <div class="chart-body">
                    @if (mouvementsJoursSeries.Any(v => v > 0))
                    {
                        <div class="bar-chart-container">
                            <div class="bar-chart-grid">
                                <div class="grid-line" style="bottom: 100%;"><span>@maxMouvementNice</span></div>
                                <div class="grid-line" style="bottom: 75%;"><span>@((int)(maxMouvementNice * 0.75))</span></div>
                                <div class="grid-line" style="bottom: 50%;"><span>@((int)(maxMouvementNice * 0.5))</span></div>
                                <div class="grid-line" style="bottom: 25%;"><span>@((int)(maxMouvementNice * 0.25))</span></div>
                                <div class="grid-line grid-line--base" style="bottom: 0%;"><span>0</span></div>
                            </div>

                            <div class="bar-chart-bars">
                                @for (int i = 0; i < mouvementsJoursLabels.Count; i++)
                                {
                                    var valeur = mouvementsJoursSeries[i];
                                    var heightPct = maxMouvementNice > 0 ? (valeur / maxMouvementNice * 100.0) : 0;
                                    if (heightPct < 3 && valeur > 0) heightPct = 3;

                                    <div class="bar-column">
                                        <div class="bar-wrapper">
                                            @if (valeur > 0)
                                            {
                                                <span class="bar-tooltip">@valeur.ToString("N0") mouvement(s)</span>
                                            }
                                            <div class="bar-fill @(valeur > 0 ? "active" : "empty")" style="--bar-h: @(heightPct.ToString("0.0", CultureInfo.InvariantCulture))%;"></div>
                                        </div>
                                        <span class="bar-label">@mouvementsJoursLabels[i]</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <MudIcon Icon="@Icons.Material.Filled.ShowChart" />
                            <p>Aucun mouvement sur les 7 derniers jours.</p>
                            <span class="empty-state-hint">Les entrées et sorties de stock apparaîtront ici au fil de l'activité.</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Répartition du stock par statut -->
            <div class="chart-card">
                <div class="chart-header">
                    <h3 class="chart-title">Répartition du Stock</h3>
                    <span class="chart-subtitle">Vue d'ensemble par statut</span>
                </div>

                <div class="chart-body">
                    @if (totalStatuts > 0)
                    {
                        <div class="donut-wrapper mb-4">
                            <svg viewBox="0 0 36 36" class="donut-svg">
                                <path class="donut-ring" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />

                                @foreach (var item in statutsDonutData)
                                {
                                    <path class="donut-segment @item.CssClass"
                                          stroke-dasharray="@(item.Pct.ToString("0", CultureInfo.InvariantCulture)), 100"
                                          stroke-dashoffset="@((-item.Offset).ToString("0", CultureInfo.InvariantCulture))"
                                          d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                }
                            </svg>
                            <div class="donut-center">
                                <span class="donut-number">@totalStatuts</span>
                                <span class="donut-label">Produits</span>
                            </div>
                        </div>

                        <div class="status-list">
                            @foreach (var item in statutsDonutData)
                            {
                                <div class="status-item status-item--clickable mb-3" @onclick='() => Navigation.NavigateTo($"/produits?statut={item.StatutCode}")' title="@($"Voir les produits « {item.Label} »")">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <span class="status-label"><span class="dot @item.DotClass"></span>@item.Label</span>
                                        <span class="status-count">@item.Count <small>(@((int)item.Pct)%)</small></span>
                                    </div>
                                    <div class="progress-bar-bg">
                                        <div class="progress-bar-fill @item.FillClass" style="width: @(((int)item.Pct))%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                            <p>Données de statut indisponibles.</p>
                            <span class="empty-state-hint">La répartition s'affichera dès que le catalogue sera chargé.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ===== TABLES D'ALERTES ===== -->
        <div class="mb-6 dashboard-tables-row">
            <div class="table-card">
                <div class="chart-header">
                    <h3 class="chart-title">Articles en Stock Faible ou Rupture</h3>
                    <span class="chart-subtitle">Niveaux nécessitant un réapprovisionnement</span>
                </div>
                <div class="table-responsive table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Article</th>
                                <th>Stock actuel</th>
                                <th>Seuil</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (data.ProduitsAlerte != null && data.ProduitsAlerte.Any())
                            {
                                @foreach (var prod in data.ProduitsAlerte)
                                {
                                    <tr>
                                        <td><span class="ref-code">@prod.Reference</span></td>
                                        <td class="cell-strong">@prod.Nom</td>
                                        <td>
                                            <span class="badge-statut @(prod.QuantiteActuelle == 0 ? "statut-refusee" : "statut-ochre")">
                                                @(prod.QuantiteActuelle == 0 ? "Rupture (0)" : $"{prod.QuantiteActuelle} articles")
                                            </span>
                                        </td>
                                        <td class="cell-muted">@prod.SeuilAlerte</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4">
                                        <div class="empty-state empty-state--inline">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" />
                                            <p>Tous les niveaux de stock sont optimaux.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="table-card">
                <div class="chart-header d-flex justify-space-between align-center">
                    <div>
                        <h3 class="chart-title">Alertes de Surstock</h3>
                        <span class="chart-subtitle">Références à écouler en priorité</span>
                    </div>
                </div>
                <div class="table-responsive table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Produit</th>
                                <th>Stock actuel</th>
                                <th>Excédent (%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (data.ProduitsEnSurstock != null && data.ProduitsEnSurstock.Any())
                            {
                                @foreach (var prod in data.ProduitsEnSurstock)
                                {
                                    <tr class="table-row--clickable" @onclick='() => Navigation.NavigateTo($"/produits?statut=SURSTOCK&highlight={Uri.EscapeDataString(prod.Reference)}")' title="Cliquer pour voir le produit en surstock au catalogue">
                                        <td><span class="ref-code">@prod.Reference</span></td>
                                        <td class="cell-strong">@prod.Nom</td>
                                        <td>@prod.QuantiteActuelle</td>
                                        <td><span class="badge-statut statut-ochre" title="Surplus par rapport au seuil de surstock">+@prod.PourcentageSurstock%</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4">
                                        <div class="empty-state empty-state--inline">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" />
                                            <p>Aucun surstock détecté — niveaux de stock sains.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ===== MOUVEMENTS RECENTS ===== -->
        <MudGrid>
            <MudItem xs="12">
                <div class="table-card h-100 d-flex flex-column">
                    <div class="chart-header d-flex justify-space-between align-center">
                        <div>
                            <h3 class="chart-title">Derniers Mouvements de Stock</h3>
                            <span class="chart-subtitle">Historique récent des entrées et sorties</span>
                        </div>
                    </div>
                    <div class="table-responsive table-scroll flex-1">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Article</th>
                                    <th>Type</th>
                                    <th>Quantité</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (data.MouvementsRecents != null && data.MouvementsRecents.Any())
                                {
                                    @foreach (var mvt in data.MouvementsRecents)
                                    {
                                        <tr>
                                            <td class="cell-strong">@mvt.ProduitNom</td>
                                            <td>
                                                <span class="badge-statut @(EstEntree(mvt.TypeMouvement) ? "statut-acceptee" : "statut-refusee")">
                                                    @(EstEntree(mvt.TypeMouvement) ? "Entrée" : "Sortie")
                                                </span>
                                            </td>
                                            <td class="cell-amount">@mvt.Quantite</td>
                                            <td class="cell-muted">@mvt.DateMouvement.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4">
                                            <div class="empty-state empty-state--inline">
                                                <MudIcon Icon="@Icons.Material.Filled.Inbox" />
                                                <p>Aucun mouvement récent enregistré.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    }
</div>

<style>
    .dashboard-page {
        --ink: #16233A;
        --ink-muted: #64748B;
        --paper: #FFFFFF;
        --sand: #F3F6FA;
        --border: #E1E7EF;
        --denim: #2B4C7E;
        --denim-dark: #14263F;
        --denim-tint: #E7EDF6;
        --pine: #1E8E3E;
        --pine-tint: #E6F4EA;
        --ochre: #B45309;
        --ochre-tint: #FEF3C7;
        --rust: #DC2626;
        --rust-tint: #FEE2E2;
        --slate: #64748B;
        --slate-tint: #EEF1F5;
        --font-display: "Sora", "Inter", sans-serif;
        --font-body: "Inter", sans-serif;
        --font-mono: "JetBrains Mono", monospace;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --shadow-sm: 0 1px 2px rgba(16,24,40,0.04), 0 1px 3px rgba(16,24,40,0.06);
        --shadow-md: 0 8px 24px -12px rgba(20,38,63,0.18);
        font-family: var(--font-body);
        color: var(--ink);
    }

    /* ===== Header ===== */
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 16px;
    }

    .dashboard-kicker {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--denim);
        margin-bottom: 6px;
    }

    .dashboard-title {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.625rem;
        letter-spacing: -0.01em;
        color: var(--ink);
        margin: 0;
    }

    .dashboard-subtitle {
        font-size: 0.875rem;
        color: var(--ink-muted);
        margin: 4px 0 0 0;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .last-updated {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8125rem;
        color: var(--ink-muted);
    }

        .last-updated .mud-icon-root {
            font-size: 1rem;
        }

    /* ===== Buttons ===== */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: var(--radius-sm);
        font-family: var(--font-body);
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: all 0.15s ease;
        text-decoration: none;
    }

    .btn--primary {
        background: var(--denim);
        color: #FFFFFF;
        box-shadow: 0 6px 16px -6px rgba(43,76,126,0.4);
    }

        .btn--primary:hover {
            background: var(--denim-dark);
        }

    .btn--outline {
        border: 1px solid var(--border);
        background: var(--paper);
        color: var(--ink);
    }

        .btn--outline:hover {
            background: var(--sand);
            border-color: var(--denim);
            color: var(--denim);
        }

        .btn--outline:disabled {
            opacity: 0.6;
            cursor: default;
        }

    /* ===== Alert ===== */
    .alert-rupture {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        background: var(--rust-tint);
        border: 1px solid #FCA5A5;
        border-radius: var(--radius-md);
        color: #991B1B;
        font-size: 0.875rem;
        flex-wrap: wrap;
    }

    .alert-icon {
        display: flex;
        color: var(--rust);
        flex-shrink: 0;
    }

    .alert-text {
        flex: 1;
        min-width: 200px;
    }

    .alert-action {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-weight: 700;
        color: var(--rust);
        text-decoration: none;
        white-space: nowrap;
    }

        .alert-action:hover {
            text-decoration: underline;
        }

    /* ===== KPI Cards (design uniforme — un seul accent, une seule identité) ===== */
    .kpi-card {
        position: relative;
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 20px 22px;
        box-shadow: var(--shadow-sm);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            border-color: #D5DEEA;
        }

    .kpi-card--clickable {
        cursor: pointer;
    }

        .kpi-card--clickable:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px -6px rgba(43, 76, 126, 0.2) !important;
            border-color: var(--denim) !important;
        }

        .kpi-card--clickable:focus-visible {
            outline: 2px solid var(--denim);
            outline-offset: 2px;
        }

    .status-item--clickable {
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 6px 8px;
        border-radius: var(--radius-sm);
        margin-left: -8px;
        margin-right: -8px;
    }

        .status-item--clickable:hover {
            background-color: var(--sand);
            box-shadow: inset 0 0 0 1px var(--border);
        }

    .table-row--clickable {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

        .table-row--clickable:hover {
            background-color: rgba(43, 76, 126, 0.08) !important;
        }

    .kpi-top {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }

    .kpi-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--denim-tint);
        color: var(--denim);
    }

    .kpi-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--ink-muted);
    }

    .kpi-value {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.85rem;
        color: var(--ink);
        margin: 0 0 4px 0;
        letter-spacing: -0.01em;
        line-height: 1.1;
    }

        .kpi-value small {
            font-size: 1rem;
            font-weight: 600;
