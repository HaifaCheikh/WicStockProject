    [SupplyParameterFromQuery(Name = "highlight")]
    private string? HighlightQuery { get; set; }

    private int? produitHighlightId;
    private string? produitHighlightRef;

    private bool IsProduitHighlighted(CatalogueProduitDto p)
    {
        if (produitHighlightId.HasValue && p.Id == produitHighlightId.Value) return true;
        if (!string.IsNullOrWhiteSpace(produitHighlightRef))
        {
            return string.Equals(p.Reference, produitHighlightRef, StringComparison.OrdinalIgnoreCase)
                || string.Equals(p.Nom, produitHighlightRef, StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }

    // Dialog commande
    private CatalogueProduitDto? produitSelectionne;
    private int commandeQuantite = 1;
    private decimal commandePrix = 0;
    private bool commandeEnCours = false;
    private DateTime? commandeDateSouhaitee;

    private bool EstModeSurCommande =>
        produitSelectionne != null
        && produitSelectionne.DisponibleSurCommande
        && commandeQuantite > (produitSelectionne.QuantiteDisponible > 0 ? produitSelectionne.QuantiteDisponible : produitSelectionne.QuantiteActuelle);

    // Dialog annulation
    private MaCommandeDto? commandeAnnuler;
    private bool annulationEnCours = false;

    // Palette couleurs catégories (cohérente avec la page produits)
    private static readonly string[] SwatchPalette = new[]
    {
        "#2B4C7E", "#B5563A", "#B8842C", "#4A6FA5", "#7C4A6E"
    };

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(ChargerCatalogue(), ChargerMesCommandes());
        // Récupérer le rôle courant pour contrôler l'affichage côté client
        try { userRole = await AuthService.ObtenirRole(); }
        catch { userRole = null; }

        AppliquerHighlightEtCategorie();

        // Calcule l'état initial (catalogue ou commandes) à partir de l'URL courante
        MettreAJourVueDepuisUri();

        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet()
    {
        AppliquerHighlightEtCategorie();
    }

    private void AppliquerHighlightEtCategorie()
    {
        if (ProduitIdQuery.HasValue)
        {
            produitHighlightId = ProduitIdQuery.Value;
        }

        if (!string.IsNullOrWhiteSpace(HighlightQuery))
        {
            produitHighlightRef = HighlightQuery.Trim();
        }

        if (!string.IsNullOrWhiteSpace(CategorieQuery))
        {
            categoryFilter = CategorieQuery;
        }
        else if ((produitHighlightId.HasValue || !string.IsNullOrWhiteSpace(produitHighlightRef)) && produits != null)
        {
            var target = produits.FirstOrDefault(p => IsProduitHighlighted(p));
            if (target != null && !string.IsNullOrWhiteSpace(target.Categorie))
            {
                categoryFilter = target.Categorie;
            }
        }
    }

    private void MettreAJourVueDepuisUri()
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];
        showCommandes = uri.StartsWith("mes-commandes", StringComparison.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        MettreAJourVueDepuisUri();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && produitHighlightId.HasValue)
        {
            await Task.Delay(400); // Laisser le DOM se stabiliser avec le filtre de catégorie appliqué
            await JS.InvokeVoidAsync("eval",
                $"(function(){{ var el = document.getElementById('produit-{produitHighlightId.Value}'); if(el){{ el.scrollIntoView({{behavior:'smooth', block:'center'}}); }} }})()");
        }
    }

    private async Task ChargerCatalogue()
    {
        try
        {
            produits = await CatalogueService.ObtenirCatalogue();
            if (produits != null && produits.Any())
            {
                _ = Task.Run(async () =>
                {
                    foreach (var prod in produits)
                    {
                        try
                        {
                            var avisList = await FeedbackService.ObtenirAvisPublicsProduit(prod.Id);
                            if (avisList != null && avisList.Any())
                            {
                                prod.NombreAvis = avisList.Count;
                                prod.NoteMoyenne = avisList.Average(a => a.Note);
                            }
                        }
                        catch { }
                    }
                    await InvokeAsync(StateHasChanged);
                });
            }
        }
        catch
        {
            produits = new List<CatalogueProduitDto>();
        }
    }

    private async Task ChargerMesCommandes()
    {
        try { mesCommandes = await CatalogueService.ObtenirMesCommandes(); }
        catch { mesCommandes = new List<MaCommandeDto>(); }
    }

    private void BasculerVueCommandes()
    {
        if (showCommandes)
        {
            Navigation.NavigateTo("/catalogue");
        }
        else
        {
            Navigation.NavigateTo("/mes-commandes");
        }
    }

    private static readonly List<string> CategoriesParDefaut = new()
    {
        "Jacket", "Pants", "Set", "Shirt", "Shorts", "Dress", "Coat", "Skirt"
    };

    private IEnumerable<string> CategoriesDisponibles
    {
        get
        {
            var list = new List<string>(CategoriesParDefaut);
            if (produits != null)
            {
                foreach (var cat in produits.Select(p => p.Categorie).Where(c => !string.IsNullOrWhiteSpace(c)))
                {
                    if (!list.Contains(cat, StringComparer.OrdinalIgnoreCase))
                    {
                        list.Add(cat!);
                    }
                }
            }
            return list.Distinct().OrderBy(c => c);
        }
    }

    private IEnumerable<CatalogueProduitDto> FilteredProduits => produits == null
        ? Enumerable.Empty<CatalogueProduitDto>()
        : produits.Where(p => FilterFunc(p));

    // Rôle de l'utilisateur courant (ex: CLIENT). Utilisé pour afficher badges et désactiver commandes.
    private string? userRole;

    private bool FilterFunc(CatalogueProduitDto p)
    {
        if (!string.IsNullOrEmpty(categoryFilter) && !string.Equals(p.Categorie, categoryFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.IsNullOrWhiteSpace(searchString)) return true;

        if (p.Nom?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.Reference?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.TypeTissu?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.Categorie?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;

        return false;
    }

    private string GetCategoryColor(string? categorie)
    {
        if (string.IsNullOrWhiteSpace(categorie)) return "#64748B";
        int hash = 0;
        foreach (var c in categorie) hash = (hash * 31 + c) & 0x7FFFFFFF;
        return SwatchPalette[hash % SwatchPalette.Length];
    }

    private string GetFullImageUrl(string? relativeUrl)
    {
        if (string.IsNullOrEmpty(relativeUrl)) return "";
        return $"{Http.BaseAddress}{relativeUrl.TrimStart('/')}";
