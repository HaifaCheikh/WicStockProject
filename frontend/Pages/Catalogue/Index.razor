@page "/catalogue"
@page "/mes-commandes"
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inject CatalogueService CatalogueService
@inject FeedbackService FeedbackService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject AuthService AuthService
@inject IJSRuntime JS

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="catalogue-page">
    <MudStack Spacing="6">

        <!-- ===== EN-TÊTE ===== -->
        <div class="d-flex justify-space-between align-center flex-wrap gap-4">
            <div>
                <div class="d-flex align-center gap-3">
                    <MudText Typo="Typo.h4" Class="page-title">Catalogue produits</MudText>
                    @if (produits != null)
                    {
                        <span class="count-badge">@FilteredProduits.Count() articles</span>
                    }
                </div>
                <MudText Typo="Typo.body2" Class="page-subtitle mt-1">
                    Consultez nos références de tissus et passez vos commandes en ligne
                </MudText>
            </div>

            <!-- Bouton Mes commandes -->
            <button class="btn btn--outline" @onclick="BasculerVueCommandes">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
                <span>@(showCommandes ? "Voir le catalogue" : "Mes commandes")</span>
                @if (mesCommandes != null && mesCommandes.Count > 0 && !showCommandes)
                {
                    <span class="notif-badge">@mesCommandes.Count</span>
                }
            </button>
        </div>

        @if (!showCommandes)
        {
            <!-- ===== CATALOGUE ===== -->
            <!-- Barre de recherche et filtres catégorie -->
            <div class="filters-card">
                <label class="filter-label">
                    <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
                    Filtrer
                </label>

                <select class="filter-select" @bind="categoryFilter">
                    <option value="">Toutes les catégories</option>
                    @foreach (var cat in CategoriesDisponibles)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>

                <div class="search-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="search-icon" />
                    <input class="search-input" placeholder="Rechercher par référence, nom, type de tissu..." @bind="searchString" @bind:event="oninput" />
                </div>

                <span class="filter-count">@FilteredProduits.Count() résultat(s)</span>
            </div>

            <!-- Grille des produits -->
            @if (produits == null)
            {
                <MudGrid Spacing="3">
                    @for (int i = 0; i < 8; i++)
                    {
                        <MudItem xs="12" sm="6" md="3">
                            <div class="skeleton-card">
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="176px" />
                                <div class="pa-4 d-flex flex-column gap-2">
                                    <MudSkeleton Width="70%" Height="20px" />
                                    <MudSkeleton Width="50%" Height="16px" />
                                </div>
                            </div>
                        </MudItem>
                    }
                </MudGrid>
            }
            else if (!FilteredProduits.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
                    </div>
                    <MudText Typo="Typo.h6" Class="empty-title mt-3">Aucun produit trouvé</MudText>
                    <MudText Typo="Typo.body2" Class="empty-subtitle mt-1">Modifiez votre recherche ou vos filtres.</MudText>
                </div>
            }
            else
            {
                <MudGrid Spacing="3">
                    @foreach (var produit in FilteredProduits)
                    {
                        var swatch = GetCategoryColor(produit.Categorie);
                        var isHighlighted = IsProduitHighlighted(produit);
                        <MudItem xs="12" sm="6" md="3">
                            <div id="produit-@produit.Id" class="product-card @(isHighlighted ? "product-highlight" : "")" @onclick="() => OuvrirDetails(produit)" style="cursor: pointer;">
                                <div class="swatch-strip" style="background: @swatch;"></div>

                                <!-- Image / Zone visuelle -->
                                <div class="product-image">
                                    @if (!string.IsNullOrEmpty(produit.ImageUrl))
                                    {
                                        <img src="@GetFullImageUrl(produit.ImageUrl)" alt="@produit.Nom" class="card-img" @onclick:stopPropagation="true" @onclick="() => OuvrirImageAgrandie(GetFullImageUrl(produit.ImageUrl), produit.Nom)" style="cursor: zoom-in;" title="Cliquer pour agrandir l'image" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Layers" Style="font-size: 2.5rem; opacity: 0.25;" />
                                    }
                                    <span class="badge-ref">@produit.Reference</span>
                                    @if (produit.EstSurCommande)
                                    {
                                        <span class="badge-cat" style="background: #2B4C7E; font-weight: 700;">Sur commande</span>
                                    }
                                    else if (produit.EstEnRupture)
                                    {
                                        <span class="badge-cat" style="background: #DC2626; font-weight: 700;">Rupture de stock</span>
                                    }
                                    else if (!string.IsNullOrEmpty(produit.Categorie))
                                    {
                                        <span class="badge-cat" style="background: @swatch;">@produit.Categorie</span>
                                    }
                                    @if (produit.EstEnPromotion)
                                    {
                                        <span class="badge-promo-overlay">-@produit.RemisePourcentage%</span>
                                    }
                                </div>

                                <!-- Corps de la carte -->
                                <div class="product-body">
                                    <div>
                                        <div class="d-flex justify-space-between align-start gap-2">
                                            <div class="product-name">@produit.Nom</div>
                                            @if (produit.NombreAvis > 0)
                                            {
                                                <div class="card-rating-tag" title="@produit.NoteMoyenne.ToString("0.0") / 5 (@produit.NombreAvis avis)">
                                                    <span class="star-icon">★</span>
                                                    <span class="score">@produit.NoteMoyenne.ToString("0.0")</span>
                                                    <span class="count">(@produit.NombreAvis)</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="card-rating-tag rating-tag-none" title="Aucun avis pour le moment">
                                                    <span class="star-icon">★</span>
                                                    <span class="score">--</span>
                                                </div>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(produit.TypeTissu))
                                        {
                                            <div class="product-detail d-flex align-center gap-1 mt-1">
                                                <MudIcon Icon="@Icons.Material.Filled.Texture" Size="Size.Small" />
                                                <span>@produit.TypeTissu</span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Action Prix & Commander -->
                                    <div class="product-footer">
                                        @if (produit.EstEnPromotion)
                                        {
                                            <div class="price-promo-block">
                                                <span class="price-original-struck">@produit.PrixUnitaire.ToString("0.00") DT</span>
                                                <span class="price-promo-badge">@produit.PrixPromo.ToString("0.00") DT</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="price-tag-badge">@produit.PrixUnitaire.ToString("0.00") DT</div>
                                        }
                                        @if (produit.EstStockFaibleEffectif)
                                        {
                                            <div class="stock-faible-banner">
                                                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" />
                                                Il ne reste que @(produit.QuantiteDisponible > 0 ? produit.QuantiteDisponible : produit.QuantiteActuelle) pièce(s)
                                            </div>
                                        }
                                        @if (!produit.PeutCommander)
                                        {
                                            <button class="btn-commander" disabled title="Produit en rupture de stock" style="opacity: 0.5; cursor: not-allowed; background: #94A3B8;">
                                                <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" />
                                                <span>En rupture</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn-commander" @onclick:stopPropagation="true" @onclick="() => OuvrirCommande(produit)">
                                                <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Small" />
                                                <span>@(produit.EstSurCommande ? "Commander (sur commande)" : "Commander")</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </MudItem>
                    }
                </MudGrid>
            }
        }
        else
        {
            <!-- ===== MES COMMANDES ===== -->
            <div>
                @if (mesCommandes == null)
                {
                    <div class="d-flex justify-center my-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else if (!mesCommandes.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" />
                        </div>
                        <MudText Typo="Typo.h6" Class="empty-title mt-3">Aucune commande passée</MudText>
                        <MudText Typo="Typo.body2" Class="empty-subtitle mt-1">Parcourez le catalogue pour passer votre première commande.</MudText>
                        <button class="btn btn--primary mt-4" @onclick="BasculerVueCommandes">
                            <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" />
                            <span>Voir le catalogue</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="table-panel">
                        <MudTable Items="@mesCommandes" Hover="true" Elevation="0" Class="commandes-table">
                            <HeaderContent>
                                <MudTh>Produit</MudTh>
                                <MudTh>Référence</MudTh>
                                <MudTh>Catégorie</MudTh>
                                <MudTh>Qté</MudTh>
                                <MudTh>Prix/u</MudTh>
                                <MudTh>Total</MudTh>
                                <MudTh>Statut</MudTh>
                                <MudTh>Date</MudTh>
                                <MudTh Style="text-align:right;">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Produit" Class="cell-name commande-row-clickable" @onclick="() => OuvrirSuivi(context)">@context.ProduitNom</MudTd>
                                <MudTd DataLabel="Référence" Class="commande-row-clickable" @onclick="() => OuvrirSuivi(context)">
                                    <span class="ref-code">@context.ProduitReference</span>
                                </MudTd>
                                <MudTd DataLabel="Catégorie" Class="commande-row-clickable" @onclick="() => OuvrirSuivi(context)">
                                    @if (!string.IsNullOrEmpty(context.ProduitCategorie))
                                    {
                                        <span class="table-cat-tag" style="background: @GetCategoryColor(context.ProduitCategorie);">
                                            @context.ProduitCategorie
                                        </span>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Qté" Style="font-weight: 600;">@context.QuantiteVendue</MudTd>
                                <MudTd DataLabel="Prix/u">@context.PrixUnitaire.ToString("0.00") DT</MudTd>
                                <MudTd DataLabel="Total" Style="font-weight: 700; color: #2B4C7E;">@context.TotalCommande.ToString("0.00") DT</MudTd>
                                <MudTd DataLabel="Statut" Class="commande-row-clickable" @onclick="() => OuvrirSuivi(context)">
                                    <span class="badge-statut @GetStatutCssClass(context.Statut ?? context.StatutCommande)">
                                        @GetStatutLabel(context.Statut ?? context.StatutCommande)
                                    </span>
                                </MudTd>
                                <MudTd DataLabel="Date">@context.DateVente.ToString("dd/MM/yyyy HH:mm")</MudTd>
                                <MudTd Style="text-align:right;">
                                    <div class="d-flex align-center justify-end gap-2">
                                        @if (CanPayer(context))
                                        {
                                            <button class="btn-payer" @onclick="() => OuvrirSuivi(context)" title="Payer cette commande">
                                                <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Small" />
                                            </button>
                                        }
                                        <button class="btn-suivi" @onclick="() => OuvrirSuivi(context)" title="Suivre cette commande">
                                            <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                                        </button>
                                        @if (context.StatutCommande != "REFUSEE" && context.Statut != "PAYEE" && context.Statut != "EN_LIVRAISON" && context.Statut != "LIVREE")
                                        {
                                            <button class="btn-modifier" @onclick="() => OuvrirModification(context)" title="Modifier">
                                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                            </button>
                                            <button class="btn-annuler" @onclick="() => DemanderAnnulation(context)" title="Annuler">
                                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                                            </button>
                                        }
                                    </div>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                }
            </div>
        }

    </MudStack>

    <!-- ===== DIALOG CONFIRMATION ANNULATION ===== -->
    @if (commandeAnnuler != null)
    {
        <div class="dialog-overlay" @onclick="FermerAnnulation">
            <div class="dialog-card dialog-card--sm" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <div>
                        <div class="dialog-title" style="color: #dc2626;">Annuler la commande ?</div>
                        <div class="dialog-subtitle">Cette action est irréversible.</div>
                    </div>
                    <button class="dialog-close" @onclick="FermerAnnulation">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
                <div class="dialog-body">
                    <div class="annulation-recap">
                        <div class="annulation-row">
                            <span class="annulation-label">Produit</span>
                            <span class="annulation-value">@commandeAnnuler.ProduitNom</span>
                        </div>
                        <div class="annulation-row">
                            <span class="annulation-label">Référence</span>
                            <span class="ref-code">@commandeAnnuler.ProduitReference</span>
                        </div>
                        <div class="annulation-row">
                            <span class="annulation-label">Quantité</span>
                            <span class="annulation-value">@commandeAnnuler.QuantiteVendue</span>
                        </div>
                        <div class="annulation-row">
                            <span class="annulation-label">Total</span>
                            <span class="annulation-value" style="font-weight:700; color:#2B4C7E;">@commandeAnnuler.TotalCommande.ToString("0.00") DT</span>
                        </div>
                        <div class="annulation-row">
                            <span class="annulation-label">Date</span>
                            <span class="annulation-value">@commandeAnnuler.DateVente.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>
                <div class="dialog-footer">
                    <button class="btn btn--outline" @onclick="FermerAnnulation">Conserver</button>
                    <button class="btn btn--danger" @onclick="ConfirmerAnnulation" disabled="@annulationEnCours">
                        @if (annulationEnCours)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                        }
                        <span>Confirmer l'annulation</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ===== DIALOG MODIFICATION COMMANDE CLIENT ===== -->
    @if (commandeModifier != null)
    {
        <div class="dialog-overlay" @onclick="FermerModification">
            <div class="dialog-card" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <div>
                        <div class="dialog-title">Modifier la commande</div>
                        <div class="dialog-subtitle">@commandeModifier.ProduitNom</div>
                    </div>
                    <button class="dialog-close" @onclick="FermerModification">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>

                <div class="dialog-body">
                    <!-- Résumé produit -->
                    <div class="order-summary-product">
                        <span class="ref-code">@commandeModifier.ProduitReference</span>
                        @if (!string.IsNullOrEmpty(commandeModifier.ProduitCategorie))
                        {
                            <span class="table-cat-tag" style="background: @GetCategoryColor(commandeModifier.ProduitCategorie); margin-left: 8px;">
                                @commandeModifier.ProduitCategorie
                            </span>
                        }
                    </div>

                    <!-- Quantité -->
                    <div class="dialog-field">
                        <label class="field-label">Nouvelle quantité (articles)</label>
                        <input type="number" class="field-input" min="1" @bind="commandeModifierQuantite" placeholder="ex : 5" />
                    </div>

                    <!-- Prix unitaire -->
                    <div class="dialog-field">
                        <label class="field-label">Prix unitaire (DT)</label>
                        <input type="number" class="field-input" readonly value="@commandeModifier.PrixUnitaire" style="background:#F8FAFC; color:#64748B; cursor:not-allowed;" />
                    </div>

                    <!-- Récapitulatif -->
                    @if (commandeModifierQuantite > 0 && commandeModifier.PrixUnitaire > 0)
                    {
                        <div class="order-total">
                            <span>Nouveau total estimé</span>
                            <strong>@((commandeModifierQuantite * commandeModifier.PrixUnitaire).ToString("0.00")) DT</strong>
                        </div>
                    }
                </div>

                <div class="dialog-footer">
                    <button class="btn btn--outline" @onclick="FermerModification">Annuler</button>
                    <button class="btn btn--primary" @onclick="ConfirmerModification" disabled="@modificationEnCours">
                        @if (modificationEnCours)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Small" />
                        }
                        <span>Enregistrer</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ===== DIALOG DÉTAILS PRODUIT CLIENT ===== -->
    @if (produitDetailsModal != null)
    {
        <div class="dialog-overlay" @onclick="FermerDetails">
            <div class="dialog-card dialog-card--md" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <div>
                        <div class="dialog-title">Détails du produit</div>
                        <div class="dialog-subtitle">Fiche technique et prix</div>
                    </div>
                    <button class="dialog-close" @onclick="FermerDetails">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
                <div class="dialog-body">
                    <div class="d-flex flex-column flex-sm-row gap-4 align-center">
                        <div class="modal-img-wrap" @onclick="() => OuvrirImageAgrandie(GetFullImageUrl(produitDetailsModal.ImageUrl), produitDetailsModal.Nom)" style="width: 160px; height: 160px; border-radius: 12px; overflow: hidden; background: #F3F6FA; flex-shrink: 0; display: flex; align-items: center; justify-content: center; position: relative; cursor: zoom-in;" title="Cliquer pour agrandir l'image">
                            @if (!string.IsNullOrEmpty(produitDetailsModal.ImageUrl))
                            {
                                <img src="@GetFullImageUrl(produitDetailsModal.ImageUrl)" alt="@produitDetailsModal.Nom" style="width: 100%; height: 100%; object-fit: cover;" />
                                <div class="zoom-badge-overlay">
                                    <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" />
                                </div>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Layers" Style="font-size: 3rem; opacity: 0.3;" />
                            }
                        </div>
                        <div style="flex: 1; width: 100%;">
                            <div class="d-flex align-center gap-2 mb-2 flex-wrap">
                                <span class="ref-code">@produitDetailsModal.Reference</span>
                                @if (!string.IsNullOrEmpty(produitDetailsModal.Categorie))
                                {
                                    <span class="table-cat-tag" style="background: @GetCategoryColor(produitDetailsModal.Categorie)">@produitDetailsModal.Categorie</span>
                                }
                            </div>
                            <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: #16233A; margin: 0 0 8px 0;">@produitDetailsModal.Nom</h3>

                            @if (!string.IsNullOrEmpty(produitDetailsModal.TypeTissu))
                            {
                                <div class="d-flex align-center gap-2 text-muted mb-3" style="font-size: 0.875rem;">
                                    <MudIcon Icon="@Icons.Material.Filled.Texture" Size="Size.Small" />
                                    <span>Type / Tissu : <strong>@produitDetailsModal.TypeTissu</strong></span>
                                </div>
                            }

                            @if (produitDetailsModal.EstEnPromotion)
                            {
                                <div style="background: linear-gradient(135deg, #FEF3C7, #FFFBEB); border: 1px solid #FDE68A; padding: 12px 16px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <span style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: #92400E;">🏷️ Promotion -@produitDetailsModal.RemisePourcentage%</span>
                                        <div style="margin-top: 4px;">
                                            <span style="text-decoration: line-through; color: #9CA3AF; font-size: 0.875rem;">@produitDetailsModal.PrixUnitaire.ToString("0.00") DT</span>
                                        </div>
                                    </div>
                                    <span style="font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; color: #D97706;">@produitDetailsModal.PrixPromo.ToString("0.00") DT</span>
                                </div>
                            }
                            else
                            {
                                <div class="price-hero-box" style="background: #E7EDF6; padding: 12px 16px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center;">
                                    <span style="font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; color: #64748B;">Prix Unitaire</span>
                                    <span style="font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; color: #2B4C7E;">@produitDetailsModal.PrixUnitaire.ToString("0.00") DT</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- ===== SECTION AVIS & COMMENTAIRES CLIENTS ===== -->
                    <div class="product-reviews-section mt-5 pt-4" style="border-top: 1px solid #E1E7EF;">
                        <div class="d-flex align-center mb-3" style="display:flex; align-items:center; justify-content:space-between; gap: 16px;">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.StarRate" Style="color: #F59E0B;" Size="Size.Medium" />
                                <h4 style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: #16233A; margin: 0;">Avis et retours clients</h4>
                            </div>
                            @if (avisProduitDetails.Any())
                            {
                                var noteMoyenne = avisProduitDetails.Average(a => a.Note);
                                <div class="d-flex align-center gap-1" style="background: #FEF3C7; border: 1px solid #FDE68A; padding: 4px 12px; border-radius: 999px; font-size: 0.8125rem; font-weight: 700; color: #D97706; flex-shrink: 0;">
                                    <span>★ @noteMoyenne.ToString("0.0") / 5</span>
                                    <span style="font-weight: 500; color: #92400E;">(@avisProduitDetails.Count avis)</span>
                                </div>
                            }
                        </div>

                        @if (isLoadingAvisDetails)
                        {
                            <div class="d-flex align-center justify-center py-4">
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                            </div>
                        }
                        else if (!avisProduitDetails.Any())
                        {
                            <div style="background: #F8FAFC; border: 1px dashed #CBD5E1; padding: 16px; border-radius: 10px; text-align: center; color: #64748B; font-size: 0.875rem;">
                                <MudIcon Icon="@Icons.Material.Filled.RateReview" Size="Size.Small" Style="color: #94A3B8;" />
                                <span class="ml-2">Aucun avis publié pour ce produit pour le moment.</span>
                            </div>
                        }
                        else
                        {
                            <div class="reviews-list" style="display: flex; flex-direction: column; gap: 10px; max-height: 220px; overflow-y: auto; padding-right: 4px;">
                                @foreach (var avis in avisProduitDetails)
                                {
                                    <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 12px 14px;">
                                        <div class="d-flex align-center mb-1" style="display:flex; align-items:center; justify-content:space-between; gap: 16px;">
                                            <span style="font-weight: 600; font-size: 0.85rem; color: #1E293B;">@avis.ClientNom</span>
                                            <span style="font-size: 0.75rem; color: #94A3B8; flex-shrink: 0;">@avis.DateCreation.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        <div class="d-flex align-center gap-1 mb-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= avis.Note)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color: #F59E0B; font-size: 14px;" />
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.StarBorder" Size="Size.Small" Style="color: #CBD5E1; font-size: 14px;" />
                                                }
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(avis.Commentaire))
                                        {
                                            <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: #334155; font-style: italic; line-height: 1.4;">« @avis.Commentaire »</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="dialog-footer">
                    <button class="btn btn--outline" @onclick="FermerDetails">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        <span>Fermer</span>
                    </button>
                    @if (produitDetailsModal != null && !produitDetailsModal.PeutCommander)
                    {
                        <button class="btn" disabled title="Rupture de stock" style="background:#94A3B8; color:#fff; opacity:0.65; cursor:not-allowed;">
                            <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Small" />
                            <span>Rupture du stock</span>
                        </button>
                    }
                    else
                    {
                        <button class="btn btn--primary" @onclick="() => { var p = produitDetailsModal; FermerDetails(); OuvrirCommande(p!); }">
                            <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Small" />
                            <span>Commander cet article</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ===== DIALOG PASSER UNE COMMANDE ===== -->
    @if (produitSelectionne != null)
    {
        <div class="dialog-overlay" @onclick="FermerCommande">
            <div class="dialog-card" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <div>
                        <div class="dialog-title">Passer une commande</div>
                        <div class="dialog-subtitle">@produitSelectionne.Nom</div>
                    </div>
                    <button class="dialog-close" @onclick="FermerCommande">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>

                <div class="dialog-body">
                    <!-- Résumé produit -->
                    <div class="order-summary-product">
                        <span class="ref-code">@produitSelectionne.Reference</span>
                        @if (!string.IsNullOrEmpty(produitSelectionne.Categorie))
                        {
                            <span class="table-cat-tag" style="background: @GetCategoryColor(produitSelectionne.Categorie); margin-left: 8px;">
                                @produitSelectionne.Categorie
                            </span>
                        }
                        @if (produitSelectionne.EstEnPromotion)
                        {
                            <span style="background: #FEF3C7; color: #B45309; border: 1px solid #FDE68A; border-radius: 6px; padding: 2px 8px; font-size: 0.75rem; font-weight: 700; margin-left: 8px;">
                                🏷️ Promo -@produitSelectionne.RemisePourcentage% active
                            </span>
                        }
                    </div>

                    @if (produitSelectionne.EstEnPromotion)
                    {
                        <div style="background: linear-gradient(135deg, #FEF3C7, #FFFBEB); border: 1px solid #FDE68A; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <div style="font-size: 0.75rem; color: #92400E; font-weight: 600; text-transform: uppercase;">Promotion IA appliquée</div>
                                <div style="font-size: 0.8125rem; color: #78350F; margin-top: 2px;">
                                    <span style="text-decoration: line-through; color: #9CA3AF;">@produitSelectionne.PrixUnitaire.ToString("0.00") DT</span>
                                    <span style="margin-left: 8px; font-size: 1rem; font-weight: 800; color: #D97706;">→ @produitSelectionne.PrixPromo.ToString("0.00") DT</span>
                                </div>
                            </div>
                            <div style="background: #D97706; color: white; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.8rem;">
                                -@produitSelectionne.RemisePourcentage%
                            </div>
                        </div>
                    }

                    <!-- Quantité -->
                    <div class="dialog-field">
                        <label class="field-label">Quantité (articles)</label>
                        <input type="number" class="field-input" min="1" @bind="commandeQuantite" placeholder="ex : 5" />
                    </div>

                    @if (EstModeSurCommande)
                    {
                        <div class="dialog-field">
                            <label class="field-label">Date souhaitée (optionnelle)</label>
                            <MudDatePicker @bind-Date="commandeDateSouhaitee"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           MinDate="DateTime.Today"
                                           Clearable="true"
                                           Placeholder="Choisir une date" />
                            <MudText Typo="Typo.caption" Class="hint-text mt-1">
                                Ce produit sera fabrié sur commande faute de stock suffisant.
                            </MudText>
                        </div>
                    }

                    <!-- Prix unitaire -->
                    <div class="dialog-field">
                        <label class="field-label">Prix unitaire (DT)</label>
                        <input type="number" class="field-input" readonly @bind="commandePrix" style="background:#F8FAFC; color:#64748B; cursor:not-allowed;" />
                    </div>

                    <!-- Récapitulatif -->
                    @if (commandeQuantite > 0 && commandePrix > 0)
                    {
                        <div class="order-total">
                            <span>Total estimé</span>
                            <strong>@((commandeQuantite * commandePrix).ToString("0.00")) DT</strong>
                        </div>
                    }
                </div>

                <div class="dialog-footer">
                    <button class="btn btn--outline" @onclick="FermerCommande">Annuler</button>
                    <button class="btn btn--primary" @onclick="ConfirmerCommande" disabled="@commandeEnCours">
                        @if (commandeEnCours)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                        }
                        <span>Confirmer la commande</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ===== LIGHTBOX IMAGE AGRANDIE ===== -->
    @if (!string.IsNullOrEmpty(imageAgrandieUrl))
    {
        <div class="image-lightbox-overlay" @onclick="FermerImageAgrandie">
            <button class="lightbox-close-btn" @onclick="FermerImageAgrandie" @onclick:stopPropagation="true" aria-label="Fermer">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Large" />
            </button>
            <img src="@imageAgrandieUrl" alt="@imageAgrandieAlt" class="lightbox-img" @onclick:stopPropagation="true" />
            @if (!string.IsNullOrEmpty(imageAgrandieAlt))
            {
                <div class="lightbox-caption">@imageAgrandieAlt</div>
            }
        </div>
    }

</div>

<style>
    .catalogue-page {
        --ink: #16233A;
        --ink-muted: #64748B;
        --paper: #FFFFFF;
        --sand: #F3F6FA;
        --border: #E1E7EF;
        --denim: #2B4C7E;
        --denim-dark: #14263F;
        --denim-tint: #E7EDF6;
        --rust: #A23B2E;
        --rust-tint: #F7E9E6;
        --radius-sm: 8px;
        --radius-lg: 14px;
        --font-display: "Sora", "Inter", sans-serif;
        --font-body: "Inter", sans-serif;
        --font-mono: "JetBrains Mono", monospace;
        font-family: var(--font-body);
        color: var(--ink);
    }

        .catalogue-page .page-title {
            font-family: var(--font-display);
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -0.02em;
        }

        .catalogue-page .page-subtitle {
            color: var(--ink-muted);
        }

        .catalogue-page .count-badge {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--denim);
            background: var(--denim-tint);
            padding: 4px 10px;
            border-radius: var(--radius-sm);
        }

        /* ===== Boutons ===== */
        .catalogue-page .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
            border-radius: var(--radius-sm);
            padding: 9px 18px;
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.15s ease;
            position: relative;
        }

        .catalogue-page .btn--primary {
            background: var(--denim);
            color: #fff;
            box-shadow: 0 6px 16px -6px rgba(43,76,126,0.4);
        }

            .catalogue-page .btn--primary:hover {
                background: var(--denim-dark);
                box-shadow: 0 8px 20px -6px rgba(43,76,126,0.55);
                transform: translateY(-1px);
            }

            .catalogue-page .btn--primary:disabled {
                opacity: 0.6;
                cursor: not-allowed;
                transform: none;
            }

        .catalogue-page .btn--outline {
            background: var(--paper);
            color: var(--ink);
            border: 1px solid var(--border);
        }

            .catalogue-page .btn--outline:hover {
                border-color: var(--denim);
                color: var(--denim);
                background: var(--denim-tint);
            }

    .notif-badge {
        position: absolute;
        top: -6px;
        right: -6px;
        background: var(--denim);
        color: #fff;
        font-size: 0.6875rem;
        font-weight: 700;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ===== Barre de filtres (style aligné sur la page Produits) ===== */
    .filters-card {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .filter-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--ink-muted);
        white-space: nowrap;
    }

    .filter-select {
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 8px 14px;
        font-size: 0.875rem;
        font-weight: 600;
        font-family: var(--font-body);
        color: var(--ink);
        background: var(--paper);
        cursor: pointer;
        outline: none;
        min-width: 180px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .filter-select:focus {
            border-color: var(--denim);
            box-shadow: 0 0 0 3px rgba(43, 76, 126, 0.14);
        }

    .search-wrap {
        position: relative;
        flex: 1;
        min-width: 220px;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--ink-muted);
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 8px 14px 8px 36px;
        font-size: 0.875rem;
        font-family: var(--font-body);
        color: var(--ink);
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .search-input:focus {
            border-color: var(--denim);
            box-shadow: 0 0 0 3px rgba(43, 76, 126, 0.14);
        }

    .filter-count {
        font-size: 0.8rem;
        color: var(--ink-muted);
        font-weight: 600;
        white-space: nowrap;
    }

    /* ===== Skeleton ===== */
    .skeleton-card {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    /* ===== Empty state ===== */
    .empty-state {
        background: var(--paper);
        border: 1px dashed var(--border);
        border-radius: var(--radius-lg);
        padding: 64px 24px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: var(--sand);
        color: var(--ink-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }

    .empty-title {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--ink);
    }

    .empty-subtitle {
        color: var(--ink-muted);
    }

    /* ===== Carte produit ===== */
    .product-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

        .product-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px -12px rgba(20,38,63,0.25);
            border-color: transparent;
        }

    .product-highlight {
        border-color: #2B4C7E !important;
        box-shadow: 0 0 0 3px rgba(43,76,126,0.25), 0 10px 28px -10px rgba(43,76,126,0.35) !important;
        animation: highlightPulse 2s ease-in-out 2;
    }

    @@keyframes highlightPulse {
        0% {
            box-shadow: 0 0 0 3px rgba(43,76,126,0.25);
        }

        50% {
            box-shadow: 0 0 0 8px rgba(43,76,126,0.10);
        }

        100% {
            box-shadow: 0 0 0 3px rgba(43,76,126,0.25);
        }
    }

    .swatch-strip {
        height: 4px;
        width: 100%;
    }

    .product-image {
        position: relative;
        width: 100%;
        height: 176px;
        background: var(--sand);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .product-card:hover .card-img {
        transform: scale(1.04);
    }

    .badge-ref {
        position: absolute;
        top: 10px;
        left: 10px;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 600;
        background: rgba(22,35,58,0.88);
        color: #fff;
        padding: 3px 9px;
        border-radius: var(--radius-sm);
    }

    .badge-cat {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 0.6875rem;
        font-weight: 600;
        color: #fff;
        padding: 3px 9px;
        border-radius: var(--radius-sm);
    }

    .product-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
        padding: 16px;
    }

    .product-name {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--ink);
        line-height: 1.3;
    }

    .product-detail {
        color: var(--ink-muted);
        font-weight: 500;
        font-size: 0.875rem;
    }

    .product-footer {
        padding-top: 12px;
        border-top: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .btn-commander {
        display: flex;
        align-items: center;
        gap: 6px;
        width: 100%;
        padding: 8px 14px;
        border: none;
        border-radius: var(--radius-sm);
        background: var(--denim);
        color: #fff;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.875rem;
        cursor: pointer;
        transition: background 0.15s ease;
        justify-content: center;
    }

        .btn-commander:hover {
            background: var(--denim-dark);
        }

    /* Alerte stock faible — allégée, sans cadre orangé, simple ligne de texte */
    .stock-faible-banner {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #C2410C;
        font-size: 0.75rem;
        font-weight: 600;
    }

        .stock-faible-banner .mud-icon-root {
            font-size: 1rem !important;
            width: 1rem;
            height: 1rem;
        }

    .commande-row-clickable {
        cursor: pointer;
    }

        .commande-row-clickable:hover {
            background: var(--sand) !important;
        }

    .suivi-link-hint {
        display: block;
        font-size: 0.6875rem;
        color: var(--denim);
        font-weight: 600;
        margin-top: 4px;
    }

    .price-tag-badge {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.9375rem;
        color: var(--denim);
    }

    /* 🏷️ Badge promo overlay sur l'image produit */
    .badge-promo-overlay {
        position: absolute;
        top: 8px;
        right: 8px;
        background: linear-gradient(135deg, #DC2626, #EF4444);
        color: #fff;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 0.8125rem;
        padding: 4px 10px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(220, 38, 38, 0.35);
        z-index: 3;
        animation: promoPulse 2s ease-in-out infinite;
    }

    @@keyframes promoPulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.06);
        }
    }

    /* Bloc prix promo dans le footer de la carte — allégé, sans cadre orangé */
    .price-promo-block {
        display: flex;
        align-items: baseline;
        gap: 8px;
    }

    .price-original-struck {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.75rem;
        color: #9CA3AF;
        text-decoration: line-through;
    }

    .price-promo-badge {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 0.9375rem;
        color: #D97706;
    }

    /* ===== Table commandes ===== */
    .table-panel {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .commandes-table .mud-table-head th {
        font-family: var(--font-body);
        font-weight: 700;
        color: var(--ink-muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        background: var(--sand);
    }

    .cell-name {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--ink);
    }

    .ref-code {
        font-family: var(--font-mono);
        font-weight: 600;
        font-size: 0.8125rem;
        color: var(--denim);
        background: var(--denim-tint);
        padding: 3px 8px;
        border-radius: 6px;
    }

    .table-cat-tag {
        font-size: 0.75rem;
        font-weight: 600;
        color: #fff;
        padding: 3px 9px;
        border-radius: 6px;
    }

    /* ===== Bouton Annuler commande ===== */
    .btn-annuler {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border: 1px solid #fca5a5;
        border-radius: var(--radius-sm);
        background: #fff5f5;
        color: #dc2626;
        font-family: var(--font-body);
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
    }

        .btn-annuler:hover {
            background: #fee2e2;
            border-color: #f87171;
        }

    /* ===== Bouton Modifier commande ===== */
    .btn-modifier {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border: 1px solid #bfdbfe;
        border-radius: var(--radius-sm);
        background: #eff6ff;
        color: #2563eb;
        font-family: var(--font-body);
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
    }

        .btn-modifier:hover {
            background: #dbeafe;
            border-color: #93c5fd;
        }

    /* ===== Bouton danger (dans dialog) ===== */
    .catalogue-page .btn--danger {
        background: #dc2626;
        color: #fff;
        border: none;
        box-shadow: 0 4px 12px -4px rgba(220, 38, 38, 0.4);
    }

        .catalogue-page .btn--danger:hover {
            background: #b91c1c;
            box-shadow: 0 6px 16px -4px rgba(220, 38, 38, 0.55);
            transform: translateY(-1px);
        }

        .catalogue-page .btn--danger:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

    /* ===== Dialog compact (annulation) ===== */
    .dialog-card--sm {
        max-width: 400px;
    }

    .annulation-recap {
        background: var(--sand);
        border-radius: var(--radius-sm);
        padding: 12px 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .annulation-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .annulation-label {
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--ink-muted);
        min-width: 80px;
