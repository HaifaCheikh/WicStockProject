            ProduitId = commandeModifier.ProduitId,
            QuantiteVendue = commandeModifierQuantite,
            PrixUnitaire = commandeModifier.PrixUnitaire
        };

        var succes = await CatalogueService.ModifierCommande(commandeModifier.Id, dto);
        modificationEnCours = false;

        if (succes)
        {
            Snackbar.Add("Commande modifiée avec succès !", Severity.Success);
            FermerModification();
            await ChargerMesCommandes();
        }
        else
        {
            Snackbar.Add("Impossible de modifier cette commande (ex: stock insuffisant).", Severity.Error);
        }
    }
}
