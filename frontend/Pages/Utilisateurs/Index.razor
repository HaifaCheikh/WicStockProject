@code {
    private List<UtilisateurDto>? utilisateurs;
    private string searchString = "";
    private string roleFilter = "";
    private bool isGridView = true;

    // ===== Edition =====
    private UtilisateurDto? userEnEdition;
    private string editPrenom = "";
    private string editNom = "";
    private string editEmail = "";
    private string editTelephone = "";
    private bool enregistrementEnCours = false;

    // ===== Suppression =====
    private UtilisateurDto? userASupprimer;

    private static readonly Dictionary<string, string> RoleColors = new()
    {
        { "ADMIN",                        "#2B4C7E" },
        { "RESPONSABLE_STOCK_PRODUCTION", "#D97706" },
        { "CLIENT",                       "#B5563A" },
        { "LIVREUR",                      "#1E6B4C" }
    };

    protected override async Task OnInitializedAsync()
    {
        await ChargerUtilisateurs();
    }

    private async Task ChargerUtilisateurs()
    {
        try
        {
            utilisateurs = await UtilisateurService.ObtenirTous();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch
        {
            utilisateurs = new List<UtilisateurDto>();
        }
    }

    private IEnumerable<UtilisateurDto> FilteredUtilisateurs => utilisateurs == null
        ? Enumerable.Empty<UtilisateurDto>()
        : utilisateurs.Where(u => FilterFunc(u));

    private bool FilterFunc(UtilisateurDto u)
    {
        if (!string.IsNullOrEmpty(roleFilter) && !string.Equals(u.Role, roleFilter, StringComparison.OrdinalIgnoreCase))
            return false;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (u.Nom?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (u.Prenom?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (u.Email?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (u.Role?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    private int CountByRole(string role) =>
        utilisateurs?.Count(u => string.Equals(u.Role, role, StringComparison.OrdinalIgnoreCase)) ?? 0;

    private string GetInitials(string prenom, string nom)
    {
        var p = string.IsNullOrWhiteSpace(prenom) ? "" : prenom.Trim()[0].ToString().ToUpper();
        var n = string.IsNullOrWhiteSpace(nom) ? "" : nom.Trim()[0].ToString().ToUpper();
        return $"{p}{n}";
    }

    private string GetRoleColor(string role) =>
        RoleColors.TryGetValue(role ?? "", out var color) ? color : "#64748B";

    private string GetRoleLabel(string role) => role switch
    {
        "ADMIN" => "Admin",
        "RESPONSABLE_STOCK_PRODUCTION" => "Resp. Stock & Production",
        "CLIENT" => "Client",
        "LIVREUR" => "Livreur",
        _ => role
    };

    // ===== Edition =====
    private void OuvrirEdition(UtilisateurDto user)
    {
        userEnEdition = user;
        editPrenom = user.Prenom;
        editNom = user.Nom;
        editEmail = user.Email;
        editTelephone = user.Telephone ?? "";
    }

    private void FermerEdition() => userEnEdition = null;

    private async Task SauvegarderEdition()
    {
        if (userEnEdition == null) return;
        if (string.IsNullOrWhiteSpace(editPrenom) || string.IsNullOrWhiteSpace(editNom))
        {
            Snackbar.Add("Le prénom et le nom sont obligatoires.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(editEmail) || !editEmail.Contains("@"))
        {
            Snackbar.Add("Veuillez saisir une adresse email valide.", Severity.Warning);
            return;
        }

        enregistrementEnCours = true;

        var dto = new ModifierUtilisateurDto
        {
            Prenom = editPrenom.Trim(),
            Nom = editNom.Trim(),
            Email = editEmail.Trim(),
            Telephone = string.IsNullOrWhiteSpace(editTelephone) ? null : editTelephone.Trim()
        };

        var (succes, message) = await UtilisateurService.Modifier(userEnEdition.Id, dto);
        enregistrementEnCours = false;

        if (succes)
        {
            userEnEdition.Prenom = dto.Prenom;
            userEnEdition.Nom = dto.Nom;
            userEnEdition.Email = dto.Email;
            userEnEdition.Telephone = dto.Telephone;
            Snackbar.Add($"Utilisateur {dto.Prenom} {dto.Nom} mis à jour avec succès.", Severity.Success);
            FermerEdition();
        }
        else
        {
            Snackbar.Add(message, Severity.Error);
        }
    }

    // ===== Suppression =====
    private void DemanderSuppression(UtilisateurDto user) => userASupprimer = user;

    private void FermerSuppression() => userASupprimer = null;

    private async Task ConfirmerSuppression()
    {
        if (userASupprimer == null) return;
        var id = userASupprimer.Id;
        FermerSuppression();

        var succes = await UtilisateurService.Supprimer(id);
        if (succes)
        {
            Snackbar.Add("Utilisateur supprimé avec succès.", Severity.Success);
            await ChargerUtilisateurs();
        }
        else
        {
            Snackbar.Add("Erreur lors de la suppression de l'utilisateur.", Severity.Error);
        }
    }

    private async Task ModifierRoleUser(UtilisateurDto user, string nouveauRole)
    {
        if (user.Role == nouveauRole) return;
        var succes = await UtilisateurService.ModifierRole(user.Id, nouveauRole);
        if (succes)
        {
            user.Role = nouveauRole;
            Snackbar.Add($"Rôle de {user.Prenom} mis à jour en {GetRoleLabel(nouveauRole)}.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Erreur lors de la modification du rôle.", Severity.Error);
        }
    }

    private void AllerVersInscription() => Navigation.NavigateTo("/register");
}
