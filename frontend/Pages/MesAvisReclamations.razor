@code {
    private List<MaCommandeDto> commandesLivrees = new();
    private List<AvisDto> mesAvis = new();
    private List<ReclamationDto> mesReclamations = new();
    private bool isLoading = true;

    private string activeTab = "TOUS";

    private MaCommandeDto? selectedCommande;
    private AvisDto? selectedAvis;
    private bool showAvisModal = false;
    private bool showReclamationModal = false;

    protected override async Task OnInitializedAsync()
    {
        await ChargerDonnees();
    }

    private async Task ChargerDonnees()
    {
        isLoading = true;
        try
        {
            var toutesCommandes = await CatalogueService.ObtenirMesCommandes();
            commandesLivrees = toutesCommandes
                .Where(c => string.Equals(c.Statut, "LIVREE", StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(c.StatutCommande, "LIVREE", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(c => c.DateVente)
                .ToList();

            mesAvis = await FeedbackService.ObtenirMesAvis();
            mesReclamations = await FeedbackService.ObtenirMesReclamations();
        }
        catch { }
        finally { isLoading = false; }
    }

    private void OuvrirAvisModal(MaCommandeDto cmd)
    {
        selectedCommande = cmd;
        selectedAvis = mesAvis.FirstOrDefault(a => a.CommandeId == cmd.Id);
        showAvisModal = true;
    }

    private void OuvrirReclamationModal(MaCommandeDto cmd)
    {
        selectedCommande = cmd;
        showReclamationModal = true;
    }

    private bool EstDelaiExceder14Jours(DateTime dateVente)
    {
        return (DateTime.Now - dateVente).TotalDays > 14;
    }

    private string GetFullImageUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        if (url.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }
        return $"{Http.BaseAddress}{url.TrimStart('/')}";
    }

    private string GetAvisStatutClass(string statut) => statut?.ToUpperInvariant() switch
    {
        "PUBLIE" => "status-pill--done",
        "REJETE" => "status-pill--rejected",
        _ => "status-pill--pending"
    };

    private string GetReclamationStatutClass(string statut) => statut?.ToUpperInvariant() switch
    {
        "RESOLUE" => "status-pill--done",
        "EN_COURS" => "status-pill--progress",
        "REJETEE" => "status-pill--rejected",
        _ => "status-pill--pending"
    };

    private string GetReclamationStatutIcon(string statut) => statut?.ToUpperInvariant() switch
    {
        "RESOLUE" => Icons.Material.Filled.CheckCircle,
        "EN_COURS" => Icons.Material.Filled.HourglassTop,
        "REJETEE" => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.MarkEmailUnread
    };

    private void NaviguerSuivi(int id) => Navigation.NavigateTo($"/mes-commandes/suivi/{id}");
    private void SetTab(string tab) => activeTab = tab;

    private string GetReclamationStatutLabel(string statut) => statut?.ToUpperInvariant() switch
    {
        "ENVOYEE" => "Envoyée",
        "EN_COURS" => "En cours de traitement",
        "RESOLUE" => "Résolue",
        "REJETEE" => "Rejetée",
        _ => statut ?? string.Empty
    };
}

