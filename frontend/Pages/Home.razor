@page "/"
@layout WicStock.Web.Layout.HomeLayout
@inject NavigationManager Navigation
@inject WicStock.Web.Services.AuthService AuthService

<PageTitle>WicStock - Accueil</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="home-page">

    <!-- ===== NAVBAR ===== -->
    <header class="navbar">
        <div class="container navbar-inner">
            <a href="/" class="brand">
                <span class="brand-mark">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                        <path d="M3 8 L21 8 M3 12 L21 12 M3 16 L21 16" stroke="#fff" stroke-width="2" stroke-linecap="round" />
                        <path d="M7 4 L7 20 M12 4 L12 20 M17 4 L17 20" stroke="rgba(255,255,255,0.55)" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                </span>
                <span class="brand-name">WicStock</span>
            </a>

            <nav class="navbar-links">
                <a href="#parcours">Comment ça marche</a>
                <a href="#fonctionnalites">Fonctionnalités</a>
            </nav>

            <div class="navbar-actions">
                <a href="/login" class="btn btn--primary btn--sm">Se connecter</a>
            </div>
        </div>
    </header>

    <!-- ===== HERO ===== -->
    <section class="hero">
        <div class="container hero-grid">
            <div class="hero-copy">
                <span class="hero-eyebrow">Gestion d'inventaire &amp; production textile</span>
                <h1 class="hero-title">Repenser la mode pour un futur plus responsable</h1>
                <p class="hero-subtitle">
                    De la production à la commande : WicStock centralise vos références, vos stocks et votre production pour réduire le gaspillage textile.
                </p>

                <div class="hero-actions">
                    <AuthorizeView>
                        <Authorized Context="authCtx">
                            <button class="btn btn--primary" @onclick="NaviguerVersApp">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                                <span>Accéder à l'inventaire</span>
                            </button>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login" class="btn btn--primary">
                                <MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Small" />
                                <span>Se connecter</span>
                            </a>
                            <a href="/register" class="btn btn--outline">
                                <span>Créer un compte</span>
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>

                <div class="hero-trust">
                    <span><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> Suivi en temps réel</span>
                    <span><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> Traçabilité complète</span>
                    <span><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> Prévision anti-gaspillage</span>
                </div>
            </div>

            <div class="hero-visual">
                <div class="mockup-card mockup-card--back" aria-hidden="true"></div>
                <div class="mockup-card mockup-card--front">
                    <div class="mockup-strip"></div>
                    <div class="mockup-image">
                        <MudIcon Icon="@Icons.Material.Filled.Layers" Style="font-size: 2.5rem; opacity: 0.3;" />
                        <span class="mockup-badge-ref">TIS-DEN-0142</span>
                        <span class="mockup-badge-cat">Denim</span>
                    </div>
                    <div class="mockup-body">
                        <div class="mockup-title">Denim Brut 14oz</div>
                        <div class="mockup-detail">
                            <MudIcon Icon="@Icons.Material.Filled.Texture" Size="Size.Small" />
                            <span>Coton croisé, tissage serré</span>
                        </div>
                        <div class="mockup-footer">
                            <span class="mockup-lifecycle">Actif</span>
                            <span class="mockup-stock">Stock : 342 m</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== COMMENT ÇA MARCHE ===== -->
    <section class="section" id="parcours">
        <div class="container">
            <div class="section-head">
                <span class="section-kicker">Le parcours d'une référence</span>
                <h2 class="section-title">De la matière première à la traçabilité</h2>
            </div>

            <div class="stitch-flow">
                <div class="stitch-line" aria-hidden="true"></div>

                <div class="stitch-step">
                    <div class="stitch-node">01</div>
                    <h3 class="stitch-label">Réception</h3>
                    <p class="stitch-text">Enregistrement des produits à l'arrivée en stock.</p>
                </div>

                <div class="stitch-step">
                    <div class="stitch-node">02</div>
                    <h3 class="stitch-label">Catalogage</h3>
                    <p class="stitch-text">Fiche produit détaillée : type de tissu, référence, catégorie, visuel.</p>
                </div>

                <div class="stitch-step">
                    <div class="stitch-node">03</div>
                    <h3 class="stitch-label">Suivi</h3>
                    <p class="stitch-text">Mouvements de stock et disponibilité consultables en temps réel.</p>
                </div>

                <div class="stitch-step">
                    <div class="stitch-node">04</div>
                    <h3 class="stitch-label">Traçabilité</h3>
                    <p class="stitch-text">Cycle de vie complet, de l'article actif jusqu'à son obsolescence.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== FONCTIONNALITÉS ===== -->
    <section class="section" id="fonctionnalites">
        <div class="container">
            <div class="section-head">
                <span class="section-kicker">Conçu pour l'atelier</span>
                <h2 class="section-title">Ce que WicStock vous apporte</h2>
            </div>

            <div class="feature-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Security" />
                    </div>
                    <h3 class="feature-title">Accès sécurisé</h3>
                    <p class="feature-text">Sécurité et confiance à chaque accès</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon">
                        <MudIcon Icon="@Icons.Material.Filled.FlashOn" />
                    </div>
                    <h3 class="feature-title">Performance temps réel</h3>
                    <p class="feature-text">Suivi en temps réel de vos stocks et produits</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon">
                        <MudIcon Icon="@Icons.Material.Filled.BarChart" />
                    </div>
                    <h3 class="feature-title">Traçabilité &amp; qualité</h3>
                    <p class="feature-text">Une qualité garantie à chaque étape</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CTA FINAL ===== -->
    <section class="section section--closing">
        <div class="container">
            <div class="closing-band">
                <div>
                    <h2 class="closing-title">Prêt à reprendre le fil de votre stock ?</h2>
                    <p class="closing-text">La mode se transforme : moins de déchets, plus de style</p>
                </div>
                <AuthorizeView>
                    <Authorized>
                        <a href="/produits" class="btn btn--primary">
                            <span>Voir le catalogue</span>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn--primary">
                            <span>Se connecter</span>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </section>

    <!-- ===== FOOTER ===== -->
    <footer class="footer">
        <div class="container footer-inner">
            <div class="d-flex align-center gap-2">
                <a href="/" class="brand">
                    <span class="brand-mark">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                            <path d="M3 8 L21 8 M3 12 L21 12 M3 16 L21 16" stroke="#fff" stroke-width="2" stroke-linecap="round" />
                            <path d="M7 4 L7 20 M12 4 L12 20 M17 4 L17 20" stroke="rgba(255,255,255,0.55)" stroke-width="1.4" stroke-linecap="round" />
                        </svg>
                    </span>
                    <span class="brand-name">WicStock</span>
                </a>
            </div>
            <span class="footer-copy">© @DateTime.Now.Year WicStock — Gestion de stock &amp; production textile</span>
        </div>
    </footer>
</div>

<style>
    .home-page {
        --ink: #16233A;
        --ink-muted: #64748B;
        --paper: #FFFFFF;
        --sand: #F3F6FA;
        --border: #E1E7EF;
        --denim: #2B4C7E;
        --denim-dark: #14263F;
        --denim-tint: #E7EDF6;
        --navbar-h: 64px;
        --page-gradient: linear-gradient(180deg, var(--denim-tint) 0%, var(--paper) 100%);
        --font-display: "Sora", "Inter", sans-serif;
        --font-body: "Inter", sans-serif;
        --font-mono: "JetBrains Mono", monospace;
        --radius-sm: 8px;
        --radius-lg: 16px;
        font-family: var(--font-body);
        color: var(--ink);
        display: flex;
        flex-direction: column;
    }

        .home-page .container {
            max-width: 1160px;
            margin: 0 auto;
            padding: 0 24px;
            width: 100%;
        }

        /* ===== Navbar ===== */
        .home-page .navbar {
            border-bottom: 1px solid var(--border);
            background: var(--paper);
            position: sticky;
            top: 0;
            z-index: 20;
        }

        .home-page .navbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: var(--navbar-h);
        }

        .home-page .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .home-page .brand-mark {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--denim);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .home-page .brand-mark--sm {
            width: 24px;
            height: 24px;
            border-radius: 6px;
        }

        .home-page .brand-name {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.125rem;
            color: var(--ink);
            letter-spacing: -0.01em;
        }

        .home-page .navbar-links {
            display: flex;
            gap: 28px;
        }

            .home-page .navbar-links a {
                font-size: 0.875rem;
                font-weight: 500;
                color: var(--ink-muted);
                text-decoration: none;
                transition: color 0.15s ease;
            }

                .home-page .navbar-links a:hover {
                    color: var(--denim);
                }

        .home-page .navbar-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .home-page .navbar-link-btn {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--ink);
            text-decoration: none;
        }

            .home-page .navbar-link-btn:hover {
                color: var(--denim);
            }

        /* ===== Boutons ===== */
        .home-page .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 22px;
            border-radius: var(--radius-sm);
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 0.9375rem;
            text-decoration: none;
            transition: all 0.15s ease;
            white-space: nowrap;
        }

        .home-page .btn--sm {
            padding: 8px 16px;
            font-size: 0.8125rem;
        }

        .home-page .btn--primary {
            background: var(--denim);
            color: #fff;
            box-shadow: 0 6px 16px -6px rgba(43,76,126,0.4);
        }

            .home-page .btn--primary:hover {
                background: var(--denim-dark);
            }

        .home-page .btn--outline {
            background: transparent;
            color: var(--ink);
            border: 1px solid var(--border);
        }

            .home-page .btn--outline:hover {
                border-color: var(--denim);
                color: var(--denim);
            }

        /* ===== Hero ===== */
        .home-page .hero {
            background: var(--page-gradient);
            padding: 72px 0 96px 0;
            overflow: hidden;
            min-height: calc(100vh - var(--navbar-h));
            display: flex;
            align-items: center;
        }

        .home-page .hero-grid {
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            align-items: center;
            gap: 48px;
        }

        .home-page .hero-eyebrow {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--denim);
            background: var(--denim-tint);
            border: 1px solid rgba(43,76,126,0.15);
            padding: 5px 12px;
            border-radius: 999px;
            margin-bottom: 20px;
        }

        .home-page .hero-title {
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 2.75rem;
            line-height: 1.15;
            letter-spacing: -0.02em;
            color: var(--ink);
            margin: 0 0 16px 0;
        }

        .home-page .hero-subtitle {
            font-size: 1.0625rem;
            line-height: 1.65;
            color: var(--ink-muted);
            margin: 0 0 28px 0;
            max-width: 460px;
        }

        .home-page .hero-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 32px;
        }

        .home-page .hero-trust {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

            .home-page .hero-trust span {
                display: flex;
                align-items: center;
                gap: 6px;
                font-size: 0.8125rem;
                font-weight: 500;
                color: var(--ink-muted);
            }

            .home-page .hero-trust svg, .home-page .hero-trust .mud-icon-root {
                color: var(--denim);
                font-size: 1rem;
            }

        /* ===== Hero visual : mockup produit ===== */
        .home-page .hero-visual {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 340px;
        }

        .home-page .mockup-card {
            position: absolute;
            width: 270px;
            background: var(--paper);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: 0 24px 48px -20px rgba(20,38,63,0.28);
        }

        .home-page .mockup-card--back {
            height: 300px;
            background: var(--denim-tint);
            transform: rotate(8deg) translate(18px, 10px);
            z-index: 1;
        }

        .home-page .mockup-card--front {
            transform: rotate(-4deg);
            overflow: hidden;
            z-index: 2;
        }

        .home-page .mockup-strip {
            height: 4px;
            background: var(--denim);
        }

        .home-page .mockup-image {
            position: relative;
            height: 150px;
            background: var(--sand);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .home-page .mockup-badge-ref {
            position: absolute;
            top: 10px;
            left: 10px;
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            background: rgba(22,35,58,0.85);
            color: #fff;
            padding: 3px 8px;
            border-radius: 6px;
        }

        .home-page .mockup-badge-cat {
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 0.625rem;
            font-weight: 600;
            color: #fff;
            background: var(--denim);
            padding: 3px 8px;
            border-radius: 6px;
        }

        .home-page .mockup-body {
            padding: 16px;
        }

        .home-page .mockup-title {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.9375rem;
            color: var(--ink);
            margin-bottom: 8px;
        }

        .home-page .mockup-detail {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.8125rem;
            color: var(--ink-muted);
            margin-bottom: 12px;
        }

        .home-page .mockup-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 10px;
            border-top: 1px solid var(--border);
            font-size: 0.75rem;
        }

        .home-page .mockup-lifecycle {
            font-weight: 600;
            color: var(--denim);
            background: var(--denim-tint);
            padding: 3px 8px;
            border-radius: 6px;
        }

        .home-page .mockup-stock {
            color: var(--ink-muted);
            font-weight: 500;
        }

        /* ===== Sections génériques =====
               Chaque section prend son propre espace (min-height plein écran)
               et partage exactement le même fond dégradé que la hero,
               pour une continuité visuelle sur toute la page. */
        .home-page .section {
            background: var(--page-gradient);
            padding: 88px 0;
            min-height: calc(100vh - var(--navbar-h));
            display: flex;
            align-items: center;
            scroll-margin-top: var(--navbar-h);
        }

        .home-page .section--closing {
            min-height: auto;
            padding: 64px 0;
        }

        .home-page .section-head {
            margin-bottom: 44px;
            max-width: 560px;
        }

        .home-page .section-kicker {
            display: block;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--denim);
            margin-bottom: 10px;
        }

        .home-page .section-title {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.75rem;
            color: var(--ink);
            letter-spacing: -0.01em;
            margin: 0;
        }

        /* ===== Frise "parcours" ===== */
        .home-page .stitch-flow {
            position: relative;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .home-page .stitch-line {
            position: absolute;
            top: 22px;
            left: 11%;
            right: 11%;
            height: 0;
            border-top: 2px dashed var(--border);
            z-index: 0;
        }

        .home-page .stitch-step {
            position: relative;
            z-index: 1;
        }

        .home-page .stitch-node {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--paper);
            border: 2px solid var(--denim);
            color: var(--denim);
            font-family: var(--font-mono);
            font-weight: 600;
            font-size: 0.8125rem;
            margin-bottom: 16px;
        }

        .home-page .stitch-label {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 1rem;
            color: var(--ink);
            margin: 0 0 6px 0;
        }

        .home-page .stitch-text {
            font-size: 0.875rem;
            line-height: 1.55;
            color: var(--ink-muted);
            margin: 0;
        }

        /* ===== Feature cards ===== */
        .home-page .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .home-page .feature-card {
            background: var(--paper);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 28px 24px;
            transition: transform 0.18s ease, box-shadow 0.18s ease;
        }

            .home-page .feature-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 16px 32px -18px rgba(20,38,63,0.25);
            }

        .home-page .feature-icon {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: var(--denim-tint);
            color: var(--denim);
            margin-bottom: 16px;
        }

        .home-page .feature-title {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 1.0625rem;
            color: var(--ink);
            margin: 0 0 8px 0;
        }

        .home-page .feature-text {
            font-size: 0.875rem;
            line-height: 1.6;
            color: var(--ink-muted);
            margin: 0;
        }

        /* ===== Bande de clôture ===== */
        .home-page .closing-band {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
            background: var(--denim);
            border-radius: var(--radius-lg);
            padding: 40px 44px;
            color: #fff;
        }

        .home-page .closing-title {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.375rem;
            margin: 0 0 4px 0;
        }

        .home-page .closing-text {
            color: rgba(255,255,255,0.8);
            margin: 0;
            font-size: 0.9375rem;
        }

        .home-page .closing-band .btn--primary {
            background: #fff;
            color: var(--denim-dark);
            box-shadow: none;
        }

            .home-page .closing-band .btn--primary:hover {
                background: rgba(255,255,255,0.9);
            }

        /* ===== Footer ===== */
        .home-page .footer {
            border-top: 1px solid var(--border);
            padding: 28px 0;
            background: var(--paper);
        }

        .home-page .footer-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

        .home-page .footer-brand {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.9375rem;
        }

        .home-page .footer-copy {
            font-size: 0.8125rem;
            color: var(--ink-muted);
        }

    /* ===== Responsive ===== */
    @@media (max-width: 960px) {
        .home-page .hero-grid {
            grid-template-columns: 1fr;
        }

        .home-page .hero-visual {
            min-height: 260px;
            margin-top: 24px;
        }

        .home-page .feature-grid {
            grid-template-columns: 1fr;
        }

        .home-page .stitch-flow {
            grid-template-columns: repeat(2, 1fr);
            row-gap: 32px;
        }

        .home-page .stitch-line {
            display: none;
        }

        .home-page .navbar-links {
            display: none;
        }

        .home-page .section,
        .home-page .hero {
            min-height: auto;
        }
    }

    @@media (max-width: 600px) {
        .home-page .hero {
            padding: 48px 0 64px 0;
        }

        .home-page .hero-title {
            font-size: 2rem;
        }

        .home-page .section {
            padding: 64px 0;
        }

        .home-page .stitch-flow {
            grid-template-columns: 1fr;
        }

