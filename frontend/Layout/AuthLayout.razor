@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div style="min-height: 100vh; background: #F3F6FA; display: flex; flex-direction: column;">

    <!-- Barre supérieure minimaliste -->
    <div style="padding: 20px 40px; display: flex; align-items: center;">
        <a href="/" style="text-decoration: none; display: flex; align-items: center; gap: 10px;">
            <div style="width: 34px; height: 34px; border-radius: 9px; background: #2B4C7E; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                    <path d="M3 8 L21 8 M3 12 L21 12 M3 16 L21 16" stroke="#fff" stroke-width="2" stroke-linecap="round" />
                    <path d="M7 4 L7 20 M12 4 L12 20 M17 4 L17 20" stroke="rgba(255,255,255,0.5)" stroke-width="1.4" stroke-linecap="round" />
                </svg>
            </div>
            <span style="font-family: 'Sora', 'Inter', sans-serif; font-size: 1.125rem; font-weight: 700; color: #16233A; letter-spacing: -0.01em;">WicStock</span>
        </a>
    </div>

    <!-- Contenu centré -->
    <div style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 20px;">
        @Body
    </div>

    <!-- Pied de page discret -->
    <div style="padding: 16px; text-align: center;">
        <span style="font-size: 0.75rem; color: #94a3b8;">© 2026 WicStock — Tous droits réservés</span>
    </div>
</div>

@code {
    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#4f46e5",
            Secondary = "#0f172a",
            AppbarBackground = "#ffffff",
            Background = "#f8fafc",
            DrawerBackground = "#ffffff",
            TextPrimary = "#0f172a",
            TextSecondary = "#475569",
            Surface = "#ffffff",
            ActionDefault = "#475569",
            Success = "#10b981",
            Error = "#ef4444",
            Info = "#0ea5e9",
            Warning = "#f59e0b"
        }
    };
}
