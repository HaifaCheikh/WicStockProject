    .item-time {
        font-size: 0.6875rem;
        color: #64748b;
    }

    .unread-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--denim, #2B4C7E);
        flex-shrink: 0;
        margin-top: 6px;
    }
</style>

@code {
    private bool _isOpen = false;
    private bool _hasNewPulse = false;
    private string currentRole = "CLIENT";
    private int? currentUserId = null;

    private IEnumerable<WicStock.Web.Models.Dtos.NotificationDto> FilteredNotifications =>
        NotificationService.Notifications.Where(EstPourUtilisateurCourant);

    private int UnreadCountFiltered => FilteredNotifications.Count(n => !n.Lue);

    private bool EstPourUtilisateurCourant(WicStock.Web.Models.Dtos.NotificationDto notif)
    {
        if (notif == null) return false;

        // Si la notif a un utilisateur destinataire spécifique
        if (notif.UtilisateurDestinataireId.HasValue && currentUserId.HasValue)
        {
            if (notif.UtilisateurDestinataireId.Value != currentUserId.Value)
                return false;
        }

        // Si la notif a un rôle destinataire spécifique
        if (!string.IsNullOrWhiteSpace(notif.RoleDestinataire))
        {
            if (!string.Equals(notif.RoleDestinataire, currentRole, StringComparison.OrdinalIgnoreCase))
                return false;
        }

        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnNotificationReceived += HandleNotificationReceived;
        NotificationService.OnUnreadCountChanged += HandleUnreadCountChanged;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var roleClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (!string.IsNullOrEmpty(roleClaim))
            {
                currentRole = roleClaim;
            }
            else
            {
                var r = await AuthService.ObtenirRole();
                if (!string.IsNullOrEmpty(r)) currentRole = r;
            }

            var subClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)
                ?? authState.User.FindFirst("sub")
                ?? authState.User.FindFirst("nameid");
            if (subClaim != null && int.TryParse(subClaim.Value, out int uid))
            {
                currentUserId = uid;
            }
        }
        catch { }
    }

    private async void HandleUnreadCountChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleNotificationReceived(WicStock.Web.Models.Dtos.NotificationDto notification)
    {
        _hasNewPulse = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(3600);
        _hasNewPulse = false;
        await InvokeAsync(StateHasChanged);
    }

    private void TogglePopover()
    {
        _isOpen = !_isOpen;
    }

    private async Task ClicNotification(WicStock.Web.Models.Dtos.NotificationDto item)
    {
        _isOpen = false;
        if (!item.Lue)
        {
            await NotificationService.MarquerCommeLueAsync(item.Id);
        }

        var targetUrl = ResoudreRouteNotification(item);
        if (!string.IsNullOrEmpty(targetUrl))
        {
            Navigation.NavigateTo(targetUrl);
        }
    }

    private string ResoudreRouteNotification(WicStock.Web.Models.Dtos.NotificationDto item)
    {
        if (item == null) return "/";

        var url = item.UrlCible?.Trim();
        var typeUpper = (item.Type ?? string.Empty).ToUpperInvariant();
        var msgLower = (item.Message ?? string.Empty).ToLowerInvariant();

        // 0. SURSTOCK ACTION DU RESPONSABLE → Rediriger l'Admin vers le produit concerné
        if (typeUpper == "ACTION_RESPONSABLE_EXECUTEE")
        {
            // L'URL cible contient déjà /produits?statut=SURSTOCK&highlight=...
            if (!string.IsNullOrEmpty(url)) return url;
            return "/produits?statut=SURSTOCK";
        }

        // 0b. ALERTE SURSTOCK POUR LE RESPONSABLE
        if (typeUpper == "ACTION_IA_A_VALIDER" || typeUpper == "SURSTOCK")
        {
            if (!string.IsNullOrEmpty(url)) return url;
            return "/produits?statut=SURSTOCK";
        }

        // 1. RÉCLAMATIONS ET AVIS
        bool estReclamationOuAvis = typeUpper.Contains("RECLAMATION") || typeUpper.Contains("AVIS") || typeUpper.Contains("DISPUTE")
            || msgLower.Contains("réclamation") || msgLower.Contains("reclamation") || msgLower.Contains("avis") || msgLower.Contains("réclamé");

        if (estReclamationOuAvis)
        {
            if (!string.IsNullOrEmpty(url) && (url.Contains("/mes-avis-reclamations") || url.Contains("/admin/reclamations") || url.Contains("/admin/avis")))
                return url;

            return currentRole == "CLIENT" ? "/mes-avis-reclamations" : "/admin/reclamations";
        }

        // 2. NOUVEAU PRODUIT ET CATALOGUE
        bool estNouveauProduit = typeUpper.Contains("PRODUIT") || typeUpper.Contains("CATALOGUE") || typeUpper.Contains("NOUVEAU")
            || msgLower.Contains("nouveau produit") || msgLower.Contains("article") || msgLower.Contains("catalogue");

        if (estNouveauProduit)
        {
            // Essayer d'extraire un ID de produit depuis UrlCible (ex: /catalogue?produit=42)
            int? produitId = null;
            string? categorie = null;

            if (!string.IsNullOrEmpty(url))
            {
                var matchId = System.Text.RegularExpressions.Regex.Match(url, @"[?&]produit=(\d+)");
                if (matchId.Success && int.TryParse(matchId.Groups[1].Value, out var pid))
                    produitId = pid;

                var matchCat = System.Text.RegularExpressions.Regex.Match(url, @"[?&]categorie=([^&]+)");
                if (matchCat.Success)
                    categorie = Uri.UnescapeDataString(matchCat.Groups[1].Value);

                // Si URL pointe déjà vers /catalogue avec les bons params, la retourner telle quelle
                if ((url.Contains("/catalogue") || url.Contains("/produits")) && produitId.HasValue)
                    return currentRole == "CLIENT" ? url : url.Replace("/catalogue", "/produits");
            }

            // Essayer d'extraire un ID de produit depuis le message (ex: "produit #42" ou "produit 42")
            if (!produitId.HasValue)
            {
                var matchIdMsg = System.Text.RegularExpressions.Regex.Match(item.Message ?? "", @"(?:produit|article|ref)[^\d]*#?(\d+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                if (matchIdMsg.Success && int.TryParse(matchIdMsg.Groups[1].Value, out var pidMsg))
                    produitId = pidMsg;
            }

            // Essayer d'extraire une catégorie connue depuis le message
            if (string.IsNullOrEmpty(categorie))
            {
                string[] categoriesConnues = { "Jacket", "Pants", "Set", "Shirt", "Shorts", "Dress", "Coat", "Skirt" };
                var msgOriginal = item.Message ?? string.Empty;
                foreach (var cat in categoriesConnues)
                {
                    if (msgOriginal.Contains(cat, StringComparison.OrdinalIgnoreCase))
                    {
                        categorie = cat;
                        break;
                    }
                }
            }

            if (currentRole == "CLIENT")
            {
                var targetBase = "/catalogue";
                if (produitId.HasValue)
                {
                    var qs = $"?produit={produitId.Value}";
                    if (!string.IsNullOrEmpty(categorie)) qs += $"&categorie={Uri.EscapeDataString(categorie)}";
                    return targetBase + qs;
                }
                if (!string.IsNullOrEmpty(categorie))
                    return $"{targetBase}?categorie={Uri.EscapeDataString(categorie)}";
                return targetBase;
            }

            return "/produits";
        }

        // 3. PAIEMENT, LIVRAISON ET SUIVI DE COMMANDE
        bool estCommandeOuLivraison = typeUpper.Contains("COMMANDE") || typeUpper.Contains("LIVRAISON") || typeUpper.Contains("PAIEMENT") || typeUpper.Contains("STATUT")
            || msgLower.Contains("commande") || msgLower.Contains("livraison") || msgLower.Contains("livré") || msgLower.Contains("livree") || msgLower.Contains("expédié") || msgLower.Contains("paiement");

        if (estCommandeOuLivraison)
        {
            if (!string.IsNullOrEmpty(url) && (url.Contains("/mes-commandes") || url.Contains("/suivi") || url.Contains("/commandes") || url.Contains("/livraisons")))
                return url;

            if (currentRole == "CLIENT")
            {
                var match = System.Text.RegularExpressions.Regex.Match(msgLower + " " + url, @"(?:commande|suivi|#)\s*[\/#]?\s*(\d+)");
                if (match.Success && int.TryParse(match.Groups[1].Value, out var commandeId) && commandeId > 0)
                {
                    return $"/mes-commandes/suivi/{commandeId}";
                }
                return "/mes-commandes";
            }

            if (currentRole == "LIVREUR") return "/livraisons";
            return "/commandes";
        }

        // 4. SI URL CIBLE VALIDE DÉJÀ PRÉSENTE
        if (!string.IsNullOrEmpty(url)) return url;

        // 5. PAR DÉFAUT SELON LE RÔLE
        return currentRole switch
        {
            "CLIENT" => "/catalogue",
            "LIVREUR" => "/livraisons",
            _ => "/produits"
        };
    }

    private async Task ToutMarquerCommeLu()
    {
        await NotificationService.MarquerToutesCommeLuesAsync();
    }

    private string GetIconClass(string type) => type switch
    {
        "RUPTURE_STOCK" => "icon-rupture",
        "COMMANDE_EN_ATTENTE" => "icon-commande",
        "ACTION_IA_A_VALIDER" => "icon-action-ia",
        "ACTION_RESPONSABLE_EXECUTEE" => "icon-responsable-done",
        "NOUVEAU_PRODUIT" => "icon-nouveau",
        _ => "icon-default"
    };

    private string GetIconName(string type) => type switch
    {
        "RUPTURE_STOCK" => Icons.Material.Filled.Warning,
        "COMMANDE_EN_ATTENTE" => Icons.Material.Filled.ShoppingCart,
        "ACTION_IA_A_VALIDER" => Icons.Material.Filled.SmartToy,
        "ACTION_RESPONSABLE_EXECUTEE" => Icons.Material.Filled.TaskAlt,
        "NOUVEAU_PRODUIT" => Icons.Material.Filled.NewReleases,
        _ => Icons.Material.Filled.Notifications
    };

    private static string NettoyerEncodage(string? texte)
    {
        if (string.IsNullOrWhiteSpace(texte)) return string.Empty;

        string cur = texte;

        // 1. Remplacement Regex ultra-robuste des mots connus avec n'importe quelle séquence de corruption entre la première lettre et la suite du mot
        cur = System.Text.RegularExpressions.Regex.Replace(cur, @"D\S*?couvrez", "Découvrez", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        cur = System.Text.RegularExpressions.Regex.Replace(cur, @"d\S*?sormais", "désormais", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        cur = System.Text.RegularExpressions.Regex.Replace(cur, @"d\S*?tails", "détails", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        cur = System.Text.RegularExpressions.Regex.Replace(cur, @"r\S*?clamation", "réclamation", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        // 2. Remplacements explicites de toutes les variations d'artéfacts (du plus long au plus court)
        cur = cur
            .Replace("DÃÃ©couvrez", "Découvrez")
            .Replace("DÃf©couvrez", "Découvrez")
            .Replace("DÃfÆ'Ã‚Â©couvrez", "Découvrez")
            .Replace("DÃfÆ'Ã‚©couvrez", "Découvrez")
            .Replace("DÃ©couvrez", "Découvrez")
            .Replace("dÃ©sormais", "désormais")
            .Replace("dÃ©tails", "détails")
            .Replace("ÃfÆ'Ã‚Â©", "é")
            .Replace("ÃfÆ'Ã‚©", "é")
            .Replace("ÃfÆ'Ã‚", "é")
            .Replace("Ãf©", "é")
            .Replace("ÃÃ©", "é")
            .Replace("ÃÃ¨", "è")
            .Replace("ÃÃ ", "à")
            .Replace("Ãé", "é")
            .Replace("Ã©", "é")
            .Replace("Ã¨", "è")
            .Replace("Ã ", "à")
            .Replace("Ãª", "ê")
            .Replace("Ã´", "ô")
            .Replace("Ã§", "ç")
            .Replace("Ã¯", "ï")
            .Replace("Ã®", "î")
            .Replace("Ã¹", "ù")
            .Replace("Ã»", "û")
            .Replace("â€™", "’")
            .Replace("Â", "");

        return cur.Trim();
    }

    private string FormaterMessage(string? message, string? urlCible)
    {
        if (string.IsNullOrWhiteSpace(message)) return string.Empty;

        message = NettoyerEncodage(message);

        bool estReclamationOuAvis = (urlCible != null && (urlCible.Contains("reclamation", StringComparison.OrdinalIgnoreCase) || urlCible.Contains("avis", StringComparison.OrdinalIgnoreCase)))
            || message.Contains("réclamation", StringComparison.OrdinalIgnoreCase)
            || message.Contains("reclamation", StringComparison.OrdinalIgnoreCase)
            || message.Contains("avis", StringComparison.OrdinalIgnoreCase);

        if (estReclamationOuAvis)
        {
            string cleaned = System.Text.RegularExpressions.Regex.Replace(
                message,
                @"\s*(sur|pour|de)?\s*(la\s*)?commande\s*#?\d+",
                "",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase
            );
            cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"\s+", " ").Trim();
            return cleaned;
        }

        return message;
    }

    private string FormaterTempsEcoule(DateTime date)
    {
        var diff = DateTime.Now - date;
        if (diff.TotalMinutes < 1) return "À l'instant";
        if (diff.TotalMinutes < 60) return $"il y a {(int)diff.TotalMinutes} min";
        if (diff.TotalHours < 24) return $"il y a {(int)diff.TotalHours} h";
        return $"le {date:dd/MM/yyyy}";
    }

    public void Dispose()
    {
        NotificationService.OnNotificationReceived -= HandleNotificationReceived;
        NotificationService.OnUnreadCountChanged -= HandleUnreadCountChanged;
    }
}
