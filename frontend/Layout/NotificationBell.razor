@inject WicStock.Web.Services.NotificationClientService NotificationService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject WicStock.Web.Services.AuthService AuthService
@implements IDisposable

<div class="notification-bell-wrapper">
    <button class="bell-button @(_hasNewPulse ? "pulse-anim" : "")" @onclick="TogglePopover" aria-label="Notifications">
        <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Medium" Class="bell-icon" />
        @if (UnreadCountFiltered > 0)
        {
            <span class="bell-badge">@UnreadCountFiltered</span>
        }
    </button>

    <MudPopover Open="_isOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="notification-popover">
        <div class="popover-content">
            <!-- Popover Header -->
            <div class="popover-header">
                <div class="header-title-wrap">
                    <span class="header-title">Notifications</span>
                    @if (UnreadCountFiltered > 0)
                    {
                        <span class="count-badge">@UnreadCountFiltered non lue(s)</span>
                    }
                </div>
                @if (UnreadCountFiltered > 0)
                {
                    <button class="btn-text-action" @onclick="ToutMarquerCommeLu">
                        Tout marquer comme lu
                    </button>
                }
            </div>

            <!-- Popover Body / List -->
            <div class="popover-body">
                @if (!FilteredNotifications.Any())
                {
                    <div class="empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.NotificationsNone" Size="Size.Large" Class="empty-icon" />
                        <span>Aucune notification pour le moment.</span>
                    </div>
                }
                else
                {
                    @foreach (var item in FilteredNotifications.Take(15))
                    {
                        <div class="notification-item @(!item.Lue ? "unread" : "")" @onclick="() => ClicNotification(item)">
                            <div class="item-icon-wrapper @GetIconClass(item.Type)">
                                <MudIcon Icon="@GetIconName(item.Type)" Size="Size.Small" />
                            </div>
                            <div class="item-content">
                                <div class="item-message">@FormaterMessage(item.Message, item.UrlCible)</div>
                                <div class="item-time">@FormaterTempsEcoule(item.DateCreation)</div>
                            </div>
                            @if (!item.Lue)
                            {
                                <div class="unread-dot"></div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </MudPopover>
</div>

<style>
    .notification-bell-wrapper {
        position: relative;
        display: inline-block;
        overflow: visible;
    }

    .bell-button {
        position: relative;
        background: #ffffff;
        border: 1px solid #E1E7EF;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #64748B;
        box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
        transition: all 0.2s ease;
    }

        .bell-button:hover {
            background: #F3F6FA;
            border-color: #2B4C7E;
            color: #2B4C7E;
            box-shadow: 0 4px 10px -2px rgba(43, 76, 126, 0.18);
            transform: translateY(-1px);
        }

        .bell-button:active {
            transform: translateY(0);
            box-shadow: 0 1px 2px rgba(16, 24, 40, 0.08);
        }

    .bell-icon {
        font-size: 1.15rem !important;
    }

    .bell-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        background: #ef4444;
        color: #ffffff;
        font-family: var(--font-mono, "JetBrains Mono", monospace);
        font-size: 0.6875rem;
        font-weight: 700;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 10px;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 0 2px #ffffff;
    }

    /* Animation pulse lors d'une nouvelle notification */
    .pulse-anim {
        animation: bellPulse 1.2s ease-in-out 3;
    }

    @@keyframes bellPulse {
        0% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5);
        }

        50% {
            transform: scale(1.08);
            box-shadow: 0 0 0 8px rgba(239, 68, 68, 0);
        }

        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
        }
    }

    /* Popover Content */
    .notification-popover {
        border-radius: 12px !important;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05) !important;
        border: 1px solid var(--border, #E1E7EF);
        z-index: 3000 !important;
    }

    .popover-content {
        width: 380px;
        max-width: 92vw;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
    }

    .popover-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border, #E1E7EF);
        background: #fafafa;
        gap: 8px;
    }

    .header-title-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: nowrap;
        min-width: 0;
    }

    .header-title {
        font-family: var(--font-display, "Sora", sans-serif);
        font-weight: 700;
        font-size: 0.9375rem;
        color: var(--ink, #16233A);
        white-space: nowrap;
    }

    .count-badge {
        font-family: var(--font-mono, monospace);
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--denim, #2B4C7E);
        background: var(--denim-tint, #E7EDF6);
        padding: 2px 8px;
        border-radius: 6px;
        white-space: nowrap;
    }

    .btn-text-action {
        background: none;
        border: none;
        color: var(--denim, #2B4C7E);
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        padding: 4px 6px;
        border-radius: 4px;
        transition: background 0.15s ease;
        white-space: nowrap;
        flex-shrink: 0;
    }

        .btn-text-action:hover {
            background: var(--denim-tint, #E7EDF6);
        }

    .popover-body {
        max-height: 380px;
        overflow-y: auto;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        color: #94a3b8;
        font-size: 0.875rem;
        gap: 8px;
    }

    .empty-icon {
        color: #cbd5e1;
    }

    .notification-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 16px;
        border-bottom: 1px solid #f1f5f9;
        cursor: pointer;
        transition: background 0.15s ease;
        position: relative;
    }

        .notification-item:hover {
            background: #f8fafc;
        }

        .notification-item.unread {
            background: #f0f7ff;
        }

            .notification-item.unread:hover {
                background: #e5f1ff;
            }

    .item-icon-wrapper {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .icon-rupture {
        background: #fee2e2;
        color: #dc2626;
    }

    .icon-commande {
