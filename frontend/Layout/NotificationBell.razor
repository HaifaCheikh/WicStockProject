        color: #4338ca;
    }

    .icon-nouveau {
        background: #dcfce7;
        color: #166534;
    }

    .icon-responsable-done {
        background: #d1fae5;
        color: #059669;
    }

    .icon-default {
        background: #f1f5f9;
        color: #64748b;
    }

    .item-content {
        flex: 1;
        min-width: 0;
    }

    .item-message {
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--ink, #16233A);
        line-height: 1.4;
        margin-bottom: 4px;
