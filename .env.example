# ============================================================
# WicStock — Exemple de fichier de variables d'environnement
# ============================================================
# Copiez ce fichier vers .env (non versionné) et personnalisez
# les valeurs avant de lancer docker-compose up.
#
# IMPORTANT : Ne commitez jamais le fichier .env réel sur Git.
# ============================================================

# --- Grafana Monitoring (Local seulement) ---
# Changez ces valeurs avant tout déploiement public !
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- SQL Server (Local docker-compose) ---
SA_PASSWORD=VotreMotDePasseFort123!
